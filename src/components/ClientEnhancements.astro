<script>
  import Alpine from "alpinejs";
  import Fuse from "fuse.js";
  import htmx from "htmx.org";

  if (!window.htmx) {
    window.htmx = htmx;
  }

  function normalize(value) {
    return String(value || "")
      .replace(/â€™|â€˜/g, "'")
      .replace(/â€œ|â€/g, "\"")
      .replace(/â€“|â€”/g, "-")
      .replace(/Â·/g, " ")
      .replace(/Â/g, "")
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[’‘`]/g, "'")
      .replace(/[^a-z0-9' ]+/g, " ")
      .replace(/\s+/g, " ")
      .trim();
  }

  function controlValue(control) {
    return normalize(control?.value || "");
  }

  function fieldValue(item, field) {
    if (!field) return normalize(item.text);
    const key = `fuzzy${field.charAt(0).toUpperCase()}${field.slice(1)}`;
    return normalize(item.el.dataset[key] || item.text);
  }

  function controlMatches(item, control) {
    const query = controlValue(control);
    if (!query || query === "all") return true;

    const field = control.dataset.fuzzyField || "";
    const matchMode = control.dataset.fuzzyMatch || (control.tagName === "SELECT" ? "exact" : "contains");
    const value = fieldValue(item, field);

    if (matchMode === "exact") return value === query;
    if (matchMode === "starts") return value.startsWith(query);
    return value.includes(query);
  }

  function isActiveControl(control) {
    const query = controlValue(control);
    return !!query && query !== "all";
  }

  function controlLabel(control) {
    return (
      control.dataset.fuzzyLabel ||
      control.closest("label")?.querySelector("span")?.textContent ||
      control.name ||
      "Filter"
    ).trim();
  }

  function rawControlValue(control) {
    return String(control?.value || "").trim();
  }

  function escapeHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function sortValue(item, key) {
    const dataKey = `fuzzySort${key.charAt(0).toUpperCase()}${key.slice(1)}`;
    return item.el.dataset[dataKey] || item.el.dataset[`fuzzy${key.charAt(0).toUpperCase()}${key.slice(1)}`] || item.text || "";
  }

  function compareValues(a, b, numeric = false) {
    if (numeric) {
      const first = Number(a);
      const second = Number(b);
      if (Number.isFinite(first) && Number.isFinite(second)) return first - second;
      if (Number.isFinite(first)) return -1;
      if (Number.isFinite(second)) return 1;
    }

    return normalize(a).localeCompare(normalize(b), undefined, { numeric: true });
  }

  function debounce(callback, wait = 120) {
    let timeout = 0;
    return (...args) => {
      window.clearTimeout(timeout);
      timeout = window.setTimeout(() => callback(...args), wait);
    };
  }

  Alpine.data("nhdbFuzzyFilter", (options = {}) => ({
    count: 0,
    matchedCount: 0,
    total: 0,
    query: "",
    visibleLimit: 0,
    init() {
      this.itemSelector = options.itemSelector || "[data-fuzzy-item]";
      this.searchControls = Array.from(this.$el.querySelectorAll("[data-fuzzy-search]"));
      this.filterControls = Array.from(this.$el.querySelectorAll("[data-fuzzy-filter-field]"));
      this.countTarget = this.$el.querySelector("[data-fuzzy-count]");
      this.matchedCountTarget = this.$el.querySelector("[data-fuzzy-matched-count]");
      this.totalCountTarget = this.$el.querySelector("[data-fuzzy-total-count]");
      this.emptyTarget = this.$el.querySelector("[data-fuzzy-empty]");
      this.chipsTarget = this.$el.querySelector("[data-fuzzy-chips]");
      this.moreButton = this.$el.querySelector("[data-fuzzy-more]");
      this.sortControls = Array.from(this.$el.querySelectorAll("[data-fuzzy-sort]"));
      this.pageSize = Number(options.pageSize || options.idleLimit || 0);
      this.visibleLimit = this.pageSize;
      this.refresh();

      this.applyAndSync = debounce(() => {
        this.resetVisibleLimit();
        this.apply();
        this.syncUrl(false);
      }, Number(options.debounce ?? 120));

      [...this.searchControls, ...this.filterControls, ...this.sortControls].forEach((control) => {
        control.addEventListener("input", () => this.applyAndSync());
        control.addEventListener("change", () => this.applyAndSync());
      });

      this.forms = Array.from(this.$el.querySelectorAll("[data-fuzzy-live-form]"));
      this.forms.forEach((form) => {
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          this.apply();
          this.syncUrl(true);
        });
      });

      this.$el.addEventListener("nhdb:fuzzy-refresh", () => this.refresh());
      this.moreButton?.addEventListener("click", (event) => {
        event.preventDefault();
        this.showMore();
      });
      this.chipsTarget?.addEventListener("click", (event) => {
        const button = event.target.closest("[data-fuzzy-chip]");
        if (!button) return;

        const control = this.activeControls()[Number(button.dataset.fuzzyChip)];
        if (!control) return;

        control.value = "";
        control.dispatchEvent(new Event("input", { bubbles: true }));
        control.dispatchEvent(new Event("change", { bubbles: true }));
      });
      this.apply();
    },
    refresh() {
      this.countTarget = this.$el.querySelector("[data-fuzzy-count]");
      this.emptyTarget = this.$el.querySelector("[data-fuzzy-empty]");
      this.chipsTarget = this.$el.querySelector("[data-fuzzy-chips]");
      this.items = Array.from(this.$el.querySelectorAll(this.itemSelector || "[data-fuzzy-item]")).map((el) => {
        const fieldData = {};
        for (const [key, value] of Object.entries(el.dataset)) {
          if (key.startsWith("fuzzy") && key !== "fuzzyItem" && key !== "fuzzyText") {
            fieldData[key] = value;
          }
        }
        return {
          el,
          text: el.dataset.fuzzyText || el.textContent || "",
          ...fieldData,
        };
      });
      this.total = this.items.length;
      this.fuse = new Fuse(this.items, {
        ignoreLocation: true,
        includeScore: true,
        minMatchCharLength: 2,
        threshold: Number(options.threshold ?? 0.36),
        keys: [
          { name: "text", weight: 0.6 },
          { name: "fuzzyName", weight: 0.9 },
          { name: "fuzzyAliases", weight: 0.85 },
          { name: "fuzzyTitle", weight: 0.9 },
          { name: "fuzzyTown", weight: 0.45 },
          { name: "fuzzyCounty", weight: 0.45 },
          { name: "fuzzyDistrict", weight: 0.45 },
          { name: "fuzzyParty", weight: 0.35 },
          { name: "fuzzyOffice", weight: 0.45 },
          { name: "fuzzyBill", weight: 0.6 },
          { name: "fuzzyBillTitle", weight: 0.7 },
          { name: "fuzzyPeople", weight: 0.6 },
        ],
      });
      this.apply();
    },
    activeControls() {
      return [...this.searchControls, ...this.filterControls].filter(isActiveControl);
    },
    activeSort() {
      const control = this.sortControls.find((current) => rawControlValue(current));
      return rawControlValue(control);
    },
    resetVisibleLimit() {
      this.visibleLimit = this.pageSize;
    },
    showMore() {
      const increment = this.pageSize || Number(options.showMoreIncrement || 12);
      this.visibleLimit = (this.visibleLimit || 0) + increment;
      this.apply();
    },
    sortItems() {
      const sort = this.activeSort();
      if (!sort) return;

      const [key, direction = "asc"] = sort.split(":");
      const numeric = ["grade", "updated", "missing"].includes(key);
      const sorted = [...this.items].sort((a, b) => {
        const result = compareValues(sortValue(a, key), sortValue(b, key), numeric);
        return direction === "desc" ? -result : result;
      });

      const byParent = new Map();
      sorted.forEach((item) => {
        const parent = item.el.parentElement;
        if (!parent) return;
        if (!byParent.has(parent)) byParent.set(parent, []);
        byParent.get(parent).push(item.el);
      });

      byParent.forEach((elements, parent) => {
        elements.forEach((element) => parent.appendChild(element));
      });
      this.items = sorted;
    },
    renderChips() {
      if (!this.chipsTarget) return;

      const controls = this.activeControls();
      this.chipsTarget.hidden = controls.length === 0;
      this.chipsTarget.innerHTML = controls
        .map((control, index) => `
          <button type="button" data-fuzzy-chip="${index}">
            <span>${escapeHtml(controlLabel(control))}: ${escapeHtml(rawControlValue(control))}</span>
            <b aria-hidden="true">×</b>
          </button>
        `)
        .join("");
    },
    apply() {
      this.sortItems();
      const searchQuery = normalize(this.searchControls.map((control) => control.value).join(" "));
      this.query = searchQuery;
      const idleLimit = Number(options.idleLimit || 0);
      const pageSize = Number(options.pageSize || 0);
      const searchActive = searchQuery.length >= 2;
      const filtersActive = this.filterControls.some(isActiveControl);
      const filterActive = searchActive || filtersActive;
      const directMatches = searchQuery.length >= 2
        ? new Set(
            this.items
              .filter((item) => normalize([
                item.text,
                item.fuzzyName,
                item.fuzzyAliases,
                item.fuzzyTitle,
                item.fuzzyBillTitle,
                item.fuzzyPeople,
              ].filter(Boolean).join(" ")).includes(searchQuery))
              .map((item) => item.el),
          )
        : null;
      const fuzzyMatches = searchQuery.length >= 2
        ? directMatches.size
          ? directMatches
          : new Set(this.fuse.search(searchQuery).map((result) => result.item.el))
        : null;

      let visible = 0;
      let matched = 0;
      this.items.forEach((item, index) => {
        const matchesSearch = !fuzzyMatches || fuzzyMatches.has(item.el);
        const matchesFilters = this.filterControls.every((control) => controlMatches(item, control));
        const matches = matchesSearch && matchesFilters;
        if (matches) matched += 1;

        const loadedLimit = pageSize
          ? (this.visibleLimit || pageSize)
          : (filterActive || !idleLimit ? 0 : idleLimit);
        const show = matches && (!loadedLimit || matched <= loadedLimit);
        item.el.hidden = !show;
        item.el.toggleAttribute("data-fuzzy-hidden", !show);
        if (show) visible += 1;
      });

      this.count = visible;
      this.matchedCount = matched;
      if (this.countTarget) this.countTarget.textContent = String(visible);
      if (this.matchedCountTarget) this.matchedCountTarget.textContent = String(matched);
      if (this.totalCountTarget) this.totalCountTarget.textContent = String(this.total);
      if (this.emptyTarget) this.emptyTarget.hidden = visible !== 0;
      this.renderChips();
      if (this.moreButton) {
        this.moreButton.hidden = !pageSize || matched <= visible;
      }
    },
    syncUrl(push = false) {
      if (options.syncUrl === false || !this.forms?.length) return;

      const form = this.forms[0];
      const url = new URL(form.getAttribute("action") || window.location.href, window.location.origin);
      const params = new URLSearchParams();

      this.forms.forEach((currentForm) => {
        const formData = new FormData(currentForm);
        for (const [key, value] of formData.entries()) {
          const normalizedValue = String(value || "").trim();
          if (!normalizedValue || normalizedValue.toLowerCase() === "all") continue;
          params.set(key, normalizedValue);
        }
      });

      url.search = params.toString();
      const hash = url.hash || window.location.hash;
      const nextUrl = `${url.pathname}${url.search}${hash}`;
      if (nextUrl === `${window.location.pathname}${window.location.search}${window.location.hash}`) return;

      if (push) {
        window.history.pushState({}, "", nextUrl);
      } else {
        window.history.replaceState({}, "", nextUrl);
      }
    },
  }));

  if (!window.Alpine) {
    window.Alpine = Alpine;
    Alpine.start();
  }
</script>
