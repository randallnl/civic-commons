---
const campaignUrl = "https://givebutter.com/findmyNHcandidate";
const showFundraisingTools = !Astro.url.pathname.startsWith("/admin");
---

{showFundraisingTools && (
  <>
    <div class="crowdfunding-popup" data-crowdfunding-popup hidden>
      <div class="crowdfunding-scrim" data-crowdfunding-dismiss></div>
      <section
        class="crowdfunding-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="crowdfunding-title"
        aria-describedby="crowdfunding-description"
      >
        <button
          class="crowdfunding-close"
          type="button"
          aria-label="Close crowdfunding message"
          data-crowdfunding-dismiss
        >
          x
        </button>

        <p class="crowdfunding-eyebrow">Support the project</p>
        <h2 id="crowdfunding-title">Help Randall keep this resource growing</h2>
        <p id="crowdfunding-description" class="crowdfunding-lede">
          Randall has donated countless hours to making sure the community has
          the information it needs about legislators and candidates. A
          contribution, no matter how small, shows that his work matters and
          helps him continue improving this project.
        </p>

        <div class="crowdfunding-actions">
          <a
            class="crowdfunding-primary"
            href={campaignUrl}
            target="_blank"
            rel="noopener"
            data-crowdfunding-dismiss
          >
            Donate
          </a>
          <button class="crowdfunding-secondary" type="button" data-crowdfunding-dismiss>
            Not now
          </button>
        </div>
      </section>
    </div>
  </>
)}

<script>
  const popup = document.querySelector("[data-crowdfunding-popup]");
  const storageKey = "nhdb_crowdfunding_popup_dismissed_v1";
  const engagementStorageKey = "nhdb_crowdfunding_engagement_v2";
  const activeDelayMs = 3 * 60 * 1000;
  const requiredInteractions = 2;

  type EngagementState = {
    activeMs: number;
    interactions: number;
    scrollSignals: string[];
  };

  function readEngagementState(): EngagementState {
    try {
      const stored = JSON.parse(window.sessionStorage.getItem(engagementStorageKey) || "{}");
      return {
        activeMs: Number.isFinite(stored.activeMs) ? Math.max(0, stored.activeMs) : 0,
        interactions: Number.isFinite(stored.interactions)
          ? Math.max(0, stored.interactions)
          : 0,
        scrollSignals: Array.isArray(stored.scrollSignals) ? stored.scrollSignals : [],
      };
    } catch {
      return { activeMs: 0, interactions: 0, scrollSignals: [] };
    }
  }

  const engagement = readEngagementState();

  function saveEngagementState() {
    try {
      window.sessionStorage.setItem(engagementStorageKey, JSON.stringify(engagement));
    } catch {
      // Keep tracking in memory when session storage is unavailable.
    }
  }

  function todayKey() {
    const now = new Date();
    return [
      now.getFullYear(),
      String(now.getMonth() + 1).padStart(2, "0"),
      String(now.getDate()).padStart(2, "0"),
    ].join("-");
  }

  function dismissCrowdfundingPopup() {
    if (!(popup instanceof HTMLElement)) return;
    popup.hidden = true;
    document.documentElement.classList.remove("crowdfunding-open");
    engagement.activeMs = 0;
    engagement.interactions = 0;
    engagement.scrollSignals = [];
    saveEngagementState();
    try {
      window.localStorage.setItem(storageKey, todayKey());
    } catch {
      // Ignore storage failures; the close button should still work.
    }
  }

  function shouldShowCrowdfundingPopup() {
    if (window.location.pathname.startsWith("/admin")) return false;
    try {
      return window.localStorage.getItem(storageKey) !== todayKey();
    } catch {
      return true;
    }
  }

  let popupShown = false;
  let lastTick = performance.now();
  let wasVisible = document.visibilityState === "visible";

  function recordInteraction() {
    engagement.interactions = Math.min(engagement.interactions + 1, 20);
    saveEngagementState();
    evaluateCrowdfundingPopup();
  }

  function updateActiveTime() {
    const now = performance.now();
    if (wasVisible) {
      engagement.activeMs += Math.min(now - lastTick, 2000);
    }
    lastTick = now;
    wasVisible = document.visibilityState === "visible";
  }

  function evaluateCrowdfundingPopup() {
    updateActiveTime();
    saveEngagementState();

    if (
      popupShown ||
      !(popup instanceof HTMLElement) ||
      !shouldShowCrowdfundingPopup() ||
      engagement.activeMs < activeDelayMs ||
      engagement.interactions < requiredInteractions
    ) {
      return;
    }

    popupShown = true;
    popup.hidden = false;
    document.documentElement.classList.add("crowdfunding-open");
  }

  if (popup instanceof HTMLElement && shouldShowCrowdfundingPopup()) {
    const engagementTimer = window.setInterval(evaluateCrowdfundingPopup, 1000);

    document.addEventListener("visibilitychange", evaluateCrowdfundingPopup);
    window.addEventListener("pagehide", () => {
      evaluateCrowdfundingPopup();
      window.clearInterval(engagementTimer);
    });

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element
        ? event.target.closest("a, button, summary, input, select, textarea")
        : null;
      if (!target || target.closest("[data-crowdfunding-popup]")) return;
      recordInteraction();
    });

    window.addEventListener("scroll", () => {
      const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollableHeight <= 0) return;

      const depth = window.scrollY / scrollableHeight;
      [0.25, 0.5, 0.75].forEach((milestone) => {
        const signal = `${window.location.pathname}:${milestone}`;
        if (depth >= milestone && !engagement.scrollSignals.includes(signal)) {
          engagement.scrollSignals.push(signal);
          recordInteraction();
        }
      });
    }, { passive: true });

    window.setTimeout(() => {
      evaluateCrowdfundingPopup();
    }, 1000);
  }

  popup?.addEventListener("click", (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest("[data-crowdfunding-dismiss]")
    ) {
      dismissCrowdfundingPopup();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && popup instanceof HTMLElement && !popup.hidden) {
      dismissCrowdfundingPopup();
    }
  });
</script>

<style is:global>
  html.crowdfunding-open {
    overflow: hidden;
  }
</style>

<style>
  .crowdfunding-popup[hidden] {
    display: none;
  }

  .crowdfunding-popup {
    align-items: center;
    display: flex;
    inset: 0;
    justify-content: center;
    padding: clamp(16px, 4vw, 40px);
    position: fixed;
    z-index: 1000;
  }

  .crowdfunding-scrim {
    background:
      radial-gradient(circle at 25% 20%, rgba(220, 77, 9, 0.28), transparent 34%),
      rgba(15, 23, 42, 0.68);
    inset: 0;
    position: absolute;
  }

  .crowdfunding-card {
    background: #fffaf1;
    border: 1px solid rgba(120, 53, 15, 0.24);
    border-radius: 18px;
    box-shadow: 0 30px 90px rgba(15, 23, 42, 0.32);
    box-sizing: border-box;
    color: #1f2933;
    max-height: min(88vh, 560px);
    max-width: 600px;
    overflow: auto;
    padding: clamp(24px, 5vw, 40px);
    position: relative;
    width: min(100%, 600px);
  }

  .crowdfunding-card::before {
    background: linear-gradient(90deg, #dc4d09, #f59e0b, #2563eb);
    border-radius: 999px;
    content: "";
    display: block;
    height: 7px;
    margin-bottom: 22px;
    width: min(320px, 62%);
  }

  .crowdfunding-close {
    align-items: center;
    background: #1f2933;
    border: 0;
    border-radius: 999px;
    color: #fffaf1;
    cursor: pointer;
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 950;
    height: 34px;
    justify-content: center;
    line-height: 1;
    position: absolute;
    right: 18px;
    top: 18px;
    width: 34px;
  }

  .crowdfunding-eyebrow {
    color: #8a3a07;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.14em;
    margin: 0 44px 10px 0;
    text-transform: uppercase;
  }

  .crowdfunding-card h2 {
    color: #111827;
    font-size: clamp(1.9rem, 5vw, 3.4rem);
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
    max-width: min(100%, 18ch);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .crowdfunding-lede {
    color: #374151;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 750;
    line-height: 1.55;
    margin: 18px 0 0;
    max-width: 58ch;
  }

  .crowdfunding-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .crowdfunding-primary,
  .crowdfunding-secondary {
    border-radius: 999px;
    font-size: 0.96rem;
    font-weight: 950;
    line-height: 1;
    padding: 14px 18px;
  }

  .crowdfunding-primary {
    background: #dc4d09;
    border: 1px solid #dc4d09;
    color: white;
    text-decoration: none;
  }

  .crowdfunding-primary:hover {
    background: #b6390a;
    border-color: #b6390a;
  }

  .crowdfunding-secondary {
    background: transparent;
    border: 1px solid #d6b98f;
    color: #4b5563;
    cursor: pointer;
  }

  .crowdfunding-secondary:hover {
    background: white;
    color: #1f2933;
  }

  @media (max-width: 680px) {
    .crowdfunding-popup {
      align-items: flex-end;
      padding: 12px 12px calc(12px + env(safe-area-inset-bottom, 0px));
    }

    .crowdfunding-card {
      border-radius: 18px 18px 10px 10px;
      max-height: min(74vh, 560px);
      padding: 22px;
    }

    .crowdfunding-card h2 {
      font-size: clamp(1.65rem, 9vw, 2.4rem);
      max-width: calc(100% - 28px);
    }

    .crowdfunding-actions {
      background: linear-gradient(180deg, rgba(255, 250, 241, 0.86), #fffaf1 34%);
      bottom: -22px;
      margin-inline: -22px;
      padding: 14px 22px 22px;
      position: sticky;
      z-index: 2;
    }

    .crowdfunding-primary,
    .crowdfunding-secondary {
      flex: 1 1 160px;
      text-align: center;
    }
  }
</style>
