---
import {
  communityUpdateDate,
  getApprovedCommunityUpdates,
} from "../lib/communityUpdates";
import {
  canModerateContent,
  currentAdminSession,
} from "../lib/adminAuth";
import {
  getCommunityUpdateCards,
  mentionParts,
  peopleProfilePath,
  previewDescription,
  previewTitle,
} from "../lib/communityUpdateCards";
import { cleanText } from "../lib/text";
import profileIcon from "../assets/profile icon.png";

const {
  entityType,
  entityKey,
  entityName,
  pageUrl = Astro.url.pathname,
  variant = "",
} = Astro.props;

const updates = await getApprovedCommunityUpdates(entityType, entityKey, { limit: 12 });
const updateCards = await getCommunityUpdateCards(updates);
const adminSession = await currentAdminSession(Astro.request);
const canModerateUpdates = canModerateContent(adminSession);
const hasInstagramEmbeds = updateCards.some((card) => card.social?.type === "instagram");
const hasTikTokEmbeds = updateCards.some((card) => card.social?.type === "tiktok" && card.social.videoId);
const hasFacebookEmbeds = updateCards.some((card) => card.social?.type === "facebook" && card.social.embedUrl);
const isReport = entityType === "report";
---

<section class:list={["panel community-updates-panel", variant === "narrow" && "community-updates-panel-narrow"]}>
  <div class="section-heading">
    <p class="eyebrow">{isReport ? "Community updates" : "Share Your Thoughts"}</p>
    <h2>{isReport ? "Help improve this public analysis" : "Community context"}</h2>
    <p>
      {isReport
        ? "Share a source, correction, alternate calculation, or local context connected to this report. Submissions are reviewed before they appear publicly."
        : "Share a local note, article, social post, image, or correction connected to this profile. These updates help neighbors understand how public decisions affect people and communities. Submissions are reviewed before they appear publicly."}
    </p>
  </div>

  <details class="community-update-disclosure">
    <summary>
      <span class="thought-input-preview">
        <strong>What should neighbors know?</strong>
        <small>Add a thought, photo, link, or correction</small>
      </span>
      <strong>+</strong>
    </summary>

    <form class="community-update-form" action="/api/community-updates" method="post" enctype="multipart/form-data">
      <input type="hidden" name="entityType" value={entityType} />
      <input type="hidden" name="entityKey" value={entityKey} />
      <input type="hidden" name="entityName" value={entityName} />
      <input type="hidden" name="pageUrl" value={pageUrl} />
      <input type="hidden" name="redirectTo" value={Astro.url.pathname} />

      <label>
        Your thought
        <div class="mention-field" data-mention-field>
          <textarea
            name="comment"
            rows="4"
            placeholder="Share a local observation, correction, article context, social post summary, or update. Type @ and a legislator's name to tag them."
            data-mention-textarea
          ></textarea>
          <input
            class="mention-query-input"
            type="search"
            name="_mentionQuery"
            autocomplete="off"
            tabindex="-1"
            aria-hidden="true"
            hx-get="/api/mentions/people"
            hx-trigger="input changed delay:120ms"
            hx-target="next .mention-suggestions"
          />
          <div class="mention-suggestions" data-mention-suggestions aria-live="polite"></div>
          <p class="mention-help">Type <strong>@</strong> plus a candidate or legislator name to tag them for moderation.</p>
        </div>
      </label>

      <div class="form-grid">
        <label>
          Name
          <input name="displayName" autocomplete="name" placeholder="Community member" />
        </label>
        <label>
          Email
          <input name="email" type="email" autocomplete="email" placeholder="Used for moderation only" />
        </label>
      </div>

      <label>
        Photos
        <input name="photos" type="file" accept="image/*" multiple />
        <small>Select up to 8 images for moderation.</small>
      </label>

      <label>
        Link
        <input name="linkUrl" type="url" placeholder="https://example.com/context" />
      </label>

      <button type="submit">Submit for Review</button>
    </form>
  </details>

  {updateCards.length ? (
    <div class="community-update-list">
      {updateCards.map((update) => (
        <article class:list={["community-update-card", (update.photoUrls?.length || update.linkUrl) && "has-media"]}>
          {(update.linkUrl || update.photoUrls?.length > 0) && (
            <div class="community-update-media">
              {update.linkUrl && (
                update.social?.type === "tiktok" ? (
                  <div class="social-embed-wrap tiktok-embed-wrap">
                    <a class="rich-link-preview social-preview-card tiktok-preview-card" href={update.social.permalink || update.linkUrl}>
                      <span class="social-icon tiktok-icon" aria-hidden="true">TT</span>
                      {update.linkPreview?.imageUrl && <img src={update.linkPreview.imageUrl} alt="" loading="lazy" />}
                      <span>
                        <strong>{previewTitle(update.linkPreview, update.linkUrl)}</strong>
                        <small>
                        {update.social.handle
                            ? `${update.social.isProfile ? "Profile: " : ""}@${update.social.handle}`
                            : previewDescription(update.linkPreview, update.linkUrl)}
                        </small>
                      </span>
                    </a>
                    {update.social.isEmbeddable && update.social.videoId && (
                      <blockquote
                        class="tiktok-embed"
                        cite={update.social.permalink}
                        data-video-id={update.social.videoId}
                      >
                        <section>
                          <a href={update.social.permalink || update.linkUrl}>
                            View this video on TikTok
                          </a>
                        </section>
                      </blockquote>
                    )}
                  </div>
                ) : update.social?.type === "facebook" ? (
                  <div class="social-embed-wrap facebook-embed-wrap">
                    <a
                      class:list={[
                        "rich-link-preview",
                        "social-preview-card",
                        "facebook-preview-card",
                        !update.linkPreview?.imageUrl && "social-preview-card-no-image",
                      ]}
                      href={update.social.permalink || update.linkUrl}
                    >
                      <span class="social-icon facebook-icon" aria-hidden="true">FB</span>
                      {update.linkPreview?.imageUrl && <img src={update.linkPreview.imageUrl} alt="" loading="lazy" />}
                      <span>
                        <strong>{previewTitle(update.linkPreview, update.linkUrl)}</strong>
                        <small>{previewDescription(update.linkPreview, update.linkUrl)}</small>
                      </span>
                    </a>
                    {!update.linkPreview?.imageUrl && update.social.embedUrl && (
                      <iframe
                        class="facebook-embed facebook-media-embed"
                        src={update.social.embedUrl}
                        width="500"
                        height="520"
                        style="border:none;overflow:hidden"
                        scrolling="no"
                        frameborder="0"
                        allowfullscreen="true"
                        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                        loading="lazy"
                        title="Facebook post preview"
                      ></iframe>
                    )}
                  </div>
                ) : update.social?.type === "instagram" ? (
                  <div class="instagram-embed-wrap">
                    <a class="rich-link-preview instagram-preview-card" href={update.social.permalink || update.linkUrl}>
                      <span class="instagram-icon" aria-hidden="true">IG</span>
                      {update.linkPreview?.imageUrl && <img src={update.linkPreview.imageUrl} alt="" loading="lazy" />}
                      <span>
                        <strong>{previewTitle(update.linkPreview, update.linkUrl)}</strong>
                        <small>
                          {update.social.handle
                            ? `${update.social.isProfile ? "Profile: " : ""}@${update.social.handle}`
                            : previewDescription(update.linkPreview, update.linkUrl)}
                        </small>
                      </span>
                    </a>
                    {update.social.isEmbeddable && (
                      <blockquote
                        class="instagram-media"
                        data-instgrm-captioned
                        data-instgrm-permalink={update.social.permalink}
                        data-instgrm-version="14"
                      >
                        <a href={update.social.permalink || update.linkUrl}>
                          View this post on Instagram
                        </a>
                      </blockquote>
                    )}
                  </div>
                ) : update.social?.type === "substack" ? (
                  <a class="rich-link-preview social-preview-card substack-preview-card" href={update.social.permalink || update.linkUrl}>
                    <span class="social-icon substack-icon" aria-hidden="true">S</span>
                    {update.linkPreview?.imageUrl && <img src={update.linkPreview.imageUrl} alt="" loading="lazy" />}
                    <span>
                      <strong>{previewTitle(update.linkPreview, update.linkUrl)}</strong>
                      <small>
                        {update.social.handle
                          ? `@${update.social.handle} on Substack`
                          : update.social.publication
                            ? `${update.social.publication} on Substack`
                            : previewDescription(update.linkPreview, update.linkUrl)}
                      </small>
                    </span>
                  </a>
                ) : (
                  <a class="community-link-preview rich-link-preview" href={update.linkUrl}>
                    {update.linkPreview?.imageUrl && <img src={update.linkPreview.imageUrl} alt="" loading="lazy" />}
                    <span>
                      <strong>{previewTitle(update.linkPreview, update.linkUrl)}</strong>
                      {previewDescription(update.linkPreview, update.linkUrl) && (
                        <small>{previewDescription(update.linkPreview, update.linkUrl)}</small>
                      )}
                    </span>
                  </a>
                )
              )}
              {update.photoUrls?.length > 0 && (
                <>
                  <div class="community-photo-grid">
                    {update.photoUrls.map((photoUrl) => (
                      <button
                        class="community-photo-button"
                        type="button"
                        data-community-photo={photoUrl}
                        aria-label="Open community update photo"
                      >
                        <img src={photoUrl} alt="" loading="lazy" />
                      </button>
                    ))}
                  </div>
                  <span>{update.photoUrls.length === 1 ? "Photo update" : `${update.photoUrls.length} photo updates`}</span>
                </>
              )}
            </div>
          )}
          <div class="community-update-copy">
            <div class="community-update-meta">
              <strong>{cleanText(update.displayName || "Community member")}</strong>
              {communityUpdateDate(update.createdAt) && (
                <span>{communityUpdateDate(update.createdAt)}</span>
              )}
            </div>
            {update.comment && (
              <p>
                {mentionParts(update.comment, update.mentions).map((part) =>
                  part.href ? (
                    <a class="comment-mention-link" href={part.href}>{part.text}</a>
                  ) : (
                    part.text
                  ),
                )}
              </p>
            )}
            {update.mentions?.length > 0 && (
              <div class="mention-list" aria-label="Tagged people">
                <span>Tagged people</span>
                {update.mentions.map((mention) => (
                  <a href={peopleProfilePath(mention)}>
                    {mention.name}
                    {(mention.roleLabel || mention.chamber) && (
                      <small>{mention.roleLabel || mention.chamber}</small>
                    )}
                  </a>
                ))}
              </div>
            )}
            {update.people?.length > 0 && (
              <div class="community-people-preview" aria-label="People connected to this update">
                {update.people.map((person) => (
                  <a class="mini-person-card" href={peopleProfilePath(person)}>
                    <img
                      class:list={[!person.photoUrl && "profile-icon"]}
                      src={person.photoUrl || profileIcon.src}
                      alt={person.photoUrl ? `Photo of ${person.name}` : ""}
                      loading="lazy"
                    />
                    <span>
                      <strong>{person.name}</strong>
                      {person.role && <small>{person.role}</small>}
                      {person.districtLabel && <small>{person.districtLabel}</small>}
                    </span>
                  </a>
                ))}
              </div>
            )}
            {canModerateUpdates && (
              <details class="community-update-admin-editor">
                <summary>Edit update</summary>
                <form
                  action="/api/admin/community-updates"
                  method="post"
                  enctype="multipart/form-data"
                  hx-post="/api/admin/community-updates"
                  hx-encoding="multipart/form-data"
                  hx-target="find .community-update-admin-status"
                  hx-swap="innerHTML"
                >
                  <input type="hidden" name="id" value={update.id} />
                  <input type="hidden" name="redirectTo" value={Astro.url.pathname} />
                  <label>
                    Submitted by
                    <input name="displayName" value={cleanText(update.displayName || "Community member")} />
                  </label>
                  <label>
                    Update text
                    <textarea name="comment" rows="4">{cleanText(update.comment || "")}</textarea>
                  </label>
                  <label>
                    Link
                    <input name="linkUrl" type="url" value={update.linkUrl || ""} placeholder="https://example.com/context" />
                  </label>
                  <label class="community-update-admin-file">
                    Add photos
                    <input name="photos" type="file" accept="image/*" multiple />
                    <small>New photos are added to this update when you save.</small>
                  </label>
                  <div class="community-update-admin-actions">
                    <button type="submit" name="action" value="save">Save edits</button>
                    <button
                      class="danger"
                      type="submit"
                      name="action"
                      value="delete"
                      onclick="return confirm('Delete this community update from public pages?');"
                    >
                      Delete update
                    </button>
                    <span class="community-update-admin-status" aria-live="polite"></span>
                  </div>
                </form>
              </details>
            )}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="empty">No approved community updates yet.</p>
  )}

  <dialog class="community-photo-dialog" aria-label="Community update photo">
    <div class="community-photo-dialog-toolbar">
      <button type="button" data-community-photo-prev aria-label="Previous photo">Previous</button>
      <span data-community-photo-count></span>
      <button type="button" data-community-photo-next aria-label="Next photo">Next</button>
      <form method="dialog">
        <button type="submit" aria-label="Close photo preview">Close</button>
      </form>
    </div>
    <img src="" alt="" />
  </dialog>
</section>

{hasInstagramEmbeds && <script async src="https://www.instagram.com/embed.js"></script>}
{hasTikTokEmbeds && <script async src="https://www.tiktok.com/embed.js"></script>}
{hasFacebookEmbeds && (
  <div id="fb-root"></div>
)}

<script>
  document.querySelectorAll(".community-updates-panel").forEach((panel) => {
    const dialog = panel.querySelector(".community-photo-dialog");
    const preview = dialog?.querySelector("img");
    const previousButton = dialog?.querySelector("[data-community-photo-prev]");
    const nextButton = dialog?.querySelector("[data-community-photo-next]");
    const counter = dialog?.querySelector("[data-community-photo-count]");

    if (
      !(dialog instanceof HTMLDialogElement) ||
      !(preview instanceof HTMLImageElement) ||
      !(previousButton instanceof HTMLButtonElement) ||
      !(nextButton instanceof HTMLButtonElement) ||
      !(counter instanceof HTMLElement)
    ) {
      return;
    }

    let activePhotos = [];
    let activeIndex = 0;

    function renderPhoto() {
      const photoUrl = activePhotos[activeIndex];
      if (!photoUrl) return;

      preview.src = photoUrl;
      const hasMultiplePhotos = activePhotos.length > 1;
      previousButton.hidden = !hasMultiplePhotos;
      nextButton.hidden = !hasMultiplePhotos;
      counter.hidden = !hasMultiplePhotos;
      counter.textContent = hasMultiplePhotos
        ? `${activeIndex + 1} of ${activePhotos.length}`
        : "";
    }

    function movePhoto(direction) {
      if (activePhotos.length <= 1) return;
      activeIndex = (activeIndex + direction + activePhotos.length) % activePhotos.length;
      renderPhoto();
    }

    panel.querySelectorAll("[data-community-photo]").forEach((button) => {
      button.addEventListener("click", () => {
        const photoUrl = button.getAttribute("data-community-photo");
        if (!photoUrl) return;

        const updateCard = button.closest(".community-update-card");
        const photoButtons = updateCard
          ? Array.from(updateCard.querySelectorAll("[data-community-photo]"))
          : [button];
        activePhotos = photoButtons
          .map((photoButton) => photoButton.getAttribute("data-community-photo"))
          .filter(Boolean);
        activeIndex = Math.max(0, activePhotos.indexOf(photoUrl));

        renderPhoto();
        dialog.showModal();
      });
    });

    previousButton.addEventListener("click", () => movePhoto(-1));
    nextButton.addEventListener("click", () => movePhoto(1));

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        movePhoto(-1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        movePhoto(1);
      }
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    dialog.addEventListener("close", () => {
      activePhotos = [];
      activeIndex = 0;
      preview.removeAttribute("src");
      counter.textContent = "";
    });
  });

  document.querySelectorAll("[data-mention-field]").forEach((field) => {
    const textarea = field.querySelector("[data-mention-textarea]");
    const queryInput = field.querySelector(".mention-query-input");
    const suggestions = field.querySelector("[data-mention-suggestions]");

    if (!(textarea instanceof HTMLTextAreaElement) || !(queryInput instanceof HTMLInputElement)) {
      return;
    }

    function activeMention() {
      const cursor = textarea.selectionStart ?? textarea.value.length;
      const beforeCursor = textarea.value.slice(0, cursor);
      const match = beforeCursor.match(/(^|\s)@([A-Za-z][A-Za-z.' -]{0,60})$/);
      if (!match) return null;

      return {
        query: match[2].trim(),
        start: cursor - match[2].length - 1,
        end: cursor,
      };
    }

    function updateMentionQuery() {
      const mention = activeMention();

      if (!mention || mention.query.length < 2) {
        field.removeAttribute("data-mention-start");
        field.removeAttribute("data-mention-end");
        queryInput.value = "";
        if (suggestions) suggestions.innerHTML = "";
        return;
      }

      field.setAttribute("data-mention-start", String(mention.start));
      field.setAttribute("data-mention-end", String(mention.end));

      if (queryInput.value === mention.query) return;
      queryInput.value = mention.query;
      queryInput.dispatchEvent(new Event("input", { bubbles: true }));
    }

    textarea.addEventListener("input", updateMentionQuery);
    textarea.addEventListener("keyup", updateMentionQuery);
    textarea.addEventListener("click", updateMentionQuery);

    field.addEventListener("click", (event) => {
      const button = event.target?.closest?.("[data-mention]");
      if (!(button instanceof HTMLButtonElement)) return;

      const mentionText = button.getAttribute("data-mention");
      const start = Number(field.getAttribute("data-mention-start"));
      const end = Number(field.getAttribute("data-mention-end"));
      if (!mentionText || !Number.isFinite(start) || !Number.isFinite(end)) return;

      const before = textarea.value.slice(0, start);
      const after = textarea.value.slice(end);
      const insertion = `${mentionText} `;
      textarea.value = `${before}${insertion}${after}`;
      const cursor = before.length + insertion.length;
      textarea.focus();
      textarea.setSelectionRange(cursor, cursor);

      queryInput.value = "";
      if (suggestions) suggestions.innerHTML = "";
      field.removeAttribute("data-mention-start");
      field.removeAttribute("data-mention-end");
    });
  });
</script>

<style>
  .community-updates-panel {
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    border-color: #bfdbfe;
    margin-top: 0;
  }

  .community-updates-panel-narrow {
    justify-self: center;
    max-width: 760px;
    width: 100%;
  }

  .section-heading p:not(.eyebrow) {
    color: #4b5563;
    font-weight: 800;
    line-height: 1.5;
    margin: 8px 0 0;
  }

  .community-update-disclosure {
    margin-top: 16px;
  }

  .community-update-disclosure summary {
    align-items: center;
    background: #eff6ff;
    border: 1px solid #60a5fa;
    border-radius: 16px;
    box-sizing: border-box;
    color: #1e3a8a;
    cursor: pointer;
    display: flex;
    gap: 12px;
    justify-content: space-between;
    list-style: none;
    padding: 10px;
  }

  .community-update-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .thought-input-preview {
    align-items: center;
    background: #ffffff;
    border: 1px solid rgba(37, 99, 235, 0.42);
    border-radius: 999px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
    box-sizing: border-box;
    color: #64748b;
    display: flex;
    flex: 1 1 auto;
    gap: 10px;
    min-width: 0;
    padding: 11px 14px;
  }

  .thought-input-preview strong {
    background: transparent;
    border-radius: 0;
    color: #1f2933;
    display: inline;
    flex: 0 0 auto;
    font-size: 0.92rem;
    font-weight: 950;
    height: auto;
    line-height: 1.2;
    width: auto;
  }

  .thought-input-preview small {
    color: #64748b;
    font-size: 0.86rem;
    font-weight: 800;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .community-update-disclosure summary > strong {
    align-items: center;
    background: #1f2933;
    border-radius: 999px;
    color: #ffffff;
    display: inline-flex;
    flex: 0 0 auto;
    font-size: 1rem;
    height: 24px;
    justify-content: center;
    line-height: 1;
    width: 24px;
  }

  .community-update-disclosure[open] summary > strong {
    transform: rotate(45deg);
  }

  .community-update-list {
    display: grid;
    gap: 12px;
    margin-top: 18px;
  }

  .community-update-card {
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(135deg, rgba(96, 165, 250, 0.68), rgba(191, 219, 254, 0.42)) border-box;
    border: 1px solid transparent;
    border-radius: 16px;
    display: grid;
    gap: 14px;
    padding: 16px;
  }

  .community-update-card.has-media {
    align-items: stretch;
    grid-template-columns: minmax(160px, 34%) minmax(0, 1fr);
  }

  .community-update-media {
    align-content: start;
    display: grid;
    gap: 8px;
  }

  .community-update-media > span {
    align-self: start;
    background: #e0f2fe;
    border: 1px solid #7dd3fc;
    border-radius: 999px;
    color: #075985;
    display: inline-flex;
    font-size: 0.72rem;
    font-weight: 950;
    justify-self: start;
    letter-spacing: 0.04em;
    line-height: 1;
    padding: 5px 8px;
    text-transform: uppercase;
  }

  .community-photo-button {
    background: transparent;
    border: 0;
    border-radius: 8px;
    cursor: zoom-in;
    display: block;
    height: auto;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .community-photo-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(auto-fit, minmax(84px, 1fr));
  }

  .community-photo-grid .community-photo-button:first-child {
    grid-column: 1 / -1;
  }

  .community-photo-button:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 3px;
  }

  .community-photo-button img {
    aspect-ratio: 16 / 9;
    background: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    display: block;
    height: 100%;
    min-height: 92px;
    object-fit: contain;
    width: 100%;
  }

  .community-photo-grid .community-photo-button:first-child img {
    min-height: 130px;
  }

  .community-update-copy {
    align-content: start;
    display: grid;
    min-width: 0;
  }

  .community-update-admin-editor {
    border-top: 1px solid #e5e7eb;
    margin-top: 12px;
    padding-top: 12px;
  }

  .community-update-admin-editor summary {
    color: #1d4ed8;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 950;
  }

  .community-update-admin-editor form {
    background: #f8fafc;
    border: 1px solid #dbeafe;
    border-radius: 12px;
    display: grid;
    gap: 10px;
    margin-top: 10px;
    padding: 12px;
  }

  .community-update-admin-editor label {
    color: #334155;
    display: grid;
    font-size: 0.76rem;
    font-weight: 950;
    gap: 5px;
    text-transform: uppercase;
  }

  .community-update-admin-editor input,
  .community-update-admin-editor textarea {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-sizing: border-box;
    color: #1f2933;
    font: inherit;
