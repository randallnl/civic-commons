---
import TopNav from "./TopNav.astro";
import SiteFooter from "./SiteFooter.astro";
import communityPlaceholder from "../assets/community_profile_placeholder.png";
import profileIcon from "../assets/profile icon.png";
import { articlePublishDate, articleSourceName } from "../lib/articlesApi";
import { getBillSummaries } from "../lib/billsApi";
import { enrichCandidatesWithLegislators } from "../lib/candidateLegislators";
import { candidateName, candidatePath, isLegislativeCandidate } from "../lib/candidatesApi";
import { isFreeStater, isTpActionAligned } from "../lib/civicTags";
import {
  FREE_STATE_ALIGNED_TOOLTIP,
  TPACTION_ALIGNED_TOOLTIP,
  VOTE_GRADE_TOOLTIP,
} from "../lib/alignmentTags";
import { countyForCommunity, countyImageUrl } from "../lib/communityImages";
import { communityPath } from "../lib/communitiesApi";
import { getRecentApprovedCommunityUpdates, communityUpdateDate } from "../lib/communityUpdates";
import {
  getCommunityUpdateCards,
  previewDescription,
  previewTitle,
} from "../lib/communityUpdateCards";
import { profilePhotoUrl } from "../lib/photos";
import { getRepresentative, repName, repSlug } from "../lib/repsApi";
import { cleanText, joinClean } from "../lib/text";
import { enrichArticlesWithPreviews } from "../lib/articlePreviews";
import { getTrackedBills, representativeGradeFor } from "../lib/trackedBills";

const { community, meta = {}, error = "" } = Astro.props;
const PROFILE_PREVIEW_LIMIT = 6;
const DISTRICT_PREVIEW_LIMIT = 6;
const TOWN_PREVIEW_LIMIT = 12;

function townsFor(value = []) {
  const towns =
    community?.townsRepresented ||
    community?.towns ||
    community?.towns_represented ||
    value;

  if (Array.isArray(towns)) return towns.map(cleanTown).filter(Boolean);

  return String(towns)
    .split(/;|,/)
    .map(cleanTown)
    .filter(Boolean);
}

function cleanTown(value = "") {
  if (typeof value === "object" && value !== null) {
    return cleanText(value.town || value.name || value.label || "").trim();
  }

  return cleanText(value).trim();
}

function representativesFor() {
  return uniqueRepresentatives([
    ...(community?.representatives || []),
    ...(community?.reps || []),
    ...(community?.legislators || []),
  ]);
}

function articlesFor() {
  return community?.relatedArticles || community?.articles || [];
}

function communityUpdatesFor() {
  return (
    community?.communityUpdates ||
    community?.community_updates ||
    community?.relatedUpdates ||
    community?.updates ||
    []
  );
}

function districtsFor() {
  return community?.districts || community?.communities || community?.relatedDistricts || [];
}

function candidatesFor() {
  return uniqueCandidates([
    ...(community?.candidates || []),
    ...(community?.candidateSummary?.candidates || []),
    ...(community?.groups?.candidates?.senate || []),
    ...(community?.groups?.candidates?.house || []),
  ]).filter(isLegislativeCandidate);
}

function candidateTowns(candidate = {}) {
  const towns = [
    candidate.townsRepresented,
    candidate.towns_represented,
    candidate.communitiesRepresented,
    candidate.communities_represented,
    candidate.locationText,
    candidate.location_text,
    candidate.legislatorTownsRepresented,
    candidate.legislatorLocationText,
    candidate.towns,
  ].flatMap(townParts);

  const unique = uniqueLabels(towns);
  if (unique.length) return unique.join(", ");

  return townsFor().join(", ");
}

function townParts(value = "") {
  if (Array.isArray(value)) return value.flatMap(townParts);
  if (typeof value === "object" && value !== null) {
    return townParts(value.town || value.name || value.label || "");
  }

  const text = cleanText(value).trim();
  if (!text) return [];
  const delimiter = /ward/i.test(text) ? /;|\||\s+and\s+/i : /[,;|]|\s+and\s+/i;
  return text.split(delimiter).map((town) => town.trim()).filter(Boolean);
}

function uniqueLabels(values = []) {
  const seen = new Set();
  const labels = [];

  for (const value of values) {
    const label = cleanText(value).trim();
    const key = label.toLowerCase();
    if (!label || seen.has(key)) continue;
    seen.add(key);
    labels.push(label);
  }

  return labels;
}

function bodyLabel() {
  const body = String(community?.chamber || community?.body || "").toLowerCase();
  if (body === "senate" || body === "s") return "Senate";
  return "House";
}

function profileLabel() {
  return community?.profileLabel || `${bodyLabel()} District`;
}

function townProfilePath(town = "") {
  return `/communities/towns/${encodeURIComponent(town)}`;
}

function repLocation(rep = {}) {
  return (
    rep.location_text ||
    rep.townsRepresented ||
    rep.towns_represented ||
    rep.towns ||
    community?.townsRepresented ||
    community?.towns ||
    community?.towns_represented ||
    ""
  );
}

function repMeta(rep = {}) {
  return joinClean([
    rep.party,
    rep.chamber,
    rep.district,
    repLocation(rep),
  ]);
}

function articleTitle(article = {}) {
  return cleanText(article.preview?.title || article.title);
}

function articlePublisher(article = {}) {
  return articleSourceName(article);
}

function communityContextTokens() {
  return uniqueLabels([
    community?.name,
    community?.label,
    community?.slug,
    community?.county,
    community?.countyName,
    community?.county_name,
    communityDistrict() && `District ${communityDistrict()}`,
    communityDistrict() && `${bodyLabel()} District ${communityDistrict()}`,
    ...townsFor(),
    ...districtsFor().flatMap((district) => [
      district.name,
      district.label,
      district.districtLabel,
      district.district_label,
      district.county,
      district.countyName,
    ]),
  ]);
}

function updateMatchesCommunity(update = {}, tokens = []) {
  if (!tokens.length) return false;
  const haystack = [
    update.entityName,
    update.entityKey,
    update.pageUrl,
    update.comment,
    update.linkUrl,
    ...(update.mentions || []).flatMap((mention) => [
      mention.name,
      mention.county,
      mention.district,
      mention.profileDistrict,
      mention.roleLabel,
      mention.path,
    ]),
  ]
    .map((value) => cleanText(value).toLowerCase())
    .join(" ");

  return tokens.some((token) => {
    const normalized = cleanText(token).toLowerCase();
    return normalized && haystack.includes(normalized);
  });
}

async function communityUpdatesForProfile({ limit = 8 } = {}) {
  const explicitUpdates = communityUpdatesFor();
  if (explicitUpdates.length) {
    return getCommunityUpdateCards(explicitUpdates.slice(0, limit));
  }

  try {
    const tokens = communityContextTokens();
    const updates = await getRecentApprovedCommunityUpdates({ limit: 120 });
    return getCommunityUpdateCards(
      updates.filter((update) => updateMatchesCommunity(update, tokens)).slice(0, limit),
    );
  } catch (error) {
    console.error(error?.message || "Unable to load community updates for profile.");
    return [];
  }
}

function updateTitle(update = {}) {
  return previewTitle(update.linkPreview) || cleanText(update.entityName) || "Community update";
}

function updateSummary(update = {}) {
  return cleanText(
    update.comment ||
      previewDescription(update.linkPreview, update.linkUrl) ||
      "Community-submitted context.",
  );
}

function updateImage(update = {}) {
  return update.linkPreview?.imageUrl || update.photoUrl || update.photoUrls?.[0] || "";
}

function coverageDateValue(item = {}) {
  const value = item.dateValue || item.createdAt || item.article?.created_at || item.article?.createdAt || "";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? 0 : date.getTime();
}

function combinedCoverageItems(articleItems = [], updateItems = []) {
  return [
    ...articleItems.map((article) => ({
      type: "article",
      title: articleTitle(article),
      href: article.url,
      imageUrl: article.preview?.imageUrl || "",
      source: articlePublisher(article),
      dateText: articlePublishDate(article),
      dateValue: article.publishedAt || article.published_at || article.createdAt || article.created_at || "",
      description: cleanText(article.preview?.description || article.summary || ""),
    })),
    ...updateItems.map((update) => ({
      type: "update",
      title: updateTitle(update),
      href: update.linkUrl || update.pageUrl || "/updates",
      imageUrl: updateImage(update),
      source: cleanText(update.displayName || "Community member"),
      dateText: communityUpdateDate(update.createdAt),
      dateValue: update.createdAt,
      description: updateSummary(update),
    })),
  ].sort((a, b) => coverageDateValue(b) - coverageDateValue(a));
}

async function hydrateRepresentativePreview(reps = []) {
  return Promise.all(
    reps.map(async (rep) => {
      const slugOrId = rep.personid || rep.id || rep.slug || repName(rep);
      if (!slugOrId) return rep;

      try {
        const data = await getRepresentative(slugOrId);
        return {
          ...rep,
          ...(data.representative || data.rep || data.person || data),
          voteHistory: data.voteHistory || data.votes || data.representative?.voteHistory || rep.voteHistory || [],
        };
      } catch (error) {
        console.error(error?.message || "Unable to hydrate community representative preview.");
        return rep;
      }
    }),
  );
}

function uniqueRepresentatives(items = []) {
  const seen = new Set();

  return items.filter((rep) => {
    if (!rep || typeof rep !== "object") return false;
    const key = rep.personid || rep.id || rep.employeeno || repName(rep);
    if (!key || seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

function uniqueCandidates(items = []) {
  const seen = new Set();

  return items.filter((candidate) => {
    if (!candidate || typeof candidate !== "object") return false;
    const key = [
      candidate.slug,
      candidate.filerEntityNumber,
      candidate.name,
      candidate.candidateFirstName,
      candidate.candidateLastName,
      candidate.office,
      candidate.county,
      candidate.district,
    ]
      .filter(Boolean)
      .join("|");

    if (!key || seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

function communityKind() {
  const label = String(community?.profileLabel || "").toLowerCase();
  const body = String(community?.body || community?.chamber || "").toLowerCase();
  if (label.includes("county")) return "county";
  if (label.includes("town")) return "town";
  if (body === "s" || body === "senate") return "senate";
  return "house";
}

function primaryTown() {
  return towns[0] || "";
}

function communityDistrict() {
  return community?.raw_district || community?.district || "";
}

function peopleDirectoryHref() {
  const params = new URLSearchParams();
  const kind = communityKind();

  if (kind === "town") {
    if (primaryTown()) params.set("town", primaryTown());
  } else if (kind === "county") {
    if (community?.county || community?.name) params.set("county", community.county || community.name);
  } else if (kind === "senate") {
    params.set("body", "senate");
    if (communityDistrict()) params.set("district", communityDistrict());
  } else {
    params.set("body", "house");
    if (community?.county) params.set("county", community.county);
    if (communityDistrict()) params.set("district", communityDistrict());
  }

  const query = params.toString();
  return `/people${query ? `?${query}` : ""}`;
}

function candidateDirectoryHref() {
  const params = new URLSearchParams();
  const kind = communityKind();

  if (kind === "town") {
    if (primaryTown()) params.set("town", primaryTown());
  } else if (kind === "county") {
    if (community?.county || community?.name) params.set("county", community.county || community.name);
  } else if (kind === "senate") {
    params.set("office", "State Senate");
    if (communityDistrict()) params.set("district", communityDistrict());
  } else {
    params.set("office", "State Representative");
    if (community?.county) params.set("county", community.county);
    if (communityDistrict()) params.set("district", communityDistrict());
  }

  const query = params.toString();
  return `/candidates${query ? `?${query}` : ""}`;
}

const towns = townsFor();
const representatives = representativesFor();
const articles = await enrichArticlesWithPreviews(articlesFor(), { limit: 10 });
const communityUpdates = await communityUpdatesForProfile({ limit: 8 });
const coverageItems = combinedCoverageItems(articles, communityUpdates);
const districts = districtsFor();
const visibleDistricts = districts.slice(0, DISTRICT_PREVIEW_LIMIT);
const hiddenDistricts = districts.slice(DISTRICT_PREVIEW_LIMIT);
const visibleTowns = towns.slice(0, TOWN_PREVIEW_LIMIT);
const hiddenTowns = towns.slice(TOWN_PREVIEW_LIMIT);
const candidates = candidatesFor();
const representativePreview = await hydrateRepresentativePreview(
  representatives.slice(0, PROFILE_PREVIEW_LIMIT),
);
const candidatePreview = await enrichCandidatesWithLegislators(
  candidates.slice(0, PROFILE_PREVIEW_LIMIT),
);
const allRepresentativesHref = peopleDirectoryHref();
const allCandidatesHref = candidateDirectoryHref();
const heroCounty = countyForCommunity(community || {});
const heroImage = countyImageUrl(heroCounty) || communityPlaceholder.src;
let trackedBills = new Map();
let billSummaries = new Map();

try {
  [trackedBills, billSummaries] = await Promise.all([
    getTrackedBills(),
    getBillSummaries(),
  ]);
} catch (error) {
  console.error(error?.message || "Unable to load tracked bills.");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>{cleanText(community?.name || "Community")} | NH Deserves Better</title>
    <meta
      name="description"
      content={`Community profile for ${community?.name || "a New Hampshire district"}.`}
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <a class="back" href="/communities">Back to communities</a>

      {error ? (
        <p class="status-message">{error}</p>
      ) : community ? (
        <>
          <section class="hero">
            <img
              class="hero-image"
              src={heroImage}
              alt=""
              width="2000"
              height="500"
            />

            <div class="hero-copy">
              <p class="eyebrow">{profileLabel()}</p>
              <h1>{cleanText(community.name)}</h1>

              <div class="hero-meta">
                {community.label && <span>{cleanText(community.label)}</span>}
                {community.county && <span>{cleanText(community.county)}</span>}
                {community.seats && <span>{community.seats} seats</span>}
                {community.floterial && <span>Floterial</span>}
                {community.districtCount && <span>{community.districtCount} districts</span>}
                {community.representativeCount && <span>{community.representativeCount} reps</span>}
              </div>
            </div>
          </section>

          <section class="content-grid">
            <div class="stack">
              <section class="panel">
                <div class="section-heading split-heading">
                  <div>
                    <p class="eyebrow">Representation</p>
                    <h2>Legislators</h2>
                  </div>
                  <a class="section-action" href={allRepresentativesHref}>
                    See all legislators
                  </a>
                </div>

                {representatives.length ? (
                  <div class="rep-list profile-preview-list">
                    {representativePreview.map((rep) => {
                      const photoUrl = profilePhotoUrl(rep.photo || rep.photo_url);
                      const grade = representativeGradeFor(rep, trackedBills, billSummaries);

                      return (
                      <article>
                        <a class="profile-photo-link" href={`/people/${repSlug(rep)}`}>
                          <img
                            class:list={[!photoUrl && "profile-icon"]}
                            src={photoUrl || profileIcon.src}
                            alt={photoUrl ? `Photo of ${repName(rep)}` : ""}
                            loading="lazy"
                          />
                        </a>
                        <div>
                          <div class="profile-preview-heading">
                            <h3>
                              <a href={`/people/${repSlug(rep)}`}>{cleanText(repName(rep))}</a>
                            </h3>
                            <a
                              class:list={["mini-grade", grade.className]}
                              href="/vote-grades"
                              title={VOTE_GRADE_TOOLTIP}
                              aria-label={`${VOTE_GRADE_TOOLTIP} ${grade.label}`}
                            >
                              <strong>{grade.letter}</strong>
                              <small>Grade</small>
                            </a>
                          </div>
                          <p>{repMeta(rep)}</p>
                          {isFreeStater(rep) && (
                            <div class="mini-tags">
                              <a
                                href="/free-staters"
                                title={FREE_STATE_ALIGNED_TOOLTIP}
                                aria-label={FREE_STATE_ALIGNED_TOOLTIP}
                              >
                                Free State Aligned
                              </a>
                              {isTpActionAligned(rep) && (
                                <a
                                  class="tpaction-mini-tag"
                                  href="/tpaction-aligned"
                                  title={TPACTION_ALIGNED_TOOLTIP}
                                  aria-label={TPACTION_ALIGNED_TOOLTIP}
                                >
                                  TPAction Aligned
                                </a>
                              )}
                            </div>
                          )}
                          {!isFreeStater(rep) && isTpActionAligned(rep) && (
                            <div class="mini-tags">
                              <a
                                class="tpaction-mini-tag"
                                href="/tpaction-aligned"
                                title={TPACTION_ALIGNED_TOOLTIP}
                                aria-label={TPACTION_ALIGNED_TOOLTIP}
                              >
                                TPAction Aligned
                              </a>
                            </div>
                          )}
                        </div>
                      </article>
                      );
                    })}
                  </div>
                ) : (
                  <p class="empty">No representatives returned.</p>
                )}

                <a class="section-footer-action" href={allRepresentativesHref}>
                  See all legislators
                </a>
              </section>

              <section class="panel">
                <div class="section-heading split-heading">
                  <div>
                    <p class="eyebrow">House and Senate Candidates</p>
                    <h2>Current Legislative Candidates</h2>
                  </div>
                  <a class="section-action" href={allCandidatesHref}>
                    See all legislative candidates
                  </a>
                </div>

                {candidates.length ? (
                  <div class="rep-list profile-preview-list">
                    {candidatePreview.map((candidate) => {
                      const photoUrl =
                        profilePhotoUrl(candidate.photoUrl || candidate.photo || candidate.photo_url) ||
                        profilePhotoUrl(candidate.legislatorPhotoUrl);
                      const towns = candidateTowns(candidate);

                      return (
                      <article>
                        <a class="profile-photo-link" href={candidatePath(candidate)}>
                          <img
                            class:list={[!photoUrl && "profile-icon"]}
                            src={photoUrl || profileIcon.src}
                            alt={photoUrl ? `Photo of ${candidateName(candidate)}` : ""}
                            loading="lazy"
                          />
                        </a>
                        <div>
                          <h3>
                            <a href={candidatePath(candidate)}>{cleanText(candidateName(candidate))}</a>
                          </h3>
                          <p>
                            {joinClean([
                              candidate.politicalParty,
                              candidate.office,
                              candidate.district && `District ${candidate.district}`,
                            ])}
                          </p>
                          {towns && (
                            <p class="preview-towns">{towns}</p>
                          )}
                          {candidate.legislatorProfileUrl && (
                            <div class="profile-preview-actions">
                              <a href={candidate.legislatorProfileUrl}>Legislator Profile</a>
                            </div>
                          )}
                          {isFreeStater(candidate) && (
                            <div class="mini-tags">
                              <a
                                href="/free-staters"
                                title={FREE_STATE_ALIGNED_TOOLTIP}
                                aria-label={FREE_STATE_ALIGNED_TOOLTIP}
                              >
                                Free State Aligned
                              </a>
                              {isTpActionAligned(candidate) && (
                                <a
                                  class="tpaction-mini-tag"
                                  href="/tpaction-aligned"
                                  title={TPACTION_ALIGNED_TOOLTIP}
                                  aria-label={TPACTION_ALIGNED_TOOLTIP}
                                >
                                  TPAction Aligned
                                </a>
                              )}
                            </div>
                          )}
                          {!isFreeStater(candidate) && isTpActionAligned(candidate) && (
                            <div class="mini-tags">
                              <a
                                class="tpaction-mini-tag"
                                href="/tpaction-aligned"
                                title={TPACTION_ALIGNED_TOOLTIP}
                                aria-label={TPACTION_ALIGNED_TOOLTIP}
                              >
                                TPAction Aligned
                              </a>
                            </div>
                          )}
                        </div>
                      </article>
                      );
                    })}
                  </div>
                ) : (
                  <p class="empty">No State House or State Senate candidates returned.</p>
                )}

                <a class="section-footer-action" href={allCandidatesHref}>
                  See all legislative candidates
                </a>
              </section>
            </div>

            <aside class="side-stack">
              {districts.length > 0 && (
                <section class="panel side-panel">
                  <div class="section-heading">
                    <p class="eyebrow">Districts</p>
                    <h2>District Profiles</h2>
                  </div>

                  <div class="chips compact-chips">
                    {visibleDistricts.map((district) => (
                      <a href={communityPath(district)}>{cleanText(district.name || district.label)}</a>
                    ))}
                  </div>

                  {hiddenDistricts.length > 0 && (
                    <details class="show-more-details">
                      <summary>Show {hiddenDistricts.length} more</summary>
                      <div class="chips compact-chips">
                        {hiddenDistricts.map((district) => (
                          <a href={communityPath(district)}>{cleanText(district.name || district.label)}</a>
                        ))}
                      </div>
                    </details>
                  )}
                </section>
              )}

              <section class="panel side-panel">
                <div class="section-heading">
                  <p class="eyebrow">Towns</p>
                  <h2>Towns Represented</h2>
                </div>

                {towns.length ? (
                  <>
                    <div class="chips compact-chips">
                      {visibleTowns.map((town) => (
                        <a href={townProfilePath(town)}>{cleanText(town)}</a>
                      ))}
                    </div>

                    {hiddenTowns.length > 0 && (
                      <details class="show-more-details">
                        <summary>Show {hiddenTowns.length} more</summary>
                        <div class="chips compact-chips">
                          {hiddenTowns.map((town) => (
                            <a href={townProfilePath(town)}>{cleanText(town)}</a>
                          ))}
                        </div>
                      </details>
                    )}
                  </>
                ) : (
                  <p class="empty">No towns returned.</p>
                )}
              </section>

              <section class="panel side-panel">
                <div class="section-heading">
                  <p class="eyebrow">Community context</p>
                  <h2>Related Coverage and Updates</h2>
                </div>

                {coverageItems.length ? (
                  <div class="article-list">
                    {coverageItems.map((item) => (
                      <article>
                        {item.imageUrl && <img src={item.imageUrl} alt="" loading="lazy" />}
                        <div class="coverage-type-row">
                          <span class:list={["coverage-type", item.type === "update" && "coverage-update"]}>
                            {item.type === "update" ? "Community update" : "Article"}
                          </span>
                        </div>
                        <h3>
                          <a
                            href={item.href}
                            target={item.type === "article" || item.href?.startsWith("http") ? "_blank" : undefined}
                            rel={item.type === "article" || item.href?.startsWith("http") ? "noopener noreferrer" : undefined}
                          >
                            {item.title}
                          </a>
                        </h3>
                        <div class="article-meta-inline">
                          {item.source && <span>{item.type === "update" ? "By" : "Source"}: {item.source}</span>}
                          {item.dateText && <span>{item.type === "update" ? "Updated" : "Published"}: {item.dateText}</span>}
                        </div>
                        {item.description && <p>{item.description}</p>}
                      </article>
                    ))}
                  </div>
                ) : (
                  <p class="empty">No related coverage or community updates returned.</p>
                )}

                {(meta.articleLimit || communityUpdates.length) && (
                  <small>
                    Showing related articles
                    {communityUpdates.length ? " and approved community updates" : ""}.
                  </small>
                )}
              </section>
            </aside>
          </section>
        </>
      ) : (
        <p class="status-message">Community not found.</p>
      )}
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .back,
