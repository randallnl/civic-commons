---
import profileIcon from "../assets/profile icon.png";
import { formatCandidateParty, partyClassName } from "../lib/candidatesApi";
import { hasValidAlignmentPercent, personRoleFilterValue } from "../lib/freeStaterDirectory";
import { profilePhotoUrl } from "../lib/photos";
import { FREE_STATE_ALIGNED_TOOLTIP } from "../lib/alignmentTags";

const { person } = Astro.props;
const name = String(person.display_name || "").trim();
const href = `/people/${encodeURIComponent(person.slug)}`;
const photoUrl = profilePhotoUrl(person.photo_url);
const roles = personRoleFilterValue(person);
const party = formatCandidateParty(person.party);
const grade = Number(person.online_testimony_alignment_pct);
const hasGrade = hasValidAlignmentPercent(person.online_testimony_alignment_pct);
const currentOffice = person.legislativebody === "S" ? "State Senator" : "State Representative";
const primaryOffice = person.isCurrentLegislator
  ? currentOffice
  : person.isCurrentCandidate
    ? person.candidate_office || "2026 candidate"
    : "Profile";
const primaryDistrict = person.isCurrentLegislator ? person.districtLabel : person.candidateDistrictLabel;
const officeLine = [primaryOffice, primaryDistrict].filter(Boolean).join(" · ");
const showSeparateCandidacy = person.isCurrentLegislator && person.isCurrentCandidate &&
  person.candidateDistrictLabel && person.candidateDistrictLabel !== person.districtLabel;
const searchableText = [
  name,
  person.name_aliases,
  person.body,
  party,
  person.towns,
  person.counties,
  person.districtLabel,
  person.candidateDistrictLabel,
  "Free State Aligned",
].flat().filter(Boolean).join(" ");

---

<article
  class="candidate-card"
  data-fuzzy-item
  data-fuzzy-name={name}
  data-fuzzy-aliases={person.name_aliases || ""}
  data-fuzzy-town={person.towns.join(" ")}
  data-fuzzy-county={person.counties.join(" ")}
  data-fuzzy-district={[person.districtLabel, person.candidateDistrictLabel].filter(Boolean).join(" ")}
  data-fuzzy-body={person.body}
  data-fuzzy-kind={roles}
  data-fuzzy-party={party}
  data-fuzzy-sort-name={name}
  data-fuzzy-sort-district={person.districtLabel || person.candidateDistrictLabel}
  data-fuzzy-sort-grade={hasGrade ? grade : ""}
  data-fuzzy-sort-updated={Date.parse(person.updated_at || "") || 0}
  data-fuzzy-text={searchableText}
>
  <a class="photo-wrap" href={href} aria-label={`View ${name}'s profile`}>
    <img class:list={[!photoUrl && "photo-fallback"]} src={photoUrl || profileIcon.src} alt={photoUrl ? `Photo of ${name}` : ""} loading="lazy" />
  </a>
  <div class="candidate-copy">
    <h3><a href={href}>{name}</a></h3>
    <div class="pill-row">
      <span class:list={["party-pill", partyClassName(person.party)]} data-party-affiliation>{party}</span>
      <a class="free-stater-pill" href="/free-staters" title={FREE_STATE_ALIGNED_TOOLTIP} aria-label={FREE_STATE_ALIGNED_TOOLTIP}>Free State Aligned</a>
      {person.isCurrentLegislator && <span>Current Legislator</span>}
      {person.isCurrentCandidate && <span>2026 Candidate</span>}
    </div>
    <p class="office-line">{officeLine}</p>
    {showSeparateCandidacy && <p class="towns-line"><span>2026 candidacy</span>{person.candidateDistrictLabel}</p>}
    {person.towns.length > 0 && <p class="towns-line"><span>Towns represented</span>{person.towns.join(", ")}</p>}
    {person.counties.length > 0 && <p class="towns-line"><span>Counties represented</span>{person.counties.join(", ")}</p>}
    {person.isCurrentLegislator && hasGrade && <p class="towns-line"><span>Testimony aligned</span>{Math.round(grade)}%</p>}
    <div class="actions"><a href={href}>View profile</a></div>
  </div>
</article>

<style>
  .candidate-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: none;
    color: inherit;
    display: grid;
    gap: 16px;
    grid-template-columns: 92px 1fr;
    padding: 16px;
  }

  .candidate-card[hidden] { display: none; }
  a { color: inherit; }

  .photo-wrap, .photo-wrap img, .photo-fallback { width: 92px; }
  .photo-wrap img, .photo-fallback {
    aspect-ratio: 4 / 5;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-sizing: border-box;
    height: 115px;
    object-fit: cover;
    object-position: center top;
  }
  .photo-wrap img.photo-fallback { background: transparent; object-fit: cover; padding: 0; }

  h3 { font-size: 1.25rem; line-height: 1.1; margin: 0; }
  .candidate-card:hover h3 a { text-decoration: underline; }

  .pill-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .pill-row span, .pill-row a {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    color: #1f2933;
    font-size: 0.78rem;
    font-weight: 900;
    padding: 5px 9px;
    text-decoration: none;
  }
  .pill-row .party-democrat { background: #dbeafe; border-color: #2563eb; }
  .pill-row .party-republican { background: #fee2e2; border-color: #dc2626; }
  .pill-row .party-libertarian { background: #fef3c7; border-color: #d97706; }
  .pill-row .free-stater-pill {
    background: #4a2414;
    border-color: #f97316;
    border-radius: 6px;
    box-shadow: 0 0 0 1px rgba(255, 180, 60, 0.25), 0 0 12px rgba(255, 107, 26, 0.18);
    color: #fffdf7 !important;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .pill-row .free-stater-pill:hover { background: #35180d; color: #fffdf7; }

  .office-line {
    color: #4b5563;
    font-weight: 800;
    line-height: 1.4;
    margin: 12px 0 0;
  }

  .towns-line {
    color: #4b5563;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.4;
    margin: 8px 0 0;
  }
  .towns-line span {
    color: #6b4f2a;
    display: block;
    font-size: 0.68rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
    text-transform: uppercase;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .actions a {
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 900;
    padding: 7px 10px;
    text-decoration: none;
  }

  @media (max-width: 520px) {
    .candidate-card { grid-template-columns: 1fr; }
  }
</style>
