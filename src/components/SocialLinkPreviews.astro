---
import { getArticlePreview } from "../lib/articlePreviews";
import {
  previewDescription,
  previewTitle,
  socialPreview,
} from "../lib/communityUpdateCards";
import { cleanText } from "../lib/text";

const {
  links = [],
  title = "Social links",
  eyebrow = "Social Context",
} = Astro.props;

const socialLinks = links
  .map((link) => ({
    ...link,
    href: String(link.href || "").trim(),
    label: cleanText(link.label || ""),
  }))
  .filter((link) => link.href);

const items = await Promise.all(
  socialLinks.map(async (link) => {
    const social = socialPreview(link.href) || { type: "link", label: link.label || "Social link" };
    const preview = await getArticlePreview(link.href);
    const itemTitle = previewTitle(preview, link.href);
    const description = mediaDescription(preview, link.href, social);
    const isPortrait = social.type === "tiktok" || isInstagramVideo(social) || isFacebookVideo(social);

    return {
      ...link,
      social,
      platform: social.type || "link",
      platformLabel: platformLabel(social, link.label),
      handle: handleText(social),
      title: itemTitle,
      description,
      imageUrl: preview?.imageUrl || "",
      embedUrl: social.type === "facebook" ? social.embedUrl || "" : "",
      fallbackLabel: fallbackLabel(social, itemTitle),
      isPortrait,
    };
  }),
);

function isInstagramVideo(social = {}) {
  const label = String(social.label || "").toLowerCase();
  return label.includes("reel") || label.includes("video");
}

function isFacebookVideo(social = {}) {
  const label = String(social.label || "").toLowerCase();
  const permalink = String(social.permalink || "").toLowerCase();
  return social.type === "facebook" && (
    label.includes("reel") ||
    label.includes("video") ||
    permalink.includes("/reel/") ||
    permalink.includes("/videos/") ||
    permalink.includes("/watch/")
  );
}

function platformLabel(social = {}, fallback = "") {
  if (social.type === "tiktok") return social.isProfile ? "TikTok profile" : "TikTok video";
  if (social.type === "instagram") return social.isProfile ? "Instagram profile" : social.label || "Instagram post";
  if (social.type === "facebook") return social.label || "Facebook post";
  if (social.type === "substack") return social.label || "Substack";
  return fallback || "Social link";
}

function handleText(social = {}) {
  if (social.handle) {
    return social.type === "substack"
      ? `@${social.handle} on Substack`
      : `${social.isProfile ? "Profile: " : ""}@${social.handle}`;
  }
  if (social.publication) return social.publication;
  if (social.type === "facebook" || social.type === "substack") return "";
  return social.host || "";
}

function mediaDescription(preview = null, linkUrl = "", social = {}) {
  const description = previewDescription(preview, linkUrl);
  if (!description) return "";

  const normalized = description.toLowerCase().trim();
  const host = String(social.host || "").toLowerCase().trim();

  if (host && normalized === host) return "";
  if (social.type === "facebook" && normalized.includes("facebook.com")) return "";
  if (social.type === "substack") {
    const publication = String(social.publication || "").toLowerCase().trim();
    const handle = String(social.handle || "").toLowerCase().trim();
    if (normalized === "substack") return "";
    if (publication && normalized === `${publication} on substack`) return "";
    if (handle && normalized === `@${handle} on substack`) return "";
  }

  return description;
}

function fallbackLabel(social = {}, itemTitle = "") {
  if (social.type === "substack") {
    const isHomePost = String(social.permalink || "").includes("substack.com/home/post/");
    return {
      mark: "S",
      kicker: isHomePost ? "Substack share link" : "Substack",
      title: social.publication
        ? `${social.publication}.substack.com`
        : social.handle
          ? `@${social.handle}`
          : cleanText(itemTitle || "Substack link"),
    };
  }

  return {
    mark: "",
    kicker: social.label || "Social media",
    title: social.host || social.handle || cleanText(itemTitle),
  };
}
---

{items.length > 0 && (
  <section class="panel social-preview-panel">
    <div class="section-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>

    <div class="social-preview-grid">
      {items.map((item) => (
        <article class:list={["social-preview-card", item.isPortrait ? "portrait-social" : "landscape-social", `platform-${item.platform}`]}>
          <a
            class="social-preview-frame"
            href={item.social.permalink || item.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="platform-badge">{item.platformLabel}</span>
            {item.imageUrl ? (
              <img src={item.imageUrl} alt="" loading="lazy" />
            ) : item.platform === "facebook" && item.embedUrl ? (
              <iframe
                class="social-preview-embed facebook-social-embed"
                src={item.embedUrl}
                width="500"
                height="520"
                style="border:none;overflow:hidden"
                scrolling="no"
                frameborder="0"
                allowfullscreen="true"
                allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                loading="lazy"
                title="Facebook preview"
              ></iframe>
            ) : item.platform === "substack" ? (
              <span class="social-preview-fallback substack-social-fallback">
                <span>{item.fallbackLabel.mark}</span>
                <small>{item.fallbackLabel.kicker}</small>
                <strong>{item.fallbackLabel.title}</strong>
              </span>
            ) : (
              <span class="social-preview-fallback">{item.platformLabel}</span>
            )}
          </a>
          <div class="social-preview-copy">
            <div class="social-preview-meta">
              <span>{item.handle || item.platformLabel}</span>
            </div>
            <h3>
              <a
                href={item.social.permalink || item.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.title}
              </a>
            </h3>
            {item.description && <p>{item.description}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .social-preview-panel {
    margin-top: 18px;
  }

  .social-preview-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
  }

  .social-preview-card {
    background: #ffffff;
    border: 1px solid #dbe4ef;
    border-radius: 14px;
    display: grid;
    overflow: hidden;
  }

  .social-preview-frame {
    align-items: center;
    aspect-ratio: 16 / 10;
    background: #f8fafc;
    color: #1f2933;
    display: flex;
    justify-content: center;
    overflow: hidden;
    position: relative;
    text-decoration: none;
  }

  .portrait-social .social-preview-frame {
    aspect-ratio: 4 / 5;
    max-height: 360px;
  }

  .social-preview-frame img,
  .social-preview-embed {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .platform-substack .social-preview-frame img,
  .platform-facebook .social-preview-frame img {
    object-fit: contain;
  }

  .platform-badge {
    background: rgba(17, 24, 39, 0.9);
    border-radius: 999px;
    color: #fffaf0;
    font-size: 0.72rem;
    font-weight: 950;
    left: 10px;
    padding: 6px 9px;
    position: absolute;
    top: 10px;
    z-index: 2;
  }

  .social-preview-fallback {
    align-items: center;
    color: #64748b;
    display: grid;
    font-weight: 950;
    gap: 8px;
    justify-items: center;
    padding: 24px;
    text-align: center;
  }

  .substack-social-fallback > span {
    align-items: center;
    background: #ff6719;
    border-radius: 14px;
    color: #ffffff;
    display: inline-flex;
    font-size: 1.4rem;
    font-weight: 950;
    height: 48px;
    justify-content: center;
    width: 48px;
  }

  .substack-social-fallback small {
    color: #9a3412;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .substack-social-fallback strong {
    color: #1f2933;
    line-height: 1.15;
  }

  .social-preview-copy {
    display: grid;
    gap: 7px;
    padding: 14px;
  }

  .social-preview-meta span {
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .social-preview-copy h3 {
    font-size: 1.08rem;
    line-height: 1.15;
    margin: 0;
  }

  .social-preview-copy a {
    color: #1f2933;
    text-decoration: none;
  }

  .social-preview-copy a:hover {
    color: #b6390a;
  }

  .social-preview-copy p {
    color: #4b5563;
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.45;
    margin: 0;
  }
</style>
