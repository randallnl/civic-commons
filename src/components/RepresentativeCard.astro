---
import BillPositionSummary from "./BillPositionSummary.astro";
import profileIcon from "../assets/profile icon.png";
import { billDetailPath } from "../lib/billsApi";
import { isFreeStater, isTpActionAligned } from "../lib/civicTags";
import {
  FREE_STATE_ALIGNED_TOOLTIP,
  TPACTION_ALIGNED_TOOLTIP,
} from "../lib/alignmentTags";
import { profilePhotoUrl } from "../lib/photos";
import { cleanText } from "../lib/text";
import {
  normalizeBillCode,
  representativeGradeFor,
  representativeOnlineTestimonyVotePreviews,
  representativeOnlineTestimonyVoteStance,
  representativeVoteStance,
  testimonyAlignmentPercentForGrade,
  trackedBillForVote,
} from "../lib/trackedBills";

const {
  rep,
  trackedBills = new Map(),
  billSummaries = new Map(),
  embed = false,
  showPublicTestimony = true,
  showTestimonyAlignment = true,
  showFreeStateAligned = true,
  showTpactionAligned = true,
  openRep = "",
  trackerAlignmentLabel = "Tracker aligned",
  voteExplanationLabel = "What this vote means",
} = Astro.props;

function formatParty(party) {
  if (!party) return "Party not listed";
  if (party === "R") return "Republican";
  if (party === "D") return "Democratic";
  if (party === "I") return "Independent";
  return cleanText(party);
}

function slugify(value = "") {
  return String(value)
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim()
    .replace(/[''`’‘]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function countyNameFor(rep = {}) {
  const codeMap = {
    "01": "Belknap",
    "02": "Carroll",
    "03": "Cheshire",
    "04": "Coos",
    "05": "Grafton",
    "06": "Hillsborough",
    "07": "Merrimack",
    "08": "Rockingham",
    "09": "Strafford",
    "10": "Sullivan",
  };
  const prefixMap = {
    BEL: "Belknap",
    CAR: "Carroll",
    CHE: "Cheshire",
    COO: "Coos",
    GRA: "Grafton",
    HIL: "Hillsborough",
    MER: "Merrimack",
    ROC: "Rockingham",
    STR: "Strafford",
    SUL: "Sullivan",
  };
  const county = cleanText(rep.county || "");
  if (county) return county;
  const code = String(rep.countycode || "").padStart(2, "0");
  if (codeMap[code]) return codeMap[code];
  const district = cleanText(rep.raw_district || rep.district || "");
  const prefix = district.match(/\b([A-Z]{3})\b/)?.[1];
  return prefixMap[prefix] || "";
}

function listText(value = "") {
  if (Array.isArray(value)) return value.map(listText).filter(Boolean).join(", ");
  if (typeof value === "object" && value !== null) {
    return listText(value.name || value.label || value.county || "");
  }
  return cleanText(value);
}

function countiesRepresentedFor(rep = {}) {
  return listText(rep.countiesRepresented || rep.counties_represented);
}

const name = cleanText(
  rep.name || `${rep.firstname || ""} ${rep.lastname || ""}`.trim(),
);
const profileHref = `/people/${rep.slug || rep.personid || rep.id || slugify(name)}`;
const photoUrl = profilePhotoUrl(rep.photo);
const embedRepKey = String(rep.slug || rep.personid || rep.id || slugify(name));
const isEmbedOpen = embed && openRep === embedRepKey;
const voteHistory = embed
  ? (rep.voteHistory || [])
      .map((vote) => ({ vote, trackedBill: trackedBillForVote(trackedBills, vote) }))
      .filter(({ trackedBill }) => Boolean(trackedBill?.preferredStance))
      .map(({ vote, trackedBill }) => ({ vote, trackedBill, billSummary: billSummaryFor(vote) }))
  : representativeOnlineTestimonyVotePreviews(rep, billSummaries, { limit: 3 });
const grade = representativeGradeFor(rep, trackedBills, billSummaries);
const testimonyAlignmentPercent = testimonyAlignmentPercentForGrade(grade);
const trackerVoteStats = voteHistory.reduce(
  (stats, preview) => {
    const stance = representativeVoteStance(preview.vote, preview.trackedBill || trackedBillFor(preview.vote));
    if (stance.className === "legislator-support") stats.aligned += 1;
    if (["legislator-support", "legislator-oppose"].includes(stance.className)) stats.total += 1;
    return stats;
  },
  { aligned: 0, total: 0 },
);
const trackerAlignmentPercent = trackerVoteStats.total
  ? Math.round((trackerVoteStats.aligned / trackerVoteStats.total) * 100)
  : null;
const aliases = cleanText([rep.nameAliases, rep.name_aliases].filter(Boolean).join(" "));
const districtLabel = cleanText(
  rep.district
    ? String(rep.district).match(/^(NH\s+)?(House|Senate)/i)
      ? rep.district
      : `${rep.chamber || "District"} ${rep.district}`
    : rep.raw_district || "",
);
const searchableText = cleanText([
  name,
  rep.firstname,
  rep.lastname,
  aliases,
  rep.chamber,
  rep.party,
  rep.district,
  rep.raw_district,
  districtLabel,
  rep.county,
  rep.countiesRepresented,
  rep.counties_represented,
  rep.countycode,
  rep.location_text,
  rep.towns_represented,
  rep.townsRepresented,
  rep.email,
  isFreeStater(rep) ? "Free State Aligned" : "",
  isTpActionAligned(rep) ? "TPAction Aligned" : "",
].flat().filter(Boolean).join(" "));
const searchableTown = cleanText([
  rep.location_text,
  rep.towns_represented,
  rep.townsRepresented,
].flat().filter(Boolean).join(" "));
const countiesRepresented = countiesRepresentedFor(rep);
const searchableCounty = countiesRepresented || countyNameFor(rep);
const searchableBody = /senate/i.test(rep.chamber || "")
  ? "senate"
  : /house/i.test(rep.chamber || "")
    ? "house"
    : cleanText(rep.chamber || "");
const gradeSortValue = testimonyAlignmentPercent ?? -1;
const missingInfoCount = [
  photoUrl,
  rep.email,
  rep.website_url || rep.website || rep.generalCourtUrl || rep.sourceUrls?.generalCourt,
].filter((value) => !String(value || "").trim()).length;
const updatedSortValue = Date.parse(
  rep.updatedAt ||
    rep.updated_at ||
    rep.lastUpdated ||
    rep.last_updated ||
    "",
) || 0;

function trackedBillFor(vote) {
  return trackedBillForVote(trackedBills, vote);
}

function billSummaryFor(vote) {
  return billSummaries.get(normalizeBillCode(vote.condensedbillno || vote.bill_number));
}

function billPreviewTitle(billSummary = {}, trackedBill = {}) {
  return cleanText(
    billSummary?.name ||
      billSummary?.title ||
      trackedBill?.name ||
      trackedBill?.title ||
      "",
  );
}

function voteInterpretationForEmbed(vote = {}, trackedBill = {}) {
  const voteValue = String(vote.vote || vote.vote_label || vote.vote_code || "").trim().toLowerCase();
  const isYea = ["1", "yea", "yes", "y", "in support", "support"].includes(voteValue) || voteValue.includes("support");
  const isNay = ["2", "nay", "no", "n", "opposed", "oppose", "against"].includes(voteValue) || voteValue.includes("oppose") || voteValue.includes("against");

  if (isYea) return trackedBill.yeaInterpretation || "";
  if (isNay) return trackedBill.nayInterpretation || "";
  return "";
}

function embedVoteActionLabel(vote = {}, fallback = "Vote not listed") {
  const voteValue = String(vote.vote || vote.vote_label || vote.vote_code || "").trim().toLowerCase();
  const isYea = ["1", "yea", "yes", "y", "in support", "support"].includes(voteValue) || voteValue.includes("support");
  const isNay = ["2", "nay", "no", "n", "opposed", "oppose", "against"].includes(voteValue) || voteValue.includes("oppose") || voteValue.includes("against");

  if (isYea) return "In support";
  if (isNay) return "Opposed";
  return fallback;
}
---

<article
  class:list={["rep-card", embed && "rep-card--embed"]}
  data-embed-rep={embed ? embedRepKey : undefined}
  data-fuzzy-item
  data-fuzzy-name={name}
  data-fuzzy-aliases={aliases}
  data-fuzzy-town={searchableTown}
  data-fuzzy-county={searchableCounty}
  data-fuzzy-district={districtLabel}
  data-fuzzy-office={rep.chamber || ""}
  data-fuzzy-body={searchableBody}
  data-fuzzy-kind="legislators"
  data-fuzzy-party={formatParty(rep.party)}
  data-fuzzy-sort-name={name}
  data-fuzzy-sort-district={districtLabel}
  data-fuzzy-sort-grade={gradeSortValue}
  data-fuzzy-sort-updated={updatedSortValue}
  data-fuzzy-sort-missing={missingInfoCount}
  data-fuzzy-text={searchableText}
>
  <div
    class="rep-card-top"
    data-embed-rep-toggle={embed ? "" : undefined}
    role={embed ? "button" : undefined}
    tabindex={embed ? "0" : undefined}
    aria-expanded={embed ? String(isEmbedOpen) : undefined}
  >
    <a class="photo-wrap" href={embed ? undefined : profileHref}>
      {photoUrl ? (
        <img
          class="rep-photo"
          src={photoUrl}
          alt={`Photo of ${name}`}
          loading="lazy"
        />
      ) : (
        <img
          class="rep-photo fallback-photo"
          src={profileIcon.src}
          alt=""
          loading="lazy"
        />
      )}
    </a>

    <div class="rep-main">
      <div class="rep-heading">
        <div class="rep-title-block">
          <h3>{embed ? name : <a href={profileHref}>{name}</a>}</h3>
          <div class="rep-meta">
            <span>{cleanText(rep.chamber || "Legislator")}</span>
            <span data-party-affiliation>{formatParty(rep.party)}</span>
            {showFreeStateAligned && isFreeStater(rep) && (
              <a
                class="free-stater-pill"
                href="/free-staters"
                title={FREE_STATE_ALIGNED_TOOLTIP}
                aria-label={FREE_STATE_ALIGNED_TOOLTIP}
              >
                Free State Aligned
              </a>
            )}
            {showTpactionAligned && isTpActionAligned(rep) && (
              <a
                class="tpaction-pill"
                href="/tpaction-aligned"
                title={TPACTION_ALIGNED_TOOLTIP}
                aria-label={TPACTION_ALIGNED_TOOLTIP}
              >
                TPAction Aligned
              </a>
            )}
          </div>
        </div>
        {showTestimonyAlignment && <a
          class="rep-grade testimony-alignment"
          href="/vote-grades"
          title={`Testimony alignment. ${grade.label}`}
          aria-label={`${testimonyAlignmentPercent === null ? "No" : `${testimonyAlignmentPercent}%`} testimony alignment. ${grade.label}`}
        >
          <span>{testimonyAlignmentPercent === null ? "N/A" : `${testimonyAlignmentPercent}%`}</span>
          <small>Testimony aligned</small>
        </a>}
        {embed && (
          <span class:list={["tracker-alignment", trackerAlignmentPercent === null && "tracker-alignment--empty"]}>
            <strong>{trackerAlignmentPercent === null ? "—" : `${trackerAlignmentPercent}%`}</strong>
            <small>{trackerAlignmentLabel}</small>
          </span>
        )}
      </div>

      <div class="district-line">
        <strong>District:</strong> {rep.district || "Not listed"}
      </div>

      {countiesRepresented && (
        <div class="location-line">
          <strong>Counties represented:</strong> {countiesRepresented}
        </div>
      )}

      {rep.location_text && (
        <div class="location-line">
          {cleanText(rep.location_text)}
        </div>
      )}

    </div>
    {embed && (
      <div class="embed-vote-preview" aria-hidden="true">
        <span class="embed-vote-preview-label">Tracked vote record</span>
        <strong>{trackerVoteStats.total || "—"}</strong>
        <span>{trackerVoteStats.total === 1 ? "vote available" : "votes available"}</span>
        <button type="button" tabindex="-1">
          <span class="embed-vote-preview-open">Show votes</span>
          <span class="embed-vote-preview-close">Hide votes</span>
          <span aria-hidden="true">⌄</span>
        </button>
      </div>
    )}
  </div>

  <div data-embed-rep-expanded={embed ? "" : undefined} hidden={embed && !isEmbedOpen}>
  <div class="rep-contact">
    <div>
      <span>Email</span>
      {cleanText(rep.email || "Email not listed")}
    </div>

    <div>
      <span>Phone</span>
      {cleanText(rep.phone || "Phone not listed")}
    </div>

    {rep.notes && (
      <div>
        <span>Notes</span>
        <p>{cleanText(rep.notes)}</p>
      </div>
    )}
  </div>

  <div class="vote-summary">
    <span>{embed ? "Partner bill tracker votes" : "Online Testimony Alignment"}</span>

    {voteHistory.length ? (
      <div class="vote-list">
        {voteHistory.map((preview) => {
          const vote = preview.vote;
          const bill = preview.trackedBill || trackedBillFor(vote);
          const billSummary = preview.billSummary || billSummaryFor(vote);
          const billYear = billSummary?.sessionyear || vote.sessionyear;
          const stance = embed
            ? representativeVoteStance(vote, bill)
            : representativeOnlineTestimonyVoteStance(vote, billSummary);
          const voteImpact = "";
          const billTitle = billPreviewTitle(billSummary, bill);
          const voteInterpretation = voteInterpretationForEmbed(vote, bill);
          const embedVoteAction = embedVoteActionLabel(vote, stance.label);

          if (embed) {
            return (
              <div class="vote-item vote-item--embed">
                <button
                  type="button"
                  class:list={["tracker-vote-pill", stance.className]}
                  data-embed-bill
                  data-bill-code={bill?.code || vote.condensedbillno || "Bill"}
                  data-bill-vote={embedVoteAction}
                  data-bill-vote-explanation={voteInterpretation}
                  data-bill-vote-explanation-label={voteExplanationLabel}
                  data-bill-preferred={bill?.preferredStance || ""}
                  data-bill-summary={billSummary?.summary || bill?.summary || ""}
                  data-bill-yea={bill?.yeaInterpretation || bill?.yeaImpact || ""}
                  data-bill-nay={bill?.nayInterpretation || bill?.nayImpact || ""}
                >
                  <strong>{bill?.code || vote.condensedbillno || "Bill"} · {embedVoteAction}</strong>
                  {billTitle && <span>{billTitle}</span>}
                </button>
              </div>
            );
          }

          return (
            <div class="vote-item">
              <div class="vote-heading">
                <strong>
                  {embed ? (
                    <button
                      type="button"
                      data-embed-bill
                      data-bill-code={bill?.code || vote.condensedbillno || "Bill"}
                      data-bill-vote={embedVoteAction}
                      data-bill-vote-explanation={voteInterpretation}
                      data-bill-vote-explanation-label={voteExplanationLabel}
                      data-bill-preferred={bill?.preferredStance || ""}
                      data-bill-summary={billSummary?.summary || bill?.summary || ""}
                      data-bill-yea={bill?.yeaInterpretation || bill?.yeaImpact || ""}
                      data-bill-nay={bill?.nayInterpretation || bill?.nayImpact || ""}
                    >{bill?.code || vote.condensedbillno || "Bill"}</button>
                  ) : (
                    <a href={billDetailPath(bill?.code || vote.condensedbillno, billYear)}>
                      {bill?.code || vote.condensedbillno || "Bill"}
                    </a>
                  )}
                </strong>
                {billTitle && (
                  <span>{billTitle}</span>
                )}
              </div>
              <div class="vote-copy">
                <div class:list={["vote-interpretation", stance.className]}>
                  <a
                    class:list={["legislator-vote-pill", stance.className]}
                    href="/vote-interpretations"
                    title="How do we determine this?"
                    aria-label={`How do we determine this? ${stance.label}`}
                  >
                    {stance.label}
                  </a>
                  {voteImpact && <p class="vote-impact">{cleanText(voteImpact)}</p>}
                </div>
              </div>
              {showPublicTestimony && (
                <div class="vote-pill-stack">
                  {billSummary && (
                  <BillPositionSummary bill={billSummary} compact={true} />
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    ) : (
      <p>No scored online testimony vote previews returned.</p>
    )}
  </div>
  </div>
</article>

<style>
  .rep-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: none;
    color: inherit;
    overflow: hidden;
    padding: 18px;
  }

  .rep-card--embed {
    background: transparent;
    border: 0;
    border-bottom: 1px solid #dbe4f0;
    border-radius: 0;
    padding: 24px 8px;
  }

  .rep-card--embed .rep-card-top {
    cursor: pointer;
    grid-template-columns: 76px minmax(0, 1fr) minmax(176px, 220px);
  }

  .rep-card--embed .rep-card-top:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 5px;
  }

  .rep-card a {
    color: inherit;
  }

  .rep-card:hover h3 a {
    text-decoration: underline;
  }

  .photo-wrap {
    display: block;
  }

  .rep-card-top {
    align-items: start;
    display: grid;
    gap: 16px;
    grid-template-columns: 96px 1fr;
  }

  .photo-wrap,
  .rep-photo {
    width: 96px;
  }

  .rep-photo {
    aspect-ratio: 4 / 5;
    background: #6b4f2a;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-sizing: border-box;
    height: 120px;
    object-fit: cover;
    object-position: center top;
  }

  .fallback-photo {
    background: transparent;
    object-fit: cover;
    padding: 0;
  }

  .rep-main h3 {
    font-size: 1.3rem;
    margin: 0;
  }

  .rep-heading {
    align-items: start;
    display: flex;
    gap: 12px;
    justify-content: space-between;
  }

  .tracker-alignment {
    align-items: center;
    background: var(--embed-accent-soft, #e0e7ff);
    border: 1px solid var(--embed-accent, #1d4ed8);
    border-radius: 999px;
    color: var(--embed-accent, #1d4ed8);
    display: inline-flex;
    flex: 0 0 auto;
    flex-direction: column;
    padding: 7px 10px;
  }

  .tracker-alignment strong { font-size: 1.05rem; line-height: 1; }
  .tracker-alignment small { font-size: .58rem; font-weight: 900; letter-spacing: .04em; line-height: 1.2; margin-top: 3px; max-width: 125px; text-align: center; }
  .tracker-alignment--empty { background: #f8fafc; border-color: #cbd5e1; color: #64748b; }

  .rep-card--embed .photo-wrap,
  .rep-card--embed .rep-photo {
    width: 76px;
  }

  .rep-card--embed .rep-photo { height: 95px; }

  .embed-vote-preview {
    align-items: center;
    background: #f8fafc;
    border: 1px solid #dbe4f0;
    border-radius: 14px;
    color: #64748b;
    display: grid;
    font-size: .78rem;
    font-weight: 700;
    gap: 2px;
    min-height: 100%;
    padding: 14px;
  }

  .embed-vote-preview-label {
    color: #64748b;
    font-size: .64rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .embed-vote-preview strong { color: #172554; font-size: 1.55rem; line-height: 1.05; }

  .embed-vote-preview button {
    align-items: center;
    align-self: end;
    background: var(--embed-accent-soft, #e0e7ff);
    border: 0;
    border-radius: 8px;
    color: var(--embed-accent, #1d4ed8);
    display: inline-flex;
    font: inherit;
    font-weight: 900;
    gap: 5px;
    margin-top: 8px;
    padding: 8px 9px;
    pointer-events: none;
    text-align: left;
    width: 100%;
  }

  .embed-vote-preview-close { display: none; }
  .rep-card-top[aria-expanded="true"] .embed-vote-preview-open { display: none; }
  .rep-card-top[aria-expanded="true"] .embed-vote-preview-close { display: inline; }
  .rep-card-top[aria-expanded="true"] .embed-vote-preview strong > span:last-child { transform: rotate(180deg); }

  .rep-title-block {
    display: grid;
    gap: 7px;
    min-width: 0;
  }

  .rep-grade,
  .rep-card a.rep-grade {
    background: #1e3a5f;
    border: 1px solid rgba(31, 41, 51, 0.32);
    border-radius: 10px;
    box-shadow: none;
    color: #fefce8;
    display: grid;
    flex: 0 0 auto;
    min-width: 112px;
    padding: 6px 8px;
    text-align: center;
    text-decoration: none;
  }

  .rep-grade span {
    color: #fefce8;
    font-size: 1.85rem;
    font-weight: 950;
    line-height: 1;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }

  .rep-grade small {
    color: #fefce8;
    font-size: 0.62rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    margin-top: 3px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .grade-a {
    background: #166534;
  }

  .grade-b {
    background: #65a30d;
  }

  .grade-c {
    background: #ca8a04;
  }

  .grade-d {
    background: #ea580c;
  }

  .grade-f {
    background: #b42318;
  }

  .grade-unknown {
    background: #5b616e;
  }

  .rep-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 0;
  }

  .rep-meta span,
  .rep-meta a {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    color: #1f2933;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 5px 10px;
    text-decoration: none;
  }

  .rep-meta .free-stater-pill {
    background: #4a2414;
    border-color: #f97316;
    border-radius: 6px;
    box-shadow: 0 0 0 1px rgba(255, 180, 60, 0.25), 0 0 12px rgba(255, 107, 26, 0.18);
    color: #fffdf7 !important;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .rep-meta .free-stater-pill:hover {
    background: #35180d;
    color: #fffdf7;
  }

  .rep-meta .tpaction-pill {
    background: #4b3a0b;
    border-radius: 6px;
    border-color: #facc15;
    box-shadow: 0 0 0 1px rgba(250, 204, 21, 0.25), 0 0 12px rgba(250, 204, 21, 0.16);
    color: #fffdf7 !important;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .district-line,
  .location-line {
    margin-top: 10px;
  }

  .location-line {
    color: #4b5563;
  }

  .rep-contact,
  .vote-summary {
    border-top: 1px solid #d1d5db;
    margin-top: 16px;
    padding-top: 16px;
  }

  .rep-contact {
    display: grid;
    gap: 12px;
  }

  .rep-contact div {
    color: #1f2933;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .rep-contact span,
  .vote-summary > span {
    color: #6b7280;
    display: block;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .rep-contact p {
    margin: 0;
  }

  .vote-summary > span {
    margin-bottom: 10px;
  }

  .vote-list {
    display: grid;
    gap: 8px;
  }

  .vote-item {
    align-items: start;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
