---
import {
  candidateName,
  candidatePath,
  formatCandidateParty,
  partyClassName,
} from "../lib/candidatesApi";
import profileIcon from "../assets/profile icon.png";
import { isFreeStater, isTpActionAligned } from "../lib/civicTags";
import { profilePhotoUrl } from "../lib/photos";

const { candidate } = Astro.props;

const name = candidateName(candidate);
const photoUrl = profilePhotoUrl(candidate.photoUrl) || profilePhotoUrl(candidate.legislatorPhotoUrl);
const officeTypeLabel =
  String(candidate.officeType || "").trim().toLowerCase() === "general court"
    ? ""
    : candidate.officeType;
const officeParts = [
  candidate.office,
  candidate.county,
  candidate.district ? `District ${candidate.district}` : "",
].filter(Boolean);
const districtLabel = [
  candidate.county,
  candidate.district ? `District ${candidate.district}` : "",
].filter(Boolean).join(" ");
const townsRepresented = candidateTownsRepresented(candidate);
const aliases = [candidate.nameAliases, candidate.name_aliases].filter(Boolean).join(" ");
const searchableText = [
  name,
  candidate.candidateFirstName,
  candidate.candidateLastName,
  aliases,
  candidate.officeType,
  candidate.office,
  candidate.county,
  candidate.district,
  districtLabel,
  candidate.politicalParty,
  candidate.party,
  candidate.town,
  candidate.city,
  candidate.towns,
  candidate.townsRepresented,
  candidate.towns_represented,
  candidate.communitiesRepresented,
  candidate.communities_represented,
  candidate.locationText,
  candidate.location_text,
  candidate.legislatorTownsRepresented,
  candidate.legislatorLocationText,
  townsRepresented,
  candidate.candidateEmail,
  candidate.candidateWebsite,
  candidate.currentLegislator ? "Current Legislator" : "",
  isFreeStater(candidate) ? "Free State Aligned" : "",
  isTpActionAligned(candidate) ? "TPAction Aligned" : "",
].flat().filter(Boolean).join(" ");
const searchableTown = [
  candidate.town,
  candidate.city,
  candidate.towns,
  candidate.townsRepresented,
  candidate.towns_represented,
  candidate.communitiesRepresented,
  candidate.communities_represented,
  candidate.locationText,
  candidate.location_text,
  candidate.legislatorTownsRepresented,
  candidate.legislatorLocationText,
  townsRepresented,
].flat().filter(Boolean).join(" ");
const searchableBody = /senate/i.test(`${candidate.office || ""} ${candidate.officeType || ""}`)
  ? "senate"
  : /representative|house/i.test(`${candidate.office || ""} ${candidate.officeType || ""}`)
    ? "house"
    : "";
const missingInfoCount = [
  photoUrl,
  candidate.candidateEmail,
  candidate.candidateWebsite,
].filter((value) => !String(value || "").trim()).length;
const updatedSortValue = Date.parse(
  candidate.updatedAt ||
    candidate.updated_at ||
    candidate.lastUpdated ||
    candidate.last_updated ||
    "",
) || 0;
const contactLinks = [
  candidate.candidateEmail && {
    href: `mailto:${candidate.candidateEmail}`,
    label: "Email",
  },
  candidate.candidateWebsite && {
    href: candidate.candidateWebsite,
    label: "Website",
  },
  candidate.legislatorProfileUrl && {
    href: candidate.legislatorProfileUrl,
    label: "Legislator Profile",
  },
].filter(Boolean);

function formatCurrency(value) {
  const amount = Number(value || 0);
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(amount);
}

function candidateTownsRepresented(candidate = {}) {
  const towns = [
    candidate.townsRepresented,
    candidate.towns_represented,
    candidate.communitiesRepresented,
    candidate.communities_represented,
    candidate.towns,
    candidate.locationText,
    candidate.location_text,
    candidate.legislatorTownsRepresented,
    candidate.legislatorLocationText,
    candidate.legislator?.towns_represented,
    candidate.legislator?.location_text,
  ].flatMap(townsFromValue);

  return uniqueTowns(towns).join(", ");
}

function townsFromValue(value = "") {
  if (Array.isArray(value)) {
    return value.flatMap((item) => {
      if (typeof item === "object" && item !== null) {
        return item.town || item.name || item.label || "";
      }
      return item;
    }).flatMap(townsFromValue);
  }

  if (typeof value === "object" && value !== null) {
    return townsFromValue(value.town || value.name || value.label || "");
  }

  const text = String(value || "").trim();
  const delimiter = /ward/i.test(text) ? /;|\||\s+and\s+/i : /[,;|]|\s+and\s+/i;

  return text
    .split(delimiter)
    .map((town) => town.trim())
    .filter(Boolean);
}

function uniqueTowns(towns = []) {
  const seen = new Set();
  const unique = [];

  for (const town of towns) {
    const label = String(town || "").trim();
    const key = label.toLowerCase();
    if (!label || seen.has(key)) continue;
    seen.add(key);
    unique.push(label);
  }

  return unique;
}
---

<article
  class="candidate-card"
  data-fuzzy-item
  data-fuzzy-name={name}
  data-fuzzy-aliases={aliases}
  data-fuzzy-town={searchableTown}
  data-fuzzy-county={candidate.county || ""}
  data-fuzzy-office={candidate.office || ""}
  data-fuzzy-district={districtLabel}
  data-fuzzy-body={searchableBody}
  data-fuzzy-kind="candidates"
  data-fuzzy-party={candidate.politicalParty || candidate.party || ""}
  data-fuzzy-sort-name={name}
  data-fuzzy-sort-district={districtLabel}
  data-fuzzy-sort-updated={updatedSortValue}
  data-fuzzy-sort-missing={missingInfoCount}
  data-fuzzy-text={searchableText}
>
  <a class="photo-wrap" href={candidatePath(candidate)}>
    {photoUrl ? (
      <img src={photoUrl} alt={`Photo of ${name}`} loading="lazy" />
    ) : (
      <img class="photo-fallback" src={profileIcon.src} alt="" loading="lazy" />
    )}
  </a>

  <div class="candidate-copy">
    <h3>
      <a href={candidatePath(candidate)}>{name}</a>
    </h3>

    <div class="pill-row">
      <span class:list={["party-pill", partyClassName(candidate.politicalParty)]}>
        {formatCandidateParty(candidate.politicalParty)}
      </span>
      {isFreeStater(candidate) && (
        <a
          class="free-stater-pill"
          href="/free-staters"
          title="What is a Free Stater?"
          aria-label="What is a Free Stater?"
        >
          Free State Aligned
        </a>
      )}
      {isTpActionAligned(candidate) && (
        <span class="tpaction-pill">TPAction Aligned</span>
      )}
      {officeTypeLabel && <span>{officeTypeLabel}</span>}
      {candidate.currentLegislator && <span>Current Legislator</span>}
    </div>

    <p class="office-line">{officeParts.join(", ") || "Office not listed"}</p>
    {townsRepresented && (
      <p class="towns-line">
        <span>Towns represented</span>
        {townsRepresented}
      </p>
    )}

    {contactLinks.length > 0 && (
      <div class="actions">
        {contactLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .candidate-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: none;
    color: inherit;
    display: grid;
    gap: 16px;
    grid-template-columns: 92px 1fr;
    padding: 16px;
  }

  a {
    color: inherit;
  }

  .photo-wrap,
  .photo-wrap img,
  .photo-fallback {
    width: 92px;
  }

  .photo-wrap img,
  .photo-fallback {
    aspect-ratio: 4 / 5;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-sizing: border-box;
    height: 115px;
    object-fit: cover;
    object-position: center top;
  }

  .photo-wrap img.photo-fallback {
    background: transparent;
    object-fit: cover;
    padding: 0;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    margin: 0 0 6px;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.1;
    margin: 0;
  }

  .candidate-card:hover h3 a {
    text-decoration: underline;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .pill-row span,
  .pill-row a {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    color: #1f2933;
    font-size: 0.78rem;
    font-weight: 900;
    padding: 5px 9px;
    text-decoration: none;
  }

  .pill-row .party-democrat {
    background: #dbeafe;
    border-color: #2563eb;
  }

  .pill-row .party-republican {
    background: #fee2e2;
    border-color: #dc2626;
  }

  .pill-row .party-libertarian {
    background: #fef3c7;
    border-color: #d97706;
  }

  .pill-row .free-stater-pill {
    background: #7f1d1d;
    border-color: #111827;
    box-shadow: none;
    color: white;
  }

  .pill-row .free-stater-pill:hover {
    background: #450a0a;
  }

  .pill-row .tpaction-pill {
    background: #172554;
    border-color: #f59e0b;
    color: #fef3c7;
    text-transform: uppercase;
  }

  .office-line {
    color: #4b5563;
    font-weight: 800;
    line-height: 1.4;
    margin: 12px 0 0;
  }

  .towns-line {
    color: #4b5563;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.4;
    margin: 8px 0 0;
  }

  .towns-line span {
    color: #6b4f2a;
    display: block;
    font-size: 0.68rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
    text-transform: uppercase;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .actions a {
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 900;
    padding: 7px 10px;
    text-decoration: none;
  }

  @media (max-width: 520px) {
    .candidate-card {
      grid-template-columns: 1fr;
    }
  }
</style>
