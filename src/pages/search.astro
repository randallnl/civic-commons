---
export const prerender = false;

import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import profileIcon from "../assets/profile icon.png";
import { articleDetailPath, articlePublishDate, articleSourceName, getArticles } from "../lib/articlesApi";
import { FREE_STATE_ALIGNED_TOOLTIP, TPACTION_ALIGNED_TOOLTIP } from "../lib/alignmentTags";
import { billDetailPath, getBills } from "../lib/billsApi";
import { candidateName, candidateSlug, getCandidates } from "../lib/candidatesApi";
import { isFreeStater, isTpActionAligned } from "../lib/civicTags";
import { communityPath, getCommunities } from "../lib/communitiesApi";
import { profilePhotoUrl } from "../lib/photos";
import { getRepresentatives, repName, repSlug } from "../lib/repsApi";
import { MAX_SITE_SEARCH_LENGTH, billSearchQuery, mergePeopleSearchResults, normalizeSiteSearchQuery } from "../lib/siteSearch";
import { cleanText } from "../lib/text";

const q = normalizeSiteSearchQuery(Astro.url.searchParams.get("q") || "");
const queryTooLong = q.length > MAX_SITE_SEARCH_LENGTH;

let communities = [];
let people = [];
let bills = [];
let articles = [];
let availability = { communities: true, legislators: true, candidates: true, bills: true, articles: true };

if (q && !queryTooLong) {
  const [communityResult, repResult, candidateResult, billResult, articleResult] = await Promise.allSettled([
    getCommunities({ q, body: "", limit: 12, articleLimit: 0 }),
    getRepresentatives({ q, limit: 20 }),
    getCandidates({ q, electionYear: 2026, limit: 20 }),
    getBills({ q: billSearchQuery(q), limit: 20 }),
    getArticles({ q, limit: 20 }),
  ]);

  availability = {
    communities: communityResult.status === "fulfilled",
    legislators: repResult.status === "fulfilled",
    candidates: candidateResult.status === "fulfilled",
    bills: billResult.status === "fulfilled",
    articles: articleResult.status === "fulfilled",
  };

  communities = communityResult.status === "fulfilled" ? communityResult.value.communities || [] : [];
  bills = billResult.status === "fulfilled" ? billResult.value.bills || [] : [];
  articles = articleResult.status === "fulfilled" ? articleResult.value.articles || [] : [];

  const legislators = repResult.status === "fulfilled"
    ? (repResult.value.representatives || []).map((person) => ({
        slug: repSlug(person),
        name: repName(person),
        aliases: person.nameAliases || person.name_aliases,
        photoUrl: person.photo || person.photo_url,
        party: person.party,
        district: person.district,
        chamber: person.chamber,
        isFreeStateAligned: isFreeStater(person),
        isTpActionAligned: isTpActionAligned(person),
      }))
    : [];
  const candidates = candidateResult.status === "fulfilled"
    ? (candidateResult.value.candidates || []).map((person) => ({
        slug: candidateSlug(person),
        name: candidateName(person),
        aliases: person.nameAliases || person.name_aliases,
        photoUrl: person.photoUrl || person.photo_url,
        party: person.politicalParty || person.political_party,
        district: person.district,
        candidateOffice: person.office,
        isFreeStateAligned: isFreeStater(person),
        isTpActionAligned: isTpActionAligned(person),
      }))
    : [];
  people = mergePeopleSearchResults(legislators, candidates, q);
}

const hasPartialResults = Object.values(availability).some((available) => !available);
const totalResults = communities.length + people.length + bills.length + articles.length;

function communityName(community = {}) {
  return (
    community.name ||
    community.district_label ||
    community.districtLabel ||
    `${bodyLabel(community)} District ${community.district || community.raw_district || ""}`
  );
}

function bodyLabel(community = {}) {
  const value = String(community.chamber || community.body || "").toLowerCase();
  if (value === "senate" || value === "s") return "Senate";
  if (value === "house" || value === "h") return "House";
  return "District";
}

function townsFor(community = {}) {
  const value =
    community.townsRepresented ||
    community.towns ||
    community.towns_represented ||
    "";

  if (Array.isArray(value)) {
    return value
      .map((town) =>
        typeof town === "object" && town !== null
          ? town.town || town.name || town.label
          : town,
      )
      .filter(Boolean);
  }

  return String(value)
    .split(/;|,/)
    .map((town) => town.trim())
    .filter(Boolean);
}

function representativesFor(community = {}) {
  return community.representatives || community.reps || community.legislators || [];
}

function previewText(text = "", maxLength = 170) {
  const normalized = cleanText(text).replace(/\s+/g, " ").trim();
  if (normalized.length <= maxLength) return normalized;
  return `${normalized.slice(0, maxLength).trim()}...`;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Search NH Deserves Better</title>
  </head>

  <body>
    <TopNav />
    <main class="page">
      <a class="back" href="/">Back home</a>

      <section class="hero">
        <h1>Search NH Deserves Better</h1>

        <form class="search" action="/search" method="get">
          <label class="visually-hidden" for="site-search-query">Search people, communities, bills, and articles</label>
          <input id="site-search-query" type="search" name="q" value={q} maxlength={MAX_SITE_SEARCH_LENGTH} placeholder="Search for a person, town, bill, or article" />
          <button type="submit">Search</button>
        </form>
      </section>

      {queryTooLong ? (
        <p class="empty" role="alert">Search terms must be {MAX_SITE_SEARCH_LENGTH} characters or fewer.</p>
      ) : q.length === 0 ? (
        <p class="empty">Enter a search term to begin.</p>
      ) : (
        <section class="results">
          <p class="summary">Showing results for “{q}”</p>
          {hasPartialResults && <p class="empty" role="status">Some result categories are temporarily unavailable. Available results are shown below.</p>}
          {!hasPartialResults && totalResults === 0 && <p class="empty">No matches yet. Try a person’s name, a town, or a bill number such as HB 123.</p>}

          <div class="group">
            <h2>Communities <span class="count">{communities.length}</span></h2>
            {!availability.communities ? (
              <p>Community results are temporarily unavailable.</p>
            ) : communities.length === 0 ? (
              <p>No communities found.</p>
            ) : (
              <ul>
                {communities.map((community) => {
                  const towns = townsFor(community);
                  const representatives = representativesFor(community);

                  return (
                    <li>
                      <a href={communityPath(community)}>
                        <span>
                          <strong>{communityName(community)}</strong>
                          <small>
                            {[
                              bodyLabel(community),
                              community.county,
                              towns.slice(0, 4).join(", "),
                              representatives.length ? `${representatives.length} reps` : "",
                            ]
                              .filter(Boolean)
                              .join(" · ")}
                          </small>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </div>

          <div class="group">
            <h2>People <span class="count">{people.length}</span></h2>
            {!availability.legislators && !availability.candidates ? (
              <p>People results are temporarily unavailable.</p>
            ) : people.length === 0 ? (
              <p>{availability.legislators && availability.candidates ? "No legislators or candidates found." : "No people found in the available results."}</p>
            ) : (
              <ul>
                {people.map((person) => {
                  const photoUrl = profilePhotoUrl(person.photoUrl);

                  return (
                    <li>
                      <div class="person-result-row">
                        <a class="person-result-link" href={`/people/${person.slug}`}>
                          <img
                            class:list={[!photoUrl && "profile-icon"]}
                            src={photoUrl || profileIcon.src}
                            alt=""
                          />
                          <span>
                            <strong>{person.name}</strong>
                            <small>
                              {[
                                person.isLegislator ? "Current legislator" : "",
                                person.isCandidate ? "Current candidate" : "",
                                person.chamber || person.candidateOffice,
                                person.party,
                                person.district,
                              ].filter(Boolean).join(" · ") || "No details listed"}
                            </small>
                          </span>
                        </a>
                        {person.isFreeStateAligned && (
                          <a
                            class="free-stater-inline"
                            href="/free-staters"
                            title={FREE_STATE_ALIGNED_TOOLTIP}
                            aria-label={FREE_STATE_ALIGNED_TOOLTIP}
                          >
                            Free State Aligned
                          </a>
                        )}
                        {person.isTpActionAligned && (
                          <a
                            class="free-stater-inline tpaction-inline"
                            href="/tpaction-aligned"
                            title={TPACTION_ALIGNED_TOOLTIP}
                            aria-label={TPACTION_ALIGNED_TOOLTIP}
                          >
                            TPAction Aligned
                          </a>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
            )}
          </div>

          <div class="group">
            <h2>Bills <span class="count">{bills.length}</span></h2>
            {!availability.bills ? (
              <p>Bill results are temporarily unavailable.</p>
            ) : bills.length === 0 ? (
              <p>No bills found.</p>
            ) : (
              <ul>
                {bills.map((bill) => (
                  <li>
                    <a href={billDetailPath(bill.condensedbillno || bill.bill_number, bill.sessionyear || bill.session_year)}>
                      <span>
                        <strong>
                          {bill.condensedbillno || bill.bill_number}: {bill.name || bill.title || "Bill details"}
                        </strong>
                        <small>
                          {previewText(
                            bill.summary ||
                              bill.description ||
                              bill.status ||
                              "No summary available yet.",
                          )}
                        </small>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="group">
            <h2>Articles <span class="count">{articles.length}</span></h2>
            {!availability.articles ? (
              <p>Article results are temporarily unavailable.</p>
            ) : articles.length === 0 ? (
              <p>No articles found.</p>
            ) : (
              <ul>
                {articles.map((article) => (
                  <li>
                    <a href={articleDetailPath(article)}>
                      <span>
                        <strong>{cleanText(article.preview?.title || article.title)}</strong>
                        <small>
                          {[articleSourceName(article), articlePublishDate(article)]
                            .filter(Boolean)
                            .join(" - ")}
                        </small>
                        <small>{previewText(article.preview?.description || article.publisher || article.resource_type || "Article")}</small>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      )}
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .back {
    color: #1f2933;
    font-weight: 800;
  }

  .hero {
    margin: 24px 0 40px;
  }

  h1 {
    font-size: clamp(2.15rem, 5.25vw, 3.9rem);
    line-height: 0.95;
    margin: 0 0 24px;
  }

  .search {
    display: flex;
    gap: 12px;
  }

  .search input {
    flex: 1;
    padding: 16px 18px;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    font-size: 1rem;
    background: white;
  }

  .search button {
    border: 1px solid #e2e8f0;
    background: #1f2933;
    color: white;
    padding: 16px 22px;
    border-radius: 999px;
    font-weight: 800;
    cursor: pointer;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .summary,
  .empty {
    font-size: 1.15rem;
    color: #4b5563;
  }

  .group {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: none;
    padding: 24px;
    margin: 24px 0;
  }

  .group h2 {
    margin-top: 0;
  }

  .count {
    color: #6b7280;
    font-size: 0.8em;
    font-weight: 600;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    border-top: 1px solid #d1d5db;
  }

  li:first-child {
    border-top: 0;
  }

  li a,
  .person-result-row {
    color: inherit;
    text-decoration: none;
  }

  li a,
  .person-result-link {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  li a {
    padding: 14px 0;
  }

  .person-result-row {
    align-items: center;
    display: flex;
    gap: 14px;
    justify-content: space-between;
    padding: 14px 0;
  }

  .person-result-link {
    min-width: 0;
  }

  img {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid #e2e8f0;
  }

  .profile-icon {
    background: transparent;
    box-sizing: border-box;
    object-fit: cover;
    padding: 0;
  }

  strong {
    display: block;
  }

  small {
    display: block;
    margin-top: 4px;
    color: #6b7280;
  }

  .free-stater-inline {
    background: #4a2414;
    border: 2px solid #f97316;
    border-radius: 6px;
    box-shadow: 0 0 0 1px rgba(255, 180, 60, 0.25), 0 0 12px rgba(255, 107, 26, 0.18);
    color: #fff8ed;
    display: inline-flex;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    margin-top: 8px;
    padding: 4px 8px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .free-stater-inline:hover {
    background: #35180d;
    color: #fffdf7;
  }

  .tpaction-inline,
  .tpaction-inline:hover {
    background: #4b3a0b;
    border-color: #facc15;
    box-shadow: 0 0 0 1px rgba(250, 204, 21, 0.25), 0 0 12px rgba(250, 204, 21, 0.16);
    color: #fff8ed;
  }

  @media (max-width: 600px) {
    .search {
      flex-direction: column;
    }
  }
</style>
