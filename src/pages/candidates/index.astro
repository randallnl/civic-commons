---
export const prerender = false;

import CandidateCard from "../../components/CandidateCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import PageHero from "../../components/PageHero.astro";
import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import {
  candidateName,
  candidateOfficePriority,
  candidateSlug,
  getCandidates,
  isLegislativeCandidate,
} from "../../lib/candidatesApi";
import { enrichCandidatesWithLegislators } from "../../lib/candidateLegislators";
import { civicApiBase, civicApiFetch } from "../../lib/civicApi";
import { getCommunities, getTownCommunity } from "../../lib/communitiesApi";

const API_BASE = civicApiBase();

const address = Astro.url.searchParams.get("address")?.trim() || "";
const county = Astro.url.searchParams.get("county")?.trim() || "";
const name = Astro.url.searchParams.get("name")?.trim() || "";
const office = Astro.url.searchParams.get("office")?.trim() || "";
const town = Astro.url.searchParams.get("town")?.trim() || "";
const sort = Astro.url.searchParams.get("sort")?.trim() || "";
const electionYear = "2026";
const officeOptions = [
  "State Representative",
  "State Senate",
];
const selectedOffice = officeOptions.find((option) => option.toLowerCase() === office.toLowerCase()) || "";
const countyOptions = [
  "Belknap",
  "Carroll",
  "Cheshire",
  "Coos",
  "Grafton",
  "Hillsborough",
  "Merrimack",
  "Rockingham",
  "Strafford",
  "Sullivan",
];

let candidates = [];
let meta = {};
let error = "";
let resultContext = "";
let nameOptions = [];
let townOptions = [];

try {
  if (address) {
    const response = await civicApiFetch(`${API_BASE}/reps/lookup`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ address }),
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || "Unable to look up candidates for that address.");
    }

    candidates = candidatesFromLookup(data);
    meta = data.meta || {};
    resultContext = formatAddress(data.normalizedInput) || data.address || address;
  } else if (town) {
    const data = await getTownCommunity(town, { articleLimit: 1 });
    candidates = candidatesFromCommunity(data);
    meta = data.meta || {};
    resultContext = data.town?.name || data.community?.name || town;
  } else {
    if (!name && !county && !selectedOffice) {
      candidates = await getAllLegislativeCandidates({ electionYear });
      meta = { count: candidates.length };
    } else {
      const data = await getDirectoryCandidates({
        q: name || town,
        county,
        office: selectedOffice,
        electionYear,
        limit: 500,
      });
      candidates = data.candidates || [];
      meta = data.meta || {};
    }
  }
} catch (loadError) {
  error = loadError?.message || "Unable to load candidates.";
}

const visibleCandidates = selectedOffice
  ? filterCandidatesByOffice(candidates, selectedOffice)
  : filterLegislativeCandidates(candidates);
candidates = prioritizeLegislativeCandidates(filterCandidatesByName(visibleCandidates, name));
candidates = await enrichCandidatesWithLegislators(candidates);

try {
  nameOptions = await candidateNameOptions();
} catch (optionsError) {
  nameOptions = uniqueOptions(candidates.map(candidateName));
}

try {
  townOptions = await communityTownOptions();
} catch (optionsError) {
  townOptions = town ? [town] : [];
}

const hasFilters = address || county || selectedOffice || town || name;
const resultCount = candidates.length;

async function getDirectoryCandidates({
  q = "",
  county = "",
  office = "",
  electionYear = "",
  limit = 100,
} = {}) {
  if (office) {
    return getCandidates({
      q,
      county,
      office,
      electionYear,
      limit,
    });
  }

  const [houseData, senateData] = await Promise.all([
    getCandidates({
      q,
      county,
      office: "State Representative",
      electionYear,
      limit,
    }),
    getCandidates({
      q,
      county,
      office: "State Senate",
      electionYear,
      limit,
    }),
  ]);

  const candidates = uniqueCandidates([
    ...(houseData.candidates || []),
    ...(senateData.candidates || []),
  ]);

  return {
    candidates,
    meta: {
      count: candidates.length,
    },
  };
}

async function getAllLegislativeCandidates({ electionYear = 2026 } = {}) {
  const [houseData, senateData] = await Promise.all([
    getCandidatePages({
      office: "State Representative",
      electionYear,
      limit: 100,
      maxPages: 20,
    }),
    getCandidatePages({
      office: "State Senate",
      electionYear,
      limit: 100,
      maxPages: 20,
    }),
  ]);

  return uniqueCandidates([...houseData, ...senateData]).filter(isLegislativeCandidate);
}

async function getCandidatePages({
  limit = 100,
  maxPages = 20,
  ...query
} = {}) {
  const pageSize = Math.max(1, Math.min(Number(limit) || 100, 100));
  const candidates = [];

  for (let page = 0; page < maxPages; page += 1) {
    const data = await getCandidates({
      ...query,
      limit: pageSize,
      offset: page * pageSize,
    });
    const pageCandidates = data.candidates || [];
    candidates.push(...pageCandidates);
    if (pageCandidates.length === 0) break;
  }

  return candidates;
}

function candidatesFromLookup(data = {}) {
  const candidateGroups = data.groups?.candidates || {};
  return uniqueCandidates([
    ...(data.candidates || []),
    ...(candidateGroups.senate || []),
    ...(candidateGroups.house || []),
    ...findNestedCandidates(candidateGroups),
  ]);
}

function candidatesFromCommunity(data = {}) {
  const community = data.town || data.community || data;

  return uniqueCandidates([
    ...(data.candidates || []),
    ...(community.candidates || []),
    ...(data.candidateSummary?.candidates || []),
    ...(community.candidateSummary?.candidates || []),
    ...(data.groups?.candidates?.senate || []),
    ...(data.groups?.candidates?.house || []),
    ...findNestedCandidates(data.groups),
    ...findNestedCandidates(community.groups),
  ]);
}

function findNestedCandidates(value) {
  if (!value) return [];

  if (Array.isArray(value)) {
    return value.flatMap((item) =>
      looksLikeCandidate(item) ? [item] : findNestedCandidates(item),
    );
  }

  if (typeof value === "object") {
    return Object.values(value).flatMap(findNestedCandidates);
  }

  return [];
}

function uniqueCandidates(items = []) {
  const seen = new Map();
  const unique = [];

  for (const candidate of items) {
    if (!looksLikeCandidate(candidate)) continue;

    const keys = candidateIdentityKeys(candidate);
    const existingIndex = keys
      .map((key) => seen.get(key))
      .find((index) => index !== undefined);

    if (existingIndex !== undefined) {
      const merged = mergeCandidateRecords(unique[existingIndex], candidate);
      unique[existingIndex] = merged;
      candidateIdentityKeys(merged).forEach((key) => seen.set(key, existingIndex));
      continue;
    }

    const index = unique.length;
    unique.push(candidate);
    keys.forEach((key) => seen.set(key, index));
  }

  return unique;
}

function candidateIdentityKeys(candidate = {}) {
  const keys = new Set();
  const personId = candidate.personId || candidate.person_id;
  const filerEntityNumber = candidate.filerEntityNumber || candidate.filer_entity_number;
  const slug = candidateSlug(candidate);
  const role = [
    candidate.office,
    candidate.county,
    candidate.district,
    candidate.electionYear || candidate.election_year,
  ].map(normalizeSearch).join("|");
  const signature = [
    candidateName(candidate),
    candidate.office,
    candidate.county,
    candidate.district,
    candidate.electionYear || candidate.election_year,
  ].map(normalizeSearch).join("|");

  if (filerEntityNumber) keys.add(`filer:${normalizeSearch(filerEntityNumber)}`);
  if (slug) keys.add(`slug:${slug}`);
  if (personId && role.replace(/\|/g, "")) {
    keys.add(`person-role:${normalizeSearch(personId)}|${role}`);
  }
  if (signature.replace(/\|/g, "")) keys.add(`signature:${signature}`);

  return [...keys];
}

function mergeCandidateRecords(current = {}, incoming = {}) {
  const primary =
    candidateCompletenessScore(incoming) > candidateCompletenessScore(current)
      ? incoming
      : current;
  const secondary = primary === incoming ? current : incoming;
  const merged = { ...secondary, ...primary };

  for (const [key, value] of Object.entries(secondary)) {
    if (!hasCandidateValue(merged[key]) && hasCandidateValue(value)) {
      merged[key] = value;
    }
  }

  return merged;
}

function candidateCompletenessScore(candidate = {}) {
  return [
    candidate.personId || candidate.person_id,
    candidate.filerEntityNumber || candidate.filer_entity_number,
    candidate.legislatorProfileUrl,
    candidate.currentLegislator || candidate.is_current_legislator,
    candidate.candidateWebsite || candidate.website,
    candidate.candidateEmail || candidate.email,
    candidate.photoUrl || candidate.photo_url,
    candidate.nameAliases || candidate.name_aliases,
  ].filter(hasCandidateValue).length;
}

function hasCandidateValue(value) {
  return value !== undefined && value !== null && String(value).trim() !== "";
}

function looksLikeCandidate(value) {
  return !!(
    value &&
    typeof value === "object" &&
    (
      value.slug ||
      value.filerEntityNumber ||
      value.candidateFirstName ||
      value.candidateLastName
    ) &&
    (
      value.office ||
      value.officeType ||
      value.politicalParty ||
      value.electionYear
    )
  );
}

function filterCandidatesByOffice(items = [], selectedOffice = "") {
  const officeFilter = selectedOffice.trim().toLowerCase();
  if (!officeFilter) return items;

  return items.filter((candidate) =>
    String(candidate.office || "")
      .trim()
      .toLowerCase()
      .includes(officeFilter),
  );
}

function filterCandidatesByName(items = [], filter = "") {
  const nameFilter = normalizeSearch(filter);
  if (!nameFilter) return items;

  return items.filter((candidate) => {
    const searchableName = [
      candidateName(candidate),
      candidate.nameAliases,
      candidate.name_aliases,
    ].filter(Boolean).join(" ");
    return normalizeSearch(searchableName).includes(nameFilter);
  });
}

function normalizeSearch(value = "") {
  return String(value || "")
    .replace(/â€™|â€˜/g, "'")
    .replace(/â€œ|â€/g, "\"")
    .replace(/â€“|â€”/g, "-")
    .replace(/Â·/g, " ")
    .replace(/Â/g, "")
    .toLowerCase()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function filterLegislativeCandidates(items = []) {
  return items.filter(isLegislativeCandidate);
}

function prioritizeLegislativeCandidates(items = []) {
  return [...items].sort((a, b) => {
    const priorityDelta = candidateOfficePriority(a.office) - candidateOfficePriority(b.office);
    if (priorityDelta) return priorityDelta;

    return [
      String(a.county || "").localeCompare(String(b.county || "")),
      numericSortValue(a.district) - numericSortValue(b.district),
      String(a.candidateLastName || a.name || "").localeCompare(String(b.candidateLastName || b.name || "")),
      String(a.candidateFirstName || "").localeCompare(String(b.candidateFirstName || "")),
    ].find((value) => value !== 0) || 0;
  });
}

function numericSortValue(value = "") {
  const number = Number(value);
  return Number.isFinite(number) ? number : 999;
}

function formatAddress(normalized = {}) {
  return [
    normalized.line1,
    normalized.city,
    normalized.state,
    normalized.zip,
  ]
    .filter(Boolean)
    .join(", ");
}

async function candidateNameOptions() {
  const data = await getDirectoryCandidates({ electionYear, limit: 200 });
  return uniqueOptions(
    filterLegislativeCandidates(data.candidates || []).map(candidateName),
  );
}

async function communityTownOptions() {
  const data = await getCommunities({ body: "house", limit: 500, articleLimit: 0 });
  return uniqueOptions(
    (data.communities || []).flatMap((community) =>
      townsFromValue(
        community.townsRepresented ||
          community.towns ||
          community.towns_represented ||
          community.communities_represented ||
          [],
      ),
    ),
  );
}

function townsFromValue(value = []) {
  if (Array.isArray(value)) {
    return value
      .map((item) =>
        typeof item === "object" && item !== null
          ? item.town || item.name || item.label
          : item,
      )
      .map(normalizeTownOption)
      .filter(Boolean);
  }

  return String(value || "")
    .split(/[,;|]/)
    .map(normalizeTownOption)
    .filter(Boolean);
}

function normalizeTownOption(value = "") {
  return String(value || "")
    .replace(/\s*-\s*Ward\s+\d+$/i, "")
    .trim();
}

function uniqueOptions(values = []) {
  return [...new Set(values.map((value) => String(value || "").trim()).filter(Boolean))]
    .sort((a, b) => a.localeCompare(b));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/NH%20DB%20Logo.svg" />
    <link rel="apple-touch-icon" href="/NH%20DB%20Logo.svg" />
    <title>Candidates | NH Deserves Better</title>
    <meta
      name="description"
      content="Browse New Hampshire State Representative and State Senate candidates by address, county, town, and name."
    />
  </head>

  <body>
    <TopNav />
    <main class="page" x-data="nhdbFuzzyFilter({ itemSelector: '.candidate-card[data-fuzzy-item]', idleLimit: 12 })">
      <PageHero
        backHref="/"
        backLabel="Back home"
        eyebrow="House and Senate Candidates"
        title="Browse candidates for the New Hampshire Legislature."
        lede="NH Deserves Better focuses on State Representative and State Senate races because those offices shape state law, local funding, public services, and the daily civic decisions closest to most people."
      >
        <form class="address-lookup" action="/candidates" method="get">
          <label for="address">Find State House and State Senate candidates for your address</label>

          <div class="address-row">
            <input
              id="address"
              type="text"
              name="address"
              value={address}
              placeholder="72 Concord St, Manchester, NH"
              autocomplete="street-address"
            />
            <button type="submit">Find Legislative Candidates</button>
          </div>
        </form>

        <FilterBar
          action="/candidates"
          submitLabel="Filter candidates"
          clearHref={hasFilters ? "/candidates" : ""}
          live
        >
          <label>
            <span>Name</span>
            <input
              type="search"
              name="name"
              value={name}
              list="candidateNameOptions"
              placeholder="Start typing a candidate"
              autocomplete="off"
              data-fuzzy-search
            />
            <datalist id="candidateNameOptions">
              {nameOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>County</span>
            <input
              type="search"
              name="county"
              value={county}
              list="candidateCountyOptions"
              placeholder="Start typing a county"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="county"
            />
            <datalist id="candidateCountyOptions">
              {countyOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Office</span>
            <input
              type="search"
              name="office"
              value={selectedOffice || office}
              list="candidateOfficeOptions"
              placeholder="State Representative or State Senate"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="office"
            />
            <datalist id="candidateOfficeOptions">
              {officeOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Town</span>
            <input
              type="search"
              name="town"
              value={town}
              list="candidateTownOptions"
              placeholder="Start typing a town"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="town"
            />
            <datalist id="candidateTownOptions">
              {townOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Sort</span>
            <select name="sort" data-fuzzy-sort>
              <option value="" selected={!sort}>Default</option>
              <option value="name:asc" selected={sort === "name:asc"}>Name A-Z</option>
              <option value="district:asc" selected={sort === "district:asc"}>District</option>
              <option value="updated:desc" selected={sort === "updated:desc"}>Recently updated</option>
              <option value="missing:desc" selected={sort === "missing:desc"}>Missing photo/email/website</option>
            </select>
          </label>
        </FilterBar>
        <div class="filter-chips" data-fuzzy-chips hidden></div>
      </PageHero>

      {error ? (
        <p class="status-message">{error}</p>
      ) : (
        <section class="results" id="candidate-results">
          <div class="results-heading">
            <div>
              <h2><span data-fuzzy-count>{Math.min(resultCount, 12)}</span> House and Senate Candidates Shown</h2>
              {resultContext ? (
                <p>Showing matches for {resultContext}</p>
              ) : hasFilters ? (
                <p>Showing candidates that match the active filters.</p>
              ) : (
                <p>Showing a preview. Use the filters to reveal matching candidate profiles.</p>
              )}
            </div>
            {hasFilters && <a href="/candidates">Clear filters</a>}
          </div>

          {candidates.length ? (
            <>
              <div class="candidate-grid">
                {candidates.map((candidate) => (
                  <CandidateCard candidate={candidate} />
                ))}
              </div>
              <div class="status-message empty-state" data-fuzzy-empty hidden>
                <strong>No State House or State Senate candidates matched those filters.</strong>
                <ul>
                  <li>Try searching by last name.</li>
                  <li>Remove the county or town chip above.</li>
                  <li>Clear the office filter to include both House and Senate candidates.</li>
                </ul>
              </div>
            </>
          ) : (
            <p class="status-message">No State House or State Senate candidates found.</p>
          )}
        </section>
      )}
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  a {
    color: #1f2933;
    font-weight: 800;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .address-lookup {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: none;
    padding: 24px;
  }

  .address-lookup {
    display: grid;
    gap: 10px;
  }

  .address-lookup + :global(.nhdb-filter-bar) {
    margin-top: 32px;
  }

  .address-row,
  .address-lookup {
    align-items: end;
    display: grid;
    gap: 12px;
  }

  .address-row {
    grid-template-columns: minmax(0, 1fr) 180px;
  }

  .address-lookup label {
    color: #4b5563;
    font-size: 0.74rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .address-lookup input,
  .address-lookup button {
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    box-sizing: border-box;
    font: inherit;
    font-weight: 800;
    min-height: 54px;
    padding: 16px 18px;
    width: 100%;
  }

  .address-lookup button {
    background: #1f2933;
    color: white;
    cursor: pointer;
  }

  .results-heading {
    align-items: center;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin: 48px 0 18px;
  }

  .results-heading h2 {
    font-size: 1.7rem;
    margin: 0;
  }

  .results-heading p {
    color: #6b7280;
    font-weight: 800;
    margin: 6px 0 0;
  }

  .candidate-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .filter-chips button {
    align-items: center;
    background: #eef6ff;
    border: 1px solid #93c5fd;
    border-radius: 999px;
    color: #1f2933;
    cursor: pointer;
    display: inline-flex;
    gap: 8px;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 900;
    padding: 7px 10px;
  }

  .filter-chips b {
    color: #b91c1c;
    font-size: 1rem;
    line-height: 1;
  }

  .see-more-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 22px;
  }

  .see-more-row button,
  .see-more-button {
    background: #1f2933;
    border: 1px solid #1f2933;
    border-radius: 999px;
    color: white;
    cursor: pointer;
    font: inherit;
    font-weight: 900;
    padding: 12px 18px;
    text-decoration: none;
  }

  .status-message {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    color: #4b5563;
    font-size: 1.05rem;
    font-weight: 800;
    padding: 18px;
  }

  .empty-state strong {
    color: #1f2933;
    display: block;
    margin-bottom: 8px;
  }

  .empty-state ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 20px;
  }

  @media (max-width: 900px) {
    .address-row,
    .candidate-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
