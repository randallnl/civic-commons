---
export const prerender = false;

import CandidateCard from "../../components/CandidateCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import {
  candidateName,
  candidateOfficePriority,
  candidateSlug,
  getCandidates,
  isLegislativeCandidate,
} from "../../lib/candidatesApi";
import { enrichCandidatesWithLegislators } from "../../lib/candidateLegislators";
import { civicApiBase, civicApiFetch } from "../../lib/civicApi";
import { getCommunities, getTownCommunity } from "../../lib/communitiesApi";
import {
  filterLegislativeRecordsByTown as filterCandidatesByTown,
  filterLegislativeRecordsByWard as filterCandidatesByWard,
  normalizeWardNumber,
  representedTownsFromValue as townsFromValue,
  representsWard,
  wardOptionsFor,
} from "../../lib/legislativeSearch";

const API_BASE = civicApiBase();

const address = Astro.url.searchParams.get("address")?.trim() || "";
const selectedWard = normalizeWardNumber(Astro.url.searchParams.get("ward") || "");
const county = Astro.url.searchParams.get("county")?.trim() || "";
const district = Astro.url.searchParams.get("district")?.trim() || "";
const name = Astro.url.searchParams.get("name")?.trim() || "";
const office = Astro.url.searchParams.get("office")?.trim() || "";
const town = Astro.url.searchParams.get("town")?.trim() || "";
const sort = Astro.url.searchParams.get("sort")?.trim() || "";
const electionYear = "2026";
const INITIAL_CANDIDATE_PREVIEW_LIMIT = 12;
const officeOptions = [
  "State Representative",
  "State Senate",
];
const selectedOffice = officeOptions.find((option) => option.toLowerCase() === office.toLowerCase()) || "";
const countyOptions = [
  "Belknap",
  "Carroll",
  "Cheshire",
  "Coos",
  "Grafton",
  "Hillsborough",
  "Merrimack",
  "Rockingham",
  "Strafford",
  "Sullivan",
];

let candidates = [];
let meta = {};
let error = "";
let resultContext = "";
let nameOptions = [];
let townOptions = [];
let lookupData = null;

try {
  if (address) {
    const response = await civicApiFetch(`${API_BASE}/reps/lookup`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        address,
        ward: selectedWard,
        resultType: "candidates",
      }),
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || "Unable to look up candidates for that address.");
    }

    lookupData = data;
    const lookupPlace = data.civic?.place?.name || data.normalizedInput?.city || "";
    const isTownOnlyLookup = lookupPlace && !String(data.normalizedInput?.line1 || "").trim();
    const lookupWardOptions = data.search?.wardOptions || wardOptionsFor(lookupPlace);
    const lookupWard = !isTownOnlyLookup && lookupWardOptions.length
      ? selectedWard || normalizeWardNumber(data.civic?.ward?.number || "")
      : "";
    const lookupCandidates = candidatesFromLookup(data, {
      ward: lookupWard,
      warded: !isTownOnlyLookup && lookupWardOptions.length > 0,
    });

    if (isTownOnlyLookup) {
      const [townResult, directoryResult] = await Promise.allSettled([
        getTownCommunity(lookupPlace, { articleLimit: 1 }),
        getDirectoryCandidates({
          q: name || lookupPlace,
          county,
          district,
          office: selectedOffice,
          electionYear,
          limit: 500,
        }),
      ]);
      const townData = townResult.status === "fulfilled" ? townResult.value : {};
      const directoryData = directoryResult.status === "fulfilled" ? directoryResult.value : {};
      const townOnlyCandidates = uniqueCandidates([
        ...lookupCandidates,
        ...candidatesFromCommunity(townData),
        ...filterCandidatesByTown(directoryData.candidates || [], lookupPlace),
      ]);
      candidates = filterCandidatesByWard(townOnlyCandidates, selectedWard);
    } else {
      candidates = lookupCandidates;
    }

    meta = data.meta || {};
    resultContext = formatAddress(data.normalizedInput) || data.address || address;
  } else if (town) {
    const [townResult, directoryResult] = await Promise.allSettled([
      getTownCommunity(town, { articleLimit: 1 }),
      getDirectoryCandidates({
        q: name || town,
        county,
        district,
        office: selectedOffice,
        electionYear,
        limit: 500,
      }),
    ]);
    const townData = townResult.status === "fulfilled" ? townResult.value : {};
    const directoryData = directoryResult.status === "fulfilled" ? directoryResult.value : {};
    candidates = uniqueCandidates([
      ...candidatesFromCommunity(townData),
      ...filterCandidatesByTown(directoryData.candidates || [], town),
    ]);
    meta = townData.meta || directoryData.meta || {};
    resultContext = townData.town?.name || townData.community?.name || town;
  } else {
    if (!name && !county && !district && !selectedOffice) {
      const data = await getDirectoryCandidates({
        electionYear,
        limit: INITIAL_CANDIDATE_PREVIEW_LIMIT,
      });
      candidates = data.candidates || [];
      meta = data.meta || {};
    } else {
      const data = await getDirectoryCandidates({
        q: name || town,
        county,
        district,
        office: selectedOffice,
        electionYear,
        limit: 500,
      });
      candidates = data.candidates || [];
      meta = data.meta || {};
    }
  }
} catch (loadError) {
  error = loadError?.message || "Unable to load candidates.";
}

const visibleCandidates = selectedOffice
  ? filterCandidatesByOffice(candidates, selectedOffice)
  : filterLegislativeCandidates(candidates);
candidates = prioritizeLegislativeCandidates(filterCandidatesByName(visibleCandidates, name));
candidates = await enrichCandidatesWithLegislators(candidates);

try {
  nameOptions = await candidateNameOptions();
} catch (optionsError) {
  nameOptions = uniqueOptions(candidates.map(candidateName));
}

try {
  townOptions = await communityTownOptions();
} catch (optionsError) {
  townOptions = town ? [town] : [];
}

const hasFilters = address || county || district || selectedOffice || town || name;
const resultCount = candidates.length;
const addressOfficeGroups = address ? groupCandidatesByOfficeDistrict(candidates) : [];
const addressSeatTotal = totalSeats(addressOfficeGroups);
const civic = lookupData?.civic || {};
const matchedDistricts = lookupData?.matchedDistricts || [];
const normalizedInput = lookupData?.normalizedInput || {};
const place = civic.place?.name || normalizedInput.city || "";
const wardOptions = lookupData?.search?.wardOptions || wardOptionsFor(place);
const isWardedCommunity = wardOptions.length > 0;
const wardNumber = isWardedCommunity
  ? selectedWard || normalizeWardNumber(civic.ward?.number || "")
  : "";
const ward = wardNumber ? `Ward ${wardNumber}` : "";
const matchedHouseDistricts = matchedDistricts
  .filter((district) => district.body === "H")
  .filter((district) => !isWardedCommunity || !selectedWard || representsWard(district, selectedWard));
const regularHouseDistricts = matchedHouseDistricts
  .filter((district) => !isFloterialDistrict(district))
  .map((district) => district.district_label)
  .filter(Boolean);
const floterialHouseDistricts = matchedHouseDistricts
  .filter(isFloterialDistrict)
  .map((district) => district.district_label)
  .filter(Boolean);
const matchedSenateDistricts = matchedDistricts
  .filter((district) => district.body === "S")
  .map((district) => district.district_label || district.district)
  .filter(Boolean);
const addressSenateDistricts = matchedSenateDistricts.length
  ? [...new Set(matchedSenateDistricts)].join(", ")
  : districtSummaryFor(addressOfficeGroups, "senate");
const addressHouseDistricts = regularHouseDistricts.length || floterialHouseDistricts.length
  ? [...regularHouseDistricts, ...floterialHouseDistricts].join(", ")
  : districtSummaryFor(addressOfficeGroups, "house");
const addressCountyName = countyFromMatchedDistricts(matchedDistricts) || cleanDisplay(county);
const divisionSummaryText = address
  ? districtDivisionSummary({
      place,
      ward,
      county: addressCountyName,
    })
  : "";

async function getDirectoryCandidates({
  q = "",
  county = "",
  district = "",
  office = "",
  electionYear = "",
  limit = 100,
} = {}) {
  if (office) {
    return getCandidates({
      q,
      county,
      district,
      office,
      electionYear,
      limit,
    });
  }

  const [houseData, senateData] = await Promise.all([
    getCandidates({
      q,
      county,
      district,
      office: "State Representative",
      electionYear,
      limit,
    }),
    getCandidates({
      q,
      county,
      district,
      office: "State Senate",
      electionYear,
      limit,
    }),
  ]);

  const candidates = uniqueCandidates([
    ...(houseData.candidates || []),
    ...(senateData.candidates || []),
  ]);

  return {
    candidates,
    meta: {
      count: candidates.length,
    },
  };
}

async function getAllLegislativeCandidates({ electionYear = 2026 } = {}) {
  const [houseData, senateData] = await Promise.all([
    getCandidatePages({
      office: "State Representative",
      electionYear,
      limit: 100,
      maxPages: 20,
    }),
    getCandidatePages({
      office: "State Senate",
      electionYear,
      limit: 100,
      maxPages: 20,
    }),
  ]);

  return uniqueCandidates([...houseData, ...senateData]).filter(isLegislativeCandidate);
}

async function getCandidatePages({
  limit = 100,
  maxPages = 20,
  ...query
} = {}) {
  const pageSize = Math.max(1, Math.min(Number(limit) || 100, 100));
  const candidates = [];

  for (let page = 0; page < maxPages; page += 1) {
    const data = await getCandidates({
      ...query,
      limit: pageSize,
      offset: page * pageSize,
    });
    const pageCandidates = data.candidates || [];
    candidates.push(...pageCandidates);
    if (pageCandidates.length === 0) break;
  }

  return candidates;
}

function candidatesFromLookup(data = {}, { ward = "", warded = false } = {}) {
  const candidateGroups = data.groups?.candidates || {};
  const senateCandidates = candidateGroups.senate || [];
  const houseCandidates = warded && ward
    ? (candidateGroups.house || []).filter((candidate) => representsWard(candidate, ward))
    : (candidateGroups.house || []);
  const groupedCandidates = [...senateCandidates, ...houseCandidates];
  const fallbackCandidates = warded && ward
    ? (data.candidates || []).filter((candidate) => {
        if (!isHouseCandidate(candidate)) return true;
        return representsWard(candidate, ward);
      })
    : (data.candidates || []);

  return uniqueCandidates([
    ...fallbackCandidates,
    ...groupedCandidates,
    ...(warded && ward ? [] : findNestedCandidates(candidateGroups)),
  ]);
}

function candidatesFromCommunity(data = {}) {
  const community = data.town || data.community || data;

  return uniqueCandidates([
    ...(data.candidates || []),
    ...(community.candidates || []),
    ...(data.candidateSummary?.candidates || []),
    ...(community.candidateSummary?.candidates || []),
    ...(data.groups?.candidates?.senate || []),
    ...(data.groups?.candidates?.house || []),
    ...findNestedCandidates(data.groups),
    ...findNestedCandidates(community.groups),
  ]);
}

function findNestedCandidates(value) {
  if (!value) return [];

  if (Array.isArray(value)) {
    return value.flatMap((item) =>
      looksLikeCandidate(item) ? [item] : findNestedCandidates(item),
    );
  }

  if (typeof value === "object") {
    return Object.values(value).flatMap(findNestedCandidates);
  }

  return [];
}

function uniqueCandidates(items = []) {
  const seen = new Map();
  const unique = [];

  for (const candidate of items) {
    if (!looksLikeCandidate(candidate)) continue;

    const keys = candidateIdentityKeys(candidate);
    const existingIndex = keys
      .map((key) => seen.get(key))
      .find((index) => index !== undefined);

    if (existingIndex !== undefined) {
      const merged = mergeCandidateRecords(unique[existingIndex], candidate);
      unique[existingIndex] = merged;
      candidateIdentityKeys(merged).forEach((key) => seen.set(key, existingIndex));
      continue;
    }

    const index = unique.length;
    unique.push(candidate);
    keys.forEach((key) => seen.set(key, index));
  }

  return unique;
}

function candidateIdentityKeys(candidate = {}) {
  const keys = new Set();
  const personId = candidate.personId || candidate.person_id;
  const filerEntityNumber = candidate.filerEntityNumber || candidate.filer_entity_number;
  const slug = candidateSlug(candidate);
  const role = [
    candidate.office,
    candidate.county,
    candidate.district,
    candidate.electionYear || candidate.election_year,
  ].map(normalizeSearch).join("|");
  const signature = [
    candidateName(candidate),
    candidate.office,
    candidate.county,
    candidate.district,
    candidate.electionYear || candidate.election_year,
  ].map(normalizeSearch).join("|");

  if (filerEntityNumber) keys.add(`filer:${normalizeSearch(filerEntityNumber)}`);
  if (slug) keys.add(`slug:${slug}`);
  if (personId && role.replace(/\|/g, "")) {
    keys.add(`person-role:${normalizeSearch(personId)}|${role}`);
  }
  if (signature.replace(/\|/g, "")) keys.add(`signature:${signature}`);

  return [...keys];
}

function mergeCandidateRecords(current = {}, incoming = {}) {
  const primary =
    candidateCompletenessScore(incoming) > candidateCompletenessScore(current)
      ? incoming
      : current;
  const secondary = primary === incoming ? current : incoming;
  const merged = { ...secondary, ...primary };

  for (const [key, value] of Object.entries(secondary)) {
    if (!hasCandidateValue(merged[key]) && hasCandidateValue(value)) {
      merged[key] = value;
    }
  }

  return merged;
}

function candidateCompletenessScore(candidate = {}) {
  return [
    candidate.personId || candidate.person_id,
    candidate.filerEntityNumber || candidate.filer_entity_number,
    candidate.legislatorProfileUrl,
    candidate.currentLegislator || candidate.is_current_legislator,
    candidate.candidateWebsite || candidate.website,
    candidate.candidateEmail || candidate.email,
    candidate.photoUrl || candidate.photo_url,
    candidate.nameAliases || candidate.name_aliases,
  ].filter(hasCandidateValue).length;
}

function hasCandidateValue(value) {
  return value !== undefined && value !== null && String(value).trim() !== "";
}

function looksLikeCandidate(value) {
  return !!(
    value &&
    typeof value === "object" &&
    (
      value.slug ||
      value.filerEntityNumber ||
      value.candidateFirstName ||
      value.candidateLastName
    ) &&
    (
      value.office ||
      value.officeType ||
      value.politicalParty ||
      value.electionYear
    )
  );
}

function filterCandidatesByOffice(items = [], selectedOffice = "") {
  const officeFilter = selectedOffice.trim().toLowerCase();
  if (!officeFilter) return items;

  return items.filter((candidate) =>
    String(candidate.office || "")
      .trim()
      .toLowerCase()
      .includes(officeFilter),
  );
}

function filterCandidatesByName(items = [], filter = "") {
  const nameFilter = normalizeSearch(filter);
  if (!nameFilter) return items;

  return items.filter((candidate) => {
    const searchableName = [
      candidateName(candidate),
      candidate.nameAliases,
      candidate.name_aliases,
    ].filter(Boolean).join(" ");
    return normalizeSearch(searchableName).includes(nameFilter);
  });
}

function normalizeSearch(value = "") {
  return String(value || "")
    .replace(/â€™|â€˜/g, "'")
    .replace(/â€œ|â€/g, "\"")
    .replace(/â€“|â€”/g, "-")
    .replace(/Â·/g, " ")
    .replace(/Â/g, "")
    .toLowerCase()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function filterLegislativeCandidates(items = []) {
  return items.filter(isLegislativeCandidate);
}

function isHouseCandidate(candidate = {}) {
  return /representative|house/i.test(`${candidate.office || ""} ${candidate.officeType || ""}`);
}

function prioritizeLegislativeCandidates(items = []) {
  return [...items].sort((a, b) => {
    const priorityDelta = candidateOfficePriority(a.office) - candidateOfficePriority(b.office);
    if (priorityDelta) return priorityDelta;

    return [
      String(a.county || "").localeCompare(String(b.county || "")),
      numericSortValue(a.district) - numericSortValue(b.district),
      String(a.candidateLastName || a.name || "").localeCompare(String(b.candidateLastName || b.name || "")),
      String(a.candidateFirstName || "").localeCompare(String(b.candidateFirstName || "")),
    ].find((value) => value !== 0) || 0;
  });
}

function numericSortValue(value = "") {
  const number = Number(value);
  return Number.isFinite(number) ? number : 999;
}

function groupCandidatesByOfficeDistrict(items = []) {
  const groups = new Map();

  for (const candidate of items) {
    const label = candidateOfficeDistrictLabel(candidate);
    if (!groups.has(label)) {
      groups.set(label, {
        label,
        office: candidate.office || "",
        county: candidate.county || "",
        district: candidate.district || "",
        seats: seatsForCandidateOffice(candidate),
        officeLabel: normalizeOfficeLabel(candidate.office),
        districtLabel: districtDisplay(candidate),
        candidates: [],
      });
    }

    groups.get(label).candidates.push(candidate);
  }

  return [...groups.values()].sort((a, b) => {
    const priorityDelta = candidateOfficePriority(a.office) - candidateOfficePriority(b.office);
    if (priorityDelta) return priorityDelta;

    return [
      String(a.county || "").localeCompare(String(b.county || "")),
      numericSortValue(a.district) - numericSortValue(b.district),
      String(a.label || "").localeCompare(String(b.label || "")),
    ].find((value) => value !== 0) || 0;
  });
}

function seatsForCandidateOffice(candidate = {}) {
  if (/state senate|state senator|senate/i.test(candidate.office || "")) return 1;
  const seats = Number(candidate.seats);
  return Number.isFinite(seats) && seats > 0 ? seats : null;
}

function totalSeats(groups = []) {
  const total = groups.reduce((sum, group) => sum + (Number(group.seats) || 0), 0);
  return total > 0 ? total : 0;
}

function isFloterialDistrict(district = {}) {
  return ["1", "true", "yes", "y"].includes(
    String(district.floterial ?? district.is_floterial_district ?? "").trim().toLowerCase(),
  );
}

function isFloterialOfficeGroup(group = {}, floterialDistricts = []) {
  if (!floterialDistricts.length) return false;
  const groupTokens = [
    group.label,
    group.districtLabel,
    [countyCodeFromName(group.county), group.district].filter(Boolean).join(" "),
  ].map(normalizeDistrictToken);
  const floterialTokens = floterialDistricts.map(normalizeDistrictToken);

  return groupTokens.some((token) => token && floterialTokens.includes(token));
}

function normalizeDistrictToken(value = "") {
  return String(value || "")
    .toLowerCase()
    .replace(/\b(state|house|district|representative|rep|nh)\b/g, " ")
    .replace(/[^a-z0-9]+/g, " ")
    .trim()
    .replace(/\s+/g, " ");
}

function countyCodeFromName(value = "") {
  const countyMap = {
    Belknap: "BEL",
    Carroll: "CAR",
    Cheshire: "CHE",
    Coos: "COO",
    Grafton: "GRA",
    Hillsborough: "HIL",
    Merrimack: "MER",
    Rockingham: "ROC",
    Strafford: "STR",
    Sullivan: "SUL",
  };
  return countyMap[cleanDisplay(value)] || "";
}

function countyNameForCode(code = "") {
  const sourceCountyIds = {
    "01": "Belknap",
    "02": "Carroll",
    "03": "Cheshire",
    "04": "Coos",
    "05": "Grafton",
    "06": "Hillsborough",
    "07": "Merrimack",
    "08": "Rockingham",
    "09": "Strafford",
    "10": "Sullivan",
  };
  const fipsCountyIds = {
    "001": "Belknap",
    "003": "Carroll",
    "005": "Cheshire",
    "007": "Coos",
    "009": "Grafton",
    "011": "Hillsborough",
    "013": "Merrimack",
    "015": "Rockingham",
    "017": "Strafford",
    "019": "Sullivan",
  };
  const value = String(code || "").trim();
  if (!value) return "";
  if (/^\d{3}$/.test(value)) return fipsCountyIds[value] || "";
  return sourceCountyIds[value.padStart(2, "0")] || "";
}

function countyDisplayName(value = "") {
  const display = cleanDisplay(value);
  if (!display || /^\d+$/.test(display)) return "";
  return display;
}

function countyCodeValue(item = {}) {
  return item.countyNumber || item.county_number || item.countyCode || item.county_code || item.county;
}

function countyFromMatchedDistricts(districts = []) {
  const district =
    districts.find((item) =>
      countyDisplayName(item.county || item.countyName || item.county_name) ||
      countyNameForCode(countyCodeValue(item)),
    ) || {};
  return (
    countyDisplayName(district.county || district.countyName || district.county_name) ||
    countyNameForCode(countyCodeValue(district))
  );
}

function districtDivisionSummary({
  place = "",
  ward = "",
  county = "",
} = {}) {
  const parts = [];
  if (ward) parts.push(ward);
  if (place) parts.push(place);
  if (county) parts.push(`${county} County`);

  return parts.length
    ? `Divisions: ${parts.join("; ")}.`
    : "";
}

function districtSummaryFor(groups = [], body = "") {
  const normalizedBody = body.toLowerCase();
  const districts = groups
    .filter((group) => {
      const office = `${group.office || ""} ${group.officeLabel || ""}`.toLowerCase();
      if (normalizedBody === "senate") return /senate/.test(office);
      if (normalizedBody === "house") return /representative|house/.test(office);
      return true;
    })
    .map((group) => cleanDisplay(group.district))
    .filter(Boolean);

  return [...new Set(districts)].join(", ");
}

function candidateOfficeDistrictLabel(candidate = {}) {
  const officeLabel = normalizeOfficeLabel(candidate.office);
  const isSenateOffice = /state senate|state senator/i.test(officeLabel);
  const countyLabel = cleanDisplay(candidate.county);
  const districtLabel = cleanDisplay(candidate.district);

  return [
    officeLabel || "Office",
    isSenateOffice ? "" : countyLabel,
    districtLabel ? `District ${districtLabel}` : "",
  ].filter(Boolean).join(", ");
}

function districtDisplay(candidate = {}) {
  const districtLabel = cleanDisplay(candidate.district);
  if (!districtLabel) return "District not listed";
  const officeLabel = normalizeOfficeLabel(candidate.office);
  if (/state senate|state senator/i.test(officeLabel)) return `District ${districtLabel}`;
  return [cleanDisplay(candidate.county), `District ${districtLabel}`].filter(Boolean).join(", ");
}

function normalizeOfficeLabel(value = "") {
  const office = cleanDisplay(value);
  if (/state senate|state senator/i.test(office)) return "State Senate";
  if (/state representative|representative/i.test(office)) return "State Representative";
  return office;
}

function cleanDisplay(value = "") {
  return String(value || "").trim();
}

function formatAddress(normalized = {}) {
  return [
    normalized.line1,
    normalized.city,
    normalized.state,
    normalized.zip,
  ]
    .filter(Boolean)
    .join(", ");
}

async function candidateNameOptions() {
  const data = await getDirectoryCandidates({ electionYear, limit: 200 });
  return uniqueOptions(
    filterLegislativeCandidates(data.candidates || []).map(candidateName),
  );
}

async function communityTownOptions() {
  const data = await getCommunities({ body: "house", limit: 500, articleLimit: 0 });
  return uniqueOptions(
    (data.communities || []).flatMap((community) =>
      townsFromValue(
        community.townsRepresented ||
          community.towns ||
          community.towns_represented ||
          community.communities_represented ||
          [],
      ),
    ),
  );
}

function uniqueOptions(values = []) {
  return [...new Set(values.map((value) => String(value || "").trim()).filter(Boolean))]
    .sort((a, b) => a.localeCompare(b));
}
