    <title>Candidates | NH Deserves Better</title>
    <meta
      name="description"
      content="Browse New Hampshire State Representative and State Senate candidates by address, county, town, and name."
    />
  </head>

  <body>
    <TopNav />
    <main class="page" x-data={`nhdbFuzzyFilter({ itemSelector: '.candidate-card[data-fuzzy-item]', idleLimit: ${address ? 0 : 12} })`}>
      <section class="candidate-hero">
        <div class="candidate-hero-copy">
          <p class="eyebrow">State House and State Senate Candidates</p>
          <h1>Find My NH Candidate</h1>
          <p class="lede">
            Enter an address to find the State Representative and State Senate
            candidates connected to your community, or use the filters below to
            browse candidates by name, town, county, and office.
          </p>
        </div>

        <form class="address-lookup" action="/candidates" method="get">
          <label for="address">Find State House and State Senate candidates for your address</label>

          <div class="address-row">
            <input
              id="address"
              type="text"
              name="address"
              value={address}
              placeholder="72 Concord St, Manchester, NH"
              autocomplete="street-address"
            />
            <button type="submit">Find Legislative Candidates</button>
          </div>
          <p>Example: 107 North Main Street, Concord, New Hampshire</p>
        </form>
      </section>

      <section class="candidate-filter-panel" aria-label="Candidate filters">
        <FilterBar
          action="/candidates"
          submitLabel="Filter candidates"
          clearHref={hasFilters ? "/candidates" : ""}
          dataResultsForm
          live
        >
          <label>
            <span>Name</span>
            <input
              type="search"
              name="name"
              value={name}
              list="candidateNameOptions"
              placeholder="Start typing a candidate"
              autocomplete="off"
              data-fuzzy-search
            />
            <datalist id="candidateNameOptions">
              {nameOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>County</span>
            <input
              type="search"
              name="county"
              value={county}
              list="candidateCountyOptions"
              placeholder="Start typing a county"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="county"
            />
            <datalist id="candidateCountyOptions">
              {countyOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Office</span>
            <input
              type="search"
              name="office"
              value={selectedOffice || office}
              list="candidateOfficeOptions"
              placeholder="State Representative or State Senate"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="office"
            />
            <datalist id="candidateOfficeOptions">
              {officeOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Town</span>
            <input
              type="search"
              name="town"
              value={town}
              list="candidateTownOptions"
              placeholder="Start typing a town"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="town"
            />
            <datalist id="candidateTownOptions">
              {townOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Sort</span>
            <select name="sort" data-fuzzy-sort>
              <option value="" selected={!sort}>Default</option>
              <option value="name:asc" selected={sort === "name:asc"}>Name A-Z</option>
              <option value="district:asc" selected={sort === "district:asc"}>District</option>
              <option value="updated:desc" selected={sort === "updated:desc"}>Recently updated</option>
              <option value="missing:desc" selected={sort === "missing:desc"}>Missing photo/email/website</option>
            </select>
          </label>
        </FilterBar>
        <div class="filter-chips" data-fuzzy-chips hidden></div>
      </section>

      {error ? (
        <p class="status-message">{error}</p>
      ) : (
        <section class="results" id="candidate-results" data-results-region>
          <div class="results-heading">
            <div>
              <h2><span data-fuzzy-count>{Math.min(resultCount, 12)}</span> House and Senate Candidates Shown</h2>
              {resultContext ? (
                <p>Showing matches for {resultContext}</p>
              ) : hasFilters ? (
                <p>Showing candidates that match the active filters.</p>
              ) : (
                <p>Showing a preview. Use the filters to reveal matching candidate profiles.</p>
              )}
            </div>
            {hasFilters && <a href="/candidates">Clear filters</a>}
          </div>

          {candidates.length ? (
            <>
              {address && addressOfficeGroups.length ? (
                <div class="address-office-results">
                  {isWardedCommunity && (
                    <form class:list={["ward-filter", !wardNumber && "needs-ward"]} action="/candidates" method="get" data-results-form>
                      <input type="hidden" name="address" value={address} />
                      <div class="ward-filter-copy">
                        <label for="ward">Select your ward</label>
                        <p>
                          {wardNumber
                            ? "Confirm or change your ward to narrow State House candidates."
                            : "This city has ward-based districts, but the address lookup did not return a ward. Select your ward so the candidate results are not town-wide."}
                        </p>
                      </div>
                      <div class="ward-filter-controls">
                        <select id="ward" name="ward">
                          <option value="">Use address result</option>
                          {wardOptions.map((option) => (
                            <option value={option} selected={selectedWard === option}>
                              Ward {option}
                            </option>
                          ))}
                        </select>
                        <button type="submit">Apply</button>
                      </div>
                    </form>
                  )}

                  <section class="address-office-summary" aria-label="Offices up for election">
                    <div class="summary-stat">
                      <strong>{addressOfficeGroups.length}</strong>
                      <span>{addressOfficeGroups.length === 1 ? "Office" : "Offices"}</span>
                    </div>
                    <div class="summary-stat">
                      <strong>{addressSeatTotal || "—"}</strong>
                      <span>{addressSeatTotal === 1 ? "Seat" : "Seats"}</span>
                    </div>
                    <div class="summary-stat">
                      <strong>{resultCount}</strong>
                      <span>{resultCount === 1 ? "Candidate" : "Candidates"}</span>
                    </div>
                  </section>

                  <section class="address-district-strip" aria-label="Districts for this address">
                    <div class="district-strip-heading">
                      <p class="eyebrow">Districts for this address</p>
                      <strong>{resultContext || "Address result"}</strong>
                    </div>
                    <div class="district-chip-row">
                      {addressSenateDistricts && (
                        <span class="district-chip senate-chip">
                          <small>State Senate</small>
                          <strong>{addressSenateDistricts}</strong>
                        </span>
                      )}
                      {(regularHouseDistricts.length > 0 || (!floterialHouseDistricts.length && addressHouseDistricts)) && (
                        <span class="district-chip house-chip">
                          <small>State House</small>
                          <strong>{regularHouseDistricts.join(", ") || addressHouseDistricts}</strong>
                        </span>
                      )}
                      {floterialHouseDistricts.length > 0 && (
                        <span class="district-chip floterial-chip">
                          <small>State House</small>
                          <strong>{floterialHouseDistricts.join(", ")}</strong>
                          <em>Floterial</em>
                        </span>
                      )}
                    </div>
                  </section>

                  {divisionSummaryText && (
                    <section class="address-division-summary" aria-label="District division summary">
                      <p>{divisionSummaryText}</p>
                    </section>
                  )}

                  {addressOfficeGroups.map((group) => (
                    <section class="office-result-group" aria-labelledby={`office-group-${group.label.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>
                      <div class="office-result-heading">
                        <div>
                          <p class="eyebrow">Office up for election</p>
                          <div class="group-title-row">
                            <h3 id={`office-group-${group.label.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>{group.officeLabel || group.label}</h3>
                            {isFloterialOfficeGroup(group, floterialHouseDistricts) && (
                              <span class="floterial-tag">Floterial</span>
                            )}
                          </div>
                          <p>{group.districtLabel}</p>
                        </div>
                        <div class="office-metrics" aria-label={`${group.label} summary`}>
                          <span><strong>{group.seats || "—"}</strong> {group.seats === 1 ? "seat" : "seats"}</span>
                          <span><strong>{group.candidates.length}</strong> {group.candidates.length === 1 ? "candidate" : "candidates"}</span>
                        </div>
                      </div>
                      <div class="candidate-grid office-candidate-grid">
                        {group.candidates.map((candidate) => (
                          <CandidateCard candidate={candidate} />
                        ))}
                      </div>
                    </section>
                  ))}
                </div>
              ) : (
                <div class="candidate-grid">
                  {candidates.map((candidate) => (
                    <CandidateCard candidate={candidate} />
                  ))}
                </div>
              )}
              <div class="status-message empty-state" data-fuzzy-empty hidden>
                <strong>No State House or State Senate candidates matched those filters.</strong>
                <ul>
                  <li>Try searching by last name.</li>
                  <li>Remove the county or town chip above.</li>
                  <li>Clear the office filter to include both House and Senate candidates.</li>
                </ul>
              </div>
            </>
          ) : (
            <p class="status-message">No State House or State Senate candidates found.</p>
          )}
        </section>
      )}
    </main>
    <script>
      const resultsRegion = document.querySelector("[data-results-region]");
      const filterForm = document.querySelector("[data-fuzzy-live-form]");
      let filterTimeout = 0;
      let latestRequestId = 0;

      function resultsUrlFor(form) {
        const formData = new FormData(form);
        const params = new URLSearchParams();

        for (const [key, value] of formData.entries()) {
          const text = String(value || "").trim();
          if (text && text.toLowerCase() !== "all") params.set(key, text);
        }

        return `/candidates${params.toString() ? `?${params}` : ""}`;
      }

      async function loadResultsFromForm(form, { push = true, scroll = true } = {}) {
        if (!resultsRegion) return false;

        const submitButton = form.querySelector("button[type='submit']");
        const originalText = submitButton?.textContent || "";
        const url = resultsUrlFor(form);
        const requestId = latestRequestId + 1;
        latestRequestId = requestId;
        if (submitButton && scroll) {
          submitButton.disabled = true;
          submitButton.textContent = "Loading...";
        }

        try {
          const response = await fetch(url, { headers: { "x-requested-with": "fetch" } });
          if (!response.ok) throw new Error("Unable to load results.");

          const html = await response.text();
          const doc = new DOMParser().parseFromString(html, "text/html");
          const nextResults = doc.querySelector("[data-results-region]");
          if (!nextResults) throw new Error("Unable to load results.");
          if (requestId !== latestRequestId) return false;

          resultsRegion.innerHTML = nextResults.innerHTML;
          resultsRegion.closest("[x-data]")?.dispatchEvent(new CustomEvent("nhdb:fuzzy-refresh", { bubbles: true }));

          if (push) {
            window.history.pushState({}, "", url);
          } else {
            window.history.replaceState({}, "", url);
          }
          if (scroll) resultsRegion.scrollIntoView({ behavior: "smooth", block: "start" });
          return true;
        } catch (error) {
          if (scroll) window.location.href = url;
          return false;
        } finally {
          if (submitButton && scroll) {
            submitButton.disabled = false;
            submitButton.textContent = originalText;
          }
        }
      }

      document.addEventListener("submit", async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.matches("[data-results-form]") || !resultsRegion) {
          return;
        }

        event.preventDefault();
        await loadResultsFromForm(form, { push: true, scroll: true });
      });

      filterForm?.addEventListener("input", () => {
        window.clearTimeout(filterTimeout);
        filterTimeout = window.setTimeout(() => {
          loadResultsFromForm(filterForm, { push: false, scroll: false });
        }, 260);
      });

      filterForm?.addEventListener("change", () => {
        window.clearTimeout(filterTimeout);
        filterTimeout = window.setTimeout(() => {
          loadResultsFromForm(filterForm, { push: false, scroll: false });
        }, 120);
      });
    </script>
    <SiteFooter />
  </body>
</html>

