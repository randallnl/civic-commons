---
export const prerender = false;

import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ArticleList from "../../components/ArticleList.astro";
import CommunityUpdates from "../../components/CommunityUpdates.astro";
import FilterBar from "../../components/FilterBar.astro";
import profileIcon from "../../assets/profile icon.png";
import {
  ExternalLink,
  Globe,
  Mail,
  UserRoundCheck,
} from "@lucide/astro";
import { getArticles } from "../../lib/articlesApi";
import { currentAdminSession } from "../../lib/adminAuth";
import { getBillSummaries } from "../../lib/billsApi";
import { representativePersonIdForCandidate } from "../../lib/candidateLegislatorLinks";
import {
  candidateName,
  candidateSlug,
  formatCandidateParty,
  getCandidate,
  partyClassName,
} from "../../lib/candidatesApi";
import { enrichCandidateWithLegislator } from "../../lib/candidateLegislators";
import { isFreeStater, isTpActionAligned } from "../../lib/civicTags";
import { profilePhotoUrl } from "../../lib/photos";
import { getRepresentative, getRepresentatives, repName } from "../../lib/repsApi";
import {
  endorsementsForCandidate,
  getOrganizations,
  organizationPath,
} from "../../lib/organizationsApi";
import { representativeGradeFor } from "../../lib/trackedBills";

const { slug } = Astro.params;

let apiData = null;
let organizations = [];
let legislatorOptions = [];
let linkedRepresentativePersonId = "";
let currentLegislator = null;
let currentLegislatorGrade = null;
const adminSession = await currentAdminSession(Astro.request);
const message = Astro.url.searchParams.get("message") || "";
const error = Astro.url.searchParams.get("error") || "";

try {
  apiData = await getCandidate(slug);
} catch (error) {
  console.error(error?.message || "Unable to load candidate profile.");
}

let candidate = apiData?.candidate || apiData;

if (!candidate?.filerEntityNumber && !candidate?.name) {
  return Astro.redirect("/404");
}

candidate = await enrichCandidateWithLegislator(candidate);

if (!adminSession && candidate.currentLegislator && candidate.legislatorProfileUrl) {
  return Astro.redirect(candidate.legislatorProfileUrl, 302);
}

if (!adminSession) {
  return Astro.redirect(`/people/${candidateSlug(candidate)}`, 302);
}

if (candidate.currentLegislator && candidate.legislatorPersonId) {
  try {
    const [representativeData, billSummaries] = await Promise.all([
      getRepresentative(candidate.legislatorPersonId, { voteLimit: 200 }),
      getBillSummaries(),
    ]);
    const representative =
      representativeData.representative ||
      representativeData.rep ||
      representativeData.person ||
      representativeData;
    currentLegislator = {
      ...representative,
      voteHistory: representativeData.voteHistory || representative.voteHistory || [],
    };
    currentLegislatorGrade = representativeGradeFor(currentLegislator, new Map(), billSummaries);
  } catch (error) {
    console.error(error?.message || "Unable to load current legislator grade.");
  }
}

const name = candidateName(candidate);
const candidateEntityKey = candidate.filerEntityNumber || slug;
const portraitUrl = profilePhotoUrl(candidate.photoUrl) || profilePhotoUrl(candidate.legislatorPhotoUrl);
const officeTypeLabel =
  String(candidate.officeType || "").trim().toLowerCase() === "general court"
    ? ""
    : candidate.officeType;
const officeParts = [
  candidate.office,
  candidate.county,
  candidate.district ? `District ${candidate.district}` : "",
].filter(Boolean);
const townsRepresented = candidateTownsRepresented(candidate, currentLegislator);
const candidateRoles = uniqueCandidateRoles(candidate.candidateRoles?.length ? candidate.candidateRoles : [candidate]);
const hasFreeStaterTag = isFreeStater(candidate) || isFreeStater(currentLegislator);
const hasTpActionTag = isTpActionAligned(candidate) || isTpActionAligned(currentLegislator);
const recentlyViewedProfile = {
  kind: "candidate",
  name,
  href: `/candidates/${candidateSlug(candidate)}`,
  photoUrl: portraitUrl || "",
  party: formatCandidateParty(candidate.politicalParty),
  officeLine: officeParts.join(", ") || "Office not listed",
  towns: townsRepresented,
  grade: currentLegislatorGrade?.letter || "",
  tags: [
    hasFreeStaterTag ? "Free State Aligned" : "",
    hasTpActionTag ? "TPAction Aligned" : "",
    candidate.currentLegislator ? "Current Legislator" : "",
  ].filter(Boolean),
};

function externalProfileUrl(entity = {}, names = []) {
  return names
    .map((name) => entity[name])
    .find((value) => typeof value === "string" && value.trim());
}

function ballotpediaUrlForName(value = "") {
  const slug = String(value)
    .trim()
    .replace(/\s+/g, "_")
    .replace(/[^A-Za-z0-9_().-]/g, "");
  return slug ? `https://ballotpedia.org/${slug}` : "";
}

function socialField(entity = {}, platform = "") {
  const camel = `${platform}Url`;
  const snake = `${platform}_url`;
  return entity?.[camel] || entity?.[snake] || "";
}

function socialProfileUrl(value = "", platform = "") {
  const cleaned = String(value || "").trim();
  if (!cleaned) return "";
  if (/^https?:\/\//i.test(cleaned)) return cleaned;

  const handle = cleaned.replace(/^@+/, "").replace(/^\/+/, "");
  if (platform === "substack") {
    if (handle.includes(".")) return `https://${handle}`;
    return `https://${handle}.substack.com`;
  }

  const bases = {
    instagram: "https://www.instagram.com/",
    facebook: "https://www.facebook.com/",
    tiktok: "https://www.tiktok.com/@",
  };
  return bases[platform] ? `${bases[platform]}${handle}` : cleaned;
}

const sourceLinks = [
  candidate.candidateWebsite && {
    href: candidate.candidateWebsite,
    label: "Campaign Website",
    icon: Globe,
  },
  candidate.candidateEmail && {
    href: `mailto:${candidate.candidateEmail}`,
    label: "Email Campaign",
    icon: Mail,
  },
  candidate.legislatorProfileUrl && {
    href: candidate.legislatorProfileUrl,
    label: "Legislator Profile",
    icon: UserRoundCheck,
    primary: true,
  },
  {
    href: "https://cfs.sos.nh.gov/public/cf/reports",
    label: "Search candidate finance filings",
    icon: ExternalLink,
  },
  {
    href:
      externalProfileUrl(candidate, ["ballotpediaUrl", "ballotpedia_url"]) ||
      ballotpediaUrlForName(name),
    label: "Ballotpedia",
    icon: ExternalLink,
  },
  externalProfileUrl(candidate, ["citizensCountUrl", "citizens_count_url", "citizenscount_url"]) && {
    href: externalProfileUrl(candidate, ["citizensCountUrl", "citizens_count_url", "citizenscount_url"]),
    label: "Citizens Count",
    icon: ExternalLink,
  },
  socialField(candidate, "substack") && {
    href: socialProfileUrl(socialField(candidate, "substack"), "substack"),
    label: "Substack",
    icon: ExternalLink,
  },
  socialField(candidate, "instagram") && {
    href: socialProfileUrl(socialField(candidate, "instagram"), "instagram"),
    label: "Instagram",
    icon: ExternalLink,
  },
  socialField(candidate, "facebook") && {
    href: socialProfileUrl(socialField(candidate, "facebook"), "facebook"),
    label: "Facebook",
    icon: ExternalLink,
  },
  socialField(candidate, "tiktok") && {
    href: socialProfileUrl(socialField(candidate, "tiktok"), "tiktok"),
    label: "TikTok",
    icon: ExternalLink,
  },
].filter(Boolean);
const linkedLegislatorProfile = sourceLinks.find((link) => link.primary);
const candidateResourceLinks = sourceLinks.filter((link) => !link.primary);

if (adminSession) {
  try {
    const [repData, explicitPersonId] = await Promise.all([
      getRepresentatives({ limit: 700 }),
      representativePersonIdForCandidate(candidate.filerEntityNumber),
    ]);
    legislatorOptions = repData.representatives || [];
    linkedRepresentativePersonId =
      explicitPersonId ||
      candidate.legislatorPersonId ||
      "";
  } catch (error) {
    console.error(error?.message || "Unable to load legislator link options.");
  }
}

try {
  organizations = await getOrganizations();
} catch (error) {
  console.error(error?.message || "Unable to load organization endorsements.");
}

const endorsements = endorsementsForCandidate(organizations, candidate, slug);
let relatedArticles = [];

try {
  const articleRequests = [
    getArticles({
      candidate: candidate.filerEntityNumber || candidate.filer_entity_number || name,
      include: "relations",
      limit: 6,
    }),
  ];

  if (candidate.legislatorPersonId) {
    articleRequests.push(
      getArticles({
        personid: candidate.legislatorPersonId,
        include: "relations",
        limit: 6,
      }),
    );
  }

  const articleResults = await Promise.allSettled(articleRequests);
  relatedArticles = uniqueArticles(
    articleResults
      .filter((result) => result.status === "fulfilled")
      .flatMap((result) => result.value.articles || []),
  ).slice(0, 6);
} catch (error) {
  console.error(error?.message || "Unable to load candidate articles.");
}

function formatCurrency(value) {
  const amount = Number(value || 0);
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(amount);
}

function endorsementMediaUrl(endorsement = {}) {
  return endorsement.photoUrl || endorsement.organization?.logoUrl || "";
}

function endorsementPillClass(endorsement = {}) {
  const text = [
    endorsement.position,
    endorsement.organization?.name,
    endorsement.organization,
    endorsement.statement,
  ].filter(Boolean).join(" ").toLowerCase();

  if (
    text.includes("tpaction") ||
    text.includes("tp action") ||
    text.includes("turning point action") ||
    text.includes("free state")
  ) {
    return "warning";
  }

  return "endorse";
}

function formatDate(value) {
  if (!value) return "";

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
}

function legislatorOptionLabel(rep = {}) {
  return [
    repName(rep),
    rep.chamber || rep.legislativebody,
    rep.district || rep.raw_district,
    rep.party,
  ].filter(Boolean).join(" - ");
}

function uniqueCandidateRoles(roles = []) {
  const seen = new Set();

  return roles.filter((role) => {
    const key = [
      role.filerEntityNumber,
      role.office,
      role.county,
      role.district,
      role.electionYear,
    ]
      .filter(Boolean)
      .join("|");
    if (!key || seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

function roleOfficeLine(role = {}) {
  return [
    role.office,
    role.county,
    role.district ? `District ${role.district}` : "",
  ].filter(Boolean).join(", ");
}

function roleTownsLine(role = {}) {
  return candidateTownsRepresented(role, currentLegislator) || townsRepresented;
}

function candidateTownsRepresented(candidate = {}, legislator = null) {
  const towns = [
    candidate.townsRepresented,
    candidate.towns_represented,
    candidate.communitiesRepresented,
    candidate.communities_represented,
    candidate.towns,
    candidate.locationText,
    candidate.location_text,
    candidate.legislatorTownsRepresented,
    candidate.legislatorLocationText,
    candidate.legislator?.towns_represented,
    candidate.legislator?.location_text,
    legislator?.towns_represented,
    legislator?.townsRepresented,
    legislator?.location_text,
    legislator?.locationText,
  ].flatMap(townsFromValue);

  return uniqueTowns(towns).join(", ");
}

function townsFromValue(value = "") {
  if (Array.isArray(value)) {
    return value.flatMap((item) => {
      if (typeof item === "object" && item !== null) {
        return item.town || item.name || item.label || "";
      }
      return item;
    }).flatMap(townsFromValue);
  }

  if (typeof value === "object" && value !== null) {
    return townsFromValue(value.town || value.name || value.label || "");
  }

  const text = String(value || "").trim();
  const delimiter = /ward/i.test(text) ? /;|\||\s+and\s+/i : /[,;|]|\s+and\s+/i;

  return text
    .split(delimiter)
    .map((town) => town.trim())
    .filter(Boolean);
}

function uniqueTowns(towns = []) {
  const seen = new Set();
  const unique = [];

  for (const town of towns) {
    const label = String(town || "").trim();
    const key = label.toLowerCase();
    if (!label || seen.has(key)) continue;
    seen.add(key);
    unique.push(label);
  }

  return unique;
}

function uniqueArticles(articles = []) {
  const seen = new Set();
  return articles.filter((article) => {
    const key = article.article_id || article.articleId || article.url || article.title;
    if (!key || seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/NH%20DB%20Logo.svg" />
    <link rel="apple-touch-icon" href="/NH%20DB%20Logo.svg" />
    <title>{name} | NH Deserves Better</title>
    <meta
      name="description"
      content={`Candidate profile and campaign finance summary for ${name}.`}
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <a class="back" href="/candidates">Back to candidates</a>

      {error && <p class="status-message error">{error}</p>}
      {message && <p class="status-message success">{message}</p>}

      <section class="profile-hero">
        <div class="portrait-card">
          {portraitUrl ? (
            <img src={portraitUrl} alt={name} />
          ) : (
            <img class="portrait-fallback" src={profileIcon.src} alt="" />
          )}
        </div>

        <div class="hero-copy">
          <p class="eyebrow">Candidate Profile</p>
          <h1>{name}</h1>

          {currentLegislatorGrade && (
            <div class="profile-grade-row">
              <a
                class:list={["legislator-grade-pill", currentLegislatorGrade.className]}
                href="/vote-grades"
                title="How do we determine this?"
                aria-label={`How do we determine this? ${currentLegislatorGrade.label}`}
              >
                <strong>{currentLegislatorGrade.letter}</strong>
                <span>Legislator Grade</span>
              </a>
              <p>{currentLegislatorGrade.label}</p>
            </div>
          )}

          <div class="hero-meta">
            <span class:list={["meta-pill", partyClassName(candidate.politicalParty)]}>
              {formatCandidateParty(candidate.politicalParty)}
            </span>
            {hasFreeStaterTag && (
              <a
                class="meta-pill free-stater-pill"
                href="/free-staters"
                title="What is a Free Stater?"
                aria-label="What is a Free Stater?"
              >
                Free State Aligned
              </a>
            )}
            {hasTpActionTag && (
              <span class="meta-pill tpaction-pill">TPAction Aligned</span>
            )}
            {candidate.currentLegislator && <span class="meta-pill">Current Legislator</span>}
          </div>

          {linkedLegislatorProfile && (
            <a class="linked-profile-action" href={linkedLegislatorProfile.href}>
              <span class="link-icon" aria-hidden="true">
                <UserRoundCheck size={19} stroke-width={2.4} />
              </span>
              <span>{linkedLegislatorProfile.label}</span>
            </a>
          )}
        </div>
      </section>

      <section class="panel profile-details-panel">
        <p class="eyebrow">Details</p>
        <div class="role-list">
          <article class="role-card">
            <div>
              <span>Office</span>
              <strong>{officeParts.join(", ") || "Office not listed"}</strong>
            </div>
            {officeTypeLabel && (
              <div>
                <span>Office Type</span>
                <strong>{officeTypeLabel}</strong>
              </div>
            )}
            <div>
              <span>Party</span>
              <strong>{candidate.politicalParty || "Not listed"}</strong>
            </div>
            <div>
              <span>Election Year</span>
              <strong>{candidate.electionYear || "Not listed"}</strong>
            </div>
            {townsRepresented && (
              <div class="role-towns">
                <span>Towns represented</span>
                <strong>{townsRepresented}</strong>
              </div>
            )}
          </article>
        </div>
      </section>

      {candidateResourceLinks.length > 0 && (
        <nav class="resource-link-bar" aria-label="Candidate links">
          {candidateResourceLinks.map((link) => {
            const Icon = link.icon || ExternalLink;

            return (
              <a href={link.href}>
                <span class="link-icon" aria-hidden="true">
                  <Icon size={17} stroke-width={2.3} />
                </span>
                <span>{link.label}</span>
              </a>
            );
          })}
        </nav>
      )}

      <section class="panel">
        <p class="eyebrow">Ballot Roles</p>
        <div class="role-list">
          {candidateRoles.map((role) => {
            const roleTowns = roleTownsLine(role);

            return (
              <article class="role-card">
                <div>
                  <span>Office</span>
                  <strong>{roleOfficeLine(role) || "Not listed"}</strong>
                </div>
                <div>
                  <span>Party</span>
                  <strong>{role.politicalParty || candidate.politicalParty || "Not listed"}</strong>
                </div>
                <div>
                  <span>Election Year</span>
                  <strong>{role.electionYear || candidate.electionYear || "Not listed"}</strong>
                </div>
                {roleTowns && (
                  <div class="role-towns">
                    <span>Towns represented</span>
                    <strong>{roleTowns}</strong>
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </section>

      <section class="content-grid">
        <div class="stack">
          <CommunityUpdates
            entityType="candidate"
            entityKey={candidateEntityKey}
            entityName={name}
            pageUrl={Astro.url.pathname}
          />
        </div>

        <aside class="stack">
          <section
            class="panel compact-panel endorsements-panel"
            x-data="nhdbFuzzyFilter({ itemSelector: '.endorsement-card[data-fuzzy-item]', syncUrl: false })"
          >
            <div class="section-heading">
              <div>
                <p class="eyebrow">Endorsements</p>
                <h2>
                  Organizational Endorsements
                  {endorsements.length > 0 && (
                    <span class="inline-count">(<span data-fuzzy-count>{endorsements.length}</span>)</span>
                  )}
                </h2>
              </div>
              <a class="section-action" href={`/endorsements/submit?candidate=${encodeURIComponent(candidateSlug(candidate))}`}>
                Submit
              </a>
            </div>

            {endorsements.length ? (
              <>
                <FilterBar submitLabel="Apply" columns="dense" live={true}>
                  <label>
                    Search
                    <input name="q" type="search" placeholder="Organization or note" data-fuzzy-search />
                  </label>
                  <label>
                    Position
                    <select name="position" data-fuzzy-filter-field data-fuzzy-field="position">
                      <option value="">All positions</option>
                      <option value="Endorsed">Endorsed</option>
                      <option value="Recommended">Recommended</option>
                      <option value="Supported">Supported</option>
                      <option value="Opposed">Opposed</option>
                    </select>
                  </label>
                  <label>
                    Sort
                    <select name="sort" data-fuzzy-sort>
                      <option value="name">Organization A-Z</option>
                      <option value="updated:desc">Newest first</option>
                      <option value="position">Position</option>
                    </select>
                  </label>
                </FilterBar>

                <div class="filter-chips" data-fuzzy-chips hidden></div>

                <div class="endorsement-list">
                {endorsements.map((endorsement) => (
                  <article
                    class="endorsement-card"
                    data-fuzzy-item
                    data-fuzzy-name={endorsement.organization.name}
                    data-fuzzy-position={endorsement.position || ""}
                    data-fuzzy-sort-name={endorsement.organization.name}
                    data-fuzzy-sort-position={endorsement.position || ""}
                    data-fuzzy-sort-updated={Date.parse(endorsement.date || endorsement.createdAt || "") || 0}
                    data-fuzzy-text={[
                      endorsement.organization.name,
                      endorsement.position,
                      endorsement.statement,
                      endorsement.office,
                      endorsement.district,
                      endorsement.electionYear,
                      endorsement.date,
                    ].filter(Boolean).join(" ")}
                  >
                    <div class="endorsement-card-main">
                      <a class="endorsement-media" href={organizationPath(endorsement.organization)}>
                        {endorsementMediaUrl(endorsement) ? (
                          <img src={endorsementMediaUrl(endorsement)} alt="" loading="lazy" />
                        ) : (
                          <span>{endorsement.organization.name.slice(0, 1)}</span>
                        )}
                      </a>
                      <div>
                        <div class="endorsement-topline">
                          <strong>
                            <a href={organizationPath(endorsement.organization)}>
                              {endorsement.organization.name}
                            </a>
                          </strong>
                          {endorsement.position && (
                            <span class:list={[endorsementPillClass(endorsement)]}>
                              {endorsement.position}
                            </span>
                          )}
                        </div>

                        {endorsement.statement && <p class="endorsement-preview">{endorsement.statement}</p>}

                        <div class="endorsement-meta">
                          {endorsement.office && <span>{endorsement.office}</span>}
                          {endorsement.district && <span>{endorsement.district}</span>}
                          {endorsement.electionYear && <span>{endorsement.electionYear}</span>}
                          {endorsement.date && <span>{formatDate(endorsement.date)}</span>}
                        </div>
                      </div>
                    </div>
                  </article>
                ))}
                </div>

                <div class="status-message empty-state" data-fuzzy-empty hidden>
                  <strong>No endorsements match those filters.</strong>
                  <span>Try searching by organization name, position, or note.</span>
                </div>
              </>
            ) : (
              <p class="empty">No organizational endorsements have been published yet.</p>
            )}
          </section>

          <section class="panel compact-panel articles-panel">
            <div class="section-heading">
              <p class="eyebrow">Articles</p>
              <h2>Related Coverage</h2>
            </div>

            <ArticleList articles={relatedArticles} compact={true} emptyText="No related articles returned yet." />
          </section>
        </aside>
      </section>

      {adminSession && (
        <section class="panel admin-edit-panel">
          <div class="section-heading">
            <p class="eyebrow">Admin</p>
            <h2>Edit Candidate Profile</h2>
            <p>
              These edits update the source candidate row in D1. Refresh after
              saving to see the API-backed profile data.
            </p>
          </div>

          <form
            class="admin-edit-form"
            action="/api/admin/profile"
            method="post"
            hx-post="/api/admin/profile"
            hx-target="find .admin-inline-status"
            hx-swap="innerHTML"
          >
            <input type="hidden" name="entityType" value="candidate" />
            <input type="hidden" name="entityKey" value={candidate.filerEntityNumber || slug} />
            <input type="hidden" name="redirectTo" value={Astro.url.pathname} />
            <input type="hidden" name="clearFields" value="linkedRepresentativePersonId" />
            <input type="hidden" name="clearFields" value="substackUrl" />
            <input type="hidden" name="clearFields" value="instagramUrl" />
            <input type="hidden" name="clearFields" value="facebookUrl" />
            <input type="hidden" name="clearFields" value="tiktokUrl" />

            <label>
              Name
              <input name="name" value={candidate.name || name} />
            </label>

            <label>
              Name Aliases
              <textarea name="nameAliases" rows="3" placeholder="Sly, Sly Karasinski">{candidate.nameAliases || candidate.name_aliases || ""}</textarea>
              <small class="field-help">
                Add alternate names separated by commas or new lines. These are
                used for search, tagging, and mention matching.
              </small>
            </label>

            <div class="form-grid">
              <label>
                First Name
                <input name="candidateFirstName" value={candidate.candidateFirstName || ""} />
              </label>
              <label>
                Last Name
                <input name="candidateLastName" value={candidate.candidateLastName || ""} />
              </label>
            </div>

            <div class="form-grid">
              <label>
                Party
                <input name="politicalParty" value={candidate.politicalParty || ""} />
              </label>
              <label>
                Free State Aligned
                <select name="is_free_stater">
                  <option value="">No override</option>
                  <option value="true" selected={candidate.is_free_stater === true}>Yes</option>
                  <option value="false" selected={candidate.is_free_stater === false}>No</option>
                </select>
              </label>
            </div>

            <label>
              Linked Legislator
              <input
                name="linkedRepresentativePersonId"
                list="legislator-link-options"
                value={linkedRepresentativePersonId}
                placeholder="Start typing a legislator name, then select their personid"
              />
              <small class="field-help">
                Saves an explicit candidate-to-legislator link. Use the numeric
                personid shown by the autocomplete option.
              </small>
            </label>
            <datalist id="legislator-link-options">
              {legislatorOptions.map((rep) => (
                <option
                  value={rep.personid || rep.id}
                  label={legislatorOptionLabel(rep)}
                />
              ))}
            </datalist>

            <div class="form-grid">
              <label>
                Office Type
                <input name="officeType" value={candidate.officeType || ""} />
              </label>
              <label>
                Office
                <input name="office" value={candidate.office || ""} />
              </label>
            </div>

            <div class="form-grid">
              <label>
                County
                <input name="county" value={candidate.county || ""} />
              </label>
              <label>
                District
                <input name="district" value={candidate.district || ""} />
              </label>
            </div>

            <div class="form-grid">
              <label>
                Email
                <input name="candidateEmail" type="email" value={candidate.candidateEmail || ""} />
              </label>
              <label>
                Website
                <input name="candidateWebsite" type="url" value={candidate.candidateWebsite || ""} />
              </label>
            </div>

            <label>
              Photo URL
              <input name="photoUrl" type="url" value={candidate.photoUrl || ""} />
            </label>

            <div class="form-grid">
              <label>
                Substack
                <input name="substackUrl" value={socialField(candidate, "substack")} placeholder="https://example.substack.com or handle" />
              </label>
              <label>
                Instagram
                <input name="instagramUrl" value={socialField(candidate, "instagram")} placeholder="https://instagram.com/name or @handle" />
              </label>
            </div>

            <div class="form-grid">
              <label>
                Facebook
                <input name="facebookUrl" value={socialField(candidate, "facebook")} placeholder="https://facebook.com/name" />
              </label>
              <label>
                TikTok
                <input name="tiktokUrl" value={socialField(candidate, "tiktok")} placeholder="https://tiktok.com/@handle or @handle" />
              </label>
            </div>
            <input
              type="hidden"
              name="reviewNote"
              value="Reviewed candidate profile for missing photo, website, or email; no update found."
            />

            <div class="form-grid">
              <label>
                Election Year
                <input name="electionYear" inputmode="numeric" value={candidate.electionYear || ""} />
              </label>
              <label>
                Election Cycle
                <input name="electionCycle" value={candidate.electionCycle || ""} />
              </label>
            </div>

            <div class="form-grid">
              <label>
                Total Raised
                <input name="totalRaised" inputmode="decimal" value={candidate.totalRaised ?? ""} />
              </label>
              <label>
                Total Spent
                <input name="totalSpent" inputmode="decimal" value={candidate.totalSpent ?? ""} />
              </label>
            </div>

            <div class="admin-form-actions">
              <button type="submit">Save Candidate Edits</button>
              <button
                class="secondary-button"
                type="submit"
                name="profileAction"
                value="confirm-reviewed"
              >
                Confirm reviewed, no update found
              </button>
              <span class="admin-inline-status" aria-live="polite"></span>
            </div>
          </form>

          <form
            class="admin-edit-form admin-upload-form"
            action="/api/admin/upload"
            method="post"
            enctype="multipart/form-data"
          >
            <input type="hidden" name="entityType" value="candidate" />
            <input type="hidden" name="entityKey" value={candidate.filerEntityNumber || slug} />
            <input type="hidden" name="redirectTo" value={Astro.url.pathname} />

            <div class="section-heading compact-heading">
              <p class="eyebrow">Photo Upload</p>
              <h2>Upload and update candidate photo</h2>
            </div>

            <label>
              R2 key
              <input
                name="key"
                value={`candidates/${candidate.filerEntityNumber || slug}-${slug}.jpg`}
              />
            </label>

            <label>
              Image file
              <input name="file" type="file" accept="image/*" required />
            </label>

            <button type="submit">Upload Candidate Photo</button>
          </form>

          <form class="admin-edit-form admin-remove-form" action="/api/admin/remove" method="post">
            <input type="hidden" name="entityType" value="candidate" />
            <input type="hidden" name="entityKey" value={candidate.filerEntityNumber || slug} />
            <input type="hidden" name="redirectTo" value={Astro.url.pathname} />

            <div class="section-heading compact-heading">
              <p class="eyebrow">Remove</p>
              <h2>Remove candidate from public results</h2>
              <p>This deletes the candidate row from the source D1 table.</p>
            </div>

            <label class="confirm-remove">
              <input name="confirmRemove" type="checkbox" value="yes" required />
              I understand this will remove this candidate from the site.
            </label>

            <button class="danger-button" type="submit">Remove Candidate</button>
          </form>
        </section>
      )}

    </main>
    <script define:vars={{ recentlyViewedProfile }}>
      const storageKey = "nhdb:recently-viewed-profiles";
      const maxItems = 6;

      try {
        const existing = JSON.parse(localStorage.getItem(storageKey) || "[]");
        const nextProfile = {
          ...recentlyViewedProfile,
          viewedAt: new Date().toISOString(),
        };
        const profiles = [
          nextProfile,
          ...existing.filter((item) => item?.href !== nextProfile.href),
        ].slice(0, maxItems);
        localStorage.setItem(storageKey, JSON.stringify(profiles));
      } catch {
        // Recently viewed profiles are a convenience; ignore storage failures.
      }
    </script>
    <SiteFooter />
  </body>
</html>

