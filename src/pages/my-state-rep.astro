---
export const prerender = false;

import CandidateCard from "../components/CandidateCard.astro";
import FilterBar from "../components/FilterBar.astro";
import RepresentativeCard from "../components/RepresentativeCard.astro";
import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { env } from "cloudflare:workers";
import { getBillDetail, getBillSummaries } from "../lib/billsApi";
import { enrichCandidatesWithLegislators } from "../lib/candidateLegislators";
import { civicApiBase, civicApiFetch } from "../lib/civicApi";
import { getRepresentative, getRepresentatives, repName } from "../lib/repsApi";
import { cleanText } from "../lib/text";
import {
  normalizeBillCode,
  getTrackedBills,
  isExcludedAlignmentMotion,
} from "../lib/trackedBills";

const API_BASE = civicApiBase();
const INITIAL_REP_PREVIEW_LIMIT = 36;
const FILTERED_REP_LIMIT = 160;
const REP_OPTION_LIMIT = 240;
const WARD_COMMUNITY_COUNTS = new Map([
  ["berlin", 4],
  ["claremont", 3],
  ["concord", 10],
  ["dover", 6],
  ["franklin", 3],
  ["keene", 5],
  ["laconia", 6],
  ["lebanon", 3],
  ["manchester", 12],
  ["nashua", 9],
  ["portsmouth", 5],
  ["rochester", 6],
  ["somersworth", 5],
]);

const address = Astro.url.searchParams.get("address")?.trim() || "";
const isEmbed = ["1", "true", "yes"].includes(
  String(Astro.url.searchParams.get("embed") || "").trim().toLowerCase(),
);
const embedPartnerKey = Astro.url.searchParams.get("partner")?.trim().toLowerCase() || "";
const embedOpenRep = Astro.url.searchParams.get("open")?.trim() || "";
const selectedWard = normalizeWardNumber(Astro.url.searchParams.get("ward") || "");
const filters = {
  body: Astro.url.searchParams.get("body")?.trim() || "",
  name: Astro.url.searchParams.get("name")?.trim() || "",
  town: Astro.url.searchParams.get("town")?.trim() || "",
  county: Astro.url.searchParams.get("county")?.trim() || "",
};
const sort = Astro.url.searchParams.get("sort")?.trim() || "";
const normalizedBodyFilter = normalizeBodyFilter(filters.body);
const hasDirectoryFilters = Object.values(filters).some(Boolean);
const countyOptions = [
  "Belknap",
  "Carroll",
  "Cheshire",
  "Coos",
  "Grafton",
  "Hillsborough",
  "Merrimack",
  "Rockingham",
  "Strafford",
  "Sullivan",
];

let lookupData = null;
let lookupError = "";
let directoryReps = [];
let nameOptions = [];
let townOptions = [];
let allCurrentReps = [];
let trackedBills = new Map();
let billSummaries = new Map();
let directoryError = "";
let embedTrackerUrl = "";
let embedTrackerError = "";
let embedFeatures = {
  testimonyAlignment: false,
  freeStateAligned: false,
  tpactionAligned: false,
  publicTestimony: false,
};
let embedTheme = {
  accentColor: "#1d4ed8",
  accentSoftColor: "#e0e7ff",
  alignmentLabel: "Tracker aligned",
  voteIntro: "What this vote means",
};

if (isEmbed) {
  if (!embedPartnerKey) {
    embedTrackerError = "This embedded tool needs a partner identifier.";
  } else {
    try {
      const partner = await env.d1_db.prepare(`
        SELECT
          tracker_url,
          show_testimony_alignment,
          show_free_state_aligned,
          show_tpaction_aligned,
          show_public_testimony,
          embed_accent_color,
          embed_accent_soft_color,
          embed_alignment_label,
          embed_vote_intro
        FROM partner_trackers
        WHERE lower(partner_key) = ? AND is_active = 1
        LIMIT 1
      `).bind(embedPartnerKey).first();
      embedTrackerUrl = String(partner?.tracker_url || "").trim();
      embedFeatures = {
        testimonyAlignment: Number(partner?.show_testimony_alignment) === 1,
        freeStateAligned: Number(partner?.show_free_state_aligned) === 1,
        tpactionAligned: Number(partner?.show_tpaction_aligned) === 1,
        publicTestimony: Number(partner?.show_public_testimony) === 1,
      };
      embedTheme = {
        accentColor: validThemeColor(partner?.embed_accent_color, embedTheme.accentColor),
        accentSoftColor: validThemeColor(partner?.embed_accent_soft_color, embedTheme.accentSoftColor),
        alignmentLabel: cleanText(partner?.embed_alignment_label || embedTheme.alignmentLabel),
        voteIntro: cleanText(partner?.embed_vote_intro || embedTheme.voteIntro),
      };
      if (!embedTrackerUrl) embedTrackerError = "This partner does not have an active bill tracker.";
    } catch (error) {
      console.error(error?.message || "Unable to load partner tracker.");
      embedTrackerError = "Unable to load this partner's bill tracker.";
    }
  }
}

if (address) {
  try {
    const response = await civicApiFetch(`${API_BASE}/reps/lookup`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ address }),
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || "Something went wrong.");
    }

    lookupData = data;
  } catch (error) {
    lookupError =
      error?.message || "Unable to look up representatives.";
  }
}

try {
  const repOptionData = await getRepresentatives({ limit: REP_OPTION_LIMIT });
  const optionReps = repOptionData.representatives || [];
  allCurrentReps = optionReps;
  nameOptions = uniqueOptions(optionReps.map(repName));
  townOptions = uniqueOptions(optionReps.flatMap(townsForOption));
} catch (error) {
  console.error(error?.message || "Unable to load preview profiles.");
}

if (!address && hasDirectoryFilters) {
  try {
    const directoryQuery = filters.name || filters.town;
    const repData = await getRepresentatives({
      body: normalizedBodyFilter,
      q: directoryQuery,
      county: filters.county,
      voteLimit: 100,
      limit: filters.town ? 600 : FILTERED_REP_LIMIT,
    });

    const matchedReps = (repData.representatives || []).filter((rep) => matchesDirectoryFilters(rep, filters));
    const fallbackReps = matchedReps.length
      ? matchedReps
      : allCurrentReps.filter((rep) => matchesDirectoryFilters(rep, filters));

    directoryReps = fallbackReps;
  } catch (error) {
    directoryError = error?.message || "Unable to load filtered profiles.";
  }
}

if (!address && !hasDirectoryFilters) {
  directoryReps = allCurrentReps.slice(0, INITIAL_REP_PREVIEW_LIMIT);
}

if (!embedTrackerError && (lookupData || (hasDirectoryFilters && directoryReps.length > 0))) {
  try {
    trackedBills = await getTrackedBills(isEmbed ? embedTrackerUrl : "");
    billSummaries = await getBillSummaries();
  } catch (error) {
    console.error(error?.message || "Unable to load bill summaries.");
  }
}

let senateReps = lookupData?.groups?.senate || [];
const houseRepsRaw = lookupData?.groups?.house || [];
const allReps = lookupData?.representatives || [];
const candidateGroups = lookupData?.groups?.candidates || {};
const allCandidates = lookupData?.candidates?.length
  ? lookupData.candidates
  : [
      ...(candidateGroups.senate || []),
      ...(candidateGroups.house || []),
    ];
let senateCandidates =
  candidateGroups.senate?.length
    ? candidateGroups.senate
    : allCandidates.filter((candidate) => isSenateCandidate(candidate));
let houseCandidates =
  candidateGroups.house?.length
    ? candidateGroups.house
    : allCandidates.filter((candidate) => isHouseCandidate(candidate));
const civic = lookupData?.civic || {};
const matchedDistricts = lookupData?.matchedDistricts || [];
const normalizedInput = lookupData?.normalizedInput || {};
const prettyAddress = formatAddress(normalizedInput);
const place = civic.place?.name || normalizedInput.city || "";
const wardOptions = wardOptionsFor(place);
const isWardedCommunity = wardOptions.length > 0;
const wardNumber = isWardedCommunity
  ? selectedWard || normalizeWardNumber(civic.ward?.number || "")
  : normalizeWardNumber(civic.ward?.number || "");
const ward = wardNumber ? `Ward ${wardNumber}` : "";
let houseReps = isWardedCommunity && selectedWard
  ? houseRepsRaw.filter((rep) => representsWard(rep, selectedWard))
  : houseRepsRaw;
let filteredHouseCandidates = isWardedCommunity && selectedWard
  ? houseCandidates.filter((candidate) => representsWard(candidate, selectedWard))
  : houseCandidates;
const filteredCandidates = [
  ...senateCandidates,
  ...filteredHouseCandidates,
];
const candidateOfficeGroups = groupCandidatesByOfficeDistrict(filteredCandidates);
const candidateSeatTotal = totalSeats(candidateOfficeGroups);
const senateDistrict =
  civic.senate?.districtLabel || civic.senate?.district || "";
const matchedHouseDistricts = matchedDistricts
  .filter((district) => district.body === "H")
  .filter((district) => !isWardedCommunity || !selectedWard || representsWard(district, selectedWard));
const regularHouseDistricts = matchedHouseDistricts
  .filter((district) => !isFloterialDistrict(district))
  .map((district) => district.district_label)
  .filter(Boolean);
const floterialHouseDistricts = matchedHouseDistricts
  .filter(isFloterialDistrict)
  .map((district) => district.district_label)
  .filter(Boolean);
const houseDistricts = [...regularHouseDistricts, ...floterialHouseDistricts];
const addressCountyName = countyFromMatchedDistricts(matchedDistricts);
const divisionSummaryText = address
  ? districtDivisionSummary({
      place,
      ward,
      county: addressCountyName,
    })
  : "";

if (lookupData) {
  [senateReps, houseReps] = await Promise.all([
    hydrateVotePreviewDetails(senateReps),
    hydrateVotePreviewDetails(houseReps),
  ]);
}

if (lookupData && trackedBills.size) {
  await hydrateMissingBillSummaries([...senateReps, ...houseReps], billSummaries);
}

if (!lookupData && directoryReps.length > 0 && trackedBills.size) {
  await hydrateMissingBillSummaries(directoryReps, billSummaries, {
    limit: hasDirectoryFilters ? 400 : 220,
  });
}

if (lookupData) {
  [senateCandidates, filteredHouseCandidates] = await Promise.all([
    enrichCandidatesWithLegislators(senateCandidates),
    enrichCandidatesWithLegislators(filteredHouseCandidates),
  ]);
}

async function hydrateVotePreviewDetails(reps = []) {
  const previewLimit = 80;
  const previewReps = reps.slice(0, previewLimit);
  const hydrated = await Promise.all(
    previewReps.map(async (rep) => {
      const slugOrId = rep.personid || rep.id || rep.slug || repName(rep);
      if (!slugOrId) return rep;

      try {
        const data = await getRepresentative(slugOrId);
        return {
          ...rep,
          ...(data.representative || data.rep || data.person || data),
          voteHistory: data.voteHistory || data.votes || data.representative?.voteHistory || rep.voteHistory || [],
        };
      } catch (error) {
        console.error(error?.message || "Unable to hydrate representative vote preview.");
        return rep;
      }
    }),
  );

  return [...hydrated, ...reps.slice(previewLimit)];
}

function normalizeBodyFilter(value = "") {
  const normalized = String(value || "").trim().toLowerCase();
  if (normalized === "house" || normalized === "h") return "house";
  if (normalized === "senate" || normalized === "s") return "senate";
  return "";
}

function matchesDirectoryFilters(rep = {}, values = {}) {
  return (
    matchesBody(rep, values.body) &&
    matchesText([repName(rep), rep.nameAliases, rep.name_aliases].filter(Boolean).join(" "), values.name) &&
    matchesText(locationLabel(rep), values.town) &&
    matchesCounty(rep, values.county)
  );
}

function matchesBody(rep = {}, query = "") {
  const normalized = normalizeBodyFilter(query);
  if (!normalized) return true;
  return legislativeBody(rep).toLowerCase() === (normalized === "house" ? "house" : "senate");
}

function matchesCounty(record = {}, query = "") {
  if (!query) return true;
  return matchesText([
    record.county,
    record.countyName,
    record.county_name,
    countyNameForCode(record.countycode),
    locationLabel(record),
  ].filter(Boolean).join(" "), query);
}

function matchesText(source = "", query = "") {
  if (!query) return true;
  return normalizeSearch(source).includes(normalizeSearch(query));
}

function normalizeSearch(value = "") {
  return String(value || "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function countyNameForCode(code = "") {
  const sourceCountyIds = {
    "01": "Belknap",
    "02": "Carroll",
    "03": "Cheshire",
    "04": "Coos",
    "05": "Grafton",
    "06": "Hillsborough",
    "07": "Merrimack",
    "08": "Rockingham",
    "09": "Strafford",
    "10": "Sullivan",
  };
  const fipsCountyIds = {
    "001": "Belknap",
    "003": "Carroll",
    "005": "Cheshire",
    "007": "Coos",
    "009": "Grafton",
    "011": "Hillsborough",
    "013": "Merrimack",
    "015": "Rockingham",
    "017": "Strafford",
    "019": "Sullivan",
  };
  const value = String(code || "").trim();
  if (!value) return "";
  if (/^\d{3}$/.test(value)) return fipsCountyIds[value] || "";
  return sourceCountyIds[value.padStart(2, "0")] || "";
}

function countyDisplayName(value = "") {
  const display = cleanDisplay(value);
  if (!display || /^\d+$/.test(display)) return "";
  return display;
}

function isSenateCandidate(candidate = {}) {
  return /senate/i.test(`${candidate.office || ""} ${candidate.officeType || ""}`);
}

function isHouseCandidate(candidate = {}) {
  return /representative|house/i.test(
    `${candidate.office || ""} ${candidate.officeType || ""}`,
  );
}

function groupCandidatesByOfficeDistrict(items = []) {
  const groups = new Map();

  for (const candidate of items) {
    const label = candidateOfficeDistrictLabel(candidate);
    if (!groups.has(label)) {
      groups.set(label, {
        label,
        office: candidate.office || "",
        county: candidate.county || "",
        district: candidate.district || "",
        seats: seatsForCandidateOffice(candidate),
        officeLabel: normalizeCandidateOffice(candidate.office),
        districtLabel: districtDisplay(candidate),
        candidates: [],
      });
    }

    groups.get(label).candidates.push(candidate);
  }

  return [...groups.values()].sort((a, b) => {
    const priorityDelta = candidateOfficePriority(a.office) - candidateOfficePriority(b.office);
    if (priorityDelta) return priorityDelta;

    return [
      String(a.county || "").localeCompare(String(b.county || "")),
      numericSortValue(a.district) - numericSortValue(b.district),
      String(a.label || "").localeCompare(String(b.label || "")),
    ].find((value) => value !== 0) || 0;
  });
}

function seatsForCandidateOffice(candidate = {}) {
  if (/state senate|state senator|senate/i.test(candidate.office || "")) return 1;
  const seats = Number(candidate.seats);
  return Number.isFinite(seats) && seats > 0 ? seats : null;
}

function totalSeats(groups = []) {
  const total = groups.reduce((sum, group) => sum + (Number(group.seats) || 0), 0);
  return total > 0 ? total : 0;
}

function isFloterialDistrict(district = {}) {
  return ["1", "true", "yes", "y"].includes(
    String(district.floterial ?? district.is_floterial_district ?? "").trim().toLowerCase(),
  );
}

function isFloterialOfficeGroup(group = {}, floterialDistricts = []) {
  if (!floterialDistricts.length) return false;
  const groupTokens = [
    group.label,
    group.districtLabel,
    [countyCodeFromName(group.county), group.district].filter(Boolean).join(" "),
  ].map(normalizeDistrictToken);
  const floterialTokens = floterialDistricts.map(normalizeDistrictToken);

  return groupTokens.some((token) => token && floterialTokens.includes(token));
}

function normalizeDistrictToken(value = "") {
  return String(value || "")
    .toLowerCase()
    .replace(/\b(state|house|district|representative|rep|nh)\b/g, " ")
    .replace(/[^a-z0-9]+/g, " ")
    .trim()
    .replace(/\s+/g, " ");
}

function countyCodeFromName(value = "") {
  const countyMap = {
    Belknap: "BEL",
    Carroll: "CAR",
    Cheshire: "CHE",
    Coos: "COO",
    Grafton: "GRA",
    Hillsborough: "HIL",
    Merrimack: "MER",
    Rockingham: "ROC",
    Strafford: "STR",
    Sullivan: "SUL",
  };
  return countyMap[cleanDisplay(value)] || "";
}

function countyCodeValue(item = {}) {
  return item.countyNumber || item.county_number || item.countyCode || item.county_code || item.county;
}

function countyFromMatchedDistricts(districts = []) {
  const district =
    districts.find((item) =>
      countyDisplayName(item.county || item.countyName || item.county_name) ||
      countyNameForCode(countyCodeValue(item)),
    ) || {};
  return (
    countyDisplayName(district.county || district.countyName || district.county_name) ||
    countyNameForCode(countyCodeValue(district))
  );
}

function districtDivisionSummary({
  place = "",
  ward = "",
  county = "",
} = {}) {
  const parts = [];
  if (ward) parts.push(ward);
  if (place) parts.push(place);
  if (county) parts.push(`${county} County`);

  return parts.length
    ? `Divisions: ${parts.join("; ")}.`
    : "";
}

function candidateOfficePriority(value = "") {
  const office = String(value || "").toLowerCase();
  if (/state representative|representative|house/.test(office)) return 0;
  if (/state senate|state senator|senate/.test(office)) return 1;
  return 2;
}

function candidateOfficeDistrictLabel(candidate = {}) {
  const officeLabel = normalizeCandidateOffice(candidate.office);
  const isSenateOffice = /state senate|state senator/i.test(officeLabel);
  const countyLabel = cleanDisplay(candidate.county);
  const districtLabel = cleanDisplay(candidate.district);

  return [
    officeLabel || "Office",
    isSenateOffice ? "" : countyLabel,
    districtLabel ? `District ${districtLabel}` : "",
  ].filter(Boolean).join(", ");
}

function districtDisplay(candidate = {}) {
  const districtLabel = cleanDisplay(candidate.district);
  if (!districtLabel) return "District not listed";
  const officeLabel = normalizeCandidateOffice(candidate.office);
  if (/state senate|state senator/i.test(officeLabel)) return `District ${districtLabel}`;
  return [cleanDisplay(candidate.county), `District ${districtLabel}`].filter(Boolean).join(", ");
}

function normalizeCandidateOffice(value = "") {
  const office = cleanDisplay(value);
  if (/state senate|state senator/i.test(office)) return "State Senate";
  if (/state representative|representative|house/i.test(office)) return "State Representative";
  return office;
}

function cleanDisplay(value = "") {
  return String(value || "").trim();
}

function numericSortValue(value = "") {
  const number = Number(value);
  return Number.isFinite(number) ? number : 999;
}

function normalizeWardNumber(value = "") {
  const match = String(value || "").match(/\d+/);
  return match ? String(Number(match[0])) : "";
}

function normalizedTownName(value = "") {
  return String(value || "").trim().toLowerCase().replace(/\s+/g, " ");
}

function wardOptionsFor(town = "") {
  const count = WARD_COMMUNITY_COUNTS.get(normalizedTownName(town)) || 0;
  return Array.from({ length: count }, (_, index) => String(index + 1));
}

function representsWard(record = {}, wardValue = "") {
  const wardNumber = normalizeWardNumber(wardValue);
  if (!wardNumber) return true;

  const text = recordText(record);
  const directWard = new RegExp(`\\bward(?:s)?\\s*${escapeRegExp(wardNumber)}\\b`, "i");
  if (directWard.test(text)) return true;

  for (const match of text.matchAll(/\bwards?\s+(\d{1,2})\s*(?:-|–|—|to|through)\s*(\d{1,2})\b/gi)) {
    const start = Number(match[1]);
    const end = Number(match[2]);
    const selected = Number(wardNumber);
    if (selected >= Math.min(start, end) && selected <= Math.max(start, end)) return true;
  }

  return false;
}

function recordText(record = {}) {
  return [
    record.location_text,
    record.locationText,
    record.towns_represented,
    record.townsRepresented,
    record.towns,
    record.town,
    record.city,
    record.district_label,
    record.districtLabel,
    record.name,
    record.office,
    record.district,
    record.raw_district,
  ].flatMap(stringifyValue).filter(Boolean).join(" ");
}

function stringifyValue(value) {
  if (!value) return [];
  if (Array.isArray(value)) return value.flatMap(stringifyValue);
  if (typeof value === "object") {
    return [value.town, value.name, value.label, value.location_text, value.locationText].flatMap(stringifyValue);
  }
  return [String(value)];
}

function townsForOption(rep = {}) {
  return stringifyValue(
    rep.location_text ||
      rep.locationText ||
      rep.towns_represented ||
      rep.townsRepresented ||
      rep.towns ||
      "",
  )
    .flatMap((value) => String(value).split(/[,;|]/))
    .map((value) => value.replace(/\s*-\s*Ward\s+\d+$/i, "").trim())
    .filter(Boolean);
}

function uniqueOptions(values = []) {
  return [...new Set(values.flat().map((value) => String(value || "").trim()).filter(Boolean))]
    .sort((a, b) => a.localeCompare(b));
}

function escapeRegExp(value = "") {
  return String(value).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function legislativeBody(person = {}) {
  const value = String(person.chamber || person.legislativebody || person.body || "").toLowerCase();
  if (value === "h" || value === "house") return "House";
  if (value === "s" || value === "senate") return "Senate";
  return person.chamber || "";
}

function districtLabel(person = {}) {
  const district = person.district || person.raw_district || "";
  const body = legislativeBody(person);
  if (!district) return body;
  if (body === "House") return `NH House District ${district}`;
  if (body === "Senate") return `NH Senate District ${district}`;
  return `District ${district}`;
}

function locationLabel(person = {}) {
  const value =
    person.location_text ||
    person.locationText ||
    person.towns_represented ||
    person.townsRepresented ||
    "";
  if (Array.isArray(value)) return value.join(", ");
  return value;
}

function formatAddress(normalized = {}) {
  return [
    normalized.line1,
    normalized.city,
    normalized.state,
    normalized.zip,
  ]
    .filter(Boolean)
    .join(", ");
}

async function hydrateMissingBillSummaries(reps, summaries, { limit = 80 } = {}) {
  const missingBills = new Map();

  for (const rep of reps) {
    for (const vote of rep.voteHistory || []) {
      const code = normalizeBillCode(vote.condensedbillno);
      if (
        !code ||
        !isVotingAction(vote) ||
        summaries.has(code) ||
        missingBills.has(code)
      ) {
        continue;
      }
      missingBills.set(code, vote.sessionyear);
      if (missingBills.size >= limit) break;
    }
    if (missingBills.size >= limit) break;
  }

  await Promise.all(
    [...missingBills].map(async ([code, year]) => {
      try {
        const detail = await getBillDetail(code, { year });
        if (detail.bill) summaries.set(code, detail.bill);
      } catch (error) {
        console.error(error?.message || "Unable to load bill summary.");
      }
    }),
  );
}

function isVotingAction(vote = {}) {
  const text = [
    vote.question_motion,
    vote.motion,
    vote.vote_label,
    vote.description,
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();

  if (vote.include_in_display === 0) return false;
  if (vote.include_in_display === undefined && isExcludedAlignmentMotion(text)) return false;
  if (!text) return true;
  return (
    /\b(ought|pass|adopt|table|refer|re-refer|inexpedient|itl|amend|conference|veto)\b/.test(text) ||
    Boolean(vote.votesequencenumber || vote.vote_sequence || vote.roll_call)
  );
}

function validThemeColor(value, fallback) {
  const color = String(value || "").trim();
  return /^#[0-9a-f]{6}$/i.test(color) ? color : fallback;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>My Legislator | NH Deserves Better</title>
    <meta
      name="description"
      content="Find your New Hampshire state legislators by address."
    />
  </head>

  <body class={isEmbed ? "embed-mode" : ""}>
    {!isEmbed && <TopNav />}
    <main
      class="page"
      style={isEmbed ? `--embed-accent: ${embedTheme.accentColor}; --embed-accent-soft: ${embedTheme.accentSoftColor};` : undefined}
      x-data="nhdbFuzzyFilter({ itemSelector: '.rep-card[data-fuzzy-item]', idleLimit: 12 })"
    >
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">My Legislator</p>
          <h1>Find your New Hampshire state legislators.</h1>
          <p class="lede">
            Enter your address to identify your State Senator, your ward-based
            House district, and any floterial House districts connected to your
            community.
          </p>
        </div>

        <form class="address-lookup" action="/my-state-rep#rep-results" method="get" data-results-form>
          {isEmbed && <input type="hidden" name="embed" value="1" />}
          {isEmbed && <input type="hidden" name="partner" value={embedPartnerKey} />}
          <label for="address">Find your current State Representatives and State Senator</label>

          <div class="address-row">
            <input
              id="address"
              name="address"
              type="text"
              value={address}
              placeholder="72 Concord St, Manchester, NH"
              autocomplete="street-address"
              required
            />

            <button type="submit">Find My Legislators</button>
          </div>
          <p>Example: 107 North Main Street, Concord, New Hampshire</p>
        </form>

        <p class="help-text">
          Address lookups and filters focus on current New Hampshire State
          Representatives and State Senators.
        </p>
      </section>

      {!isEmbed && <section class="legislator-filter-panel" aria-label="Legislator filters">
        <FilterBar
          action="/my-state-rep#rep-results"
          submitLabel="Filter current legislators"
          clearHref={hasDirectoryFilters ? "/my-state-rep#rep-results" : ""}
          dataResultsForm
          live
        >
          <label>
            <span>Name</span>
            <input
              type="search"
              name="name"
              value={filters.name}
              list="legislatorNameOptions"
              placeholder="Start typing a legislator"
              autocomplete="off"
              data-fuzzy-search
            />
            <datalist id="legislatorNameOptions">
              {nameOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>County</span>
            <input
              type="search"
              name="county"
              value={filters.county}
              list="legislatorCountyOptions"
              placeholder="Start typing a county"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="county"
            />
            <datalist id="legislatorCountyOptions">
              {countyOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Chamber</span>
            <select
              name="body"
              data-fuzzy-filter-field
              data-fuzzy-field="body"
            >
              <option value="" selected={!normalizedBodyFilter}>All</option>
              <option value="house" selected={normalizedBodyFilter === "house"}>House</option>
              <option value="senate" selected={normalizedBodyFilter === "senate"}>Senate</option>
            </select>
          </label>
          <label>
            <span>Town</span>
            <input
              type="search"
              name="town"
              value={filters.town}
              list="legislatorTownOptions"
              placeholder="Start typing a town"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="town"
            />
            <datalist id="legislatorTownOptions">
              {townOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Sort</span>
            <select name="sort" data-fuzzy-sort>
              <option value="" selected={!sort}>Default</option>
              <option value="name:asc" selected={sort === "name:asc"}>Name A-Z</option>
              <option value="district:asc" selected={sort === "district:asc"}>District</option>
              <option value="grade:desc" selected={sort === "grade:desc"}>Grade high-low</option>
              <option value="grade:asc" selected={sort === "grade:asc"}>Grade low-high</option>
              <option value="updated:desc" selected={sort === "updated:desc"}>Recently updated</option>
              <option value="missing:desc" selected={sort === "missing:desc"}>Missing info</option>
            </select>
          </label>
        </FilterBar>
        <div class="filter-chips" data-fuzzy-chips hidden></div>
      </section>}

      <div id="rep-results" data-results-region>
      {embedTrackerError && <div class="status-message" aria-live="polite">{embedTrackerError}</div>}
      {lookupError && (
        <div class="status-message" aria-live="polite">
          {lookupError}
        </div>
      )}

      {address && !lookupError && allReps.length === 0 && allCandidates.length === 0 && (
        <div class="status-message" aria-live="polite">
          No State Representatives, State Senators, or legislative candidates found for that address.
        </div>
      )}

      {!isEmbed && !address && (
        <section class="filtered-directory">
          <div class="results-heading">
            <div>
              <p class="eyebrow">{hasDirectoryFilters ? "Filtered Current Legislators" : "Current Legislator Directory"}</p>
              <h2><span data-fuzzy-count>{Math.min(directoryReps.length, 12)}</span> Representatives and Senators Shown</h2>
              <p class="result-note">
                <span data-fuzzy-matched-count>{directoryReps.length}</span> loaded matches
              </p>
            </div>
            {hasDirectoryFilters && <a class="secondary-link" href="/my-state-rep#rep-results">Clear filters</a>}
          </div>

          {directoryError ? (
            <p class="status-message">{directoryError}</p>
          ) : directoryReps.length ? (
            <>
              <div class:list={["rep-grid", isEmbed && "rep-grid--embed"]}>
                {directoryReps.map((rep) => (
                  <RepresentativeCard
                    rep={rep}
                    trackedBills={trackedBills}
                    billSummaries={billSummaries}
                    embed={isEmbed}
                    showPublicTestimony={!isEmbed || embedFeatures.publicTestimony}
                    showTestimonyAlignment={!isEmbed || embedFeatures.testimonyAlignment}
                    showFreeStateAligned={!isEmbed || embedFeatures.freeStateAligned}
                    showTpactionAligned={!isEmbed || embedFeatures.tpactionAligned}
                    openRep={embedOpenRep}
                    trackerAlignmentLabel={embedTheme.alignmentLabel}
                    voteExplanationLabel={embedTheme.voteIntro}
                  />
                ))}
              </div>
              <p class="status-message" data-fuzzy-empty hidden>
                No current legislators matched those filters. Try a broader town,
                county, or name search.
              </p>
            </>
          ) : (
            <p class="status-message">
              No current legislators matched those filters. Try a broader town,
              county, or name search.
            </p>
          )}

        </section>
      )}

      {lookupData && (allReps.length > 0 || allCandidates.length > 0) && (
        <>
          <section class="district-summary">
            <div class="address-office-results">
              <div class="address-result-heading">
                <p class="summary-label">Showing results for</p>
                <h2>{prettyAddress || lookupData.address || "This address"}</h2>
              </div>

              {isWardedCommunity && (
                <form class:list={["ward-filter", !wardNumber && "needs-ward"]} action="/my-state-rep#rep-results" method="get" data-results-form>
                  <input type="hidden" name="address" value={address} />
                  {isEmbed && <input type="hidden" name="embed" value="1" />}
                  {isEmbed && <input type="hidden" name="partner" value={embedPartnerKey} />}
                  <div class="ward-filter-copy">
                    <label for="ward">Select your ward</label>
                    <p>
                      {wardNumber
                        ? "Confirm or change your ward to narrow State House representatives and candidates."
                        : "This city has ward-based districts, but the address lookup did not return a ward. Select your ward so the results are not town-wide."}
                    </p>
                  </div>
                  <div class="ward-filter-controls">
                    <select id="ward" name="ward">
                      <option value="">Use address result</option>
                      {wardOptions.map((option) => (
                        <option value={option} selected={selectedWard === option}>
                          Ward {option}
                        </option>
                      ))}
                    </select>
                    <button type="submit">Apply</button>
                  </div>
                </form>
              )}

              <div class="address-office-summary">
                {place && (
                  <div class="summary-stat">
                    <strong>{place}</strong>
                    <span>Community</span>
                  </div>
                )}

                {ward && (
                  <div class="summary-stat">
                    <strong>{ward}</strong>
                    <span>Ward</span>
                  </div>
                )}

                {senateDistrict && (
                  <div class="summary-stat">
                    <strong>{senateDistrict}</strong>
                    <span>State Senate</span>
                  </div>
                )}

                {houseDistricts.length > 0 && (
                  <div class="summary-stat">
                    <strong>{houseDistricts.join(", ")}</strong>
                    <span>State House</span>
                  </div>
                )}
              </div>

              {(senateDistrict || regularHouseDistricts.length > 0 || floterialHouseDistricts.length > 0) && (
                <section class="address-district-strip" aria-label="Districts for this address">
                  <div class="district-strip-heading">
                    <p class="eyebrow">Districts for this address</p>
                    <strong>{prettyAddress || address}</strong>
                  </div>
                  <div class="district-chip-row">
                    {senateDistrict && (
                      <span class="district-chip senate-chip">
                        <small>State Senate</small>
                        <strong>{senateDistrict}</strong>
                      </span>
                    )}
                    {regularHouseDistricts.length > 0 && (
                      <span class="district-chip house-chip">
                        <small>State House</small>
                        <strong>{regularHouseDistricts.join(", ")}</strong>
                      </span>
                    )}
                    {floterialHouseDistricts.length > 0 && (
                      <span class="district-chip floterial-chip">
                        <small>State House</small>
                        <strong>{floterialHouseDistricts.join(", ")}</strong>
                        <em>Floterial</em>
                      </span>
                    )}
                  </div>
                </section>
              )}

              {divisionSummaryText && (
                <section class="address-division-summary" aria-label="District division summary">
                  <p>{divisionSummaryText}</p>
                </section>
              )}
            </div>
          </section>

          <section class="results">
            {senateReps.length > 0 && (
              <section class="rep-group">
                <div class="group-header">
                  <h2>State Senate</h2>
                  <p>
                    Your State Senator represents a larger district in the New
                    Hampshire Senate.
                  </p>
                </div>

                <div class:list={["rep-grid", isEmbed && "rep-grid--embed"]}>
                  {senateReps.map((rep) => (
                    <RepresentativeCard
                      rep={rep}
                      trackedBills={trackedBills}
                      billSummaries={billSummaries}
                      embed={isEmbed}
                      showPublicTestimony={!isEmbed || embedFeatures.publicTestimony}
                      showTestimonyAlignment={!isEmbed || embedFeatures.testimonyAlignment}
                      showFreeStateAligned={!isEmbed || embedFeatures.freeStateAligned}
                      showTpactionAligned={!isEmbed || embedFeatures.tpactionAligned}
                      openRep={embedOpenRep}
                      trackerAlignmentLabel={embedTheme.alignmentLabel}
                      voteExplanationLabel={embedTheme.voteIntro}
                    />
                  ))}
                </div>
              </section>
            )}

            {houseReps.length > 0 && (
              <section class="rep-group">
                <div class="group-header">
                  <div class="group-title-row">
                    <h2>State House</h2>
                    {floterialHouseDistricts.length > 0 && (
                      <span class="floterial-tag">Includes floterial district</span>
                    )}
                  </div>
                  <p>
                    Your House representatives may include your ward or town
                    district plus a floterial district.
                  </p>
                </div>

                <div class:list={["rep-grid", isEmbed && "rep-grid--embed"]}>
                  {houseReps.map((rep) => (
                    <RepresentativeCard
                      rep={rep}
                      trackedBills={trackedBills}
                      billSummaries={billSummaries}
                      embed={isEmbed}
                      showPublicTestimony={!isEmbed || embedFeatures.publicTestimony}
                      showTestimonyAlignment={!isEmbed || embedFeatures.testimonyAlignment}
                      showFreeStateAligned={!isEmbed || embedFeatures.freeStateAligned}
                      showTpactionAligned={!isEmbed || embedFeatures.tpactionAligned}
                      openRep={embedOpenRep}
                      trackerAlignmentLabel={embedTheme.alignmentLabel}
                      voteExplanationLabel={embedTheme.voteIntro}
                    />
                  ))}
                </div>
              </section>
            )}

            {!isEmbed && candidateOfficeGroups.length > 0 && (
              <section class="candidate-results">
                <div class="group-header">
                  <h2>2026 Legislative Candidates</h2>
                  <div class="candidate-summary-strip" aria-label="Election summary">
                    <div class="summary-stat">
                      <strong>{candidateOfficeGroups.length}</strong>
                      <span>{candidateOfficeGroups.length === 1 ? "Office" : "Offices"}</span>
                    </div>
                    <div class="summary-stat">
                      <strong>{candidateSeatTotal || "—"}</strong>
                      <span>{candidateSeatTotal === 1 ? "Seat" : "Seats"}</span>
                    </div>
                    <div class="summary-stat">
                      <strong>{filteredCandidates.length}</strong>
                      <span>{filteredCandidates.length === 1 ? "Candidate" : "Candidates"}</span>
                    </div>
                  </div>
                </div>

                {candidateOfficeGroups.map((group) => (
                  <section class="candidate-group" aria-labelledby={`candidate-office-${group.label.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>
                    <div class="candidate-group-heading">
                      <div>
                        <p class="eyebrow">Office up for election</p>
                        <div class="group-title-row">
                          <h3 id={`candidate-office-${group.label.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>{group.officeLabel || group.label}</h3>
                          {isFloterialOfficeGroup(group, floterialHouseDistricts) && (
                            <span class="floterial-tag">Floterial</span>
                          )}
                        </div>
                        <p>{group.districtLabel}</p>
                      </div>
                      <div class="office-metrics" aria-label={`${group.label} summary`}>
                        <span><strong>{group.seats || "—"}</strong> {group.seats === 1 ? "seat" : "seats"}</span>
                        <span><strong>{group.candidates.length}</strong> {group.candidates.length === 1 ? "candidate" : "candidates"}</span>
                      </div>
                    </div>
                    <div class="candidate-grid">
                      {group.candidates.map((candidate) => (
                        <CandidateCard candidate={candidate} />
                      ))}
                    </div>
                  </section>
                ))}
              </section>
            )}
          </section>
        </>
      )}
      </div>
    </main>
    <script>
      const resultsRegion = document.querySelector("[data-results-region]");
      const filterForm = document.querySelector("[data-fuzzy-live-form]");
      let filterTimeout = 0;
      let latestRequestId = 0;

      function resultsUrlFor(form) {
        const formData = new FormData(form);
        const params = new URLSearchParams();

        for (const [key, value] of formData.entries()) {
          const text = String(value || "").trim();
          if (text && text.toLowerCase() !== "all") params.set(key, text);
        }

        if (new URL(window.location.href).searchParams.get("embed") === "1") {
          params.set("embed", "1");
          const partner = new URL(window.location.href).searchParams.get("partner");
          if (partner) params.set("partner", partner);
        }

        return `/my-state-rep${params.toString() ? `?${params}` : ""}`;
      }

      async function loadResultsFromForm(form, { push = true, scroll = true } = {}) {
        if (!resultsRegion) return false;

        const submitButton = form.querySelector("button[type='submit']");
        const originalText = submitButton?.textContent || "";
        const url = resultsUrlFor(form);
        const requestId = latestRequestId + 1;
        latestRequestId = requestId;
        if (submitButton && scroll) {
          submitButton.disabled = true;
          submitButton.textContent = "Loading...";
        }

        try {
          const response = await fetch(url, { headers: { "x-requested-with": "fetch" } });
          if (!response.ok) throw new Error("Unable to load results.");

          const html = await response.text();
          const doc = new DOMParser().parseFromString(html, "text/html");
          const nextResults = doc.querySelector("[data-results-region]");
          if (!nextResults) throw new Error("Unable to load results.");
          if (requestId !== latestRequestId) return false;

          resultsRegion.innerHTML = nextResults.innerHTML;
          resultsRegion.closest("[x-data]")?.dispatchEvent(new CustomEvent("nhdb:fuzzy-refresh", { bubbles: true }));

          const nextUrl = `${url}#rep-results`;
          if (push) {
            window.history.pushState({}, "", nextUrl);
          } else {
            window.history.replaceState({}, "", nextUrl);
          }
          if (scroll) resultsRegion.scrollIntoView({ behavior: "smooth", block: "start" });
          return true;
        } catch (error) {
          if (scroll) window.location.href = `${url}#rep-results`;
          return false;
        } finally {
          if (submitButton && scroll) {
            submitButton.disabled = false;
            submitButton.textContent = originalText;
          }
        }
      }

      document.addEventListener("submit", async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.matches("[data-results-form]") || !resultsRegion) {
          return;
        }

          event.preventDefault();
          await loadResultsFromForm(form, { push: true, scroll: true });
      });

      filterForm?.addEventListener("input", () => {
        window.clearTimeout(filterTimeout);
        filterTimeout = window.setTimeout(() => {
          loadResultsFromForm(filterForm, { push: false, scroll: false });
        }, 260);
      });

      filterForm?.addEventListener("change", () => {
        window.clearTimeout(filterTimeout);
        filterTimeout = window.setTimeout(() => {
          loadResultsFromForm(filterForm, { push: false, scroll: false });
        }, 120);
      });
    </script>
    {isEmbed && (
      <dialog class="embed-bill-dialog" data-embed-bill-dialog>
        <div class="embed-bill-dialog-header">
          <span>Bill details</span>
          <form method="dialog"><button type="submit" aria-label="Close bill details">×</button></form>
        </div>
        <div data-embed-bill-content></div>
      </dialog>
    )}
    {isEmbed && (
      <script>
        const billDialog = document.querySelector("[data-embed-bill-dialog]");
        const billDialogContent = document.querySelector("[data-embed-bill-content]");
        const addBillDetail = (label, value) => {
          if (!value) return;
          const section = document.createElement("section");
          const heading = document.createElement("strong");
          const copy = document.createElement("p");
          heading.textContent = label;
          copy.textContent = value;
          section.append(heading, copy);
          billDialogContent?.append(section);
        };

        document.addEventListener("click", (event) => {
          const trigger = event.target.closest?.("[data-embed-bill]");
          if (!trigger || !billDialog || !billDialogContent) return;
          event.preventDefault();
          billDialogContent.replaceChildren();
          const title = document.createElement("h2");
          title.textContent = trigger.dataset.billCode || "Bill details";
          billDialogContent.append(title);
          addBillDetail("Legislator vote", trigger.dataset.billVote);
          addBillDetail(trigger.dataset.billVoteExplanationLabel || "What this vote means", trigger.dataset.billVoteExplanation);
          addBillDetail("Organization recommendation", trigger.dataset.billPreferred);
          addBillDetail("Summary", trigger.dataset.billSummary);
          if (!trigger.dataset.billVoteExplanation) {
            addBillDetail("If in support", trigger.dataset.billYea);
            addBillDetail("If opposed", trigger.dataset.billNay);
          }
          billDialog.showModal();
        });

        billDialog?.addEventListener("click", (event) => {
          if (event.target === billDialog) billDialog.close();
        });

        document.addEventListener("click", (event) => {
          const toggle = event.target.closest?.("[data-embed-rep-toggle]");
          if (!toggle || event.target.closest("a[href], button")) return;
          toggleEmbedRepresentative(toggle);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          const toggle = event.target.closest?.("[data-embed-rep-toggle]");
          if (!toggle) return;
          event.preventDefault();
          toggleEmbedRepresentative(toggle);
        });

        const notifyEmbedHeight = () => {
          const height = Math.ceil(Math.max(
            document.documentElement.scrollHeight || 0,
            document.body?.scrollHeight || 0,
          ));
          window.parent?.postMessage({ type: "nhcc:my-state-rep:height", height }, "*");
        };

        const toggleEmbedRepresentative = (toggle) => {
          const card = toggle.closest("[data-embed-rep]");
          const expanded = card?.querySelector("[data-embed-rep-expanded]");
          if (!card || !expanded) return;
          const willOpen = expanded.hidden;
          if (willOpen) {
            document.querySelectorAll("[data-embed-rep-expanded]").forEach((otherExpanded) => {
              if (otherExpanded === expanded) return;
              otherExpanded.hidden = true;
              otherExpanded.closest("[data-embed-rep]")
                ?.querySelector("[data-embed-rep-toggle]")
                ?.setAttribute("aria-expanded", "false");
            });
          }
          expanded.hidden = !willOpen;
          toggle.setAttribute("aria-expanded", String(willOpen));
          const url = new URL(window.location.href);
          if (willOpen) url.searchParams.set("open", card.dataset.embedRep || "");
          else url.searchParams.delete("open");
          window.history.pushState({}, "", url);
          window.parent?.postMessage({
            type: "nhcc:my-state-rep:url",
            url: url.toString(),
            open: willOpen ? card.dataset.embedRep || "" : "",
          }, "*");
          setTimeout(notifyEmbedHeight, 0);
        };

        if ("ResizeObserver" in window) {
          new ResizeObserver(notifyEmbedHeight).observe(document.body);
        }
        window.addEventListener("load", notifyEmbedHeight);
        window.addEventListener("resize", notifyEmbedHeight);
        setTimeout(notifyEmbedHeight, 250);
      </script>
    )}
    {!isEmbed && <SiteFooter />}
  </body>
</html>

<style>
  :global(body.embed-mode) {
    background: transparent;
  }

  :global(body.embed-mode) .page {
    margin: 0;
    max-width: none;
    padding: 0;
  }

  :global(body.embed-mode) .hero {
    margin: 0;
    min-height: 0;
    padding: clamp(20px, 4vw, 38px);
  }

  :global(body.embed-mode) .help-text {
    display: none;
  }

  .embed-bill-dialog {
    background: #fff;
    border: 1px solid #dbe4f0;
    border-radius: 20px;
    box-shadow: 0 28px 90px rgba(15, 23, 42, 0.38);
    box-sizing: border-box;
    color: #1e293b;
    max-height: min(720px, calc(100vh - 32px));
    max-width: min(680px, calc(100vw - 32px));
    inset: 0;
    margin: auto;
    overflow: auto;
    padding: 20px 22px 24px;
    position: fixed;
    width: 100%;
  }

  .embed-bill-dialog::backdrop { background: rgba(15, 23, 42, 0.62); backdrop-filter: blur(3px); }
  .embed-bill-dialog-header { align-items: center; color: #475569; display: flex; font-size: .72rem; font-weight: 950; justify-content: space-between; letter-spacing: .1em; text-transform: uppercase; }
  .embed-bill-dialog form { margin: -5px -5px 0 0; }
  .embed-bill-dialog button {
    align-items: center;
    background: #e2e8f0;
    border: 0;
    border-radius: 999px;
    color: #0f172a;
    cursor: pointer;
    display: inline-flex;
    font-size: 1.4rem;
    font-weight: 800;
    height: 38px;
    justify-content: center;
    line-height: 1;
    width: 38px;
  }
  .embed-bill-dialog button:hover { background: #cbd5e1; }
  .embed-bill-dialog h2 { color: #0f172a; font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.1; margin: 12px 0 20px; }
  .embed-bill-dialog section { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; margin-top: 10px; padding: 14px 16px; }
  .embed-bill-dialog section strong { color: #334155; font-size: .68rem; letter-spacing: .07em; text-transform: uppercase; }
  .embed-bill-dialog p { color: #334155; font-size: .92rem; line-height: 1.5; margin: 7px 0 0; }

  .hero {
    align-items: center;
    background:
      radial-gradient(circle at 82% 18%, rgba(220, 77, 9, 0.16), transparent 28%),
      linear-gradient(135deg, #eff6ff 0%, #ffffff 48%, #f8fbff 100%);
    border: 1px solid #bfdbfe;
    border-radius: 18px;
