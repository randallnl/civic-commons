                      rep={rep}
                      trackedBills={trackedBills}
                      billSummaries={billSummaries}
                    />
                  ))}
                </div>
              </section>
            )}

            {candidateOfficeGroups.length > 0 && (
              <section class="candidate-results">
                <div class="group-header">
                  <h2>2026 Legislative Candidates</h2>
                  <div class="candidate-summary-strip" aria-label="Election summary">
                    <div class="summary-stat">
                      <strong>{candidateOfficeGroups.length}</strong>
                      <span>{candidateOfficeGroups.length === 1 ? "Office" : "Offices"}</span>
                    </div>
                    <div class="summary-stat">
                      <strong>{candidateSeatTotal || "—"}</strong>
                      <span>{candidateSeatTotal === 1 ? "Seat" : "Seats"}</span>
                    </div>
                    <div class="summary-stat">
                      <strong>{filteredCandidates.length}</strong>
                      <span>{filteredCandidates.length === 1 ? "Candidate" : "Candidates"}</span>
                    </div>
                  </div>
                </div>

                {candidateOfficeGroups.map((group) => (
                  <section class="candidate-group" aria-labelledby={`candidate-office-${group.label.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>
                    <div class="candidate-group-heading">
                      <div>
                        <p class="eyebrow">Office up for election</p>
                        <h3 id={`candidate-office-${group.label.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>{group.officeLabel || group.label}</h3>
                        <p>{group.districtLabel}</p>
                      </div>
                      <div class="office-metrics" aria-label={`${group.label} summary`}>
                        <span><strong>{group.seats || "—"}</strong> {group.seats === 1 ? "seat" : "seats"}</span>
                        <span><strong>{group.candidates.length}</strong> {group.candidates.length === 1 ? "candidate" : "candidates"}</span>
                      </div>
                    </div>
                    <div class="candidate-grid">
                      {group.candidates.map((candidate) => (
                        <CandidateCard candidate={candidate} />
                      ))}
                    </div>
                  </section>
                ))}
              </section>
            )}
          </section>
        </>
      )}
      </div>
    </main>
    <script>
      const resultsRegion = document.querySelector("[data-results-region]");
      const filterForm = document.querySelector("[data-fuzzy-live-form]");
      let filterTimeout = 0;
      let latestRequestId = 0;

      function resultsUrlFor(form) {
        const formData = new FormData(form);
        const params = new URLSearchParams();

        for (const [key, value] of formData.entries()) {
          const text = String(value || "").trim();
          if (text && text.toLowerCase() !== "all") params.set(key, text);
        }

        return `/my-state-rep${params.toString() ? `?${params}` : ""}`;
      }

      async function loadResultsFromForm(form, { push = true, scroll = true } = {}) {
        if (!resultsRegion) return false;

        const submitButton = form.querySelector("button[type='submit']");
        const originalText = submitButton?.textContent || "";
        const url = resultsUrlFor(form);
        const requestId = latestRequestId + 1;
        latestRequestId = requestId;
        if (submitButton && scroll) {
          submitButton.disabled = true;
          submitButton.textContent = "Loading...";
        }

        try {
          const response = await fetch(url, { headers: { "x-requested-with": "fetch" } });
          if (!response.ok) throw new Error("Unable to load results.");

          const html = await response.text();
          const doc = new DOMParser().parseFromString(html, "text/html");
          const nextResults = doc.querySelector("[data-results-region]");
          if (!nextResults) throw new Error("Unable to load results.");
          if (requestId !== latestRequestId) return false;

          resultsRegion.innerHTML = nextResults.innerHTML;
          resultsRegion.closest("[x-data]")?.dispatchEvent(new CustomEvent("nhdb:fuzzy-refresh", { bubbles: true }));

          const nextUrl = `${url}#rep-results`;
          if (push) {
            window.history.pushState({}, "", nextUrl);
          } else {
            window.history.replaceState({}, "", nextUrl);
          }
          if (scroll) resultsRegion.scrollIntoView({ behavior: "smooth", block: "start" });
          return true;
        } catch (error) {
          if (scroll) window.location.href = `${url}#rep-results`;
          return false;
        } finally {
          if (submitButton && scroll) {
            submitButton.disabled = false;
            submitButton.textContent = originalText;
          }
        }
      }

      document.addEventListener("submit", async (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.matches("[data-results-form]") || !resultsRegion) {
          return;
        }

          event.preventDefault();
          await loadResultsFromForm(form, { push: true, scroll: true });
      });

      filterForm?.addEventListener("input", () => {
        window.clearTimeout(filterTimeout);
        filterTimeout = window.setTimeout(() => {
          loadResultsFromForm(filterForm, { push: false, scroll: false });
        }, 260);
      });

      filterForm?.addEventListener("change", () => {
        window.clearTimeout(filterTimeout);
        filterTimeout = window.setTimeout(() => {
          loadResultsFromForm(filterForm, { push: false, scroll: false });
        }, 120);
      });
    </script>
    <SiteFooter />
  </body>
</html>

