---
export const prerender = false;

import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getContributorCampaignFinance } from "../../lib/campaignFinance";

const contributorName = Astro.url.searchParams.get("name")?.trim() || "";
const electionYear = Number(Astro.url.searchParams.get("year")) || 2026;
let finance = {
  contributorName,
  electionYear,
  recipients: [],
  totalAmount: 0,
};
let loadError = false;

if (contributorName) {
  try {
    finance = await getContributorCampaignFinance({ contributorName, electionYear });
  } catch (error) {
    loadError = true;
    console.error(error?.message || "Unable to load contributor details.");
  }
}

const title = contributorName
  ? `${finance.contributorName} contributions`
  : "Campaign-finance contributors";

function formatCurrency(value) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: 0,
    maximumFractionDigits: 2,
  }).format(Number(value) || 0);
}

function formatDate(value) {
  if (!value) return "";
  const parsed = new Date(`${value}T12:00:00`);
  if (Number.isNaN(parsed.getTime())) return value;
  return parsed.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

function officeLine(recipient) {
  const district = recipient.district
    ? recipient.county
      ? `${recipient.county} District ${recipient.district}`
      : `District ${recipient.district}`
    : "";
  return [recipient.office, district].filter(Boolean).join(" · ");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <title>{title} | NH Deserves Better</title>
    <meta
      name="description"
      content={contributorName
        ? `Candidates who received itemized contributions from ${finance.contributorName}.`
        : "Explore itemized campaign-finance contributions to New Hampshire candidates."}
    />
  </head>
  <body>
    <TopNav />
    <main class="page">
      <a class="back" href="/candidates">Back to candidates</a>

      <section class="hero">
        <p class="eyebrow">Campaign finance · {finance.electionYear}</p>
        <h1>{contributorName ? finance.contributorName : "Contributor details"}</h1>
        {contributorName && !loadError && finance.recipients.length > 0 && (
          <p class="summary">
            <strong>{formatCurrency(finance.totalAmount)}</strong> contributed across
            {` ${finance.recipients.length} candidate ${finance.recipients.length === 1 ? "campaign" : "campaigns"}`}.
          </p>
        )}
      </section>

      {loadError ? (
        <section class="panel empty-state">
          <h2>Contributor details are temporarily unavailable</h2>
          <p>Please try again shortly.</p>
        </section>
      ) : !contributorName ? (
        <section class="panel empty-state">
          <h2>Choose a contributor from a candidate profile</h2>
          <p>Contributor names in campaign-finance cards link to their recipient history.</p>
        </section>
      ) : finance.recipients.length === 0 ? (
        <section class="panel empty-state">
          <h2>No matching contributions found</h2>
          <p>No itemized contributions match this contributor for {finance.electionYear}.</p>
        </section>
      ) : (
        <section class="panel" aria-labelledby="recipient-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Recipients</p>
              <h2 id="recipient-heading">Candidate campaigns</h2>
            </div>
            <a
              class="source-link"
              href="https://cfs.sos.nh.gov/public/cf/reports"
              target="_blank"
              rel="noopener noreferrer"
            >NH filings <span aria-hidden="true">↗</span></a>
          </div>

          <ol class="recipient-list">
            {finance.recipients.map((recipient) => (
              <li>
                <a href={`/people/${encodeURIComponent(recipient.slug)}`}>
                  <div class="recipient-copy">
                    <strong>{recipient.name}</strong>
                    {officeLine(recipient) && <span>{officeLine(recipient)}</span>}
                    {recipient.latestContributionDate && (
                      <small>Latest recorded contribution {formatDate(recipient.latestContributionDate)}</small>
                    )}
                  </div>
                  <div class="recipient-amount">
                    <strong>{formatCurrency(recipient.amount)}</strong>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    background: #e8edf3;
    color: #1f2933;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    margin: 0;
  }
  .page {
    margin: 0 auto;
    max-width: 980px;
    min-height: 70vh;
    padding: 34px 22px 64px;
  }
  .back {
    color: #1f2933;
    display: inline-block;
    font-weight: 900;
    margin-bottom: 28px;
    text-underline-offset: 3px;
  }
  .hero { margin-bottom: 24px; }
  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.13em;
    margin: 0 0 8px;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 4.2rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .summary {
    color: #475569;
    font-size: 1.1rem;
    font-weight: 750;
    line-height: 1.5;
    margin: 18px 0 0;
  }
  .summary strong { color: #1d4ed8; font-size: 1.35em; }
  .panel {
    background: #fff;
    border: 1px solid #d5deea;
    border-radius: 8px;
    padding: 24px;
  }
  .section-heading {
    align-items: start;
    border-bottom: 1px solid #dbe4ef;
    display: flex;
    gap: 18px;
    justify-content: space-between;
    padding-bottom: 16px;
  }
  h2 { font-size: 1.55rem; margin: 0; }
  .source-link {
    color: #64748b;
    flex: 0 0 auto;
    font-size: 0.82rem;
    font-weight: 850;
    text-underline-offset: 3px;
  }
  .recipient-list {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .recipient-list li { border-bottom: 1px solid #e2e8f0; }
  .recipient-list li:last-child { border-bottom: 0; }
  .recipient-list a {
    align-items: start;
    color: inherit;
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr) auto;
    margin: 0 -10px;
    padding: 18px 10px;
    text-decoration: none;
  }
  .recipient-list a:hover,
  .recipient-list a:focus-visible {
    background: #eff6ff;
    border-radius: 6px;
    outline: none;
  }
  .recipient-copy { display: grid; gap: 4px; min-width: 0; }
  .recipient-copy > strong {
    font-size: 1.05rem;
    overflow-wrap: anywhere;
  }
  .recipient-list a:hover .recipient-copy > strong,
  .recipient-list a:focus-visible .recipient-copy > strong {
    color: #1d4ed8;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .recipient-copy span { color: #475569; font-size: 0.9rem; font-weight: 750; }
  .recipient-copy small { color: #64748b; font-size: 0.78rem; font-weight: 700; }
  .recipient-amount { text-align: right; }
  .recipient-amount strong { color: #1d4ed8; font-size: 1.05rem; }
  .empty-state h2 { margin-bottom: 8px; }
  .empty-state p { color: #64748b; line-height: 1.5; margin: 0; }
  @media (max-width: 620px) {
    .page { padding: 24px 14px 48px; }
    .panel { padding: 18px; }
    .recipient-list a { grid-template-columns: 1fr; gap: 8px; }
    .recipient-amount { text-align: left; }
  }
</style>
