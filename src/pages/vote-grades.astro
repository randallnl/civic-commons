---
import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const workflowSteps = [
  {
    step: "1",
    title: "Start with online testimony",
    text: "For each bill, we compare online Support and Oppose testimony. Neutral, divided, missing, or too-close testimony does not create an alignment result.",
  },
  {
    step: "2",
    title: "Interpret the vote",
    text: "A yea or nay vote is translated into support or opposition to the bill. ITL, table, and postpone motions are interpreted in the opposite direction because they work against the bill.",
  },
  {
    step: "3",
    title: "Classify the result",
    text: "A recorded vote is classified as aligned or misaligned. A documented nonvote is included among scored actions but is not counted as aligned.",
  },
  {
    step: "4",
    title: "Calculate the percentage",
    text: "Aligned scored votes are divided by all scored voting actions, then multiplied by 100. The result is shown as the legislator's testimony alignment percentage.",
  },
];

const testimonySignals = [
  { label: "Slightly support / oppose", mark: "Leans", text: "The submitted online testimony has a usable direction, though the difference is limited." },
  { label: "Mostly support / oppose", mark: "Clear", text: "The online testimony record has a clear majority position." },
  { label: "Overwhelmingly support / oppose", mark: "Strong", text: "The online testimony record is very strongly one-sided." },
  { label: "Neutral / divided", mark: "Excluded", text: "No alignment result is calculated because testimony does not provide a clear position." },
];

const referenceLinks = [
  { href: "/vote-interpretations", label: "How vote labels work", text: "See how yea, nay, ITL, support, oppose, and testimony alignment labels are interpreted." },
  { href: "/bills", label: "Browse bills", text: "Review bill summaries, online testimony counts, organizational comments, and roll-call links." },
  { href: "/people", label: "Browse legislators", text: "Search current State Representatives and State Senators and compare vote records." },
  { href: "/my-state-rep", label: "Find your legislators", text: "Look up the legislators who represent your address and preview their testimony alignment." },
  { href: "/communities", label: "Explore communities", text: "Connect towns, districts, legislators, candidates, articles, and local updates." },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>How Testimony Alignment Works | NH Deserves Better</title>
    <meta
      name="description"
      content="How NH Deserves Better calculates legislator testimony alignment percentages from online testimony and scored voting actions."
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <section class="hero">
        <p class="eyebrow">Methodology</p>
        <h1>How Testimony Alignment Works</h1>
        <p>
          Testimony alignment is a plain-language percentage showing how often a
          legislator's scored voting actions matched the position inferred from
          online public testimony. It is a starting point for understanding a
          voting record, not the whole story.
        </p>
        <div class="hero-actions">
          <a href="/people">See legislator alignment</a>
          <a href="/vote-interpretations">Vote label guide</a>
        </div>
      </section>

      <section class="graphic-panel">
        <div>
          <p class="eyebrow">The Basic Idea</p>
          <h2>The percentage compares votes to online testimony.</h2>
          <p>
            When online testimony clearly leans support or oppose, we treat that
            as the public testimony position for scoring. Then we compare each
            legislator's vote to that position.
          </p>
        </div>
        <div class="formula" aria-label="Testimony alignment formula">
          <span>Aligned scored votes</span>
          <strong>/</strong>
          <span>All scored voting actions</span>
          <strong>=</strong>
          <span>Testimony alignment</span>
        </div>
      </section>

      <section class="workflow" aria-label="Testimony alignment workflow">
        {workflowSteps.map((item) => (
          <article class="workflow-card">
            <span>{item.step}</span>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </section>

      <section class="split">
        <article class="panel score-panel">
          <p class="eyebrow">Scoring</p>
          <h2>What counts in the percentage</h2>
          <div class="score-row aligned">
            <strong>Aligned vote</strong>
            <span>Numerator + denominator</span>
          </div>
          <div class="score-row misaligned">
            <strong>Misaligned vote</strong>
            <span>Denominator only</span>
          </div>
          <div class="score-row partial">
            <strong>Documented nonvote</strong>
            <span>Denominator only</span>
          </div>
          <p>
            A voting action is scored only when there is both a documented action
            and a clear online testimony position. Neutral, divided, or missing
            testimony is excluded from the percentage.
          </p>
        </article>

        <article class="panel percentage-example">
          <p class="eyebrow">Example</p>
          <h2>12 of 18 scored actions aligned</h2>
          <strong class="example-percentage">67%</strong>
          <small>Testimony aligned</small>
          <p>
            The other six scored actions may be misaligned votes or documented
            nonvotes. The percentage is rounded to the nearest whole number.
          </p>
        </article>
      </section>

      <section class="panel methodology-panel">
        <div class="section-heading">
          <p class="eyebrow">The Formula</p>
          <h2>The displayed percentage is aligned actions divided by scored actions.</h2>
          <p>
            Every eligible voting action contributes once to the denominator.
            Only actions classified as aligned contribute to the numerator.
          </p>
        </div>

        <div class="formula-large">
          <span>Alignment percentage</span>
          <strong>=</strong>
          <span>aligned scored votes</span>
          <strong>/</strong>
          <span>all scored voting actions</span>
          <strong>×</strong>
          <span>100</span>
        </div>

        <div class="method-grid">
          <article>
            <h3>Numerator</h3>
            <p>
              The numerator is the number of scored recorded votes whose
              interpreted bill position matched the online testimony position.
            </p>
          </article>
          <article>
            <h3>Denominator</h3>
            <p>
              The denominator includes aligned votes, misaligned votes, and
              documented nonvotes on bills with a clear testimony position.
            </p>
          </article>
          <article>
            <h3>Excluded actions</h3>
            <p>
              Bills without a clear online testimony position and records without
              an interpretable voting action do not enter either side of the
              calculation.
            </p>
          </article>
        </div>
      </section>

      <section class="panel testimony-panel">
        <div class="section-heading">
          <p class="eyebrow">Eligible Testimony</p>
          <h2>A clear testimony direction is required.</h2>
          <p>
            We describe how strongly online testimony leans support or oppose,
            but each eligible voting action counts once in the displayed
            percentage. Neutral and divided testimony is excluded.
          </p>
        </div>
        <div class="weight-grid">
          {testimonySignals.map((item) => (
            <article>
              <strong>{item.mark}</strong>
              <h3>{item.label}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="panel example-panel">
        <div>
          <p class="eyebrow">Example</p>
          <h2>Why motions matter</h2>
          <p>
            A vote label is not always enough by itself. If the motion is
            <strong> Inexpedient to Legislate </strong> or <strong>ITL</strong>,
            a yea vote supports killing the bill, while a nay vote supports
            keeping the bill alive. That is why vote cards may say something
            like: <em>Voted: Nay: Support - aligned with online testimony.</em>
          </p>
          <p>
            If online testimony supports the bill, the nay vote is counted as
            aligned. If the legislator is absent on that scored action, the
            nonvote remains in the denominator but does not enter the aligned
            numerator.
          </p>
        </div>
        <a href="/vote-interpretations">Read the vote interpretation guide</a>
      </section>

      <section class="references">
        <div class="section-heading">
          <p class="eyebrow">References</p>
          <h2>Where to check the underlying data</h2>
        </div>
        <div class="reference-grid">
          {referenceLinks.map((link) => (
            <a class="reference-card" href={link.href}>
              <strong>{link.label}</strong>
              <span>{link.text}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="panel note">
        <h2>Why This Matters</h2>
        <p>
          New Hampshire has a very large legislature. A simple percentage helps
          make patterns easier to see, but it should be read alongside the underlying
          bill summaries, vote explanations, testimony counts, and roll-call
          records. It is a starting point for accountability, not a substitute
          for reading the record.
        </p>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .back,
  a {
    color: #1f2933;
    font-weight: 900;
  }

  .hero {
    padding: 28px 0 18px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .hero-actions a,
  .example-panel a {
    background: #2563eb;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    box-shadow: none;
    color: white;
    display: inline-flex;
    font-weight: 950;
    padding: 10px 14px;
    text-decoration: none;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.45rem, 7vw, 4.8rem);
    line-height: 0.95;
    margin: 0 0 18px;
  }

  h2 {
    font-size: 1.35rem;
    margin: 0 0 10px;
  }

  p {
    color: #4b5563;
    line-height: 1.65;
    margin: 0;
  }

  .hero p {
    font-size: 1.08rem;
    max-width: 760px;
  }

  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 16px;
  }

  .graphic-panel,
  .panel {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    padding: 20px;
  }

  .graphic-panel {
    align-items: center;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    margin-top: 10px;
  }

  .graphic-panel h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
  }

  .formula {
    display: grid;
    gap: 10px;
  }

  .formula span {
    background: #eef6ff;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    color: #1e3a8a;
    font-weight: 950;
    padding: 12px 14px;
    text-align: center;
  }

  .formula strong {
    color: #b42318;
    font-size: 1.7rem;
    line-height: 1;
    text-align: center;
  }

  .workflow {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 16px;
  }

  .workflow-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    display: grid;
    gap: 10px;
    padding: 18px;
    position: relative;
  }

  .workflow-card span {
    align-items: center;
    background: #b42318;
    border-radius: 999px;
    color: white;
    display: inline-flex;
    font-size: 1.15rem;
    font-weight: 950;
    height: 38px;
    justify-content: center;
    width: 38px;
  }

  .workflow-card h2 {
    font-size: 1.05rem;
    margin: 0;
  }

  .workflow-card p {
    font-size: 0.92rem;
  }

  .split {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    margin-top: 16px;
  }

  .score-panel {
    display: grid;
    gap: 12px;
  }

  .score-row {
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: flex;
    gap: 10px;
    justify-content: space-between;
    padding: 12px;
  }

  .score-row span {
    border-radius: 999px;
    color: white;
    font-weight: 950;
    padding: 7px 10px;
  }

  .score-row.aligned {
    background: #dcfce7;
  }

  .score-row.aligned span {
    background: #166534;
  }

  .score-row.partial {
    background: #fff7ed;
  }

  .score-row.partial span {
    background: #ea580c;
  }

  .score-row.misaligned {
    background: #fee2e2;
  }

  .score-row.misaligned span {
    background: #b42318;
  }

  .percentage-example {
    align-content: start;
    display: grid;
    gap: 10px;
  }

  .example-percentage {
    color: #1e3a5f;
    font-size: clamp(3.4rem, 8vw, 5.8rem);
    font-weight: 950;
    letter-spacing: -0.05em;
    line-height: 0.9;
    margin-top: 8px;
  }

  .percentage-example > small {
    color: #4b5563;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .methodology-panel,
  .testimony-panel {
    display: grid;
    gap: 18px;
    margin-top: 16px;
  }

  .formula-large {
    align-items: center;
    background: #eef6ff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 14px;
  }

  .formula-large span {
    background: white;
    border: 1px solid #dbeafe;
    border-radius: 999px;
    color: #1e3a8a;
    font-weight: 950;
    padding: 9px 12px;
  }

  .formula-large strong {
    color: #b42318;
    font-size: 1.25rem;
  }

  .method-grid,
  .weight-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .weight-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .method-grid article,
  .weight-grid article {
    background: #f8fbff;
    border: 1px solid #dbeafe;
    border-radius: 8px;
    display: grid;
    gap: 8px;
    padding: 14px;
  }

  .method-grid h3,
  .weight-grid h3 {
    color: #1f2933;
    font-size: 1rem;
    margin: 0;
  }

  .weight-grid strong {
    align-items: center;
    background: #1e3a8a;
    border-radius: 999px;
    color: white;
    display: inline-flex;
    font-weight: 950;
    justify-content: center;
    justify-self: start;
    min-width: 56px;
    padding: 7px 10px;
  }

  .example-panel {
    align-items: center;
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-top: 16px;
  }

  .example-panel strong {
    color: #1f2933;
  }

  .example-panel p + p {
    margin-top: 10px;
  }

  .references {
    margin-top: 16px;
  }

  .section-heading {
    margin-bottom: 12px;
  }

  .reference-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .reference-card {
    background: #eef6ff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    color: #1f2933;
    display: grid;
    gap: 8px;
    min-height: 130px;
    padding: 14px;
    text-decoration: none;
  }

  .reference-card strong {
    font-size: 1rem;
  }

  .reference-card span {
    color: #4b5563;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .note {
    margin-top: 16px;
  }

  @media (max-width: 900px) {
    .graphic-panel,
    .split,
    .example-panel {
      grid-template-columns: 1fr;
    }

    .workflow,
    .reference-grid,
    .method-grid,
    .weight-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .workflow,
    .reference-grid,
    .method-grid,
    .weight-grid {
      grid-template-columns: 1fr;
    }

    .example-panel a {
      justify-content: center;
    }
  }
</style>
