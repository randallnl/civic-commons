---
import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const gradeScale = [
  { letter: "A", range: "0.55 to 1.00", label: "Strong positive alignment", className: "grade-a" },
  { letter: "B", range: "0.25 to 0.549", label: "Positive alignment", className: "grade-b" },
  { letter: "C", range: "-0.42 to 0.249", label: "Mixed or close to neutral", className: "grade-c" },
  { letter: "D", range: "-0.60 to -0.421", label: "Negative alignment", className: "grade-d" },
  { letter: "F", range: "Below -0.60", label: "Strong negative alignment", className: "grade-f" },
];

const workflowSteps = [
  {
    step: "1",
    title: "Start with online testimony",
    text: "For each bill, we compare online Support and Oppose testimony. Bills with neutral, divided, missing, or too-close testimony do not move the grade.",
  },
  {
    step: "2",
    title: "Weight the testimony signal",
    text: "A slightly leaning testimony record receives a lighter weight than a mostly or overwhelmingly one-sided testimony record.",
  },
  {
    step: "3",
    title: "Interpret the vote",
    text: "A yea or nay vote is translated into support or opposition to the bill. ITL, table, and postpone motions are handled differently because they are motions against the bill.",
  },
  {
    step: "4",
    title: "Score the record",
    text: "Aligned votes are positive, misaligned votes are negative, and nonvotes are always a smaller negative accountability score. The weighted average becomes the letter grade.",
  },
];

const testimonyWeights = [
  { label: "Slightly support / oppose", weight: "0.35", text: "The public testimony signal leans one way, but not strongly." },
  { label: "Mostly support / oppose", weight: "0.70", text: "The testimony signal is clearly one-sided." },
  { label: "Overwhelmingly support / oppose", weight: "1.00", text: "The testimony signal is very strongly one-sided." },
  { label: "Neutral / divided", weight: "0", text: "The bill is not scored because testimony does not give a clear position." },
];

const referenceLinks = [
  { href: "/vote-interpretations", label: "How vote labels work", text: "See how yea, nay, ITL, support, oppose, and testimony alignment labels are interpreted." },
  { href: "/bills", label: "Browse bills", text: "Review bill summaries, online testimony counts, organizational comments, and roll-call links." },
  { href: "/people", label: "Browse legislators", text: "Search current State Representatives and State Senators and compare vote records." },
  { href: "/my-state-rep", label: "Find your legislators", text: "Look up the legislators who represent your address and preview their grades." },
  { href: "/communities", label: "Explore communities", text: "Connect towns, districts, legislators, candidates, articles, and local updates." },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>How Vote Grades Work | NH Deserves Better</title>
    <meta
      name="description"
      content="How NH Deserves Better calculates legislator vote grades from online testimony alignment, voting actions, and documented non-votes."
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <section class="hero">
        <p class="eyebrow">Methodology</p>
        <h1>How Vote Grades Work</h1>
        <p>
          Vote grades are meant to be a plain-language accountability signal,
          not the whole story. They help visitors quickly understand how often a
          legislator's voting record lines up with the position inferred from
          online public testimony, while also accounting for missed votes.
        </p>
        <div class="hero-actions">
          <a href="/people">See legislator grades</a>
          <a href="/vote-interpretations">Vote label guide</a>
        </div>
      </section>

      <section class="graphic-panel">
        <div>
          <p class="eyebrow">The Basic Idea</p>
          <h2>Grades compare votes to online testimony.</h2>
          <p>
            When online testimony clearly leans support or oppose, we treat that
            as the public testimony position for scoring. Then we compare each
            legislator's vote to that position.
          </p>
        </div>
        <div class="formula" aria-label="Vote grade formula">
          <span>Testimony strength</span>
          <strong>+</strong>
          <span>Vote interpretation</span>
          <strong>=</strong>
          <span>Weighted score</span>
        </div>
      </section>

      <section class="workflow" aria-label="Vote grade workflow">
        {workflowSteps.map((item) => (
          <article class="workflow-card">
            <span>{item.step}</span>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </section>

      <section class="split">
        <article class="panel score-panel">
          <p class="eyebrow">Scoring</p>
          <h2>How each vote moves the score</h2>
          <div class="score-row aligned">
            <strong>Aligned vote</strong>
            <span>+1.0 x weight</span>
          </div>
          <div class="score-row partial">
            <strong>Documented nonvote</strong>
            <span>-0.3 x weight</span>
          </div>
          <div class="score-row misaligned">
            <strong>Misaligned vote</strong>
            <span>-1.0 x weight</span>
          </div>
          <p>
            Votes are only scored when we have both a voting action and a clear
            online testimony position. If testimony is neutral, divided, or
            missing, that bill can still appear elsewhere, but it does not drive
            the grade.
          </p>
        </article>

        <article class="panel grade-scale">
          <p class="eyebrow">Scale</p>
          <h2>Letter Scale</h2>
          {gradeScale.map((grade) => (
            <div class="grade-row">
              <span class:list={["grade-badge", grade.className]}>{grade.letter}</span>
              <div>
                <strong>{grade.range}</strong>
                <small>{grade.label}</small>
              </div>
            </div>
          ))}
        </article>
      </section>

      <section class="panel methodology-panel">
        <div class="section-heading">
          <p class="eyebrow">The Formula</p>
          <h2>The grade uses a weighted average from -1 to +1.</h2>
          <p>
            Each scored vote receives a positive or negative value, then that
            value is multiplied by the strength of the online testimony signal.
            The final score is the weighted net score divided by the total
            testimony weight.
          </p>
        </div>

        <div class="formula-large">
          <span>Weighted average</span>
          <strong>=</strong>
          <span>sum of weighted vote scores</span>
          <strong>/</strong>
          <span>sum of testimony weights</span>
        </div>

        <div class="method-grid">
          <article>
            <h3>Vote values</h3>
            <p>
              A recorded vote that aligns with testimony is positive. A recorded
              vote that goes against testimony is negative. Any documented
              nonvote, including absent, present, or present-not-voting, is
              scored as a smaller negative value because the legislator did not
              cast a vote on the motion.
            </p>
          </article>
          <article>
            <h3>Motion context</h3>
            <p>
              Normal motions treat yea as support and nay as opposition. On
              motions that work against a bill, such as ITL, table, or
              indefinitely postpone, the meaning flips: yea opposes the bill and
              nay supports the bill.
            </p>
          </article>
          <article>
            <h3>Nonvotes</h3>
            <p>
              Nonvotes are always negative in the grade model. They are weighted
              at -0.3 instead of -1.0, so missing a vote matters but is not
              treated the same as casting a recorded vote against the testimony
              position.
            </p>
          </article>
        </div>
      </section>

      <section class="panel testimony-panel">
        <div class="section-heading">
          <p class="eyebrow">Testimony Weights</p>
          <h2>Stronger public testimony signals count more.</h2>
          <p>
            The same vote matters more when online testimony is overwhelmingly
            one-sided, and less when the testimony signal is only slightly
            tilted. Neutral and divided testimony does not affect the grade.
          </p>
        </div>
        <div class="weight-grid">
          {testimonyWeights.map((item) => (
            <article>
              <strong>{item.weight}</strong>
              <h3>{item.label}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="panel example-panel">
        <div>
          <p class="eyebrow">Example</p>
          <h2>Why motions matter</h2>
          <p>
            A vote label is not always enough by itself. If the motion is
            <strong> Inexpedient to Legislate </strong> or <strong>ITL</strong>,
            a yea vote supports killing the bill, while a nay vote supports
            keeping the bill alive. That is why vote cards may say something
            like: <em>Voted: Nay: Support - aligned with online testimony.</em>
          </p>
          <p>
            If online testimony overwhelmingly supports the bill, that aligned
            vote contributes <strong>+1.0</strong>. If the legislator is absent
            on a scored vote with overwhelming testimony, the nonvote contributes
            <strong>-0.3</strong>.
          </p>
        </div>
        <a href="/vote-interpretations">Read the vote interpretation guide</a>
      </section>

      <section class="references">
        <div class="section-heading">
          <p class="eyebrow">References</p>
          <h2>Where to check the underlying data</h2>
        </div>
        <div class="reference-grid">
          {referenceLinks.map((link) => (
            <a class="reference-card" href={link.href}>
              <strong>{link.label}</strong>
              <span>{link.text}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="panel note">
        <h2>Why This Matters</h2>
        <p>
          New Hampshire has a very large legislature. A simple grade helps make
          patterns easier to see, but it should be read alongside the underlying
          bill summaries, vote explanations, testimony counts, and roll-call
          records. It is a starting point for accountability, not a substitute
          for reading the record.
        </p>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .back,
  a {
    color: #1f2933;
    font-weight: 900;
  }

  .hero {
    padding: 28px 0 18px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .hero-actions a,
  .example-panel a {
    background: #2563eb;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    box-shadow: none;
    color: white;
    display: inline-flex;
    font-weight: 950;
    padding: 10px 14px;
    text-decoration: none;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.45rem, 7vw, 4.8rem);
    line-height: 0.95;
    margin: 0 0 18px;
  }

  h2 {
    font-size: 1.35rem;
    margin: 0 0 10px;
  }

  p {
    color: #4b5563;
    line-height: 1.65;
    margin: 0;
  }

  .hero p {
    font-size: 1.08rem;
    max-width: 760px;
  }

  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 16px;
  }

  .graphic-panel,
  .panel {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    padding: 20px;
  }

  .graphic-panel {
    align-items: center;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    margin-top: 10px;
  }

  .graphic-panel h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
  }

  .formula {
    display: grid;
    gap: 10px;
  }

  .formula span {
    background: #eef6ff;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    color: #1e3a8a;
    font-weight: 950;
    padding: 12px 14px;
    text-align: center;
  }

  .formula strong {
    color: #b42318;
    font-size: 1.7rem;
    line-height: 1;
    text-align: center;
  }

  .workflow {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 16px;
  }

  .workflow-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    display: grid;
    gap: 10px;
    padding: 18px;
    position: relative;
  }

  .workflow-card span {
    align-items: center;
    background: #b42318;
    border-radius: 999px;
    color: white;
    display: inline-flex;
    font-size: 1.15rem;
    font-weight: 950;
    height: 38px;
    justify-content: center;
    width: 38px;
  }

  .workflow-card h2 {
    font-size: 1.05rem;
    margin: 0;
  }

  .workflow-card p {
    font-size: 0.92rem;
  }

  .split {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    margin-top: 16px;
  }

  .score-panel {
    display: grid;
    gap: 12px;
  }

  .score-row {
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: flex;
    gap: 10px;
    justify-content: space-between;
    padding: 12px;
  }

  .score-row span {
    border-radius: 999px;
    color: white;
    font-weight: 950;
    padding: 7px 10px;
  }

  .score-row.aligned {
    background: #dcfce7;
  }

  .score-row.aligned span {
    background: #166534;
  }

  .score-row.partial {
    background: #fff7ed;
  }

  .score-row.partial span {
    background: #ea580c;
  }

  .score-row.misaligned {
    background: #fee2e2;
  }

  .score-row.misaligned span {
    background: #b42318;
  }

  .grade-scale {
    display: grid;
    gap: 10px;
  }

  .methodology-panel,
  .testimony-panel {
    display: grid;
    gap: 18px;
    margin-top: 16px;
  }

  .formula-large {
    align-items: center;
    background: #eef6ff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 14px;
  }

  .formula-large span {
    background: white;
    border: 1px solid #dbeafe;
    border-radius: 999px;
    color: #1e3a8a;
    font-weight: 950;
    padding: 9px 12px;
  }

  .formula-large strong {
    color: #b42318;
    font-size: 1.25rem;
  }

  .method-grid,
  .weight-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .weight-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .method-grid article,
  .weight-grid article {
    background: #f8fbff;
    border: 1px solid #dbeafe;
    border-radius: 8px;
    display: grid;
    gap: 8px;
    padding: 14px;
  }

  .method-grid h3,
  .weight-grid h3 {
    color: #1f2933;
    font-size: 1rem;
    margin: 0;
  }

  .weight-grid strong {
    align-items: center;
    background: #1e3a8a;
    border-radius: 999px;
    color: white;
    display: inline-flex;
    font-weight: 950;
    justify-content: center;
    justify-self: start;
    min-width: 56px;
    padding: 7px 10px;
  }

  .grade-row {
    align-items: center;
    display: grid;
    gap: 12px;
    grid-template-columns: 58px 1fr;
  }

  .grade-badge {
    align-items: center;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    color: #fefce8;
    display: inline-flex;
    font-size: 2rem;
    font-weight: 950;
    height: 54px;
    justify-content: center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    width: 54px;
  }

  .grade-row strong,
  .grade-row small {
    display: block;
  }

  .grade-row small {
    color: #4b5563;
    font-weight: 800;
    margin-top: 2px;
  }

  .grade-a {
    background: #166534;
  }

  .grade-b {
    background: #65a30d;
  }

  .grade-c {
    background: #ca8a04;
  }

  .grade-d {
    background: #ea580c;
  }

  .grade-f {
    background: #b42318;
  }

  .example-panel {
    align-items: center;
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-top: 16px;
  }

  .example-panel strong {
    color: #1f2933;
  }

  .example-panel p + p {
    margin-top: 10px;
  }

  .references {
    margin-top: 16px;
  }

  .section-heading {
    margin-bottom: 12px;
  }

  .reference-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .reference-card {
    background: #eef6ff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    color: #1f2933;
    display: grid;
    gap: 8px;
    min-height: 130px;
    padding: 14px;
    text-decoration: none;
  }

  .reference-card strong {
    font-size: 1rem;
  }

  .reference-card span {
    color: #4b5563;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .note {
    margin-top: 16px;
  }

  @media (max-width: 900px) {
    .graphic-panel,
    .split,
    .example-panel {
      grid-template-columns: 1fr;
    }

    .workflow,
    .reference-grid,
    .method-grid,
    .weight-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .workflow,
    .reference-grid,
    .method-grid,
    .weight-grid {
      grid-template-columns: 1fr;
    }

    .example-panel a {
      justify-content: center;
    }
  }
</style>
