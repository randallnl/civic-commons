---
export const prerender = false;

import { env } from "cloudflare:workers";
import FilterBar from "../components/FilterBar.astro";
import FreeStaterPersonCard from "../components/FreeStaterPersonCard.astro";
import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getFreeStateAlignedPeople } from "../lib/freeStaterDirectory";

const freeStateLogoUrl = organizationAssetUrl("freestateprojectlogo.png");

const timelineMilestones = [
  {
    year: "2001",
    era: "foundation",
    title: "The proposal is published",
    summary: "Jason Sorens publishes the essay that proposes concentrating activists in one state.",
    detail: "Sorens's July 23 essay in The Libertarian Enterprise proposed using a pledge to coordinate a move to a small state. Its first outline placed state selection at 20,000 participants.",
    sourceLabel: "Read the founding essay",
    sourceUrl: "https://ncc-1776.org/archives/tle2001/libe131-20010723-03.html",
  },
  {
    year: "2003",
    era: "foundation",
    title: "New Hampshire is selected",
    summary: "After a 5,000-signature threshold and a vote among candidate states, the project announces New Hampshire.",
    detail: "The project's history says more than 2,500 ballots were cast in a Condorcet vote among ten candidate states, with the October 1 announcement selecting New Hampshire.",
    sourceLabel: "FSP history",
    sourceUrl: "https://www.fsp.org/history/",
  },
  {
    year: "2004",
    era: "growth",
    title: "First Porcupine Freedom Festival",
    summary: "The first PorcFest is reported in Lancaster as the movement begins building a recurring public gathering.",
    detail: "Contemporary ABC reporting describes the 2004 festival and reports more than 6,000 committed members and more than 300 participants then residing in New Hampshire. The reported resident figure is not a completed-moves count.",
    sourceLabel: "ABC News reporting",
    sourceUrl: "https://abcnews.com/amp/US/story?id=96696&page=1",
  },
  {
    year: "2006–07",
    era: "growth",
    title: "Early-move campaign and first electoral milestone",
    summary: "The First 1000 campaign launches; the project's history identifies Joel Winters as its first mover elected to the NH House.",
    detail: "A contemporary reproduction of a 2006 FSP release describes the First 1000 campaign. FSP's history identifies Winters as the first mover elected to the House in the November 2006 election. These are organizational and contemporary-source claims, respectively, not a complete mover roster.",
    sourceLabel: "First 1000 contemporary reproduction",
    sourceUrl: "https://outoftheinkwell.blogspot.com/2006/01/bothered-by-illegal-domestic-spying.html",
  },
  {
    year: "2011–13",
    era: "public-life",
    title: "Leadership and jury-instruction legislation",
    summary: "Carla Gericke's FSP presidency begins in 2011; a 2012 law takes effect in 2013 allowing a defense to inform juries about judging facts and law.",
    detail: "FSP's legacy team page dates Gericke's presidency from March 2011; 2013 Concord city minutes independently identify her as FSP president. HB 146 became Chapter 243 in 2012 and took effect January 1, 2013. The law's legislative outcome should not be used alone to assign organizational credit.",
    sourceLabel: "HB 146, Chapter 243",
    sourceUrl: "https://gc.nh.gov/legislation/2012/HB0146.html",
  },
  {
    year: "2016",
    era: "growth",
    title: "20,000 pledge threshold triggers a move commitment",
    summary: "FSP reports 20,000 Statements of Intent and begins a five-year relocation commitment period.",
    detail: "The project's announcement reports nearly 2,000 people already relocated when the threshold was reached. A signed Statement of Intent is not evidence that a person completed a move.",
    sourceLabel: "FSP trigger announcement",
    sourceUrl: "https://legacy.fsp.org/free-state-project-triggers-the-move-libertarians-new-hampshire/",
  },
  {
    year: "2017",
    era: "public-life",
    title: "Concealed-carry bill becomes law",
    summary: "SB 12 is signed as Chapter 1, effective on the day of signature.",
    detail: "The official docket records Senate passage of 13–10 and House passage of 200–97. Those results document the law, but do not by themselves establish FSP's contribution or identify the organizational status of individual legislators.",
    sourceLabel: "Official SB 12 docket",
    sourceUrl: "https://gc.nh.gov/bill_status/legacy/bs2016/Bill_docket.aspx?lsr=140&q=1&sortoption=&sy=2017&txtbillnumber=Sb12&txtsessionyear=2017",
  },
  {
    year: "2021–22",
    era: "public-life",
    title: "Education and local-government controversies",
    summary: "The state creates Education Freedom Accounts; Croydon's school-budget conflict brings national attention to local FSP-linked participants.",
    detail: "HB 2, Chapter 91 created the EFA program in 2021. In 2022, NHPR reported that Ian and Jody Underwood had moved to Croydon as part of FSP and described their roles in the proposed school-budget cut. That reports a person-specific connection, not organizational direction of the school board or SDGANH.",
    sourceLabel: "NHPR on Croydon",
    sourceUrl: "https://www.nhpr.org/nh-news/2022-03-31/in-croydon-school-budget-cuts-prompt-a-reckoning-on-the-role-of-local-government",
  },
  {
    year: "2023",
    era: "current",
    title: "Eric Brakey becomes executive director",
    summary: "FSP names former Maine state senator Eric Brakey as its next executive director.",
    detail: "NHPR reported the selection November 30, 2023, and FSP's leadership page dates the start of his tenure to December 2023. This page uses the month-level date reflected by those sources.",
    sourceLabel: "NHPR reporting",
    sourceUrl: "https://www.nhpr.org/politics/2023-11-30/free-state-project-taps-maine-state-senator-as-its-next-leader",
  },
  {
    year: "2025",
    era: "public-life",
    title: "EFA eligibility expands",
    summary: "SB 295 becomes Chapter 75, changing EFA eligibility and enrollment provisions.",
    detail: "The enacted law removed the general income eligibility ceiling while retaining priority categories and an enrollment-cap mechanism. The enactment documents a policy outcome; the supplied research does not assign it to a single organization or group of legislators.",
    sourceLabel: "SB 295, enacted text",
    sourceUrl: "https://gc.nh.gov/bill_status/legacy/bs2016/billText.aspx?id=965&sy=2025&txtFormat=html",
  },
  {
    year: "2026",
    era: "current",
    title: "A changing organizational landscape",
    summary: "Separate political organizations emerge while Carla Gericke departs the FSP board and PorcFest production.",
    detail: "Reporting on a newly launched Free State Party says its name alone does not establish FSP authorization or affiliation. Separately, FSP announced in April that Gericke had left her chair and board roles and withdrawn from PorcFest production.",
    sourceLabel: "FSP's April 2026 announcement",
    sourceUrl: "https://community.fsp.org/era-defining-leader-carla-gericke-steps-down-and-passes-the-fsp-baton/",
  },
];

const relationshipRoster = [
  {
    id: "fsp",
    category: "Project and events",
    name: "Free State Project",
    type: "Core organization",
    relationship: "The hub used for this map",
    description: "The organization behind the pledge-based migration project. Its own history is used for its internal milestones; other claims on this page use government records or independent reporting where available.",
    sourceLabel: "FSP mission and history",
    sourceUrl: "https://www.fsp.org/learn/mission/",
  },
  {
    id: "porcfest-liberty-forum",
    category: "Project and events",
    name: "PorcFest & Liberty Forum",
    type: "Events",
    relationship: "Project-run gatherings",
    description: "PorcFest is documented in the supplied research as a recurring FSP festival. Liberty Forum's own retrospective identifies 2007 as its first year. They are places where participants, advocates, candidates, and speakers may appear; attendance or a speaking role does not establish membership.",
    sourceLabel: "Liberty Forum's history",
    sourceUrl: "https://nhlibertyforum.com/why-this-conference/",
  },
  {
    id: "nhla",
    category: "Independent organizations",
    name: "New Hampshire Liberty Alliance",
    type: "Advocacy organization",
    relationship: "Independent organization; documented network proximity",
    description: "NHLA dates its own founding to November 2003. Its organization directory lists both NHLA and FSP, which documents directory-level network proximity—not shared governance, funding, or formal affiliation.",
    sourceLabel: "NHLA organizations directory",
    sourceUrl: "https://www.nhliberty.org/organizations/",
  },
  {
    id: "sdganh",
    category: "Independent organizations",
    name: "School District Governance Association of NH",
    type: "Education advocacy organization",
    relationship: "Documented person-specific bridge",
    description: "SDGANH identifies Jody Underwood as a founding member, past president, and secretary. NHPR reported that Jody and Ian Underwood moved to Croydon in 2007 as part of FSP. That is evidence about an individual, not proof that SDGANH is owned, directed, funded, or authorized by FSP.",
    sourceLabel: "SDGANH about page",
    sourceUrl: "https://sdganh.org/about/",
  },
  {
    id: "afp-nh",
    category: "Independent organizations",
    name: "Americans for Prosperity–New Hampshire",
    type: "Advocacy organization",
    relationship: "Issue-specific parallel advocacy",
    description: "FSP, NHLA, and AFP-NH each publicly advocated for 2025 EFA expansion in distinct ways. Those parallel advocacy records do not establish that FSP directed AFP-NH or that any group controlled the final bill.",
    sourceLabel: "AFP-NH's 2025 EFA statement",
    sourceUrl: "https://americansforprosperity.org/press-release/afp-nh-praises-new-hampshire-legislature-for-voting-to-make-efas-universal/",
  },
  {
    id: "porcupine-real-estate",
    category: "Businesses",
    name: "Porcupine Real Estate",
    type: "Business",
    relationship: "Founder-specific business connection",
    description: "FSP's leadership page identifies Mark Warden as an early mover, board director, and founder of Porcupine Real Estate. The company's description of serving movers and liberty-community clients is context for its business audience, not evidence of political control or activity.",
    sourceLabel: "Porcupine Real Estate team page",
    sourceUrl: "https://porcupinerealestate.com/our-agents/",
  },
  {
    id: "josiah-bartlett",
    category: "Distinct entities",
    name: "Josiah Bartlett Center for Public Policy",
    type: "Policy organization",
    relationship: "Pre-FSP organization; no affiliation conclusion",
    description: "The center says it was launched in 1992 and elsewhere references a 1993 founding—both before FSP began in 2001. A shared listing in NHLA's directory does not establish an FSP affiliation.",
    sourceLabel: "Josiah Bartlett Center history",
    sourceUrl: "https://jbartlett.org/about-us/",
  },
  {
    id: "lpnh",
    category: "Distinct entities",
    name: "Libertarian Party of New Hampshire",
    type: "Political party organization",
    relationship: "Separate entity; no FSP relationship conclusion",
    description: "The supplied research calls for separate role histories and primary records before any relationship label is assigned. This roster therefore does not treat party rhetoric, shared ideology, or individual overlap as evidence that LPNH is an FSP affiliate.",
    sourceLabel: "NHPR reporting on LPNH",
    sourceUrl: "https://www.nhpr.org/nh-news/2026-05-28/nh-libertarians-newhampshire-ejected-party-jeremy-kauffman",
  },
  {
    id: "free-state-party",
    category: "Distinct entities",
    name: "Free State Party",
    type: "New political organization",
    relationship: "Reported as separate; not treated as an FSP subsidiary",
    description: "Independent Political Report described a newly launched organization in 2026. Its name does not establish that it is FSP-authorized, an FSP affiliate, or a ballot-qualified political party. Primary governance and registration records are still needed.",
    sourceLabel: "Independent Political Report",
    sourceUrl: "https://independentpoliticalreport.com/2026/03/new-free-state-party-organization-launches-in-new-hampshire/",
  },
];

const keyPeople = [
  {
    id: "jason-sorens",
    name: "Jason Sorens",
    role: "Founder and author of the 2001 proposal",
    relationship: "Direct project founder",
    summary: "Published the founding essay while at Yale, proposing a pledge-based strategy to concentrate activists in one state.",
    sourceLabel: "Founding essay",
    sourceUrl: "https://ncc-1776.org/archives/tle2001/libe131-20010723-03.html",
  },
  {
    id: "carla-gericke",
    name: "Carla Gericke",
    role: "Former FSP president, chair, and board member",
    relationship: "Direct organizational leadership",
    summary: "FSP's legacy biography dates her PorcFest organizing to 2009–10 and her presidency from 2011. FSP announced her departure from chair and board roles in April 2026.",
    sourceLabel: "FSP's April 2026 announcement",
    sourceUrl: "https://community.fsp.org/era-defining-leader-carla-gericke-steps-down-and-passes-the-fsp-baton/",
  },
  {
    id: "mark-warden",
    name: "Mark Warden",
    role: "Early mover, FSP board director, and entrepreneur",
    relationship: "Leadership and business bridge",
    summary: "FSP identifies Warden as an early mover, board director, and founder of Porcupine Real Estate. That supports a founder-specific connection to the business, not a claim that the business is an FSP arm.",
    sourceLabel: "FSP leadership page",
    sourceUrl: "https://www.fsp.org/learn/leaders/",
  },
  {
    id: "jody-underwood",
    name: "Jody Underwood",
    role: "SDGANH founder and former president",
    relationship: "Documented person-specific bridge",
    summary: "SDGANH describes Underwood as a founding member, past president, and secretary. NHPR reported that she and Ian Underwood moved to Croydon in 2007 as part of FSP.",
    sourceLabel: "NHPR on Croydon",
    sourceUrl: "https://www.nhpr.org/nh-news/2022-03-31/in-croydon-school-budget-cuts-prompt-a-reckoning-on-the-role-of-local-government",
  },
  {
    id: "joel-winters",
    name: "Joel Winters",
    role: "New Hampshire House member",
    relationship: "FSP history's first elected mover",
    summary: "FSP's history identifies Winters as its first mover elected to the NH House in 2006. He is listed among the sponsors of 2007's HB 685, the REAL ID restriction law.",
    sourceLabel: "HB 685, Chapter 243",
    sourceUrl: "https://gc.nh.gov/legislation/2007/hb0685.html",
  },
  {
    id: "keith-ammon",
    name: "Keith Ammon",
    role: "New Hampshire legislator",
    relationship: "Reported FSP mover; bill sponsor",
    summary: "NHPR identified Ammon as an FSP mover in 2018. He was the prime sponsor of 2025's HB 302, which authorized a limited state strategic reserve investment option; the law does not establish a completed purchase or investment return.",
    sourceLabel: "NHPR's FSP explainer",
    sourceUrl: "https://www.nhpr.org/nh-news/2018-04-12/you-asked-we-answered-what-is-the-free-state-project",
  },
  {
    id: "eric-brakey",
    name: "Eric Brakey",
    role: "FSP executive director since December 2023",
    relationship: "Direct organizational leadership",
    summary: "NHPR reported his selection in late November 2023; FSP's leadership page gives a December 2023 start date.",
    sourceLabel: "NHPR reporting",
    sourceUrl: "https://www.nhpr.org/politics/2023-11-30/free-state-project-taps-maine-state-senator-as-its-next-leader",
  },
  {
    id: "jason-osborne",
    name: "Jason Osborne",
    role: "New Hampshire House Majority Leader",
    relationship: "Political-context figure; membership not established here",
    summary: "NHPR reported on his March 2026 Liberty Forum speech encouraging political participation and coalition work. This records the event and speech, not FSP membership or a formal leadership role.",
    sourceLabel: "NHPR on Liberty Forum",
    sourceUrl: "https://www.nhpr.org/nh-news/2026-03-09/free-staters-freestateproject-nh-newhampshire-jason-osbrne-libertarians-free-state-liberty-forum",
  },
];

const relationshipCategories = [...new Set(relationshipRoster.map((entry) => entry.category))];
const filterName = cleanFilter(Astro.url.searchParams.get("q"));
const filterType = cleanFilter(Astro.url.searchParams.get("type")) || "all";
const filterBody = cleanFilter(Astro.url.searchParams.get("body")) || "all";
const filterParty = cleanFilter(Astro.url.searchParams.get("party")) || "all";
const filterCounty = cleanFilter(Astro.url.searchParams.get("county"));
const filterTown = cleanFilter(Astro.url.searchParams.get("town"));
const sort = cleanFilter(Astro.url.searchParams.get("sort"));
let people = [];
let directoryError = "";

try {
  people = await getFreeStateAlignedPeople(env.d1_db);
} catch (error) {
  console.error("Unable to load Free State Aligned directory", error);
  directoryError = "The Free State Aligned directory is temporarily unavailable.";
}

const countyOptions = uniqueOptions(people.flatMap((person) => person.counties));
const townOptions = uniqueOptions(people.flatMap((person) => person.towns));
const legislatorCount = people.filter((person) => person.isCurrentLegislator).length;
const candidateCount = people.filter((person) => person.isCurrentCandidate).length;
const hasDirectoryFilters =
  filterName ||
  filterType !== "all" ||
  filterBody !== "all" ||
  filterParty !== "all" ||
  filterCounty ||
  filterTown;

function organizationAssetUrl(filename = "") {
  return `/api/organization-assets/${String(filename)
    .split("/")
    .map((part) => encodeURIComponent(part))
    .join("/")}`;
}

function cleanFilter(value = "") {
  return String(value || "").trim();
}

function uniqueOptions(values = []) {
  return [...new Set(values.flat().map(cleanFilter).filter(Boolean))]
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Free State Project Timeline & Relationship Map | NH Deserves Better</title>
    <meta
      name="description"
      content="Explore a sourced timeline, relationship map, and roster of Free State Project-connected organizations, businesses, and people in New Hampshire."
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Research guide · New Hampshire</p>
          <h1>Free State Project: Timeline &amp; Relationship Map</h1>
          <p class="lede">
            A visual starting point for understanding the Free State Project’s
            history, the people and organizations around it, and the evidence
            behind each connection. Follow the dots for a quick overview, then
            jump to the sourced record below.
          </p>
          <div class="hero-actions" aria-label="Explore this guide">
            <a class="primary-action" href="#timeline">Explore the timeline</a>
            <a class="secondary-action" href="#relationship-map">View the relationship map</a>
          </div>
        </div>
        <div class="hero-logo">
          <img src={freeStateLogoUrl} alt="Free State Project logo" data-fsp-logo />
          <span class="logo-fallback" aria-hidden="true">FSP</span>
        </div>
      </section>

      <section class="snapshot-panel" aria-label="Free State Project overview">
        <article>
          <span>2001</span>
          <strong>Founding proposal</strong>
          <p>Jason Sorens publishes the pledge-based migration concept.</p>
        </article>
        <article>
          <span>2003</span>
          <strong>New Hampshire selected</strong>
          <p>The project announces its winning destination after a state vote.</p>
        </article>
        <article>
          <span>2016</span>
          <strong>20,000 pledges</strong>
          <p>FSP reports the threshold that activated a five-year move commitment.</p>
        </article>
        <article>
          <span>2026</span>
          <strong>Still evolving</strong>
          <p>Leadership changes and separate political entities complicate the landscape.</p>
        </article>
      </section>

      <section class="reading-note" aria-labelledby="reading-note-title">
        <div>
          <p class="eyebrow">How to read this map</p>
          <h2 id="reading-note-title">A connection is not automatically an affiliation.</h2>
        </div>
        <p>
          This guide separates direct project leadership and project-run events from
          person-specific connections, parallel advocacy, and distinct organizations.
          A source may show a shared speaker, a directory listing, or a person’s role;
          it does not by itself prove shared funding, control, membership, or responsibility
          for a policy outcome.
        </p>
      </section>

      <section class="timeline-section" id="timeline" aria-labelledby="timeline-title">
        <div class="section-intro">
          <div>
            <p class="eyebrow">At a glance</p>
            <h2 id="timeline-title">A timeline you can scan in a minute</h2>
          </div>
          <p>
            Select an era to narrow the view. Each milestone links to a short explanation
            and its source farther down the page.
          </p>
        </div>

        <div class="timeline-filters" role="group" aria-label="Filter timeline milestones">
          <button type="button" class="is-active" data-timeline-filter="all" aria-pressed="true">All milestones</button>
          <button type="button" data-timeline-filter="foundation" aria-pressed="false">Foundation</button>
          <button type="button" data-timeline-filter="growth" aria-pressed="false">Growth</button>
          <button type="button" data-timeline-filter="public-life" aria-pressed="false">Public life</button>
          <button type="button" data-timeline-filter="current" aria-pressed="false">Current landscape</button>
        </div>

        <ol class="visual-timeline" data-timeline-list>
          {timelineMilestones.map((milestone) => (
            <li data-timeline-item data-era={milestone.era}>
              <a href={`#milestone-${milestone.year.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>
                <span class="timeline-year">{milestone.year}</span>
                <strong>{milestone.title}</strong>
                <span>{milestone.summary}</span>
                <small>Read the record ↓</small>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="relationship-section" id="relationship-map" aria-labelledby="relationship-map-title">
        <div class="section-intro">
          <div>
            <p class="eyebrow">Relationship map</p>
            <h2 id="relationship-map-title">Start at the center. Read every edge.</h2>
          </div>
          <p>
            These are relationship labels, not a claim that every organization is part of the
            Free State Project. Choose a node to see the supporting explanation in the roster.
          </p>
        </div>

        <div class="relationship-map" aria-label="Free State Project relationship map">
          <div class="map-hub">
            <img src={freeStateLogoUrl} alt="" data-fsp-logo />
            <span class="hub-logo-fallback" aria-hidden="true">FSP</span>
            <strong>Free State<br />Project</strong>
            <span>Core organization</span>
          </div>
          <div class="map-orbits">
            <a class="map-node project-node" href="#porcfest-liberty-forum">
              <span class="node-icon" aria-hidden="true">✦</span>
              <strong>Project events</strong>
              <small>PorcFest &amp; Liberty Forum</small>
            </a>
            <a class="map-node org-node" href="#nhla">
              <span class="node-icon" aria-hidden="true">↔</span>
              <strong>Independent groups</strong>
              <small>Network proximity or issue overlap</small>
            </a>
            <a class="map-node person-node" href="#people-in-the-record">
              <span class="node-icon" aria-hidden="true">●</span>
              <strong>People</strong>
              <small>Leadership, movers, event figures</small>
            </a>
            <a class="map-node business-node" href="#porcupine-real-estate">
              <span class="node-icon" aria-hidden="true">⌂</span>
              <strong>Businesses</strong>
              <small>Founder-specific connections</small>
            </a>
            <a class="map-node boundary-node" href="#free-state-party">
              <span class="node-icon" aria-hidden="true">!</span>
              <strong>Important boundaries</strong>
              <small>Distinct entities ≠ affiliates</small>
            </a>
          </div>
        </div>

        <div class="relationship-legend" aria-label="Relationship label legend">
          <span><b class="legend-dot direct"></b> Direct project role or project-run event</span>
          <span><b class="legend-dot bridge"></b> Documented person-specific or issue-specific connection</span>
          <span><b class="legend-dot boundary"></b> Separate entity; no affiliation conclusion</span>
        </div>
      </section>

      <section class="people-callouts" aria-labelledby="people-callouts-title">
        <div class="section-intro compact-intro">
          <div>
            <p class="eyebrow">Key people</p>
            <h2 id="people-callouts-title">Who appears in this record?</h2>
          </div>
          <p>These callouts are shortcuts to a fuller, sourced explanation below—not a complete member list.</p>
        </div>
        <div class="people-callout-grid">
          {keyPeople.map((person) => (
            <a href={`#${person.id}`}>
              <span>{person.relationship}</span>
              <strong>{person.name}</strong>
              <small>{person.role}</small>
              <b>Read profile ↓</b>
            </a>
          ))}
        </div>
      </section>

      <section class="detailed-record" aria-labelledby="record-title">
        <div class="section-intro">
          <div>
            <p class="eyebrow">Detailed record</p>
            <h2 id="record-title">Milestones, people, and organizations</h2>
          </div>
          <p>
            Each card states what the cited record supports, and where the evidence stops.
            External sources open in a new tab.
          </p>
        </div>

        <div class="record-group" id="timeline-record">
          <div class="record-group-heading">
            <p class="eyebrow">Timeline detail</p>
            <h3>Milestone record</h3>
          </div>
          <div class="milestone-records">
            {timelineMilestones.map((milestone) => (
              <article id={`milestone-${milestone.year.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>
                <span class="record-year">{milestone.year}</span>
                <div>
                  <h4>{milestone.title}</h4>
                  <p>{milestone.detail}</p>
                  <a class="source-link" href={milestone.sourceUrl} target="_blank" rel="noreferrer">
                    {milestone.sourceLabel} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="record-group" id="people-in-the-record">
          <div class="record-group-heading">
            <p class="eyebrow">People</p>
            <h3>People in the record</h3>
          </div>
          <div class="person-records">
            {keyPeople.map((person) => (
              <article id={person.id}>
                <span class="person-monogram" aria-hidden="true">{person.name.split(" ").map((part) => part[0]).join("")}</span>
                <div>
                  <p class="relationship-label">{person.relationship}</p>
                  <h4>{person.name}</h4>
                  <h5>{person.role}</h5>
                  <p>{person.summary}</p>
                  <a class="source-link" href={person.sourceUrl} target="_blank" rel="noreferrer">
                    {person.sourceLabel} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="record-group" id="organization-roster">
          <div class="record-group-heading">
            <p class="eyebrow">Roster</p>
            <h3>Organizations and businesses</h3>
          </div>
          <p class="roster-note">This is a starting roster of entities in the supplied research, organized by the kind of relationship the available record supports.</p>
          {relationshipCategories.map((category) => (
            <section class="roster-category" aria-labelledby={`category-${category.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>
              <h4 id={`category-${category.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>{category}</h4>
              <div class="organization-records">
                {relationshipRoster.filter((entry) => entry.category === category).map((entry) => (
                  <article id={entry.id}>
                    <div class="organization-mark" aria-hidden="true">{entry.name.slice(0, 1)}</div>
                    <div>
                      <p class="relationship-label">{entry.relationship}</p>
                      <h5>{entry.name}</h5>
                      <span class="organization-type">{entry.type}</span>
                      <p>{entry.description}</p>
                      <a class="source-link" href={entry.sourceUrl} target="_blank" rel="noreferrer">
                        {entry.sourceLabel} <span aria-hidden="true">↗</span>
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>

      <article class="content-panel" id="free-state-aligned">
        <section>
          <h2>The Movement</h2>
          <p>
            Rather than building a national movement, the project's strategy is
            to concentrate supporters in one state where they can have greater
            influence over elections, legislation, and public policy.
          </p>
          <p>
            Today, many of the movement's participants serve in the New
            Hampshire Legislature, local government, and advocacy organizations,
            making it one of the state's most organized political forces.
          </p>
        </section>

        <section>
          <h2>Why Are Free Staters Controversial?</h2>
          <p>
            Critics argue that the movement has had an outsized influence on New
            Hampshire politics and is working to fundamentally change the role
            of government in the state. They point to efforts to:
          </p>

          <ul>
            <li>Cut funding for public education while expanding school voucher programs</li>
            <li>Reduce business and other state taxes, shifting more of the burden onto local property taxpayers</li>
            <li>Roll back environmental regulations and public health protections</li>
            <li>Reduce funding for healthcare and other public services</li>
            <li>Override local control on issues like housing and zoning</li>
            <li>Advance legislation targeting LGBTQ+ rights, particularly transgender people</li>
            <li>Shrink state government by reducing agencies, programs, and regulations</li>
          </ul>

          <p>
            Critics also argue that highly organized Free State activists have
            helped shift legislative priorities away from issues like affordable
            housing, healthcare costs, workforce shortages, and public
            education, toward ideological and culture-war legislation.
          </p>
        </section>

        <section class="callout">
          <h2>Supporters Say...</h2>
          <p>
            Supporters of the Free State Project argue they are simply
            exercising their right to participate in democracy. They believe
            lower taxes, smaller government, fewer regulations, and greater
            individual freedom make New Hampshire a better place to live and do
            business.
          </p>
        </section>

        <section>
          <h2>Why It Matters</h2>
          <p>
            Whether you support or oppose the Free State Project, its influence
            on New Hampshire politics is significant. Understanding which
            elected officials are voting in alignment with its agenda can help
            voters better understand the priorities and policies shaping the
            state's future.
          </p>
        </section>

        <section class="source-note">
          <h2>How We Use This Designation</h2>
          <p>
            On NH Deserves Better, the <strong>Free State Aligned</strong>
            designation is not a claim about formal membership in the Free State
            Project. It identifies people whose legislative voting record
            consistently aligns with the Free Stater agenda, using the
            <a href="https://www.nhliberty.org/wp-content/uploads/2026/07/Liberty-Rating-2026.pdf">
              New Hampshire Liberty Alliance 2026 Liberty Rating
            </a>.
            Current state representatives and state senators with a 2026 NHLA
            combined grade of <strong>B+ or higher</strong> are labeled Free
            State Aligned. When those same people are also 2026 legislative
            candidates, the designation appears on their candidate profiles too.
            The designation also applies to candidates named on NHLA's
            <a href="https://www.nhliberty.org/2026-candidate-endorsements/">
              2026 Candidate Endorsements
            </a>
            page, including non-incumbents who do not have a legislative voting
            record. An endorsement indicates NHLA's electoral support; it is not
            evidence of formal Free State Project membership.
          </p>
        </section>
      </article>

      <section class="directory-section" id="directory" x-data="nhdbFuzzyFilter({ pageSize: 12 })">
        <div class="directory-heading">
          <p class="eyebrow">Directory</p>
          <h2>Free State Aligned People</h2>
          <p>
            Each person marked Free State Aligned appears once, whether they are a
            current legislator, a 2026 candidate, both, or neither. Filter by current
            role below. Open a profile for the evidence behind the designation and
            more details about the person.
          </p>
        </div>

        {directoryError && <p class="status-message">{directoryError}</p>}

        {!directoryError && <div class="directory-summary">
          <article>
            <span>Matching people</span>
            <strong data-fuzzy-matched-count>{people.length}</strong>
            <small>of {people.length} labeled people</small>
          </article>
          <article>
            <span>Current roles</span>
            <strong>{legislatorCount} / {candidateCount}</strong>
            <small>legislators / 2026 candidates; some are both</small>
          </article>
        </div>}

        <FilterBar
          action="/free-staters#directory"
          submitLabel="Apply filters"
          clearHref={hasDirectoryFilters ? "/free-staters#directory" : ""}
          live
        >
          <label>
