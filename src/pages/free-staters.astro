---
export const prerender = false;

import { env } from "cloudflare:workers";
import FilterBar from "../components/FilterBar.astro";
import FreeStaterPersonCard from "../components/FreeStaterPersonCard.astro";
import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getFreeStateAlignedPeople } from "../lib/freeStaterDirectory";

const filterName = cleanFilter(Astro.url.searchParams.get("q"));
const filterType = cleanFilter(Astro.url.searchParams.get("type")) || "all";
const filterBody = cleanFilter(Astro.url.searchParams.get("body")) || "all";
const filterParty = cleanFilter(Astro.url.searchParams.get("party")) || "all";
const filterCounty = cleanFilter(Astro.url.searchParams.get("county"));
const filterTown = cleanFilter(Astro.url.searchParams.get("town"));
const sort = cleanFilter(Astro.url.searchParams.get("sort"));
let people = [];
let directoryError = "";

try {
  people = await getFreeStateAlignedPeople(env.d1_db);
} catch (error) {
  console.error("Unable to load Free State Aligned directory", error);
  directoryError = "The Free State Aligned directory is temporarily unavailable.";
}

const countyOptions = uniqueOptions(people.flatMap((person) => person.counties));
const townOptions = uniqueOptions(people.flatMap((person) => person.towns));
const legislatorCount = people.filter((person) => person.isCurrentLegislator).length;
const candidateCount = people.filter((person) => person.isCurrentCandidate).length;
const hasDirectoryFilters =
  filterName ||
  filterType !== "all" ||
  filterBody !== "all" ||
  filterParty !== "all" ||
  filterCounty ||
  filterTown;

function cleanFilter(value = "") {
  return String(value || "").trim();
}

function uniqueOptions(values = []) {
  return [...new Set(values.flat().map(cleanFilter).filter(Boolean))]
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Free State Aligned People | NH Deserves Better</title>
    <meta
      name="description"
      content="Browse New Hampshire legislators and candidates labeled Free State Aligned, with filters and details about how NH Deserves Better uses the designation."
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <section class="hero" aria-labelledby="page-title">
        <div>
          <p class="eyebrow">New Hampshire legislators and candidates</p>
          <h1 id="page-title">Free State Aligned People</h1>
          <p class="lede">
            Browse current legislators and 2026 candidates whose voting records or NH Liberty
            Alliance endorsements meet this site’s Free State Aligned designation.
          </p>
          <a class="research-link" href="/free-state-project">Explore the Free State Project timeline &amp; relationship map <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <article class="content-panel" id="free-state-aligned">
        <section>
          <h2>The Movement</h2>
          <p>
            Rather than building a national movement, the project's strategy is
            to concentrate supporters in one state where they can have greater
            influence over elections, legislation, and public policy.
          </p>
          <p>
            Today, many of the movement's participants serve in the New
            Hampshire Legislature, local government, and advocacy organizations,
            making it one of the state's most organized political forces.
          </p>
        </section>

        <section>
          <h2>Why Are Free Staters Controversial?</h2>
          <p>
            Critics argue that the movement has had an outsized influence on New
            Hampshire politics and is working to fundamentally change the role
            of government in the state. They point to efforts to:
          </p>

          <ul>
            <li>Cut funding for public education while expanding school voucher programs</li>
            <li>Reduce business and other state taxes, shifting more of the burden onto local property taxpayers</li>
            <li>Roll back environmental regulations and public health protections</li>
            <li>Reduce funding for healthcare and other public services</li>
            <li>Override local control on issues like housing and zoning</li>
            <li>Advance legislation targeting LGBTQ+ rights, particularly transgender people</li>
            <li>Shrink state government by reducing agencies, programs, and regulations</li>
          </ul>

          <p>
            Critics also argue that highly organized Free State activists have
            helped shift legislative priorities away from issues like affordable
            housing, healthcare costs, workforce shortages, and public
            education, toward ideological and culture-war legislation.
          </p>
        </section>

        <section class="callout">
          <h2>Supporters Say...</h2>
          <p>
            Supporters of the Free State Project argue they are simply
            exercising their right to participate in democracy. They believe
            lower taxes, smaller government, fewer regulations, and greater
            individual freedom make New Hampshire a better place to live and do
            business.
          </p>
        </section>

        <section>
          <h2>Why It Matters</h2>
          <p>
            Whether you support or oppose the Free State Project, its influence
            on New Hampshire politics is significant. Understanding which
            elected officials are voting in alignment with its agenda can help
            voters better understand the priorities and policies shaping the
            state's future.
          </p>
        </section>

        <section class="source-note">
          <h2>How We Use This Designation</h2>
          <p>
            On NH Deserves Better, the <strong>Free State Aligned</strong>
            designation is not a claim about formal membership in the Free State
            Project. It identifies people whose legislative voting record
            consistently aligns with the Free Stater agenda, using the
            <a href="https://www.nhliberty.org/wp-content/uploads/2026/07/Liberty-Rating-2026.pdf">
              New Hampshire Liberty Alliance 2026 Liberty Rating
            </a>.
            Current state representatives and state senators with a 2026 NHLA
            combined grade of <strong>B+ or higher</strong> are labeled Free
            State Aligned. When those same people are also 2026 legislative
            candidates, the designation appears on their candidate profiles too.
            The designation also applies to candidates named on NHLA's
            <a href="https://www.nhliberty.org/2026-candidate-endorsements/">
              2026 Candidate Endorsements
            </a>
            page, including non-incumbents who do not have a legislative voting
            record. An endorsement indicates NHLA's electoral support; it is not
            evidence of formal Free State Project membership.
          </p>
        </section>
      </article>

      <section class="directory-section" id="directory" x-data="nhdbFuzzyFilter({ pageSize: 12 })">
        <div class="directory-heading">
          <p class="eyebrow">Directory</p>
          <h2>Free State Aligned People</h2>
          <p>
            Each person marked Free State Aligned appears once, whether they are a
            current legislator, a 2026 candidate, both, or neither. Filter by current
            role below. Open a profile for the evidence behind the designation and
            more details about the person.
          </p>
        </div>

        {directoryError && <p class="status-message">{directoryError}</p>}

        {!directoryError && <div class="directory-summary">
          <article>
            <span>Matching people</span>
            <strong data-fuzzy-matched-count>{people.length}</strong>
            <small>of {people.length} labeled people</small>
          </article>
          <article>
            <span>Current roles</span>
            <strong>{legislatorCount} / {candidateCount}</strong>
            <small>legislators / 2026 candidates; some are both</small>
          </article>
        </div>}

        <FilterBar
          action="/free-staters#directory"
          submitLabel="Apply filters"
          clearHref={hasDirectoryFilters ? "/free-staters#directory" : ""}
          live
        >
          <label>
            <span>Name</span>
            <input name="q" value={filterName} placeholder="Search by name" data-fuzzy-search />
          </label>

          <label>
            <span>Show</span>
            <select name="type" data-fuzzy-filter-field data-fuzzy-field="kind" data-fuzzy-match="contains">
              <option value="all" selected={filterType === "all"}>All labeled people</option>
              <option value="legislators" selected={filterType === "legislators"}>Current legislators</option>
              <option value="candidates" selected={filterType === "candidates"}>2026 candidates</option>
            </select>
          </label>

          <label>
            <span>Body / office</span>
            <input
              name="body"
              value={filterBody === "all" ? "" : filterBody}
              list="freeStaterBodyOptions"
              placeholder="House or Senate"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="body"
            />
            <datalist id="freeStaterBodyOptions">
              <option value="house" />
              <option value="senate" />
            </datalist>
          </label>

          <label>
            <span>Party</span>
            <input
              name="party"
              value={filterParty === "all" ? "" : filterParty}
              list="freeStaterPartyOptions"
              placeholder="Republican, Democrat..."
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="party"
            />
            <datalist id="freeStaterPartyOptions">
              <option value="republican" />
              <option value="democrat" />
              <option value="independent" />
            </datalist>
          </label>

          <label>
            <span>County</span>
            <input name="county" value={filterCounty} list="freeStaterCountyOptions" placeholder="County" data-fuzzy-filter-field data-fuzzy-field="county" />
            <datalist id="freeStaterCountyOptions">
              {countyOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>

          <label>
            <span>Town / city</span>
            <input name="town" value={filterTown} list="freeStaterTownOptions" placeholder="Town or city" data-fuzzy-filter-field data-fuzzy-field="town" />
            <datalist id="freeStaterTownOptions">
              {townOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Sort</span>
            <select name="sort" data-fuzzy-sort>
              <option value="" selected={!sort}>Default</option>
              <option value="name:asc" selected={sort === "name:asc"}>Name A-Z</option>
              <option value="district:asc" selected={sort === "district:asc"}>District</option>
              <option value="grade:desc" selected={sort === "grade:desc"}>Testimony alignment high-low</option>
              <option value="grade:asc" selected={sort === "grade:asc"}>Testimony alignment low-high</option>
              <option value="updated:desc" selected={sort === "updated:desc"}>Recently updated</option>
            </select>
          </label>
        </FilterBar>
        <div class="filter-chips" data-fuzzy-chips hidden></div>

        <section class="directory-block">
          <div class="section-heading">
            <h3>People</h3>
            <p>People with both current roles are shown once and match either role filter.</p>
          </div>

          {people.length ? (
            <div class="person-card-list">
              {people.map((person) => (
                <FreeStaterPersonCard person={person} />
              ))}
            </div>
          ) : (
            !directoryError && <p class="empty">No people are currently labeled Free State Aligned.</p>
          )}
        </section>

        <div class="see-more-row">
          <button type="button" data-fuzzy-more hidden>Show more profiles</button>
        </div>

        {!directoryError && (
          <div class="status-message empty-state" data-fuzzy-empty hidden>
            <strong>No Free State Aligned profiles matched those filters.</strong>
            <ul>
              <li>Try searching by last name.</li>
              <li>Remove the town, county, or party chip above.</li>
              <li>Clear the Show filter to include everyone labeled Free State Aligned.</li>
            </ul>
          </div>
        )}
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .page {
    margin: 0 auto;
    padding: clamp(30px, 5vw, 64px) 0;
    width: min(1180px, calc(100% - clamp(28px, 5vw, 72px)));
  }

  .hero {
    padding: 12px 0 36px;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 0.98;
    margin: 0;
  }

  .lede {
    color: #374151;
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    font-weight: 720;
    line-height: 1.5;
    margin: 20px 0 0;
    max-width: 800px;
  }

  .research-link {
    color: #9a3412;
    display: inline-flex;
    font-weight: 900;
    gap: 7px;
    margin-top: 20px;
  }

  .research-link:hover,
  .research-link:focus-visible {
    color: #dc4d09;
  }

  .content-panel {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: grid;
    gap: 28px;
    padding: clamp(22px, 4vw, 40px);
  }

  .content-panel h2 {
    font-size: clamp(1.4rem, 2.7vw, 2rem);
    margin: 0 0 10px;
  }

  .content-panel p,
  .directory-heading > p {
    color: #4b5563;
    font-weight: 700;
    line-height: 1.6;
  }

  .content-panel p + p {
    margin-top: 14px;
  }

  .content-panel ul {
    display: grid;
    gap: 10px;
    margin: 18px 0;
    padding-left: 22px;
  }

  .content-panel li {
    color: #4b5563;
    font-weight: 700;
    line-height: 1.5;
    padding-left: 4px;
  }

  .callout,
  .source-note {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 22px;
  }

  .source-note {
    background: #fffaf1;
    border-color: #fed7aa;
  }

  .content-panel a {
    color: #9a3412;
  }

  .directory-section {
    display: grid;
    gap: 24px;
    margin-top: 42px;
  }

  .directory-heading {
    max-width: 860px;
  }

  .directory-heading h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1.05;
    margin: 0 0 12px;
  }

  .directory-summary {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .directory-summary article,
  .directory-block,
  .status-message,
  .empty {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px;
  }

  .directory-summary span {
    color: #6b7280;
    display: block;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .directory-summary strong {
    display: block;
    font-size: 2.6rem;
    line-height: 1;
    margin-top: 8px;
  }

  .directory-summary small {
    color: #6b7280;
    display: block;
    font-weight: 850;
    margin-top: 6px;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .filter-chips button {
    align-items: center;
    background: #eef6ff;
    border: 1px solid #93c5fd;
    border-radius: 999px;
    color: #1f2933;
    cursor: pointer;
    display: inline-flex;
    gap: 8px;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 900;
    padding: 7px 10px;
  }

  .filter-chips b {
    color: #b91c1c;
    font-size: 1rem;
    line-height: 1;
  }

  .directory-block {
    display: grid;
    gap: 18px;
  }

  .section-heading h3 {
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    line-height: 1.05;
    margin: 0 0 8px;
  }

  .section-heading p,
  .empty,
  .status-message {
    color: #4b5563;
    font-weight: 750;
    line-height: 1.55;
    margin: 0;
  }

  .empty-state {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 18px;
  }

  .empty-state strong {
    color: #1f2933;
    display: block;
    margin-bottom: 8px;
  }

  .empty-state ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 20px;
  }

  .person-card-list {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .see-more-row {
    align-items: center;
    display: flex;
    justify-content: center;
    margin-top: 22px;
  }

  .see-more-row button {
    background: #1f2933;
    border: 1px solid #1f2933;
    border-radius: 999px;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-weight: 900;
    padding: 12px 18px;
  }

  @media (max-width: 760px) {
    .directory-summary,
    .person-card-list {
      grid-template-columns: 1fr;
    }

    .content-panel {
      padding: 22px;
    }
  }
</style>
