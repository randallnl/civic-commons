            <input name="q" value={filterName} placeholder="Search by name" data-fuzzy-search />
          </label>

          <label>
            <span>Show</span>
            <select name="type" data-fuzzy-filter-field data-fuzzy-field="kind" data-fuzzy-match="contains">
              <option value="all" selected={filterType === "all"}>All labeled people</option>
              <option value="legislators" selected={filterType === "legislators"}>Current legislators</option>
              <option value="candidates" selected={filterType === "candidates"}>2026 candidates</option>
            </select>
          </label>

          <label>
            <span>Body / office</span>
            <input
              name="body"
              value={filterBody === "all" ? "" : filterBody}
              list="freeStaterBodyOptions"
              placeholder="House or Senate"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="body"
            />
            <datalist id="freeStaterBodyOptions">
              <option value="house" />
              <option value="senate" />
            </datalist>
          </label>

          <label>
            <span>Party</span>
            <input
              name="party"
              value={filterParty === "all" ? "" : filterParty}
              list="freeStaterPartyOptions"
              placeholder="Republican, Democrat..."
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="party"
            />
            <datalist id="freeStaterPartyOptions">
              <option value="republican" />
              <option value="democrat" />
              <option value="independent" />
            </datalist>
          </label>

          <label>
            <span>County</span>
            <input name="county" value={filterCounty} list="freeStaterCountyOptions" placeholder="County" data-fuzzy-filter-field data-fuzzy-field="county" />
            <datalist id="freeStaterCountyOptions">
              {countyOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>

          <label>
            <span>Town / city</span>
            <input name="town" value={filterTown} list="freeStaterTownOptions" placeholder="Town or city" data-fuzzy-filter-field data-fuzzy-field="town" />
            <datalist id="freeStaterTownOptions">
              {townOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label>
            <span>Sort</span>
            <select name="sort" data-fuzzy-sort>
              <option value="" selected={!sort}>Default</option>
              <option value="name:asc" selected={sort === "name:asc"}>Name A-Z</option>
              <option value="district:asc" selected={sort === "district:asc"}>District</option>
              <option value="grade:desc" selected={sort === "grade:desc"}>Testimony alignment high-low</option>
              <option value="grade:asc" selected={sort === "grade:asc"}>Testimony alignment low-high</option>
              <option value="updated:desc" selected={sort === "updated:desc"}>Recently updated</option>
            </select>
          </label>
        </FilterBar>
        <div class="filter-chips" data-fuzzy-chips hidden></div>

        <section class="directory-block">
          <div class="section-heading">
            <h3>People</h3>
            <p>
              People with both current roles are shown once and match either role filter.
            </p>
          </div>

          {people.length ? (
            <div class="person-card-list">
              {people.map((person) => (
                <FreeStaterPersonCard person={person} />
              ))}
            </div>
          ) : (
            !directoryError && <p class="empty">No people are currently labeled Free State Aligned.</p>
          )}
        </section>

        <div class="see-more-row">
          <button type="button" data-fuzzy-more hidden>Show more profiles</button>
        </div>

        {!directoryError && (
          <div class="status-message empty-state" data-fuzzy-empty hidden>
            <strong>No Free State Aligned profiles matched those filters.</strong>
            <ul>
              <li>Try searching by last name.</li>
              <li>Remove the town, county, or party chip above.</li>
              <li>Clear the Show filter to include everyone labeled Free State Aligned.</li>
            </ul>
          </div>
        )}
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<script>
  const timelineFilters = Array.from(document.querySelectorAll("[data-timeline-filter]"));
  const timelineItems = Array.from(document.querySelectorAll("[data-timeline-item]"));

  timelineFilters.forEach((filter) => {
    filter.addEventListener("click", () => {
      const selectedEra = filter.dataset.timelineFilter || "all";

      timelineFilters.forEach((button) => {
        const isSelected = button === filter;
        button.classList.toggle("is-active", isSelected);
        button.setAttribute("aria-pressed", String(isSelected));
      });

      timelineItems.forEach((item) => {
        const isVisible = selectedEra === "all" || item.dataset.era === selectedEra;
        item.toggleAttribute("hidden", !isVisible);
      });
    });
  });

  document.querySelectorAll("[data-fsp-logo]").forEach((image) => {
    const showFallback = () => image.parentElement?.classList.add("logo-unavailable");

    image.addEventListener("error", showFallback);
    if (image instanceof HTMLImageElement && image.complete && image.naturalWidth === 0) {
      showFallback();
    }
  });
</script>

