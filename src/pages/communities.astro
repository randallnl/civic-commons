---
export const prerender = false;

import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FilterBar from "../components/FilterBar.astro";
import { getRecentApprovedCommunityUpdates } from "../lib/communityUpdates";
import {
  getCommunityUpdateCards,
  previewDescription,
  previewTitle,
} from "../lib/communityUpdateCards";
import {
  communityPath,
  getCountyCommunity,
} from "../lib/communitiesApi";
import { countyImageUrl } from "../lib/communityImages";
import { repName } from "../lib/repsApi";
import { cleanText } from "../lib/text";
import profileIcon from "../assets/profile icon.png";

const COUNTY_NAMES = [
  "Belknap",
  "Carroll",
  "Cheshire",
  "Coos",
  "Grafton",
  "Hillsborough",
  "Merrimack",
  "Rockingham",
  "Strafford",
  "Sullivan",
];

const q = Astro.url.searchParams.get("q")?.trim() || "";
const articleLimit = Number(Astro.url.searchParams.get("articleLimit") || 3);
const updateType = Astro.url.searchParams.get("type")?.trim() || "";
const countyFilter = Astro.url.searchParams.get("county")?.trim() || "";
const sort = Astro.url.searchParams.get("sort")?.trim() || "updated:desc";

let countyGroups = [];
let communityUpdates = [];
let meta = {};
let loadError = "";
let updatesError = "";

try {
  const [data, updates] = await Promise.all([
    getCountyGroups({
      q,
      county: countyFilter,
      articleLimit,
    }),
    getRecentApprovedCommunityUpdates({ limit: 100 }),
  ]);
  countyGroups = data.counties || [];
  communityUpdates = await getCommunityUpdateCards(updates || []);
  meta = data.meta || {};
} catch (error) {
  loadError = cleanApiError(error?.message) || "Unable to load communities.";
}

async function getCountyGroups({
  q = "",
  county = "",
  articleLimit = 3,
} = {}) {
  const countyResults = await Promise.allSettled(
    COUNTY_NAMES.map(async (county) => {
      const data = await getCountyCommunity(county, {
        body: "house",
        articleLimit,
      });
      return normalizeCountyGroup(data, county);
    }),
  );

  let counties = countyResults
    .filter((result) => result.status === "fulfilled")
    .map((result) => result.value)
    .filter(Boolean);

  if (q) counties = counties.filter((county) => countyMatchesQuery(county, q));
  if (county) counties = counties.filter((countyGroup) =>
    countyGroup.county.toLowerCase() === county.toLowerCase(),
  );

  return {
    counties,
    meta: {
      total: counties.length,
    },
  };
}

function normalizeCountyGroup(data = {}, fallbackCounty = "") {
  const county =
    data.counties?.[0] ||
    data.county ||
    data.community ||
    data.result ||
    data;
  const rawCommunities =
    county.communities ||
    county.districts ||
    county.results ||
    data.communities ||
    data.districts ||
    [];
  const communities = rawCommunities.map((community) => ({
    ...community,
    county: community.county || county.name || county.county || fallbackCounty,
  }));
  const towns =
    county.townsRepresented ||
    county.towns ||
    county.towns_represented ||
    [];
  const representatives =
    county.representatives ||
    county.reps ||
    county.legislators ||
    [];
  const articles =
    county.relatedArticles ||
    county.articles ||
    data.relatedArticles ||
    data.articles ||
    [];
  const representativesMap = new Map(
    [
      ...representatives,
      ...communities.flatMap((community) => representativesFor(community)),
    ]
      .filter(Boolean)
      .map((rep) => [rep.personid || rep.id || repName(rep), rep])
      .filter(([key]) => key),
  );
  const representativeSummaryCount = Number(
    county.representativeCount ??
      county.representativeSummary?.count ??
      data.representativeCount ??
      data.representativeSummary?.count ??
      representativesMap.size ??
      0,
  );
  const updateSummaryCount = Number(
    county.articleCount ??
      county.updateCount ??
      county.relatedArticleCount ??
      data.articleCount ??
      data.updateCount ??
      data.relatedArticleCount ??
      articles.length ??
      0,
  );

  return {
    county: county.name || county.county || fallbackCounty,
    slug: county.slug || slugify(county.name || county.county || fallbackCounty),
    districtCount: county.districtCount || communities.length,
    representativeCount: representativeSummaryCount,
    updateCount: updateSummaryCount,
    communities,
    towns: new Set([
      ...normalizeTowns(towns),
      ...communities.flatMap((community) => townsFor(community)),
    ]),
    representatives: representativesMap,
    articles: [...articles, ...communities.flatMap((community) => articlesFor(community))]
      .filter(Boolean)
      .slice(0, articleLimit),
  };
}

function townsFor(community = {}) {
  const value =
    community.towns ||
    community.towns_represented ||
    community.townsRepresented ||
    community.location_text ||
    "";
  if (Array.isArray(value)) return value.map(cleanTown).filter(Boolean);

  return String(value)
    .split(/;|,/)
    .map(cleanTown)
    .filter(Boolean);
}

function normalizeTowns(value = []) {
  if (Array.isArray(value)) return value.map(cleanTown).filter(Boolean);

  return String(value)
    .split(/;|,/)
    .map(cleanTown)
    .filter(Boolean);
}

function cleanTown(value = "") {
  if (typeof value === "object" && value !== null) {
    return String(value.town || value.name || value.label || "").trim();
  }

  return String(value).trim();
}

function communityName(community = {}) {
  return (
    community.name ||
    community.district_label ||
    community.districtLabel ||
    `${bodyLabel(community.body || community.chamber)} District ${formatDistrictNumber(community.district || community.raw_district || "")}`
  );
}

function bodyLabel(value = "") {
  const normalized = String(value).toLowerCase();
  return normalized === "senate" || normalized === "s" ? "Senate" : "House";
}

function representativesFor(community = {}) {
  return community.representatives || community.reps || community.legislators || [];
}

function articlesFor(community = {}) {
  return community.articles || community.relatedArticles || [];
}

function countyMatchesQuery(county = {}, query = "") {
  const needle = query.toLowerCase();
  const towns = [...county.towns];
  const representatives = [...county.representatives.values()];
  const haystack = [
    county.county,
    ...towns,
    ...county.communities.map(communityName),
    ...representatives.map(repName),
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();

  return haystack.includes(needle);
}

function countyProfilePath(county = {}) {
  return `/communities/counties/${encodeURIComponent(county.slug || slugify(county.county))}`;
}

function townProfilePath(town = "") {
  return `/communities/towns/${encodeURIComponent(town)}`;
}

function slugify(value = "") {
  return String(value)
    .toLowerCase()
    .trim()
    .replace(/['']/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function formatDistrictNumber(value = "") {
  const district = String(value).trim();
  if (!district) return "";
  if (/^\d+$/.test(district)) return String(Number(district));
  return district;
}

function cleanApiError(message = "") {
  if (/internal error/i.test(message)) return "Communities are temporarily unavailable.";
  return message;
}

function updateDate(value = "") {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "";
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

function updateSortValue(value = "") {
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? 0 : date.getTime();
}

function updateTypeLabel(value = "") {
  const normalized = String(value || "").trim().toLowerCase();
  if (!normalized) return "Community update";
  if (normalized === "person" || normalized === "people") return "Legislator update";
  if (normalized === "candidate") return "Candidate update";
  if (normalized === "bill") return "Bill update";
  if (normalized === "community") return "Community update";
  return `${normalized.charAt(0).toUpperCase()}${normalized.slice(1)} update`;
}

function updateHref(update = {}) {
  return update.pageUrl || update.linkUrl || "/communities";
}

function updateCountyText(update = {}) {
  const haystack = [
    update.entityName,
    update.entityKey,
    update.pageUrl,
    update.comment,
    ...(update.mentions || []).map((mention) => [
      mention.county,
      mention.district,
      mention.roleLabel,
    ].filter(Boolean).join(" ")),
  ].filter(Boolean).join(" ");

  return COUNTY_NAMES.filter((county) =>
    haystack.toLowerCase().includes(county.toLowerCase()),
  ).join(" ");
}

const updateTypeOptions = [
  ["", "All update types"],
  ["person", "Legislator updates"],
  ["candidate", "Candidate updates"],
  ["bill", "Bill updates"],
  ["report", "Report updates"],
  ["community", "Community updates"],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/NH%20DB%20Logo.svg" />
    <link rel="apple-touch-icon" href="/NH%20DB%20Logo.svg" />
    <title>Communities | NH Deserves Better</title>
    <meta
      name="description"
      content="Search New Hampshire communities by county and towns represented."
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <section class="hero">
        <p class="eyebrow">Communities</p>
        <h1>Explore community updates and county profiles.</h1>

        <p class="lede">
          Browse recent community-submitted context, then use the county panel
          to drill into town, House district, and county profiles.
        </p>
      </section>

      <section
        class="community-browser"
        x-data="nhdbFuzzyFilter({ itemSelector: '[data-community-feed-item]', pageSize: 12, threshold: 0.32 })"
      >
        <FilterBar action="/communities" submitLabel="Apply filters" clearHref="/communities" columns="wide" live={true}>
          <label for="q">
            <span>Search</span>
            <input
              id="q"
              type="search"
              name="q"
              value={q}
              placeholder="Town, county, person, bill, or keyword"
              data-fuzzy-search
            />
          </label>

          <label for="type">
            <span>Update type</span>
            <select id="type" name="type" data-fuzzy-filter-field data-fuzzy-field="type" data-fuzzy-match="exact">
              {updateTypeOptions.map(([value, label]) => (
                <option value={value} selected={updateType === value}>{label}</option>
              ))}
            </select>
          </label>

          <label for="county">
            <span>County</span>
            <input
              id="county"
              name="county"
              value={countyFilter}
              list="countyOptions"
              placeholder="County"
              data-fuzzy-filter-field
              data-fuzzy-field="county"
            />
          </label>

          <label for="sort">
            <span>Sort</span>
            <select id="sort" name="sort" data-fuzzy-sort>
              <option value="updated:desc" selected={sort === "updated:desc"}>Newest first</option>
              <option value="updated:asc" selected={sort === "updated:asc"}>Oldest first</option>
              <option value="name:asc" selected={sort === "name:asc"}>Name A-Z</option>
              <option value="county:asc" selected={sort === "county:asc"}>County A-Z</option>
            </select>
          </label>

          <input type="hidden" name="articleLimit" value={articleLimit} />
        </FilterBar>
        <datalist id="countyOptions">
          {COUNTY_NAMES.map((county) => <option value={county} />)}
        </datalist>
        <div class="filter-chips" data-fuzzy-chips hidden></div>

        <div class="community-layout">
          <section class="update-feed" aria-labelledby="community-updates-heading">
            <div class="results-heading">
              <div>
                <p class="eyebrow">Recent Updates</p>
                <h2 id="community-updates-heading">
                  <span data-fuzzy-count>{communityUpdates.length}</span> Community Updates
                </h2>
              </div>
              <a href="/suggest-update">Suggest an update</a>
            </div>

            {updatesError ? (
              <p class="status-message">{updatesError}</p>
            ) : communityUpdates.length ? (
              <div class="feed-list">
                {communityUpdates.map((update) => {
                  const countyText = updateCountyText(update);
                  const photoUrls = update.photoUrls?.length ? update.photoUrls : update.photoUrl ? [update.photoUrl] : [];
                  const mentions = (update.mentions || []).filter((mention) => mention.name && mention.path);

                  return (
                    <article
                      class:list={["update-card", photoUrls[0] && "has-photo"]}
                      data-community-feed-item
                      data-fuzzy-text={[
                        update.entityName,
                        update.entityKey,
                        update.displayName,
                        update.comment,
                        update.linkUrl,
                        countyText,
                        mentions.map((mention) => mention.name).join(" "),
                      ].filter(Boolean).join(" ")}
                      data-fuzzy-name={update.entityName || update.displayName || ""}
                      data-fuzzy-type={update.entityType || ""}
                      data-fuzzy-county={countyText}
                      data-fuzzy-sort-name={update.entityName || update.displayName || ""}
                      data-fuzzy-sort-updated={updateSortValue(update.createdAt)}
                      data-fuzzy-sort-county={countyText}
                    >
                      {photoUrls[0] && (
                        <a class="update-photo" href={updateHref(update)} tabindex="-1" aria-hidden="true">
                          <img src={photoUrls[0]} alt="" loading="lazy" />
                        </a>
                      )}
                      <div class="update-copy">
                        <div class="update-topline">
                          <span>{updateTypeLabel(update.entityType)}</span>
                          {countyText && <span>{countyText}</span>}
                          {updateDate(update.createdAt) && <time datetime={update.createdAt}>{updateDate(update.createdAt)}</time>}
                        </div>
                        <h3>
                          <a href={updateHref(update)}>{update.entityName || "Community update"}</a>
                        </h3>
                        <p>{cleanText(update.comment || update.linkUrl || "Community-submitted context.")}</p>
                        {update.linkUrl && (
                          <a class="community-link-preview rich-link-preview" href={update.linkUrl}>
                            {update.linkPreview?.imageUrl && <img src={update.linkPreview.imageUrl} alt="" loading="lazy" />}
                            <span>
                              <strong>{previewTitle(update.linkPreview)}</strong>
                              {previewDescription(update.linkPreview, update.linkUrl) && (
                                <small>{previewDescription(update.linkPreview, update.linkUrl)}</small>
                              )}
                            </span>
                          </a>
                        )}
                        <div class="update-meta">
                          <span>Submitted by {cleanText(update.displayName || "Community member")}</span>
                        </div>
                        {mentions.length > 0 && (
                          <div class="mention-list" aria-label="Mentioned people">
                            {mentions.slice(0, 4).map((mention) => (
                              <a href={mention.path}>{cleanText(mention.name)}</a>
                            ))}
                          </div>
                        )}
                        {update.people?.length > 0 && (
                          <div class="community-people-preview" aria-label="People connected to this update">
                            {update.people.slice(0, 4).map((person) => (
                              <a class="mini-person-card" href={person.path}>
                                <img
                                  class:list={[!person.photoUrl && "profile-icon"]}
                                  src={person.photoUrl || profileIcon.src}
                                  alt={person.photoUrl ? `Photo of ${person.name}` : ""}
                                  loading="lazy"
                                />
                                <span>
                                  <strong>{cleanText(person.name)}</strong>
                                  {person.role && <small>{cleanText(person.role)}</small>}
                                  {person.districtLabel && <small>{cleanText(person.districtLabel)}</small>}
                                </span>
                              </a>
                            ))}
                          </div>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="status-message">No approved community updates yet.</p>
            )}

            <p class="empty-state" data-fuzzy-empty hidden>
              No community updates match those filters. Try a broader town,
              county, person, bill, or keyword.
            </p>
            <button class="show-more-button" type="button" data-fuzzy-more hidden>Show more</button>
          </section>

          <aside class="county-panel" aria-labelledby="county-panel-heading">
            <div class="panel-heading">
              <p class="eyebrow">County Communities</p>
              <h2 id="county-panel-heading">{countyGroups.length} Counties</h2>
            </div>

            {loadError ? (
              <p class="status-message">{loadError}</p>
            ) : countyGroups.length ? (
              <div class="county-list">
                {countyGroups.map((countyGroup) => {
                  const towns = [...countyGroup.towns].sort((a, b) => a.localeCompare(b));
                  const houseDistricts = countyGroup.communities.filter((community) =>
                    !String(community.body || community.chamber).toLowerCase().startsWith("s"),
                  );
                  const previewDistricts = houseDistricts.slice(0, 4);
                  const districtTotal = houseDistricts.length;
                  const hiddenDistrictCount = Math.max(
                    0,
                    districtTotal - previewDistricts.length,
                  );
                  const profileHref = countyProfilePath(countyGroup);
                  const imageUrl = countyImageUrl(countyGroup.county);
                  const representativeCount = countyGroup.representativeCount;
                  const updateCount = countyGroup.updateCount || countyGroup.articles.length;

                  return (
                    <article
                      class="county-card"
                      data-county-card
                      data-fuzzy-text={[
                        countyGroup.county,
                        ...towns,
                        ...countyGroup.communities.map(communityName),
                      ].filter(Boolean).join(" ")}
                      data-fuzzy-name={countyGroup.county}
                      data-fuzzy-county={countyGroup.county}
                      data-fuzzy-type="county"
                      data-fuzzy-sort-name={countyGroup.county}
                      data-fuzzy-sort-updated="0"
                      data-fuzzy-sort-county={countyGroup.county}
                    >
                      <a class="county-image" href={profileHref}>
                        {imageUrl && <img src={imageUrl} alt="" loading="lazy" />}
                        <div>
                          <span>County Profile</span>
                          <h3>{countyGroup.county}</h3>
                        </div>
                      </a>

                      <div class="county-summary">
                        <div class="county-stats">
                          <span><strong>{towns.length}</strong> Towns</span>
                          <span><strong>{districtTotal}</strong> House districts</span>
                          <span><strong>{representativeCount}</strong> Legislators</span>
                          <span><strong>{updateCount}</strong> Updates</span>
                        </div>
                      </div>

                      {towns.length > 0 && (
                        <div class="towns">
                          {towns.slice(0, 8).map((town) => (
                            <a href={townProfilePath(town)}>{town}</a>
                          ))}
                          {towns.length > 8 && (
                            <a href={profileHref}>+{towns.length - 8} more</a>
                          )}
                        </div>
                      )}

                      <div class="district-links">
                        <strong>House districts</strong>
                        {previewDistricts.map((community) => (
                          <a href={communityPath(community)}>{communityName(community)}</a>
                        ))}
                        {hiddenDistrictCount > 0 && (
                          <a href={profileHref}>+{hiddenDistrictCount} more</a>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="status-message">No counties found.</p>
            )}
          </aside>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .back,
  a {
    color: #1f2933;
    font-weight: 800;
  }

  .hero {
    padding: 42px 0 28px;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.2rem, 5.5vw, 4.25rem);
    line-height: 0.95;
    margin: 0 0 24px;
    max-width: 920px;
  }

  .lede {
    color: #4b5563;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.55;
    margin: 0;
    max-width: 760px;
  }

  .community-browser {
    display: grid;
    gap: 18px;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-chips button {
    align-items: center;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    color: #1e3a8a;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 900;
    gap: 8px;
    padding: 8px 10px;
  }

  .filter-chips b {
    color: #dc4d09;
    font-size: 1rem;
    line-height: 1;
  }

  .community-layout {
    align-items: start;
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
  }

  .update-feed,
  .county-panel {
    display: grid;
    gap: 16px;
  }

  .results-heading {
    align-items: center;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .results-heading a {
    background: #dc4d09;
    border-radius: 999px;
    color: #fffaf1;
    font-size: 0.88rem;
    padding: 10px 14px;
    text-decoration: none;
    white-space: nowrap;
  }

  .results-heading h2 {
    font-size: 1.6rem;
    margin: 0;
  }

  .feed-list,
  .county-list {
    display: grid;
    gap: 16px;
  }

  .update-card,
  .county-card,
  .status-message,
  .empty-state {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    padding: 18px;
  }

  .update-card {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(140px, 190px) minmax(0, 1fr);
  }

  .update-card:not(.has-photo) {
    grid-template-columns: 1fr;
  }

  .update-photo {
    align-self: start;
    aspect-ratio: 4 / 3;
    background: #eff6ff;
    border-radius: 8px;
    display: block;
    overflow: hidden;
  }

  .update-photo img {
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .update-copy {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .update-topline,
  .update-meta,
  .mention-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .update-topline span,
  .update-topline time,
  .mention-list a {
    background: #f8fafc;
    border: 1px solid #dbeafe;
    border-radius: 999px;
    color: #334155;
    font-size: 0.76rem;
    font-weight: 900;
    padding: 6px 9px;
    text-decoration: none;
  }

  .update-card h3 {
    font-size: 1.35rem;
    line-height: 1.1;
    margin: 0;
  }

  .update-card p {
    color: #4b5563;
    font-weight: 750;
    line-height: 1.5;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .update-meta {
    color: #64748b;
    font-size: 0.84rem;
    font-weight: 850;
  }

  .update-meta a {
    color: #1d4ed8;
  }

  .rich-link-preview {
    overflow: hidden;
  }

  .rich-link-preview > img {
    aspect-ratio: 16 / 9;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    grid-column: 1 / -1;
    max-height: 220px;
    object-fit: cover;
    width: 100%;
  }

  .community-link-preview {
    background: #ffffff;
    border: 1px solid #93c5fd;
