---
export const prerender = false;

import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FilterBar from "../components/FilterBar.astro";
import {
  getOrganizations,
  getRecentOrganizationComments,
  normalizeBillCode,
  organizationPath,
} from "../lib/organizationsApi";
import { cleanText } from "../lib/text";

const q = Astro.url.searchParams.get("q")?.trim() || "";
const position = Astro.url.searchParams.get("position")?.trim() || "";
const sort = Astro.url.searchParams.get("sort")?.trim() || "updated:desc";

let comments = [];
let organizations = [];
let error = "";

try {
  [comments, organizations] = await Promise.all([
    getRecentOrganizationComments({ limit: 150 }),
    getOrganizations(),
  ]);
} catch (loadError) {
  error = loadError?.message || "Unable to load organizational updates.";
}

const organizationMap = new Map(
  organizations.map((organization) => [organization.slug, organization]),
);

const commentItems = comments
  .map((comment) => {
    const organization = organizationMap.get(comment.organizationSlug) || {};
    const organizationName = cleanText(organization.name || comment.organization || comment.organizationSlug);
    const billCode = normalizeBillCode(comment.bill || comment.billLabel);
    const dateValue = comment.date || "";
    const sortDate = Date.parse(dateValue) || 0;

    return {
      ...comment,
      organization,
      organizationName,
      billCode,
      billTitle: cleanText(comment.billLabel || billCode || "Bill"),
      dateText: formatDate(dateValue),
      sortDate,
      text: [
        comment.organization,
        organization.name,
        comment.bill,
        comment.billLabel,
        comment.position,
        comment.comment,
        comment.author,
        comment.issueAreas?.join(" "),
        comment.towns?.join(" "),
      ].filter(Boolean).join(" "),
    };
  })
  .sort((first, second) => second.sortDate - first.sortDate);

const recentlyCommentingOrganizations = recentOrganizations(commentItems);
const recentlyMentionedBills = recentBills(commentItems);
const positionOptions = ["Support", "Oppose", "Neutral"];

function formatDate(value = "") {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return cleanText(value);

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
}

function positionClass(value = "") {
  const normalized = String(value || "").toLowerCase();
  if (normalized.includes("support")) return "support";
  if (normalized.includes("oppose") || normalized.includes("against")) return "oppose";
  return "neutral";
}

function recentOrganizations(items = []) {
  const bySlug = new Map();

  for (const item of items) {
    const slug = item.organizationSlug || item.organization?.slug || "";
    if (!slug) continue;

    const existing = bySlug.get(slug);
    const next = {
      organization: item.organizationName,
      slug,
      logoUrl: item.organization?.logoUrl || "",
      issueArea: item.organization?.issueArea || item.issueAreas?.[0] || "",
      count: (existing?.count || 0) + 1,
      latestDate: Math.max(existing?.latestDate || 0, item.sortDate || 0),
      latestDateText: existing?.latestDate > item.sortDate ? existing.latestDateText : item.dateText,
      latestBill: existing?.latestDate > item.sortDate ? existing.latestBill : item.billTitle,
      text: [existing?.text, item.text].filter(Boolean).join(" "),
    };

    bySlug.set(slug, next);
  }

  return [...bySlug.values()]
    .sort((first, second) => second.latestDate - first.latestDate)
    .slice(0, 14);
}

function recentBills(items = []) {
  const byBill = new Map();

  for (const item of items) {
    const billCode = item.billCode;
    if (!billCode) continue;

    const existing = byBill.get(billCode);
    const next = {
      billCode,
      billTitle: item.billTitle,
      count: (existing?.count || 0) + 1,
      latestDate: Math.max(existing?.latestDate || 0, item.sortDate || 0),
      latestDateText: existing?.latestDate > item.sortDate ? existing.latestDateText : item.dateText,
      latestOrganization: existing?.latestDate > item.sortDate ? existing.latestOrganization : item.organizationName,
      positions: new Set([...(existing?.positions || []), item.position].filter(Boolean)),
      text: [existing?.text, item.text].filter(Boolean).join(" "),
    };

    byBill.set(billCode, next);
  }

  return [...byBill.values()]
    .map((bill) => ({ ...bill, positions: [...bill.positions] }))
    .sort((first, second) => second.latestDate - first.latestDate)
    .slice(0, 14);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Organizational Updates | NH Deserves Better</title>
    <meta
      name="description"
      content="Recent organizational comments on New Hampshire bills, with recently active organizations and recently mentioned bills."
    />
  </head>

  <body>
    <TopNav />
    <main
      class="page organization-updates-page"
      x-data="nhdbFuzzyFilter({ itemSelector: '.org-update-card[data-fuzzy-item]', pageSize: 18, threshold: 0.32 })"
    >
      <div class="updates-layout">
        <aside class="side-panel org-panel" aria-label="Recently commenting organizations">
          <div class="sidebar-heading">
            <p class="eyebrow">Recently Active</p>
            <h2>Organizations making comments</h2>
            <a class="rail-action" href="/organizations">Organization directory</a>
          </div>

          {recentlyCommentingOrganizations.length ? (
            <div class="side-list">
              {recentlyCommentingOrganizations.map((item) => (
                <a
                  class="side-card org-side-card"
                  href={organizationPath({ slug: item.slug })}
                  data-fuzzy-sidebar-item
                  data-fuzzy-sidebar-text={item.text}
                >
                  <span class="org-logo">
                    {item.logoUrl ? (
                      <img src={item.logoUrl} alt="" loading="lazy" />
                    ) : (
                      <strong>{cleanText(item.organization || "O").slice(0, 1)}</strong>
                    )}
                  </span>
                  <span>
                    <strong>{cleanText(item.organization)}</strong>
                    {item.issueArea && <small>{cleanText(item.issueArea)}</small>}
                    <em>
                      {item.count} {item.count === 1 ? "comment" : "comments"}
                      {item.latestDateText && ` · ${item.latestDateText}`}
                    </em>
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p>No organizational comments yet.</p>
          )}
        </aside>

        <div class="updates-main">
          <section class="hero">
            <div class="hero-kicker-row">
              <p class="eyebrow">Organizational Updates</p>
              <a href="/organizations">Browse organizations</a>
            </div>
            <h1>What advocacy organizations are saying about bills.</h1>
            <p class="lede">
              Follow recent comments from organizations tracking New Hampshire
              legislation, see which bills are getting attention, and connect
              each statement back to the organization and bill profile.
            </p>
          </section>

          <FilterBar action="/organization-updates" submitLabel="Filter updates" clearHref="/organization-updates" columns="wide" live={true}>
            <label for="q">
              <span>Search</span>
              <input
                id="q"
                name="q"
                type="search"
                value={q}
                placeholder="Organization, bill, issue, town, or keyword"
                data-fuzzy-search
              />
            </label>
            <label for="position">
              <span>Position</span>
              <select id="position" name="position" data-fuzzy-filter-field data-fuzzy-field="position" data-fuzzy-match="includes">
                <option value="" selected={position === ""}>All positions</option>
                {positionOptions.map((option) => (
                  <option value={option} selected={position === option}>{option}</option>
                ))}
              </select>
            </label>
            <label for="sort">
              <span>Sort</span>
              <select id="sort" name="sort" data-fuzzy-sort>
                <option value="updated:desc" selected={sort === "updated:desc"}>Newest first</option>
                <option value="updated:asc" selected={sort === "updated:asc"}>Oldest first</option>
                <option value="name:asc" selected={sort === "name:asc"}>Organization A-Z</option>
                <option value="bill:asc" selected={sort === "bill:asc"}>Bill A-Z</option>
              </select>
            </label>
          </FilterBar>
          <div class="filter-chips" data-fuzzy-chips hidden></div>

          {error ? (
            <p class="status-message">{error}</p>
          ) : (
            <section class="updates-panel">
              <div class="results-heading">
                <div>
                  <p class="eyebrow">Recent Comments</p>
                  <h2><span data-fuzzy-count>{commentItems.length}</span> organizational updates shown</h2>
                </div>
                <a href="/organizations">Organization directory</a>
              </div>

              {commentItems.length ? (
                <div class="update-list">
                  {commentItems.map((item) => (
                    <article
                      class="org-update-card"
                      data-fuzzy-item
                      data-fuzzy-text={item.text}
                      data-fuzzy-position={item.position}
                      data-fuzzy-sort-name={item.organizationName}
                      data-fuzzy-sort-bill={item.billCode}
                      data-fuzzy-sort-updated={item.sortDate}
                    >
                      <div class="comment-topline">
                        <a class="organization-lockup" href={organizationPath(item.organization)}>
                          <span class="org-logo">
                            {item.organization?.logoUrl ? (
                              <img src={item.organization.logoUrl} alt="" loading="lazy" />
                            ) : (
                              <strong>{cleanText(item.organizationName || item.organizationSlug || "O").slice(0, 1)}</strong>
                            )}
                          </span>
                          <span>
                            <strong>{cleanText(item.organizationName)}</strong>
                            {item.dateText && <small>{item.dateText}</small>}
                          </span>
                        </a>
                        {item.position && (
                          <span class:list={["position-pill", positionClass(item.position)]}>
                            {item.position}
                          </span>
                        )}
                      </div>

                      {item.billCode && (
                        <a class="bill-link" href={`/bills/${item.billCode}`}>
                          <span>{item.billCode}</span>
                          <strong>{item.billTitle}</strong>
                        </a>
                      )}

                      <p>{item.comment}</p>

                      {item.photoUrl && (
                        <a class="comment-photo" href={item.photoUrl}>
                          <img src={item.photoUrl} alt="" loading="lazy" />
                        </a>
                      )}

                      <div class="comment-footer">
                        <span>{item.issueAreas?.slice(0, 2).join(", ")}</span>
                        {item.linkUrl && (
                          <a href={item.linkUrl} target="_blank" rel="noopener noreferrer">
                            {item.linkLabel || "Read more"}
                          </a>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <p class="status-message">No organizational comments have been published yet.</p>
              )}

              <div class="status-message empty-state" data-fuzzy-empty hidden>
                <strong>No organizational updates matched those filters.</strong>
                <p>Try a broader organization name, bill number, or issue area.</p>
              </div>
              <div class="see-more-row">
                <button type="button" class="see-more-button subtle" data-fuzzy-more hidden>Show more updates</button>
              </div>
            </section>
          )}
        </div>

        <aside class="side-panel bill-panel" aria-label="Recently mentioned bills">
          <div class="sidebar-heading">
            <p class="eyebrow">Recently Mentioned</p>
            <h2>Bills getting organizational attention</h2>
          </div>

          {recentlyMentionedBills.length ? (
            <div class="side-list">
              {recentlyMentionedBills.map((bill) => (
                <a
                  class="side-card bill-side-card"
                  href={`/bills/${bill.billCode}`}
                  data-fuzzy-sidebar-item
                  data-fuzzy-sidebar-text={bill.text}
                >
                  <span>
                    <strong>{bill.billCode}</strong>
                    <small>{cleanText(bill.billTitle)}</small>
                    <em>
                      {bill.count} {bill.count === 1 ? "comment" : "comments"}
                      {bill.latestDateText && ` · ${bill.latestDateText}`}
                    </em>
                  </span>
                  {bill.positions.length > 0 && (
                    <span class="mini-position-row">
                      {bill.positions.slice(0, 2).map((billPosition) => (
                        <small class:list={["position-dot", positionClass(billPosition)]}>
                          {billPosition}
                        </small>
                      ))}
                    </span>
                  )}
                </a>
              ))}
            </div>
          ) : (
            <p>No bills have been mentioned yet.</p>
          )}
        </aside>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .organization-updates-page {
    display: grid;
    gap: 18px;
    padding-inline: clamp(20px, 3vw, 44px);
    width: 100%;
  }

  .updates-layout {
    align-items: start;
    display: grid;
    gap: clamp(22px, 2.5vw, 40px);
    grid-template-columns: minmax(220px, 280px) minmax(0, 728px) minmax(230px, 300px);
    justify-content: center;
    width: 100%;
  }

  .updates-main {
    box-sizing: border-box;
    display: grid;
    gap: 18px;
    justify-self: center;
    max-width: 728px;
    min-width: 0;
    padding-inline: clamp(8px, 1.6vw, 28px);
    width: 100%;
  }

  .hero {
    background:
      radial-gradient(circle at 88% 16%, rgba(255, 103, 25, 0.2), transparent 18%),
      linear-gradient(135deg, #eff6ff 0%, #ffffff 54%, #fff7ed 100%);
    border: 1px solid var(--nhdb-line);
    border-radius: 16px;
    color: #1f2933;
    overflow: hidden;
    padding: clamp(26px, 4vw, 46px);
    position: relative;
  }

  .hero::after {
    background: linear-gradient(90deg, #1d4ed8, #ff6719);
    content: "";
    inset: auto 0 0;
    height: 8px;
    position: absolute;
  }

  .hero-kicker-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: space-between;
  }

  .hero-kicker-row a,
  .results-heading a,
  .comment-footer a {
    background: #1f2933;
    border: 1px solid #111827;
    border-radius: 999px;
    color: #fffaf1;
    font-size: 0.86rem;
    font-weight: 950;
    padding: 9px 12px;
    text-decoration: none;
  }

  .hero h1 {
    font-size: clamp(2.1rem, 4.8vw, 4rem);
    letter-spacing: 0;
    line-height: 0.98;
    margin: 0 0 16px;
    max-width: 820px;
  }

  .lede {
    color: #475569;
    font-size: clamp(1rem, 1.4vw, 1.16rem);
    line-height: 1.6;
    margin: 0;
    max-width: 760px;
  }

  .hero .eyebrow {
    color: #6b4f2a;
  }

  .side-panel {
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 14px;
    display: grid;
    gap: 14px;
    max-height: calc(100vh - 108px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 18px;
    position: sticky;
    scrollbar-color: #bfdbfe transparent;
    scrollbar-width: thin;
    top: 84px;
  }

  .side-panel::-webkit-scrollbar {
    width: 8px;
  }

  .side-panel::-webkit-scrollbar-track {
    background: transparent;
  }

  .side-panel::-webkit-scrollbar-thumb {
    background: #bfdbfe;
    border-radius: 999px;
  }

  .sidebar-heading {
    display: grid;
    gap: 8px;
  }

  .sidebar-heading h2 {
    font-size: 1.08rem;
    line-height: 1.1;
    margin: 0;
  }

  .rail-action {
    align-items: center;
    background: #1f2933;
    border: 1px solid #111827;
    border-radius: 999px;
    color: #fffaf1;
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 950;
    justify-content: center;
    padding: 8px 10px;
    text-decoration: none;
  }

  .side-list,
  .update-list,
  .updates-panel {
    display: grid;
    gap: 12px;
  }

  .side-card {
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(135deg, rgba(37, 99, 235, 0.45), rgba(255, 103, 25, 0.28)) border-box;
    border: 1px solid transparent;
    border-radius: 12px;
    color: #1f2933;
    display: grid;
    gap: 10px;
    padding: 10px;
    text-decoration: none;
  }

  .org-side-card {
    align-items: center;
    grid-template-columns: 48px minmax(0, 1fr);
  }

  .side-card:hover {
    border-color: #60a5fa;
    transform: translateY(-1px);
  }

  .side-card span {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .side-card strong,
  .side-card small,
  .side-card em {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .side-card strong,
  .side-card small {
    white-space: nowrap;
  }

  .side-card em {
    color: #1d4ed8;
    font-size: 0.74rem;
    font-style: normal;
    font-weight: 950;
    line-height: 1.3;
  }

  .side-card small {
    color: #64748b;
    font-size: 0.75rem;
    font-weight: 850;
  }

  .org-logo {
    align-items: center;
    aspect-ratio: 1;
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    display: grid;
    justify-content: center;
    overflow: hidden;
    place-items: center;
  }

  .org-logo img {
    display: block;
    height: calc(100% - 10px);
    object-fit: contain;
    padding: 0;
    width: calc(100% - 10px);
  }

  .org-logo strong {
    color: #1f2933;
    font-size: 1.1rem;
  }

  .results-heading {
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 10px;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding: 20px;
  }

  .results-heading h2 {
    font-size: 1.55rem;
    line-height: 1.05;
    margin: 0;
  }

  .org-update-card {
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 14px;
    display: grid;
    gap: 14px;
    padding: 18px;
  }

  .comment-topline {
    align-items: center;
    display: flex;
    gap: 14px;
    justify-content: space-between;
  }

  .organization-lockup {
    align-items: center;
    color: #1f2933;
    display: grid;
    gap: 10px;
    grid-template-columns: 52px minmax(0, 1fr);
    min-width: 0;
    text-decoration: none;
  }

  .organization-lockup small {
    color: #64748b;
    display: block;
    font-size: 0.82rem;
    font-weight: 850;
    margin-top: 2px;
  }

  .position-pill,
  .position-dot {
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    display: inline-flex;
    font-size: 0.78rem;
    font-weight: 950;
    padding: 6px 9px;
    white-space: nowrap;
  }

  .position-pill.support,
  .position-dot.support {
    background: #dcfce7;
    border-color: #86efac;
    color: #166534;
  }

  .position-pill.oppose,
  .position-dot.oppose {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #991b1b;
  }

  .position-pill.neutral,
  .position-dot.neutral {
    background: #e0f2fe;
    border-color: #7dd3fc;
    color: #075985;
  }

  .bill-link {
    background: #f8fafc;
    border: 1px solid #dbeafe;
    border-radius: 12px;
    color: #1f2933;
    display: grid;
    gap: 4px;
    padding: 12px;
    text-decoration: none;
  }

  .bill-link span {
    color: #1d4ed8;
    font-size: 0.8rem;
    font-weight: 950;
  }

  .bill-link strong {
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .org-update-card p {
    color: #4b5563;
    line-height: 1.55;
    margin: 0;
  }

  .comment-photo {
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    display: block;
    overflow: hidden;
  }

  .comment-photo img {
    aspect-ratio: 16 / 9;
    display: block;
    object-fit: contain;
    width: 100%;
  }

  .comment-footer,
  .mini-position-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: space-between;
  }

  .comment-footer > span {
    color: #64748b;
    font-size: 0.84rem;
    font-weight: 850;
  }

  .see-more-row {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 980px) {
    .updates-layout {
      grid-template-columns: 1fr;
    }

    .updates-main,
    .side-panel {
      max-height: none;
      overflow: visible;
      padding-inline: 0;
      position: static;
    }

    .org-panel {
      order: 2;
    }

    .updates-main {
      order: 1;
    }

    .bill-panel {
      order: 3;
    }

    .results-heading,
    .comment-topline {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
