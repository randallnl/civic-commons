---
export const prerender = false;

import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FilterBar from "../components/FilterBar.astro";
import { articleDetailPath, articlePublishDate, articleSourceName, getArticles } from "../lib/articlesApi";
import {
  communityUpdateDate,
  getRecentApprovedCommunityUpdates,
} from "../lib/communityUpdates";
import {
  getCommunityUpdateCards,
  previewDescription,
  previewTitle,
} from "../lib/communityUpdateCards";
import { getRecentOrganizationComments } from "../lib/organizationsApi";
import { cleanText } from "../lib/text";
import profileIcon from "../assets/profile icon.png";

const q = Astro.url.searchParams.get("q")?.trim() || "";
const typeParam = Astro.url.searchParams.get("type");
const type = typeParam === null ? "community" : typeParam.trim();
const sort = Astro.url.searchParams.get("sort")?.trim() || "updated:desc";

let feedItems = [];
let error = "";

try {
  const [communityUpdates, articleData, organizationComments] = await Promise.all([
    getRecentApprovedCommunityUpdates({ limit: 80 }),
    getArticles({ include: "relations", limit: 80 }),
    getRecentOrganizationComments({ limit: 80 }),
  ]);
  const communityUpdateCards = await getCommunityUpdateCards(communityUpdates || []);

  feedItems = [
    ...communityUpdateCards.map((update) => communityFeedItem(update)),
    ...((articleData.articles || []).map((article) => articleFeedItem(article))),
    ...(organizationComments || []).map((comment) => organizationCommentFeedItem(comment)),
  ].sort((a, b) => b.sortDate - a.sortDate);
} catch (loadError) {
  error = loadError?.message || "Unable to load updates.";
}

const typeOptions = [
  ["community", "Community updates"],
  ["article", "Articles"],
  ["organization-comment", "Organization comments"],
  ["", "Everything"],
];

function communityFeedItem(update = {}) {
  const photos = update.photoUrls?.length ? update.photoUrls : update.photoUrl ? [update.photoUrl] : [];
  const dateValue = update.createdAt || "";
  const submittedBy = `Submitted by ${cleanText(update.displayName || "Community member")}`;
  const dateText = communityUpdateDate(dateValue);
  return {
    type: "community",
    typeLabel: "Community update",
    typeIcon: "CU",
    title: cleanText(update.entityName || "Community update"),
    eyebrow: cleanText(update.entityType || "Community"),
    body: cleanText(update.comment || update.linkUrl || "Community-submitted context."),
    href: update.pageUrl || update.linkUrl || "/communities",
    sourceHref: update.linkUrl || "",
    sourceLabel: update.linkUrl ? "Open submitted link" : "",
    meta: [submittedBy, dateText].filter(Boolean).join(" - "),
    submittedBy,
    dateValue,
    dateText,
    image: photos[0] || "",
    photos,
    linkUrl: update.linkUrl || "",
    linkPreview: update.linkPreview || null,
    social: update.social || null,
    people: update.people || [],
    text: [
      update.entityName,
      update.entityKey,
      update.displayName,
      update.comment,
      update.linkUrl,
      (update.mentions || []).map((mention) => mention.name).join(" "),
    ].filter(Boolean).join(" "),
    sortName: cleanText(update.entityName || update.displayName || ""),
    sortDate: Date.parse(dateValue || "") || 0,
  };
}

function articleFeedItem(article = {}) {
  const dateText = articlePublishDate(article);
  const source = articleSourceName(article);
  const title = cleanText(article.preview?.title || article.title || "Article");
  return {
    type: "article",
    typeLabel: "Article",
    typeIcon: "A",
    title,
    eyebrow: source || "Article",
    body: cleanText(article.preview?.description || article.summary || "Civic coverage tracked by NH Deserves Better."),
    href: articleDetailPath(article),
    sourceHref: article.url || "",
    sourceLabel: source ? `Original source: ${source}` : "Open original article",
    meta: [source, dateText].filter(Boolean).join(" - "),
    image: article.preview?.imageUrl || "",
    text: [
      title,
      source,
      article.summary,
      article.preview?.description,
      (article.bills || []).map((bill) => bill.name || bill.title || bill.condensedbillno || bill).join(" "),
      (article.legislators || []).map((person) => person.name || person.matched_name || person).join(" "),
      (article.candidates || []).map((person) => person.name || person.candidate_name_raw || person).join(" "),
      (article.towns || []).map((town) => town.town || town.name || town).join(" "),
    ].filter(Boolean).join(" "),
    sortName: title,
    sortDate: articleDateSortValue(article),
  };
}

function organizationCommentFeedItem(comment = {}) {
  const billLabel = cleanText(comment.billLabel || comment.bill || "Tracked bill");
  const organization = cleanText(comment.organization || "Organization");
  const title = `${organization} on ${billLabel}`;
  return {
    type: "organization-comment",
    typeLabel: "Organization comment",
    typeIcon: "OC",
    title,
    eyebrow: [comment.position, billLabel].filter(Boolean).join(" - "),
    body: cleanText(comment.comment || "Organization position on a tracked bill."),
    href: comment.bill ? `/bills/${encodeURIComponent(comment.bill)}` : `/organizations/${comment.organizationSlug}`,
    sourceHref: comment.linkUrl || "",
    sourceLabel: cleanText(comment.linkLabel || "Read source"),
    meta: [organization, cleanDate(comment.date)].filter(Boolean).join(" - "),
    image: comment.photoUrl || "",
    text: [
      organization,
      billLabel,
      comment.bill,
      comment.position,
      comment.comment,
      comment.author,
      (comment.issueAreas || []).join(" "),
      (comment.towns || []).join(" "),
    ].filter(Boolean).join(" "),
    sortName: title,
    sortDate: Date.parse(comment.date || "") || 0,
  };
}

function articleDateSortValue(article = {}) {
  const value =
    article.published_at ||
    article.publishedAt ||
    article.published_date ||
    article.publishedDate ||
    article.publish_date ||
    article.publishDate ||
    article.date ||
    article.created_at ||
    article.createdAt ||
    article.updated_at ||
    article.updatedAt;
  return Date.parse(value || "") || 0;
}

function cleanDate(value = "") {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return cleanText(value);
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/NH%20DB%20Logo.svg" />
    <link rel="apple-touch-icon" href="/NH%20DB%20Logo.svg" />
    <title>Updates Feed | NH Deserves Better</title>
    <meta
      name="description"
      content="A combined feed of community updates, civic articles, and organization comments on tracked bills."
    />
  </head>

  <body>
    <TopNav />
    <main
      class="page"
      x-data="nhdbFuzzyFilter({ itemSelector: '.feed-card[data-fuzzy-item]', pageSize: 20, threshold: 0.32 })"
    >
      <section class="hero">
        <p class="eyebrow">Updates Feed</p>
        <h1>Follow community context, coverage, and organization comments.</h1>
        <p class="lede">
          Start with community updates, then filter into articles and
          organizational comments connected to candidates, legislators,
          communities, and tracked bills.
        </p>
      </section>

      <FilterBar action="/updates" submitLabel="Filter feed" clearHref="/updates" columns="wide" live={true}>
        <label for="q">
          <span>Search</span>
          <input
            id="q"
            name="q"
            type="search"
            value={q}
            placeholder="Town, bill, person, organization, or keyword"
            data-fuzzy-search
          />
        </label>
        <label for="type">
          <span>Feed type</span>
          <select id="type" name="type" data-fuzzy-filter-field data-fuzzy-field="type" data-fuzzy-match="exact">
            {typeOptions.map(([value, label]) => (
              <option value={value} selected={type === value}>{label}</option>
            ))}
          </select>
        </label>
        <label for="sort">
          <span>Sort</span>
          <select id="sort" name="sort" data-fuzzy-sort>
            <option value="updated:desc" selected={sort === "updated:desc"}>Newest first</option>
            <option value="updated:asc" selected={sort === "updated:asc"}>Oldest first</option>
            <option value="name:asc" selected={sort === "name:asc"}>Title A-Z</option>
            <option value="type:asc" selected={sort === "type:asc"}>Type A-Z</option>
          </select>
        </label>
      </FilterBar>
      <div class="filter-chips" data-fuzzy-chips hidden></div>

      {error ? (
        <p class="status-message">{error}</p>
      ) : (
        <section class="feed-panel">
          <div class="results-heading">
            <div>
              <p class="eyebrow">Recent Context</p>
              <h2><span data-fuzzy-count>{feedItems.length}</span> items shown</h2>
            </div>
            <a href="/suggest-update">Suggest an update</a>
          </div>

          <div class="feed-list">
            {feedItems.map((item) => (
              <article
                class:list={["feed-card", item.image && "has-image"]}
                data-fuzzy-item
                data-fuzzy-text={item.text}
                data-fuzzy-type={item.type}
                data-fuzzy-sort-name={item.sortName}
                data-fuzzy-sort-updated={item.sortDate}
                data-fuzzy-sort-type={item.typeLabel}
              >
                {item.image && (
                  <a class="feed-image" href={item.href} tabindex="-1" aria-hidden="true">
                    <img src={item.image} alt="" loading="lazy" />
                  </a>
                )}
                <div class="feed-copy">
                  <div class="feed-card-head">
                    <span class:list={["feed-type-icon", `feed-type-${item.type}`]} aria-hidden="true">
                      {item.typeIcon}
                    </span>
                    <div class="feed-head-copy">
                      {item.type === "community" ? (
                        <>
                          <strong>{item.submittedBy}</strong>
                          {item.dateText && <time datetime={item.dateValue}>{item.dateText}</time>}
                        </>
                      ) : (
                        <div class="feed-topline">
                          <span>{item.typeLabel}</span>
                          {item.eyebrow && <span>{item.eyebrow}</span>}
                        </div>
                      )}
                    </div>
                  </div>
                  {item.type !== "community" && <h3><a href={item.href}>{item.title}</a></h3>}
                  {item.type !== "community" && item.meta && <p class="feed-meta">{item.meta}</p>}
                  <p>{item.body}</p>
                  {item.type === "community" && item.linkUrl && (
                    ["instagram", "tiktok", "substack"].includes(item.social?.type || "") ? (
                      <a
                        class:list={[
                          "community-link-preview",
                          "rich-link-preview",
                          item.social.type === "tiktok"
                            ? "tiktok-preview-card"
                            : item.social.type === "substack"
                              ? "substack-preview-card"
                              : "instagram-preview-card",
                        ]}
                        href={item.social.permalink || item.linkUrl}
                      >
                        <span class:list={[
                          item.social.type === "tiktok"
                            ? "tiktok-icon"
                            : item.social.type === "substack"
                              ? "substack-icon"
                              : "instagram-icon",
                        ]} aria-hidden="true">
                          {item.social.type === "tiktok" ? "TT" : item.social.type === "substack" ? "S" : "IG"}
                        </span>
                        {item.linkPreview?.imageUrl && <img src={item.linkPreview.imageUrl} alt="" loading="lazy" />}
                        <span>
                          <strong>{previewTitle(item.linkPreview, item.linkUrl)}</strong>
                          <small>
                            {item.social.handle
                              ? item.social.type === "substack"
                                ? `@${item.social.handle} on Substack`
                                : `${item.social.isProfile ? "Profile: " : ""}@${item.social.handle}`
                              : item.social.publication
                                ? `${item.social.publication} on Substack`
                                : previewDescription(item.linkPreview, item.linkUrl)}
                          </small>
                        </span>
                      </a>
                    ) : (
                      <a class="community-link-preview rich-link-preview" href={item.linkUrl}>
                        {item.linkPreview?.imageUrl && <img src={item.linkPreview.imageUrl} alt="" loading="lazy" />}
                        <span>
                          <strong>{previewTitle(item.linkPreview)}</strong>
                          {previewDescription(item.linkPreview, item.linkUrl) && (
                            <small>{previewDescription(item.linkPreview, item.linkUrl)}</small>
                          )}
                        </span>
                      </a>
                    )
                  )}
                  {item.type === "community" && item.people?.length > 0 && (
                    <div class="community-people-block">
                      <h4>People</h4>
                      <div class="community-people-preview" aria-label="People connected to this update">
                        {item.people.slice(0, 4).map((person) => (
                          <a class="mini-person-card" href={person.path}>
                            <img
                              class:list={[!person.photoUrl && "profile-icon"]}
                              src={person.photoUrl || profileIcon.src}
                              alt={person.photoUrl ? `Photo of ${person.name}` : ""}
                              loading="lazy"
                            />
                            <span>
                              <strong>{cleanText(person.name)}</strong>
                              {person.role && <small>{cleanText(person.role)}</small>}
                              {person.districtLabel && <small>{cleanText(person.districtLabel)}</small>}
                            </span>
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                  <div class="feed-actions">
                    <a href={item.href}>Open details</a>
                    {item.sourceHref && <a href={item.sourceHref}>{item.sourceLabel}</a>}
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="status-message empty-state" data-fuzzy-empty hidden>
            <strong>No updates matched those filters.</strong>
            <p>Try a broader keyword, clear the type chip, or switch the feed type to Everything.</p>
          </div>
          <div class="see-more-row">
            <button type="button" class="see-more-button subtle" data-fuzzy-more hidden>Show more loaded updates</button>
          </div>
        </section>
      )}
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  a {
    color: #1f2933;
    font-weight: 800;
  }

  .hero {
    margin-bottom: 18px;
    padding: 32px;
  }

  .hero h1 {
    font-size: clamp(2.15rem, 5.25vw, 4rem);
    line-height: 0.95;
    margin: 0 0 18px;
    max-width: 920px;
  }

  .lede {
    color: #4b5563;
    line-height: 1.6;
    margin: 0;
    max-width: 760px;
  }

  .feed-panel {
    display: grid;
    gap: 16px;
    justify-self: center;
    margin-top: 18px;
    max-width: 880px;
    width: 100%;
  }

  .results-heading {
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 10px;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding: 20px;
  }

  .results-heading h2 {
    font-size: 1.55rem;
    line-height: 1.05;
    margin: 0;
  }

  .feed-list {
    display: grid;
    gap: 14px;
  }

  .feed-card {
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 10px;
    display: grid;
    gap: 0;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
  }

  .feed-card.has-image {
    grid-template-columns: minmax(0, 1fr) minmax(180px, 0.34fr);
  }

  .feed-image {
    background: #f8fafc;
    grid-column: 2;
    grid-row: 1;
    min-height: 190px;
  }

  .feed-image img {
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .feed-copy {
    display: grid;
    gap: 10px;
    grid-column: 1;
    grid-row: 1;
    padding: 20px;
  }

  .feed-card-head {
    align-items: start;
    display: grid;
    gap: 10px;
    grid-template-columns: 38px minmax(0, 1fr);
  }

  .feed-type-icon {
    align-items: center;
    background: #1d4ed8;
    border-radius: 10px;
    color: #ffffff;
    display: inline-flex;
    font-size: 0.7rem;
    font-weight: 950;
    height: 34px;
    justify-content: center;
    line-height: 1;
    width: 34px;
  }

  .feed-type-article {
    background: #7c2d12;
  }

  .feed-type-organization-comment {
    background: #166534;
  }

  .feed-head-copy {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .feed-head-copy > strong {
    color: #1f2933;
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .feed-head-copy time {
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 850;
  }

  .feed-topline,
  .feed-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .feed-topline span {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    color: #475569;
    font-size: 0.76rem;
    font-weight: 950;
    padding: 6px 9px;
  }

  .feed-topline span:first-child {
    background: #fff7ed;
    border-color: #f4b35f;
    color: #8a3a05;
  }

  .feed-copy h3 {
    font-size: clamp(1.18rem, 2vw, 1.6rem);
    line-height: 1.08;
    margin: 0;
  }

  .feed-copy p {
    color: #4b5563;
    line-height: 1.55;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .feed-meta {
    color: #64748b !important;
    font-size: 0.84rem;
    font-weight: 850;
  }

  .feed-actions a {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    font-size: 0.82rem;
    padding: 8px 10px;
    text-decoration: none;
  }

  .rich-link-preview {
    overflow: hidden;
  }

  .rich-link-preview > img {
    aspect-ratio: 16 / 9;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    grid-column: 1 / -1;
    max-height: 220px;
    object-fit: contain;
    width: 100%;
  }

  .community-link-preview {
    background: #ffffff;
    border: 1px solid #93c5fd;
    border-radius: 14px;
    color: #1f2933;
    display: grid;
    gap: 10px;
    justify-self: start;
    max-width: min(520px, 100%);
    padding: 12px;
    text-decoration: none;
    width: 100%;
  }

  .instagram-preview-card {
    align-items: center;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(135deg, #f97316, #db2777, #7c3aed) border-box;
    border: 2px solid transparent;
    grid-template-columns: auto minmax(0, 1fr);
  }

  .tiktok-preview-card {
    align-items: center;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(135deg, #111827, #06b6d4, #ef4444) border-box;
    border: 2px solid transparent;
    grid-template-columns: auto minmax(0, 1fr);
  }

  .substack-preview-card {
    align-items: center;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(135deg, #ff6719, #f59e0b, #7c2d12) border-box;
    border: 2px solid transparent;
    grid-template-columns: auto minmax(0, 1fr);
  }

  .instagram-icon,
  .tiktok-icon,
  .substack-icon {
    align-items: center;
    background: linear-gradient(135deg, #f97316, #db2777, #7c3aed);
    border-radius: 10px;
    color: #ffffff;
    display: inline-flex;
    font-size: 0.78rem;
    font-weight: 950;
    height: 38px;
    justify-content: center;
    width: 38px;
  }

  .tiktok-icon {
    background: linear-gradient(135deg, #111827, #06b6d4, #ef4444);
  }

  .substack-icon {
    background: linear-gradient(135deg, #ff6719, #f97316);
  }

  .community-link-preview strong,
  .community-link-preview small {
    display: block;
  }

  .community-link-preview strong {
    font-size: 1rem;
    line-height: 1.2;
  }

  .community-link-preview small {
    color: #64748b;
    font-size: 0.84rem;
    font-weight: 850;
    line-height: 1.35;
    margin-top: 4px;
  }

  .community-people-preview {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(auto-fit, minmax(150px, 220px));
    justify-content: start;
    max-width: 700px;
  }

  .community-people-block {
    border-top: 1px solid #dbeafe;
    display: grid;
    gap: 8px;
    margin-top: 4px;
    max-width: 700px;
    padding-top: 12px;
  }

  .community-people-block h4 {
    color: #6b4f2a;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.1em;
    line-height: 1;
    margin: 0;
    text-transform: uppercase;
  }

  .mini-person-card {
    align-items: center;
    background: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    color: #1f2933;
    display: grid;
    gap: 10px;
    grid-template-columns: 42px minmax(0, 1fr);
    max-width: 220px;
    min-width: 0;
    padding: 8px;
    text-decoration: none;
  }

  .mini-person-card img {
    aspect-ratio: 4 / 5;
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 9px;
    display: block;
    height: 52px;
    object-fit: cover;
    object-position: center top;
    width: 42px;
  }

  .mini-person-card img.profile-icon {
    object-fit: cover;
  }

  .mini-person-card span {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .mini-person-card strong,
  .mini-person-card small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mini-person-card strong {
    color: #1f2933;
    font-size: 0.92rem;
    line-height: 1.15;
  }

  .mini-person-card small {
    color: #64748b;
    font-size: 0.74rem;
    font-weight: 850;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0;
  }

  .status-message,
  .empty-state {
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 10px;
    color: #4b5563;
    line-height: 1.5;
    padding: 16px;
  }

  .see-more-row {
    display: flex;
    justify-content: center;
  }

  .see-more-button {
    background: #1f2933;
    border: 1px solid #1f2933;
    border-radius: 999px;
    color: white;
    cursor: pointer;
    font: inherit;
    font-weight: 900;
    padding: 10px 14px;
  }

  @media (max-width: 760px) {
    .feed-card.has-image {
      grid-template-columns: 1fr;
    }

    .feed-image,
    .feed-copy {
      grid-column: auto;
      grid-row: auto;
    }

    .feed-image {
      min-height: 220px;
    }

    .results-heading {
      align-items: start;
      display: grid;
    }
  }
</style>
