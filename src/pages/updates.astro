---
export const prerender = false;

import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FilterBar from "../components/FilterBar.astro";
import {
  communityUpdateDate,
  getRecentApprovedCommunityUpdates,
} from "../lib/communityUpdates";
import {
  getCommunityUpdateCards,
  peopleProfilePath,
  previewDescription,
  previewTitle,
} from "../lib/communityUpdateCards";
import { cleanText } from "../lib/text";
import profileIcon from "../assets/profile icon.png";

const q = Astro.url.searchParams.get("q")?.trim() || "";
const platform = Astro.url.searchParams.get("platform")?.trim() || "";
const sort = Astro.url.searchParams.get("sort")?.trim() || "updated:desc";
const TITLE_PREVIEW_LENGTH = 114;
const DESCRIPTION_PREVIEW_LENGTH = 114;
const NOTE_PREVIEW_LENGTH = 114;

let mediaItems = [];
let recentlyUpdatedPeople = [];
let error = "";

try {
  const updates = await getRecentApprovedCommunityUpdates({ limit: 120 });
  const cards = await getCommunityUpdateCards(updates || []);

  mediaItems = cards
    .map((update) => mediaFeedItem(update))
    .sort((a, b) => b.sortDate - a.sortDate);
  recentlyUpdatedPeople = recentPeopleFromUpdates(mediaItems);
} catch (loadError) {
  error = loadError?.message || "Unable to load community updates.";
}

const platformOptions = [
  ["", "All platforms"],
  ["tiktok", "TikTok"],
  ["instagram", "Instagram"],
  ["facebook", "Facebook"],
  ["substack", "Substack"],
  ["photo", "Photos"],
  ["link", "Links"],
  ["update", "Notes"],
];

function mediaFeedItem(update = {}) {
  const social = update.social || {};
  const people = update.people || [];
  const dateValue = update.createdAt || "";
  const preview = update.linkPreview || null;
  const title = previewTitle(preview, update.linkUrl);
  const titlePreview = textPreview(title, TITLE_PREVIEW_LENGTH);
  const description = mediaDescription(preview, update.linkUrl, social);
  const isPortrait = social.type === "tiktok" || isInstagramVideo(social) || isFacebookVideo(social);
  const fallbackImageUrl = update.photoUrls?.[0] || update.photoUrl || "";
  const platform = social.type || (fallbackImageUrl ? "photo" : update.linkUrl ? "link" : "update");

  return {
    id: update.id,
    title,
    titlePreview: titlePreview.preview,
    description,
    body: cleanText(update.comment || ""),
    dateText: communityUpdateDate(dateValue),
    dateValue,
    displayName: cleanText(update.displayName || "Community member"),
    entityName: cleanText(update.entityName || ""),
    href: update.pageUrl || update.linkUrl || "/updates",
    imageUrl: preview?.imageUrl || fallbackImageUrl,
    linkUrl: update.linkUrl || "",
    people,
    platform,
    platformLabel: platformLabel(social, platform),
    fallbackLabel: fallbackLabel(social, title),
    social,
    embedUrl: social.type === "facebook" ? social.embedUrl || "" : "",
    isPortrait,
    sortDate: Date.parse(dateValue || "") || 0,
    sortName: title,
    text: [
      title,
      description,
      update.comment,
      update.entityName,
      update.displayName,
      update.linkUrl,
      social.handle,
      social.publication,
      people.map((person) => person.name || person.role || person.districtLabel).join(" "),
    ].filter(Boolean).join(" "),
  };
}

function recentPeopleFromUpdates(items = []) {
  const peopleByKey = new Map();

  for (const item of items) {
    for (const person of item.people || []) {
      const key = [
        person.personId,
        person.personid,
        person.filerEntityNumber,
        person.path,
        person.name,
      ].filter(Boolean)[0];
      if (!key) continue;

      const existing = peopleByKey.get(String(key));
      const sortDate = Number(item.sortDate) || 0;
      if (!existing) {
        peopleByKey.set(String(key), {
          ...person,
          path: peopleProfilePath(person),
          updateCount: 1,
          latestDate: sortDate,
          latestDateText: item.dateText,
          latestPlatform: item.platformLabel,
          latestTitle: item.titlePreview || item.title || "Community update",
          text: [
            person.name,
            person.role,
            person.districtLabel,
            item.title,
            item.body,
            item.platformLabel,
          ].filter(Boolean).join(" "),
        });
      } else {
        existing.updateCount += 1;
        existing.text = [existing.text, item.title, item.body, item.platformLabel].filter(Boolean).join(" ");
        if (sortDate > existing.latestDate) {
          existing.latestDate = sortDate;
          existing.latestDateText = item.dateText;
          existing.latestPlatform = item.platformLabel;
          existing.latestTitle = item.titlePreview || item.title || "Community update";
        }
      }
    }
  }

  return [...peopleByKey.values()]
    .sort((a, b) => b.latestDate - a.latestDate)
    .slice(0, 12);
}

function fallbackLabel(social = {}, title = "") {
  if (social.type === "substack") {
    const isHomePost = String(social.permalink || "").includes("substack.com/home/post/");
    return {
      mark: "S",
      kicker: isHomePost ? "Substack share link" : "Substack",
      title: social.publication
        ? `${social.publication}.substack.com`
        : social.handle
          ? `@${social.handle}`
          : cleanText(title || "Substack link"),
    };
  }

  return {
    mark: "",
    kicker: social.label || "Community update",
    title: social.host || social.handle || cleanText(title || "Shared context"),
  };
}

function isInstagramVideo(social = {}) {
  const label = String(social.label || "").toLowerCase();
  return label.includes("reel") || label.includes("video");
}

function isFacebookVideo(social = {}) {
  const label = String(social.label || "").toLowerCase();
  const permalink = String(social.permalink || "").toLowerCase();
  return social.type === "facebook" && (
    label.includes("reel") ||
    label.includes("video") ||
    permalink.includes("/reel/") ||
    permalink.includes("/videos/") ||
    permalink.includes("/watch/")
  );
}

function platformLabel(social = {}, platform = "") {
  if (social.type === "tiktok") return social.isProfile ? "TikTok profile" : "TikTok video";
  if (social.type === "instagram") return social.isProfile ? "Instagram profile" : social.label || "Instagram post";
  if (social.type === "facebook") return social.label || "Facebook post";
  if (social.type === "substack") return social.label || "Substack";
  if (platform === "photo") return "Photo update";
  if (platform === "link") return "Community link";
  return "Community note";
}

function handleText(item = {}) {
  if (item.social?.handle) {
    return item.platform === "substack"
      ? `@${item.social.handle} on Substack`
      : `${item.social.isProfile ? "Profile: " : ""}@${item.social.handle}`;
  }
  if (item.social?.publication) return item.social.publication;
  if (item.platform === "facebook" || item.platform === "substack" || item.platform === "photo") return "";
  return item.social?.host || "";
}

function mediaDescription(preview = null, linkUrl = "", social = {}) {
  const description = previewDescription(preview, linkUrl);
  if (!description) return "";

  const normalized = description.toLowerCase().trim();
  const host = String(social.host || "").toLowerCase().trim();

  if (host && normalized === host) return "";
  if (social.type === "facebook" && normalized.includes("facebook.com")) return "";
  if (social.type === "substack") {
    const publication = String(social.publication || "").toLowerCase().trim();
    const handle = String(social.handle || "").toLowerCase().trim();
    if (normalized === "substack") return "";
    if (publication && normalized === `${publication} on substack`) return "";
    if (handle && normalized === `@${handle} on substack`) return "";
  }

  return description;
}

function textPreview(value = "", maxLength = 170) {
  const text = cleanText(value).replace(/\s+/g, " ").trim();
  if (text.length <= maxLength) {
    return { text, preview: text, isLong: false };
  }

  const clipped = text.slice(0, maxLength + 1);
  const sentenceBreak = Math.max(
    clipped.lastIndexOf(". "),
    clipped.lastIndexOf("! "),
    clipped.lastIndexOf("? "),
  );
  const commaBreak = clipped.lastIndexOf(", ");
  const spaceBreak = clipped.lastIndexOf(" ");
  const breakAt =
    sentenceBreak > 80
      ? sentenceBreak + 1
      : commaBreak > 80
        ? commaBreak
        : spaceBreak > 80
          ? spaceBreak
          : maxLength;

  return {
    text,
    preview: `${text.slice(0, breakAt).trim()}...`,
    isLong: true,
  };
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/NH%20DB%20Logo.svg" />
    <link rel="apple-touch-icon" href="/NH%20DB%20Logo.svg" />
    <title>Community Updates | NH Deserves Better</title>
    <meta
      name="description"
      content="Community-submitted updates, social posts, reels, videos, and newsletter links about New Hampshire legislators."
    />
  </head>

  <body>
    <TopNav />
    <main
      class="page"
      x-data="nhdbFuzzyFilter({ itemSelector: '.media-card[data-fuzzy-item]', pageSize: 18, threshold: 0.32 })"
    >
      <div class="updates-layout">
        <aside class="recently-updated-panel" aria-label="Recently updated profiles">
          <div class="sidebar-heading">
            <p class="eyebrow">Recently Updated</p>
            <h3>People with new community context</h3>
          </div>

          {recentlyUpdatedPeople.length ? (
            <div class="recent-people-list">
              {recentlyUpdatedPeople.map((person) => (
                <a
                  class="recent-person-card"
                  href={peopleProfilePath(person)}
                  data-fuzzy-sidebar-item
                  data-fuzzy-sidebar-text={person.text}
                >
                  <img
                    class:list={[!person.photoUrl && "profile-icon"]}
                    src={person.photoUrl || profileIcon.src}
                    alt={person.photoUrl ? `Photo of ${person.name}` : ""}
                    loading="lazy"
                  />
                  <span>
                    <strong>{cleanText(person.name)}</strong>
                    {(person.role || person.districtLabel) && (
                      <small>{cleanText([person.role, person.districtLabel].filter(Boolean).join(" - "))}</small>
                    )}
                    <em>
                      {person.updateCount} {person.updateCount === 1 ? "update" : "updates"}
                      {person.latestDateText && ` · ${person.latestDateText}`}
                    </em>
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p>No tagged people yet.</p>
          )}
        </aside>

        <div class="updates-main">
          <section class="hero">
            <div class="hero-kicker-row">
              <p class="eyebrow">Community Updates</p>
              <a href="/suggest-update">Submit context</a>
            </div>
            <h1>Local context that helps neighbors understand public power.</h1>
            <p class="lede">
              Browse community-submitted posts, photos, links, reels, TikToks, and
              newsletter updates connected to New Hampshire legislators and
              candidates. The public record gets stronger when people add what they
              are seeing in their own communities.
            </p>
          </section>

      <FilterBar action="/updates" submitLabel="Filter updates" clearHref="/updates" columns="wide" live={true}>
        <label for="q">
          <span>Search</span>
          <input
            id="q"
            name="q"
            type="search"
            value={q}
            placeholder="Legislator, town, district, platform, or keyword"
            data-fuzzy-search
          />
        </label>
        <label for="platform">
          <span>Platform</span>
          <select id="platform" name="platform" data-fuzzy-filter-field data-fuzzy-field="platform" data-fuzzy-match="exact">
            {platformOptions.map(([value, label]) => (
              <option value={value} selected={platform === value}>{label}</option>
            ))}
          </select>
        </label>
        <label for="sort">
          <span>Sort</span>
          <select id="sort" name="sort" data-fuzzy-sort>
            <option value="updated:desc" selected={sort === "updated:desc"}>Newest first</option>
            <option value="updated:asc" selected={sort === "updated:asc"}>Oldest first</option>
            <option value="name:asc" selected={sort === "name:asc"}>Title A-Z</option>
            <option value="platform:asc" selected={sort === "platform:asc"}>Platform A-Z</option>
          </select>
        </label>
      </FilterBar>
      <div class="filter-chips" data-fuzzy-chips hidden></div>

      {error ? (
        <p class="status-message">{error}</p>
      ) : (
        <section class="media-panel">
          <div class="results-heading">
            <div>
              <p class="eyebrow">Social Context</p>
              <h2><span data-fuzzy-count>{mediaItems.length}</span> community updates shown</h2>
            </div>
            <a href="/suggest-update">Suggest an update</a>
          </div>

            <div class="media-grid">
              {mediaItems.map((item) => (
                <article
                  class:list={[
                    "media-card",
                    item.isPortrait ? "portrait-media" : "landscape-media",
                    `platform-${item.platform}`,
                  ]}
                  data-fuzzy-item
                  data-fuzzy-text={item.text}
                  data-fuzzy-platform={item.platform}
                  data-fuzzy-sort-name={item.sortName}
                  data-fuzzy-sort-updated={item.sortDate}
                  data-fuzzy-sort-platform={item.platformLabel}
                >
                  <a
                    class="media-frame"
                    href={item.linkUrl || item.href}
                    target={item.linkUrl ? "_blank" : undefined}
                    rel={item.linkUrl ? "noopener noreferrer" : undefined}
                  >
                    <span class="platform-badge">{item.platformLabel}</span>
                    {item.imageUrl ? (
                      <img src={item.imageUrl} alt="" loading="lazy" />
                    ) : item.platform === "facebook" && item.embedUrl ? (
                      <iframe
                        class="media-embed facebook-media-embed"
                        src={item.embedUrl}
                        width="500"
                        height="520"
                        style="border:none;overflow:hidden"
                        scrolling="no"
                        frameborder="0"
                        allowfullscreen="true"
                        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                        loading="lazy"
                        title="Facebook post preview"
                      ></iframe>
                    ) : item.platform === "substack" ? (
                      <span class="media-fallback substack-media-fallback">
                        <span>{item.fallbackLabel.mark}</span>
                        <small>{item.fallbackLabel.kicker}</small>
                        <strong>{item.fallbackLabel.title}</strong>
                      </span>
                    ) : (
                      <span class="media-fallback">{item.platformLabel}</span>
                    )}
                  </a>

                  <div class="media-copy">
                    <div class="media-meta">
                      <span>{handleText(item)}</span>
                      {item.dateText && <time datetime={item.dateValue}>{item.dateText}</time>}
                    </div>
                    <h3>
                      <a
                        href={item.linkUrl || item.href}
                        target={item.linkUrl ? "_blank" : undefined}
                        rel={item.linkUrl ? "noopener noreferrer" : undefined}
                        title={item.title}
                        aria-label={item.title}
                      >
                        {item.titlePreview}
                      </a>
                    </h3>
                    {item.description && (
                      textPreview(item.description, DESCRIPTION_PREVIEW_LENGTH).isLong ? (
                        <details class="text-disclosure">
                          <summary>
                            <span>{textPreview(item.description, DESCRIPTION_PREVIEW_LENGTH).preview}</span>
                            <strong>Show more</strong>
                          </summary>
                          <p>{textPreview(item.description, DESCRIPTION_PREVIEW_LENGTH).text}</p>
                        </details>
                      ) : (
                        <p>{item.description}</p>
                      )
                    )}
                    {item.body && (
                      textPreview(item.body, NOTE_PREVIEW_LENGTH).isLong ? (
                        <details class="text-disclosure community-note">
                          <summary>
                            <span>{textPreview(item.body, NOTE_PREVIEW_LENGTH).preview}</span>
                            <strong>Show more</strong>
                          </summary>
                          <p>{textPreview(item.body, NOTE_PREVIEW_LENGTH).text}</p>
                        </details>
                      ) : (
                        <p class="community-note">{item.body}</p>
                      )
                    )}

                    {item.people.length > 0 && (
                      <div class="people-strip" aria-label="People connected to this post">
                        <span>Legislator context</span>
                        <div>
                          {item.people.slice(0, 3).map((person) => (
                            <a class="mini-person-card" href={peopleProfilePath(person)}>
                              <img
                                class:list={[!person.photoUrl && "profile-icon"]}
                                src={person.photoUrl || profileIcon.src}
                                alt={person.photoUrl ? `Photo of ${person.name}` : ""}
                                loading="lazy"
                              />
                              <strong>{cleanText(person.name)}</strong>
                              {(person.role || person.districtLabel) && (
                                <small>{cleanText([person.role, person.districtLabel].filter(Boolean).join(" - "))}</small>
                              )}
                            </a>
                          ))}
                        </div>
                      </div>
                    )}

                    <div class="media-actions">
                      <a href={item.href}>Open update</a>
                      {item.linkUrl && (
                        <a href={item.linkUrl} target="_blank" rel="noopener noreferrer">
                          Open post
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>

          <div class="status-message empty-state" data-fuzzy-empty hidden>
            <strong>No community updates matched those filters.</strong>
            <p>Try a broader name, remove the platform filter, or search by town or district.</p>
          </div>
          <div class="see-more-row">
            <button type="button" class="see-more-button subtle" data-fuzzy-more data-auto-load-more hidden>Show more updates</button>
          </div>
          <div class="scroll-load-sentinel" data-scroll-load-sentinel aria-hidden="true"></div>
        </section>
      )}
        </div>
      </div>
    </main>
    <SiteFooter />
    <script>
      function setupUpdateAutoLoad() {
        const button = document.querySelector("[data-auto-load-more]");
        const sentinel = document.querySelector("[data-scroll-load-sentinel]");
        if (!(button instanceof HTMLButtonElement) || !(sentinel instanceof HTMLElement)) return;

        let ticking = false;
        function maybeLoadMore() {
          if (button.hidden || ticking) return;
          const rect = sentinel.getBoundingClientRect();
          if (rect.top > window.innerHeight + 620) return;

          ticking = true;
          button.click();
          window.setTimeout(() => {
            ticking = false;
            maybeLoadMore();
          }, 160);
        }

        window.addEventListener("scroll", maybeLoadMore, { passive: true });
        window.addEventListener("resize", maybeLoadMore);
        maybeLoadMore();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupUpdateAutoLoad, { once: true });
      } else {
        setupUpdateAutoLoad();
      }
    </script>
  </body>
</html>

<style>
  .page {
    display: grid;
    gap: 18px;
    padding-inline: clamp(20px, 3vw, 44px);
    width: 100%;
  }

  .hero {
    background:
      radial-gradient(circle at 88% 16%, rgba(255, 103, 25, 0.22), transparent 18%),
      linear-gradient(135deg, #eff6ff 0%, #ffffff 54%, #fff7ed 100%);
    border: 1px solid var(--nhdb-line);
    border-radius: 16px;
    color: #1f2933;
    overflow: hidden;
    padding: clamp(26px, 4vw, 46px);
    position: relative;
  }

  .hero::after {
    background: linear-gradient(90deg, #1d4ed8, #ff6719);
    content: "";
    inset: auto 0 0;
    height: 8px;
    position: absolute;
  }

  .hero::before {
    background: #ff6719;
    border-radius: 999px;
    content: "";
    height: 72px;
    opacity: 0.9;
    position: absolute;
    right: clamp(20px, 4vw, 46px);
    top: clamp(22px, 4vw, 44px);
    width: 10px;
  }

  .hero-kicker-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: space-between;
  }

  .hero-kicker-row a {
    background: #1f2933;
    border: 1px solid #111827;
    border-radius: 999px;
    color: #fffaf1;
    font-size: 0.86rem;
    font-weight: 950;
    padding: 9px 12px;
    text-decoration: none;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5.2vw, 4.35rem);
    letter-spacing: 0;
    line-height: 0.96;
    margin: 0 0 16px;
    max-width: 880px;
  }

  .lede {
    color: #475569;
    font-size: clamp(1rem, 1.4vw, 1.16rem);
    line-height: 1.6;
    margin: 0;
    max-width: 760px;
  }

  .hero .eyebrow {
    color: #6b4f2a;
  }

  .media-panel {
    display: grid;
    gap: 18px;
  }

  .results-heading {
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 10px;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding: 20px;
  }

  .results-heading h2 {
    font-size: 1.55rem;
    line-height: 1.05;
    margin: 0;
  }

  .results-heading a,
  .media-actions a {
    background: #1f2933;
    border: 1px solid #111827;
    border-radius: 999px;
    color: #fffaf1;
    font-size: 0.86rem;
    font-weight: 950;
    padding: 9px 12px;
    text-decoration: none;
  }

  .updates-layout {
    align-items: start;
    display: grid;
    gap: clamp(26px, 3vw, 48px);
    grid-template-columns: minmax(0, 1fr) minmax(230px, 300px);
    width: 100%;
  }

  .updates-main {
    box-sizing: border-box;
    display: grid;
    gap: 18px;
    grid-column: 1;
    grid-row: 1;
    justify-self: center;
    max-width: 1120px;
    min-width: 0;
    padding-inline: clamp(8px, 1.6vw, 28px);
    width: 100%;
  }

  .recently-updated-panel {
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 14px;
    display: grid;
    gap: 14px;
    grid-column: 2;
    grid-row: 1;
    max-height: calc(100vh - 108px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 18px;
    position: sticky;
    scrollbar-color: #bfdbfe transparent;
    scrollbar-width: thin;
    top: 84px;
  }

  .recently-updated-panel::-webkit-scrollbar {
    width: 8px;
  }

  .recently-updated-panel::-webkit-scrollbar-track {
    background: transparent;
  }

  .recently-updated-panel::-webkit-scrollbar-thumb {
    background: #bfdbfe;
    border-radius: 999px;
  }

  .sidebar-heading {
    display: grid;
    gap: 5px;
  }

  .sidebar-heading h3 {
    font-size: 1.18rem;
    line-height: 1.08;
    margin: 0;
  }

  .recent-people-list {
    display: grid;
    gap: 9px;
  }

  .recent-person-card {
    align-items: center;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(135deg, rgba(37, 99, 235, 0.55), rgba(255, 103, 25, 0.35)) border-box;
    border: 1px solid transparent;
    border-radius: 12px;
    color: #1f2933;
    display: grid;
    gap: 10px;
    grid-template-columns: 48px minmax(0, 1fr);
    padding: 9px;
    text-decoration: none;
  }

  .recent-person-card:hover {
    border-color: #60a5fa;
    transform: translateY(-1px);
  }

  .recent-person-card img {
    aspect-ratio: 4 / 5;
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    display: block;
    height: 60px;
    object-fit: cover;
    object-position: center top;
    width: 48px;
  }

  .recent-person-card img.profile-icon {
    object-fit: cover;
  }

  .recent-person-card span {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .recent-person-card strong,
  .recent-person-card small,
  .recent-person-card em {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recent-person-card strong {
    font-size: 0.95rem;
    line-height: 1.12;
  }

  .recent-person-card small {
    color: #64748b;
    font-size: 0.75rem;
