---
export const prerender = false;

import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FilterBar from "../components/FilterBar.astro";
import { civicGuides, featuredCivicGuides } from "../lib/civicGuides";

const leadGuide = featuredCivicGuides[0] || civicGuides[0];
const categories = [...new Set(civicGuides.map((guide) => guide.category).filter(Boolean))];
const q = Astro.url.searchParams.get("q")?.trim() || "";
const category = Astro.url.searchParams.get("category")?.trim() || "";
const sort = Astro.url.searchParams.get("sort")?.trim() || "featured:desc";
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Civic Guides | NH Deserves Better</title>
    <meta
      name="description"
      content="Plain-language civic guides explaining New Hampshire government, bills, votes, political movements, and accountability tools."
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <section class="hero guide-hero">
        <p class="eyebrow">Civic Guides</p>
        <h1>Plain-language explainers for following New Hampshire politics.</h1>
        <p class="lede">
          Start with the basics, then go deeper into bills, vote grades,
          political context, and the decisions shaping communities across the
          state.
        </p>
      </section>

      {leadGuide && (
        <section class="lead-guide">
          <a class="lead-card" href={leadGuide.href}>
            <div class="lead-copy">
              <span>{leadGuide.kicker}</span>
              <h2>{leadGuide.title}</h2>
              <p>{leadGuide.description}</p>
              <small>{leadGuide.readTime}</small>
            </div>
            <img src={leadGuide.image} alt="" loading="eager" />
          </a>
        </section>
      )}

      <section
        class="guide-layout"
        x-data="nhdbFuzzyFilter({ itemSelector: '.guide-card[data-fuzzy-item]', pageSize: 12 })"
      >
        <div class="guide-main">
          <div class="section-heading">
            <p class="eyebrow">All Guides</p>
            <h2>Build your civic toolkit.</h2>
          </div>

          <FilterBar action="/civic-guides" submitLabel="Filter guides" clearHref="/civic-guides" columns="wide" live={true}>
            <label for="q">
              <span>Search</span>
              <input
                id="q"
                name="q"
                type="search"
                value={q}
                placeholder="Bills, vote grades, state government..."
                data-fuzzy-search
              />
            </label>
            <label for="category">
              <span>Topic</span>
              <select id="category" name="category" data-fuzzy-filter-field data-fuzzy-field="category" data-fuzzy-match="exact">
                <option value="" selected={!category}>All topics</option>
                {categories.map((topic) => (
                  <option value={topic} selected={category === topic}>{topic}</option>
                ))}
              </select>
            </label>
            <label for="sort">
              <span>Sort</span>
              <select id="sort" name="sort" data-fuzzy-sort>
                <option value="featured:desc" selected={sort === "featured:desc"}>Featured first</option>
                <option value="name:asc" selected={sort === "name:asc"}>Title A-Z</option>
                <option value="category:asc" selected={sort === "category:asc"}>Topic A-Z</option>
              </select>
            </label>
          </FilterBar>
          <div class="filter-chips" data-fuzzy-chips hidden></div>

          <div class="guide-grid">
            {civicGuides.map((guide) => (
              <a
                class="guide-card"
                href={guide.href}
                data-fuzzy-item
                data-fuzzy-text={[
                  guide.title,
                  guide.kicker,
                  guide.category,
                  guide.description,
                  guide.readTime,
                ].join(" ")}
                data-fuzzy-category={guide.category}
                data-fuzzy-sort-featured={guide.featured ? 1 : 0}
                data-fuzzy-sort-name={guide.title}
                data-fuzzy-sort-category={guide.category}
              >
                <img src={guide.image} alt="" loading="lazy" />
                <div>
                  <span>{guide.kicker}</span>
                  <h3>{guide.title}</h3>
                  <p>{guide.description}</p>
                  <small>{guide.readTime}</small>
                </div>
              </a>
            ))}
          </div>
          <div class="status-message empty-state" data-fuzzy-empty hidden>
            <strong>No guides matched those filters.</strong>
            <p>Try a broader search, or clear the topic filter.</p>
          </div>
        </div>

        <aside class="guide-sidebar">
          <section>
            <h2>Topics</h2>
            <div class="topic-list">
              {categories.map((category) => (
                <span>{category}</span>
              ))}
            </div>
          </section>

          <section>
            <h2>Good Starting Points</h2>
            <div class="sidebar-links">
              {featuredCivicGuides.map((guide) => (
                <a href={guide.href}>
                  <strong>{guide.title}</strong>
                  <span>{guide.readTime}</span>
                </a>
              ))}
            </div>
          </section>

          <section class="contribute-panel">
            <h2>Help Grow This Library</h2>
            <p>
              New Hampshire has a large citizen legislature. Keeping up with it
              takes a large community response.
            </p>
            <a href="/suggest-update?page=/civic-guides">Suggest a guide topic</a>
          </section>
        </aside>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .guide-hero {
    max-width: 920px;
  }

  .guide-hero h1 {
    max-width: 780px;
  }

  .guide-hero .lede {
    max-width: 720px;
  }

  .lead-guide {
    margin-top: 24px;
  }

  .lead-card {
    background: #142c46;
    border-radius: 14px;
    color: #fffaf1;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 1.05fr);
    min-height: 360px;
    overflow: hidden;
    text-decoration: none;
  }

  .lead-copy {
    align-content: end;
    display: grid;
    gap: 14px;
    padding: clamp(28px, 5vw, 56px);
  }

  .lead-copy span,
  .guide-card span {
    color: #f4b35f;
    font-size: 0.75rem;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lead-copy h2 {
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.98;
    margin: 0;
  }

  .lead-copy p {
    color: rgba(255, 250, 241, 0.86);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0;
  }

  .lead-copy small,
  .guide-card small {
    color: inherit;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .lead-card img {
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    width: 100%;
  }

  .guide-layout {
    align-items: start;
    display: grid;
    gap: 28px;
    grid-template-columns: minmax(0, 1fr) 320px;
    margin-top: 34px;
  }

  .guide-main,
  .guide-sidebar {
    display: grid;
    gap: 18px;
  }

  .section-heading {
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 10px;
    padding: 24px;
  }

  .section-heading h2 {
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 1;
    margin: 0;
  }

  .section-heading p {
    margin: 0 0 6px;
  }

  .guide-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .guide-card,
  .guide-sidebar section {
    background: #ffffff;
    border: 1px solid var(--nhdb-line);
    border-radius: 10px;
  }

  .guide-card {
    color: var(--nhdb-ink);
    display: grid;
    overflow: hidden;
    text-decoration: none;
  }

  .guide-card img {
    aspect-ratio: 16 / 9;
    background: #f8fafc;
    object-fit: cover;
    width: 100%;
  }

  .guide-card div {
    display: grid;
    gap: 10px;
    padding: 20px;
  }

  .guide-card h3,
  .guide-sidebar h2 {
    line-height: 1.08;
    margin: 0;
  }

  .guide-card p,
  .guide-sidebar p {
    color: var(--nhdb-muted);
    line-height: 1.55;
    margin: 0;
  }

  .guide-sidebar {
    position: sticky;
    top: 88px;
  }

  .guide-sidebar section {
    display: grid;
    gap: 14px;
    padding: 20px;
  }

  .topic-list,
  .sidebar-links {
    display: grid;
    gap: 8px;
  }

  .topic-list span {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    color: #334155;
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 900;
    padding: 8px 11px;
  }

  .sidebar-links a {
    border-top: 1px solid #e2e8f0;
    color: var(--nhdb-ink);
    display: grid;
    gap: 4px;
    padding-top: 12px;
    text-decoration: none;
  }

  .sidebar-links a:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .sidebar-links span {
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .contribute-panel {
    background: #fff7ed !important;
  }

  .contribute-panel a {
    background: #dc4d09;
    border-radius: 999px;
    color: #fffaf1;
    display: inline-flex;
    font-weight: 950;
    justify-content: center;
    padding: 10px 14px;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .lead-card,
    .guide-layout {
      grid-template-columns: 1fr;
    }

    .lead-card img {
      min-height: 240px;
      order: -1;
    }

    .guide-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .lead-copy {
      padding: 24px;
    }

    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
