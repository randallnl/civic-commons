---
export const prerender = false;

import RepresentativeCard from "../../components/RepresentativeCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import PageHero from "../../components/PageHero.astro";
import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getBillSummaries } from "../../lib/billsApi";
import { getRepresentative, getRepresentatives, repName } from "../../lib/repsApi";
import { cleanText } from "../../lib/text";
import { getTrackedBills } from "../../lib/trackedBills";

const DETAIL_PREVIEW_LIMIT = 80;

const filters = {
  body: Astro.url.searchParams.get("body")?.trim() || "",
  name: Astro.url.searchParams.get("name")?.trim() || "",
  town: Astro.url.searchParams.get("town")?.trim() || "",
  county: Astro.url.searchParams.get("county")?.trim() || "",
};
const sort = Astro.url.searchParams.get("sort")?.trim() || "";
const countyOptions = [
  "Belknap",
  "Carroll",
  "Cheshire",
  "Coos",
  "Grafton",
  "Hillsborough",
  "Merrimack",
  "Rockingham",
  "Strafford",
  "Sullivan",
];

let representatives = [];
let allRepresentatives = [];
let trackedBills = new Map();
let billSummaries = new Map();
let loadError = "";

try {
  const [repData, tracker, summaries] = await Promise.all([
    getRepresentatives({
      limit: 500,
    }),
    getTrackedBills(),
    getBillSummaries(),
  ]);

  allRepresentatives = repData.representatives || [];
  const filteredReps = allRepresentatives.filter((rep) => matchesFilters(rep, filters));

  representatives = await hydrateVotePreviewDetails(filteredReps);
  trackedBills = tracker;
  billSummaries = summaries;
} catch (error) {
  loadError = error?.message || "Unable to load representatives.";
}

const activeFilterCount = Object.values(filters).filter(Boolean).length;
const nameOptions = uniqueOptions(allRepresentatives.map(repName));
const townOptions = uniqueOptions(allRepresentatives.flatMap((rep) => townsFromValue(locationText(rep))));
const totalRepresentatives = Number(repDataTotal(allRepresentatives, representatives));

function matchesFilters(rep = {}, values = {}) {
  return (
    matchesBody(rep, values.body) &&
    matchesText([repName(rep), rep.nameAliases, rep.name_aliases].filter(Boolean).join(" "), values.name) &&
    matchesText(locationText(rep), values.town) &&
    matchesCounty(rep, values.county)
  );
}

function matchesBody(rep = {}, query = "") {
  if (!query) return true;
  const body = legislativeBody(rep).toLowerCase();
  const normalized = normalizeSearch(query);
  return body.includes(normalized);
}

async function hydrateVotePreviewDetails(reps = []) {
  const previewReps = reps.slice(0, DETAIL_PREVIEW_LIMIT);
  const hydrated = await Promise.all(
    previewReps.map(async (rep) => {
      const slugOrId = rep.personid || rep.id || rep.slug || repName(rep);
      if (!slugOrId) return rep;

      try {
        const data = await getRepresentative(slugOrId);
        return {
          ...rep,
          ...(data.representative || data.rep || data.person || data),
          voteHistory: data.voteHistory || data.votes || data.representative?.voteHistory || rep.voteHistory || [],
        };
      } catch (error) {
        console.error(error?.message || "Unable to hydrate representative vote preview.");
        return rep;
      }
    }),
  );

  return [...hydrated, ...reps.slice(DETAIL_PREVIEW_LIMIT)];
}

function matchesText(source = "", query = "") {
  if (!query) return true;
  return normalizeSearch(source).includes(normalizeSearch(query));
}

function matchesCounty(rep = {}, query = "") {
  if (!query) return true;
  const countyText = [
    rep.county,
    rep.countyName,
    rep.county_name,
    rep.countiesRepresented,
    rep.counties_represented,
    countyNameForCode(rep.countycode),
    locationText(rep),
  ].filter(Boolean).join(" ");

  return matchesText(countyText, query);
}

function locationText(rep = {}) {
  const value =
    rep.location_text ||
    rep.locationText ||
    rep.towns_represented ||
    rep.townsRepresented ||
    rep.towns ||
    "";

  if (Array.isArray(value)) {
    return value
      .map((item) =>
        typeof item === "object" && item !== null
          ? item.town || item.name || item.label || item.location_text || ""
          : item,
      )
      .filter(Boolean)
      .join(", ");
  }

  return cleanText(value);
}

function legislativeBody(rep = {}) {
  const value = String(rep.chamber || rep.legislativebody || rep.body || "").toLowerCase();
  if (value === "h" || value === "house") return "House";
  if (value === "s" || value === "senate") return "Senate";
  return rep.chamber || "";
}

function normalizeSearch(value = "") {
  return cleanText(value)
    .toLowerCase()
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function townsFromValue(value = "") {
  if (Array.isArray(value)) {
    return value.flatMap(townsFromValue);
  }

  return String(value || "")
    .split(/[,;|]/)
    .map((item) => item.replace(/\s*-\s*Ward\s+\d+$/i, "").trim())
    .filter(Boolean);
}

function uniqueOptions(values = []) {
  return [...new Set(values.map((value) => cleanText(value).trim()).filter(Boolean))]
    .sort((a, b) => a.localeCompare(b));
}

function countyNameForCode(code = "") {
  const counties = {
    "01": "Belknap",
    "02": "Carroll",
    "03": "Cheshire",
    "04": "Coos",
    "05": "Grafton",
    "06": "Hillsborough",
    "07": "Merrimack",
    "08": "Rockingham",
    "09": "Strafford",
    "10": "Sullivan",
  };

  const normalized = String(code || "").padStart(2, "0");
  return counties[normalized] || "";
}

function repDataTotal(allReps = [], filteredReps = []) {
  return Math.max(allReps.length, filteredReps.length);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>All Representatives | NH Deserves Better</title>
    <meta
      name="description"
      content="Browse New Hampshire legislators by name, town, or county and preview their tracked bill votes."
    />
  </head>

  <body>
    <TopNav />
    <main class="page" x-data="nhdbFuzzyFilter({ itemSelector: '.rep-card[data-fuzzy-item]', idleLimit: 12 })">
      <PageHero
        backHref="/my-state-rep"
        backLabel="Back to My Legislator"
        eyebrow="Representative Directory"
        title="Browse New Hampshire state legislators."
        lede="Search by name, town, or county to preview representative profiles, testimony alignment, and recent tracked bill votes."
      >
        <FilterBar
          action="/people"
          submitLabel="Filter reps"
          clearHref={activeFilterCount > 0 ? "/people" : ""}
          live
        >
          <label for="body">
            <span>Body</span>
            <select id="body" name="body" data-fuzzy-filter-field data-fuzzy-field="body" data-fuzzy-match="exact">
              <option value="" selected={!filters.body}>House and Senate</option>
              <option value="house" selected={filters.body === "house"}>House</option>
              <option value="senate" selected={filters.body === "senate"}>Senate</option>
            </select>
          </label>
          <label for="name">
            <span>Name</span>
            <input
              id="name"
              name="name"
              type="search"
              value={filters.name}
              list="repNameOptions"
              placeholder="Start typing a legislator"
              autocomplete="off"
              data-fuzzy-search
            />
            <datalist id="repNameOptions">
              {nameOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label for="town">
            <span>Town</span>
            <input
              id="town"
              name="town"
              type="search"
              value={filters.town}
              list="repTownOptions"
              placeholder="Start typing a town"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="town"
            />
            <datalist id="repTownOptions">
              {townOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label for="county">
            <span>County</span>
            <input
              id="county"
              name="county"
              type="search"
              value={filters.county}
              list="repCountyOptions"
              placeholder="Start typing a county"
              autocomplete="off"
              data-fuzzy-filter-field
              data-fuzzy-field="county"
            />
            <datalist id="repCountyOptions">
              {countyOptions.map((option) => <option value={option} />)}
            </datalist>
          </label>
          <label for="sort">
            <span>Sort</span>
            <select id="sort" name="sort" data-fuzzy-sort>
              <option value="" selected={!sort}>Default</option>
              <option value="name:asc" selected={sort === "name:asc"}>Name A-Z</option>
              <option value="district:asc" selected={sort === "district:asc"}>District</option>
              <option value="grade:desc" selected={sort === "grade:desc"}>Testimony alignment high-low</option>
              <option value="grade:asc" selected={sort === "grade:asc"}>Testimony alignment low-high</option>
              <option value="updated:desc" selected={sort === "updated:desc"}>Recently updated</option>
              <option value="missing:desc" selected={sort === "missing:desc"}>Missing photo/email/website</option>
            </select>
          </label>
        </FilterBar>
        <div class="filter-chips" data-fuzzy-chips hidden></div>
      </PageHero>

      <section class="results-heading" id="rep-results">
        <div>
          <p class="eyebrow">Results</p>
          <h2><span data-fuzzy-count>{Math.min(representatives.length, 12)}</span> Representatives Shown</h2>
          <p class="result-note">
            <span data-fuzzy-matched-count>{representatives.length}</span> loaded matches
            {totalRepresentatives ? <span> from the current database batch</span> : null}
          </p>
        </div>
        <a class="secondary-link" href="/my-state-rep">Find my legislators</a>
      </section>

      {loadError ? (
        <p class="status-message">{loadError}</p>
      ) : representatives.length ? (
        <>
          <div class="rep-grid">
            {representatives.map((rep) => (
              <RepresentativeCard
                rep={rep}
                trackedBills={trackedBills}
                billSummaries={billSummaries}
              />
            ))}
          </div>
          <div class="status-message empty-state" data-fuzzy-empty hidden>
            <strong>No current legislators matched those filters.</strong>
            <ul>
              <li>Try searching by last name.</li>
              <li>Remove the county or town chip above.</li>
              <li>Clear the body filter to include both House and Senate.</li>
            </ul>
          </div>
        </>
      ) : (
        <p class="status-message">
          No representatives matched those filters. Try a broader town, county,
          or name search.
        </p>
      )}
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  a {
    color: #1f2933;
    font-weight: 850;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.2rem, 5.5vw, 4.25rem);
    line-height: 0.95;
    margin: 0;
    max-width: 980px;
  }

  h2 {
    font-size: clamp(1.7rem, 4vw, 2.65rem);
    line-height: 1;
    margin: 0;
  }

  .lede {
    color: #4b5563;
    font-size: clamp(1.12rem, 2.2vw, 1.35rem);
    font-weight: 750;
    line-height: 1.5;
    margin: 22px 0 0;
    max-width: 780px;
  }

  .secondary-link {
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    font: inherit;
    font-weight: 900;
    padding: 12px 16px;
    text-decoration: none;
  }

  .secondary-link {
    background: white;
    color: #1f2933;
  }

  .results-heading {
    align-items: end;
    display: flex;
    gap: 18px;
    justify-content: space-between;
    margin: 34px 0 18px;
  }

  .rep-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .filter-chips button {
    align-items: center;
    background: #eef6ff;
    border: 1px solid #93c5fd;
    border-radius: 999px;
    color: #1f2933;
    cursor: pointer;
    display: inline-flex;
    gap: 8px;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 900;
    padding: 7px 10px;
  }

  .filter-chips b {
    color: #b91c1c;
    font-size: 1rem;
    line-height: 1;
  }

  .result-note {
    color: #6b7280;
    font-size: 0.95rem;
    font-weight: 800;
    margin: 8px 0 0;
  }

  .status-message {
    color: #4b5563;
    font-size: 1.08rem;
    font-weight: 850;
  }

  .empty-state strong {
    color: #1f2933;
    display: block;
    margin-bottom: 8px;
  }

  .empty-state ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 20px;
  }

  .see-more-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 22px;
  }

  .see-more-row button,
  .see-more-button {
    background: #1f2933;
    border: 1px solid #1f2933;
    border-radius: 999px;
    color: white;
    cursor: pointer;
    font: inherit;
    font-weight: 900;
    padding: 12px 18px;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .rep-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .results-heading {
      grid-template-columns: 1fr;
    }

    .results-heading {
      align-items: start;
      display: grid;
    }
  }
</style>
