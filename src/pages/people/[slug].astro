---
export const prerender = false;

import ArticleList from "../../components/ArticleList.astro";
import BillPositionSummary from "../../components/BillPositionSummary.astro";
import CommunityUpdates from "../../components/CommunityUpdates.astro";
import FilterBar from "../../components/FilterBar.astro";
import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import profileIcon from "../../assets/profile icon.png";
import {
  ExternalLink,
  Globe,
  Mail,
  Phone,
  UserRoundCheck,
} from "@lucide/astro";
import { getArticles } from "../../lib/articlesApi";
import { currentAdminSession } from "../../lib/adminAuth";
import { billDetailPath, getBillDetail, getBillSummaries } from "../../lib/billsApi";
import { candidateFilerForRepresentative } from "../../lib/candidateLegislatorLinks";
import { candidateProfileForLegislator } from "../../lib/candidateLegislators";
import {
  candidateName,
  candidateSlug,
  formatCandidateParty,
  getCandidate,
  getCandidates,
  isLegislativeCandidate,
} from "../../lib/candidatesApi";
import { isFreeStater, isTpActionAligned } from "../../lib/civicTags";
import { profilePhotoUrl } from "../../lib/photos";
import {
  endorsementsForCandidate,
  getOrganizations,
  organizationPath,
} from "../../lib/organizationsApi";
import { getRepresentative } from "../../lib/repsApi";
import {
  getTrackedBills,
  isVotingAction,
  normalizeBillCode,
  representativeGradeFor,
  representativeVoteAttendance,
  representativeVoteImpact,
  representativeVoteStance,
  trackedBillForVote,
} from "../../lib/trackedBills";

const { slug } = Astro.params;

let apiData = null;
let candidateOptions = [];
let linkedCandidateFilerEntityNumber = "";
const adminSession = await currentAdminSession(Astro.request);
const message = Astro.url.searchParams.get("message") || "";
const error = Astro.url.searchParams.get("error") || "";

try {
  apiData = await getRepresentative(slug);
} catch (error) {
  console.error(error?.message || "Unable to load representative profile.");
}

const representative = apiData?.representative || null;
let candidateFallback = null;

if (!representative) {
  try {
    const candidateData = await getCandidate(slug);
    candidateFallback = candidateData?.candidate || candidateData;
  } catch (error) {
    console.error(error?.message || "Unable to load candidate profile fallback.");
  }
}

if (!representative && (!candidateFallback?.filerEntityNumber && !candidateFallback?.name)) {
  return Astro.redirect("/404");
}

const hasLegislatorProfile = Boolean(representative);
const profileCandidate = candidateFallback || null;
const person = {
  id: representative?.personid || representative?.id || profileCandidate?.personId || profileCandidate?.filerEntityNumber || slug,
  full_name: representative?.name || candidateName(profileCandidate) || "Civic Profile",
  slug,
  bio: representative?.notes || profileCandidate?.notes || "",
  photo_url: representative?.photo || profileCandidate?.photoUrl || profileCandidate?.legislatorPhotoUrl || "",
  party: representative?.party || profileCandidate?.politicalParty || profileCandidate?.party || "",
  email: representative?.email || profileCandidate?.candidateEmail || "",
  phone: representative?.phone || "",
  website_url: representative?.sourceUrls?.generalCourt || profileCandidate?.candidateWebsite || "",
};
const representativeEntityKey = representative?.personid || representative?.id || slug;
const trackedVotesHref = `/people/${slug}/votes`;

const apiTerm = representative
  ? representativeToTerm(representative)
  : candidateToTerm(profileCandidate);
const officeTerms = [{ ...apiTerm, status: "current" }];
const currentOfficeTerms = officeTerms;
const candidacies = {
  results: uniqueCandidateRoles(profileCandidate?.candidateRoles?.length ? profileCandidate.candidateRoles : profileCandidate ? [profileCandidate] : []),
};

let trackedBills = new Map();
let billSummaries = new Map();

try {
  [trackedBills, billSummaries] = await Promise.all([
    getTrackedBills(),
    getBillSummaries(),
  ]);
} catch (error) {
  console.error(error?.message || "Unable to load tracked bill data.");
}

const voteHistory = representative ? apiData?.voteHistory || [] : [];
const voteAttendance = representativeVoteAttendance(voteHistory);
let trackedVotes = voteHistory
  .map((vote) => normalizeVote(vote, trackedBills, billSummaries))
  .filter((vote) => vote.trackedBill && isVotingAction(vote));
const voteGrade = representativeGradeFor(
  { ...representative, voteHistory },
  trackedBills,
  billSummaries,
);

trackedVotes = await Promise.all(
  trackedVotes.map(async (vote) => {
    if (vote.billSummary) return vote;

    try {
      const detail = await getBillDetail(vote.trackedBill.code, {
        year: vote.sessionyear,
      });
      return { ...vote, billSummary: detail.bill };
    } catch (error) {
      console.error(error?.message || "Unable to load bill summary.");
      return vote;
    }
  }),
);

const officeLabel = apiTerm.title || "Civic profile";
const bodyLabel = apiTerm.body || "New Hampshire";
const districtLabel = formatDistrictLabel(apiTerm);
const townServiceAreas = [];
if (representative?.towns_represented || representative?.location_text) {
  townServiceAreas.push({
    district: formatDistrictLabel(apiTerm),
    towns:
      parseTownsServed(representative.towns_represented).length > 0
        ? parseTownsServed(representative.towns_represented)
        : parseLocationText(representative.location_text),
  });
} else if (profileCandidate) {
  const candidateTowns = candidateTownsRepresented(profileCandidate);
  if (candidateTowns) {
    townServiceAreas.push({
      district: candidateOfficeLine(profileCandidate),
      towns: candidateTowns.split(/,\s*/).filter(Boolean),
    });
  }
}
const sourceLinks = sourceUrlsToLinks(representative?.sourceUrls);
const portraitUrl = profilePhotoUrl(person.photo_url);
const currentCandidateProfile = representative
  ? await candidateProfileForLegislator(representative)
  : profileCandidate
    ? {
        candidate: profileCandidate,
        href: `/people/${slug}`,
        label: "Candidate Profile",
      }
    : null;
const linkedCandidateForEndorsements = currentCandidateProfile?.candidate || null;
const linkedCandidateOfficeLine = candidateOfficeLine(linkedCandidateForEndorsements);
const linkedCandidateTowns = candidateTownsRepresented(linkedCandidateForEndorsements, representative);
const recentlyViewedProfile = {
  kind: hasLegislatorProfile ? "legislator" : "candidate",
  name: person.full_name,
  href: `/people/${slug}`,
  photoUrl: portraitUrl || "",
  party: hasLegislatorProfile ? formatParty(person.party) : formatCandidateParty(person.party),
  officeLine: [officeLabel, districtLabel].filter(Boolean).join(", "),
  towns: townServiceAreas.flatMap((area) => area.towns).join(", "),
  grade: voteGrade?.letter || "",
  tags: [
    isFreeStater(representative) ? "Free State Aligned" : "",
    isTpActionAligned(representative) ? "TPAction Aligned" : "",
  ].filter(Boolean),
};
let organizations = [];
let endorsements = [];
if (adminSession && hasLegislatorProfile) {
  try {
    const [candidateData, explicitCandidateId] = await Promise.all([
      getCandidates({ electionYear: 2026, limit: 700 }),
      candidateFilerForRepresentative(representative.personid || representative.id),
    ]);
    candidateOptions = (candidateData.candidates || []).filter(isLegislativeCandidate);
    linkedCandidateFilerEntityNumber =
      explicitCandidateId ||
      currentCandidateProfile?.candidate?.filerEntityNumber ||
      "";
  } catch (error) {
    console.error(error?.message || "Unable to load candidate link options.");
  }
}

if (linkedCandidateForEndorsements) {
  try {
    organizations = await getOrganizations();
    endorsements = endorsementsForCandidate(
      organizations,
      linkedCandidateForEndorsements,
      candidateSlug(linkedCandidateForEndorsements),
    );
  } catch (error) {
    console.error(error?.message || "Unable to load organization endorsements.");
  }
}

let relatedArticles =
  apiData?.relatedArticles ||
  representative?.relatedArticles ||
  [];

if (!relatedArticles.length && person.id) {
  try {
    if (hasLegislatorProfile) {
      const articleData = await getArticles({
        personid: person.id,
        include: "relations",
        limit: 6,
      });
      relatedArticles = articleData.articles || [];
    } else if (profileCandidate) {
      const articleData = await getArticles({
        candidate: profileCandidate.filerEntityNumber || profileCandidate.filer_entity_number || person.full_name,
        include: "relations",
        limit: 6,
      });
      relatedArticles = articleData.articles || [];
    }
  } catch (error) {
    console.error(error?.message || "Unable to load representative articles.");
  }
}
function formatParty(party) {
  if (!party) return "Party not listed";
  if (party === "R") return "Republican";
  if (party === "D") return "Democrat";
  if (party === "I") return "Independent";
  return party;
}

function partyClass(party) {
  const normalized = String(party || "").toLowerCase();
  if (party === "R" || normalized.includes("republican")) return "party-republican";
  if (party === "D" || normalized.includes("democrat")) return "party-democrat";
  if (party === "I" || normalized.includes("independent")) return "party-independent";
  return "party-unknown";
}

function candidateToTerm(candidate = {}) {
  return {
    title: candidate?.office || "Candidate Profile",
    body: candidate?.officeType || "Candidate",
    district: candidate?.district || "",
    division_name: candidateOfficeLine(candidate),
  };
}

function formatDistrictLabel(term = {}) {
  const divisionName = term?.division_name || "";
  const rawDistrict = term?.district || "";
  const district = formatDistrictNumber(rawDistrict);

  if (divisionName.startsWith("NH House District")) {
    return `NH House District ${formatDistrictNumber(
      divisionName.replace("NH House District", "").trim(),
    )}`;
  }

  if (divisionName.startsWith("NH Senate District")) {
    return `NH Senate District ${formatDistrictNumber(
      divisionName.replace("NH Senate District", "").trim(),
    )}`;
  }

  if (term?.body?.includes("House") && district) {
    return `NH House District ${district}`;
  }

  if (term?.body?.includes("Senate") && district) {
    return `NH Senate District ${district}`;
  }

  return divisionName || rawDistrict || "District not listed";
}

function formatDistrictNumber(value = "") {
  const district = String(value).trim();
  if (!district) return "";
  if (/^\d+$/.test(district)) return String(Number(district));
  return district;
}

function parseTownsServed(value = "") {
  if (Array.isArray(value)) {
    return value.map((town) => String(town).trim()).filter(Boolean);
  }

  return String(value)
    .split(/;|,/)
    .map((town) => town.trim())
    .filter(Boolean);
}

function parseLocationText(value = "") {
  const location = String(value).trim();
  if (!location) return [];
  if (/ward/i.test(location)) return [location];

  return location
    .split(/\s+and\s+|;/i)
    .map((town) => town.trim())
    .filter(Boolean);
}

function representativeToTerm(rep = {}) {
  if (!rep) return {};

  return {
    title:
      rep.chamber === "House"
        ? "State Representative"
        : rep.chamber === "Senate"
          ? "State Senator"
          : "State Legislator",
    body:
      rep.chamber === "House"
        ? "New Hampshire House of Representatives"
        : rep.chamber === "Senate"
          ? "New Hampshire Senate"
          : "New Hampshire General Court",
    district: rep.raw_district || rep.district || "",
    division_name: "",
  };
}

function normalizeVote(vote = {}, bills = new Map(), summaries = new Map()) {
  const billNumber = vote.condensedbillno || vote.bill_number || "";
  const trackedBill = trackedBillForVote(bills, vote);
  const billSummary = summaries.get(normalizeBillCode(billNumber));

  return {
    ...vote,
    bill_number: billNumber,
    title: vote.title || vote.action_text || vote.question_motion || vote.description || "",
    vote_date: vote.vote_date || vote.statusdate || "",
    motion: vote.motion || vote.action_text || vote.question_motion || vote.description || "",
    vote_label: vote.vote_label || vote.vote || "Not listed",
    general_court_url: vote.general_court_url || "",
    legiscan_url: vote.legiscan_url || "",
    billSummary,
    trackedBill,
  };
}

function sourceUrlsToLinks(sourceUrls = {}) {
  const links = [];

  if (sourceUrls.generalCourt) {
    links.push({
      title: "General Court Profile",
      link_type: "general_court",
      url: sourceUrls.generalCourt,
      publisher: "New Hampshire General Court",
    });
  }

  if (sourceUrls.photo) {
    links.push({
      title: "Photo Source",
      link_type: "photo",
      url: sourceUrls.photo,
      publisher: "NH Deserves Better",
    });
  }

  return links;
}

function externalProfileUrl(entity = {}, names = []) {
  return names
    .map((name) => entity[name])
    .find((value) => typeof value === "string" && value.trim());
}

function ballotpediaUrlForName(value = "") {
  const slug = String(value)
    .trim()
    .replace(/\s+/g, "_")
    .replace(/[^A-Za-z0-9_().-]/g, "");
  return slug ? `https://ballotpedia.org/${slug}` : "";
}

const profileLinkEntity = representative || profileCandidate || {};
const ballotpediaProfileUrl =
  externalProfileUrl(profileLinkEntity, ["ballotpediaUrl", "ballotpedia_url"]) ||
  ballotpediaUrlForName(person.full_name);
const citizensCountProfileUrl = externalProfileUrl(profileLinkEntity, [
  "citizensCountUrl",
  "citizens_count_url",
  "citizenscount_url",
]);
const profileResourceLinks = [
  person.email && {
    href: contactHref("email", person.email),
    label: "Email",
    icon: Mail,
  },
  person.phone && {
    href: contactHref("phone", person.phone),
    label: "Call",
    icon: Phone,
  },
  person.website_url && {
    href: contactHref("web", person.website_url),
    label: "Website",
    icon: Globe,
  },
  linkedCandidateForEndorsements?.candidateWebsite && {
    href: linkedCandidateForEndorsements.candidateWebsite,
    label: "Campaign Website",
    icon: Globe,
  },
  linkedCandidateForEndorsements?.candidateEmail && {
    href: `mailto:${linkedCandidateForEndorsements.candidateEmail}`,
    label: "Campaign Email",
    icon: Mail,
  },
  linkedCandidateForEndorsements && {
    href: "https://cfs.sos.nh.gov/public/cf/reports",
    label: "Search candidate finance filings",
    icon: ExternalLink,
  },
  ballotpediaProfileUrl && {
    href: ballotpediaProfileUrl,
    label: "Ballotpedia",
    icon: ExternalLink,
  },
  citizensCountProfileUrl && {
    href: citizensCountProfileUrl,
    label: "Citizens Count",
    icon: ExternalLink,
  },
].filter(Boolean);

function formatDate(value) {
  if (!value) return "";

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
}

function endorsementMediaUrl(endorsement = {}) {
  return endorsement.photoUrl || endorsement.organization?.logoUrl || "";
}

function endorsementPillClass(endorsement = {}) {
  const text = [
    endorsement.position,
    endorsement.organization?.name,
    endorsement.organization,
    endorsement.statement,
  ].filter(Boolean).join(" ").toLowerCase();

  if (
    text.includes("tpaction") ||
    text.includes("tp action") ||
    text.includes("turning point action") ||
    text.includes("free state")
  ) {
    return "warning";
  }

  return "endorse";
}

function contactHref(type, value) {
  if (!value) return "";
  if (type === "email") return `mailto:${value}`;
  if (type === "phone") return `tel:${value}`;
  return value;
}

function candidateOptionLabel(candidate = {}) {
  return [
    candidateName(candidate),
    candidate.office,
    candidate.county,
    candidate.district ? `District ${candidate.district}` : "",
    candidate.politicalParty,
  ].filter(Boolean).join(" - ");
}

function uniqueCandidateRoles(roles = []) {
  const seen = new Set();

  return roles.filter((role) => {
    const key = [
      role.filerEntityNumber,
      role.office,
      role.county,
      role.district,
      role.electionYear,
    ]
      .filter(Boolean)
      .join("|");
    if (!key || seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

function candidateOfficeLine(candidate = {}) {
  if (!candidate) return "";

  return [
    candidate.office,
    candidate.county,
    candidate.district ? `District ${candidate.district}` : "",
  ].filter(Boolean).join(", ");
}

function candidateTownsRepresented(candidate = {}, legislator = {}) {
  const towns = [
    candidate?.townsRepresented,
    candidate?.towns_represented,
    candidate?.communitiesRepresented,
    candidate?.communities_represented,
    candidate?.towns,
    candidate?.locationText,
    candidate?.location_text,
    candidate?.legislatorTownsRepresented,
    candidate?.legislatorLocationText,
    legislator?.towns_represented,
    legislator?.townsRepresented,
    legislator?.location_text,
    legislator?.locationText,
  ].flatMap(townsFromValue);

  return uniqueTowns(towns).join(", ");
}

function townsFromValue(value = "") {
  if (Array.isArray(value)) {
    return value.flatMap((item) => {
      if (typeof item === "object" && item !== null) {
        return item.town || item.name || item.label || "";
      }
      return item;
    }).flatMap(townsFromValue);
  }

  if (typeof value === "object" && value !== null) {
    return townsFromValue(value.town || value.name || value.label || "");
  }

  const text = String(value || "").trim();
  const delimiter = /ward/i.test(text) ? /;|\||\s+and\s+/i : /[,;|]|\s+and\s+/i;

  return text
    .split(delimiter)
    .map((town) => town.trim())
    .filter(Boolean);
}

function uniqueTowns(towns = []) {
  const seen = new Set();
  const unique = [];

  for (const town of towns) {
    const label = String(town || "").trim();
    const key = label.toLowerCase();
    if (!label || seen.has(key)) continue;
    seen.add(key);
    unique.push(label);
  }

  return unique;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/NH%20DB%20Logo.svg" />
    <link rel="apple-touch-icon" href="/NH%20DB%20Logo.svg" />
    <title>{person.full_name} | NH Deserves Better</title>
    <meta
      name="description"
      content={`Profile, offices, links, and tracked votes for ${person.full_name}.`}
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <a class="back" href="/">Back home</a>

      {error && <p class="status-message error">{error}</p>}
      {message && <p class="status-message success">{message}</p>}

      <section class="profile-hero">
        <div class="portrait-card">
          {portraitUrl ? (
            <img src={portraitUrl} alt={person.full_name} />
          ) : (
            <img class="portrait-fallback" src={profileIcon.src} alt="" />
          )}
        </div>

        <div class="hero-copy">
          <p class="eyebrow">{hasLegislatorProfile ? officeLabel : "Candidate Profile"}</p>
          <h1>{person.full_name}</h1>

          {hasLegislatorProfile && (
          <div class="profile-grade-row">
            <a
              class:list={["profile-grade", voteGrade.className]}
              href="/vote-grades"
              title="How do we determine this?"
              aria-label={`How do we determine this? ${voteGrade.label}`}
            >
              <span>{voteGrade.letter}</span>
              <small>Vote Grade</small>
            </a>
            <p>{voteGrade.label}</p>
          </div>
          )}

          <div class="hero-meta">
            <span class:list={["meta-pill", "party-pill", partyClass(person.party)]}>
              {hasLegislatorProfile ? formatParty(person.party) : formatCandidateParty(person.party)}
            </span>
            {(isFreeStater(representative) || isFreeStater(profileCandidate)) && (
              <a
                class="meta-pill free-stater-pill"
                href="/free-staters"
                title="What is a Free Stater?"
                aria-label="What is a Free Stater?"
              >
                Free State Aligned
              </a>
            )}
            {(isTpActionAligned(representative) || isTpActionAligned(profileCandidate)) && (
              <span class="meta-pill tpaction-pill">TPAction Aligned</span>
            )}
          </div>

          {person.bio ? (
            <p class="bio">{person.bio}</p>
          ) : (
            <p class="bio">
              Profile details are being assembled from public civic records.
            </p>
          )}

          {hasLegislatorProfile && currentCandidateProfile && (
            <a class="linked-profile-action" href="#candidate-role">
              <span class="link-icon" aria-hidden="true">
                <UserRoundCheck size={19} stroke-width={2.4} />
              </span>
              <span>2026 Candidate Role</span>
            </a>
          )}

          <aside class="hero-details" aria-label="Profile details">
            <div class="hero-details-heading">
              <p class="eyebrow">Details</p>
              <h2>{hasLegislatorProfile ? "Official Role" : "Candidate Details"}</h2>
            </div>

            <dl class="detail-list profile-detail-list">
              <div>
                <dt>Office</dt>
                <dd>{officeLabel || "Not listed"}</dd>
              </div>
              <div>
                <dt>{hasLegislatorProfile ? "Legislative Body" : "Role Type"}</dt>
                <dd>{bodyLabel || "Not listed"}</dd>
              </div>
              <div>
                <dt>District</dt>
                <dd>{districtLabel || "Not listed"}</dd>
              </div>
              <div>
                <dt>Party</dt>
                <dd>{hasLegislatorProfile ? formatParty(person.party) : formatCandidateParty(person.party)}</dd>
              </div>
              {townServiceAreas.length ? (
                <div class="profile-detail-wide">
                  <dt>Towns served</dt>
                  <dd>
                    {townServiceAreas.map((area) => (
                      <span>
                        <strong>{area.district}</strong>: {area.towns.join(", ")}
                      </span>
                    ))}
                  </dd>
                </div>
              ) : null}
            </dl>

            {hasLegislatorProfile && (
              <div class="attendance-card" aria-label={voteAttendance.label}>
                <div>
                  <span>Vote Attendance</span>
                  <strong>
                    {voteAttendance.percent === null
                      ? "No data"
                      : `${Math.round(voteAttendance.percent * 100)}%`}
                  </strong>
                </div>
                <p>
                  {voteAttendance.recorded} recorded of {voteAttendance.accountableTotal} documented voting actions.
                  {voteAttendance.notVoting > 0 && ` ${voteAttendance.notVoting} absent, excused, or not voting.`}
                </p>
              </div>
            )}

          </aside>
        </div>
      </section>

      {profileResourceLinks.length > 0 && (
        <nav class="resource-link-bar" aria-label="Profile links">
          {profileResourceLinks.map((link) => {
            const Icon = link.icon;

            return (
              <a href={link.href}>
                <span class="link-icon" aria-hidden="true">
                  <Icon size={17} stroke-width={2.3} />
                </span>
                <span>{link.label}</span>
              </a>
            );
          })}
        </nav>
      )}

      {linkedCandidateForEndorsements && (
        <section class="panel candidate-role-panel" id="candidate-role">
          <div class="section-heading split-heading">
            <div>
              <p class="eyebrow">2026 Candidate Role</p>
              <h2>Candidate information for this person</h2>
            </div>
            {adminSession && currentCandidateProfile && (
              <a
                class="section-action"
                href={hasLegislatorProfile ? currentCandidateProfile.href : `/candidates/${candidateSlug(linkedCandidateForEndorsements)}`}
              >
                Edit candidate fields
              </a>
            )}
          </div>

          <div class="candidate-role-grid">
            <article>
              <span>Office sought</span>
              <strong>{linkedCandidateOfficeLine || "Office not listed"}</strong>
            </article>
            <article>
              <span>Party</span>
              <strong>{formatCandidateParty(linkedCandidateForEndorsements.politicalParty)}</strong>
            </article>
            <article>
              <span>Election year</span>
              <strong>{linkedCandidateForEndorsements.electionYear || "2026"}</strong>
            </article>
            {linkedCandidateTowns && (
              <article class="candidate-role-wide">
                <span>Towns represented</span>
                <strong>{linkedCandidateTowns}</strong>
              </article>
            )}
          </div>
        </section>
      )}

      {adminSession && hasLegislatorProfile && (
        <section class="panel admin-edit-panel">
          <div class="section-heading">
            <p class="eyebrow">Admin</p>
            <h2>Edit Legislator Profile</h2>
            <p>
              These edits update the source legislator rows in D1. Refresh after
              saving to see the API-backed profile data.
            </p>
          </div>

          <form
            class="admin-edit-form"
            action="/api/admin/profile"
            method="post"
            hx-post="/api/admin/profile"
            hx-target="find .admin-inline-status"
            hx-swap="innerHTML"
          >
            <input type="hidden" name="entityType" value="representative" />
            <input
              type="hidden"
              name="entityKey"
              value={representative.personid || representative.id || slug}
            />
            <input type="hidden" name="redirectTo" value={Astro.url.pathname} />
            <input type="hidden" name="clearFields" value="linkedCandidateFilerEntityNumber" />

            <label>
              Name
              <input name="name" value={representative.name || person.full_name} />
            </label>

            <label>
              Name Aliases
              <textarea name="nameAliases" rows="3" placeholder="Sly, Sly Karasinski">{representative.nameAliases || representative.name_aliases || ""}</textarea>
              <small class="field-help">
                Add alternate names separated by commas or new lines. These are
                used for search, tagging, and mention matching.
              </small>
            </label>

            <div class="form-grid">
              <label>
                First Name
                <input name="firstname" value={representative.firstname || ""} />
              </label>
              <label>
                Last Name
                <input name="lastname" value={representative.lastname || ""} />
              </label>
            </div>

            <div class="form-grid">
              <label>
                Middle Name
                <input name="middlename" value={representative.middlename || ""} />
              </label>
              <label>
                Party
                <input name="party" value={representative.party || ""} />
              </label>
            </div>

            <div class="form-grid">
              <label>
                Chamber
                <select name="chamber">
                  <option value="">No override</option>
                  <option value="House" selected={representative.chamber === "House"}>House</option>
                  <option value="Senate" selected={representative.chamber === "Senate"}>Senate</option>
                </select>
              </label>
              <label>
                Free State Aligned
                <select name="is_free_stater">
                  <option value="">No override</option>
                  <option value="true" selected={representative.is_free_stater === true}>Yes</option>
                  <option value="false" selected={representative.is_free_stater === false}>No</option>
                </select>
              </label>
            </div>

            <label>
              Linked Candidate
              <input
                name="linkedCandidateFilerEntityNumber"
                list="candidate-link-options"
                value={linkedCandidateFilerEntityNumber}
                placeholder="Start typing a candidate name, then select their filer number"
              />
              <small class="field-help">
                Saves an explicit legislator-to-candidate link. Use the filer
                entity number shown by the autocomplete option.
              </small>
            </label>
            <datalist id="candidate-link-options">
              {candidateOptions.map((candidate) => (
                <option
                  value={candidate.filerEntityNumber}
                  label={candidateOptionLabel(candidate)}
                />
              ))}
            </datalist>

            <div class="form-grid">
              <label>
                District Label
                <input name="district" value={representative.district || ""} />
              </label>
              <label>
                Raw District
                <input name="raw_district" value={representative.raw_district || ""} />
              </label>
            </div>

            <label>
              Location Text
              <input name="location_text" value={representative.location_text || ""} />
            </label>

            <label>
              Towns Represented
              <textarea name="towns_represented" rows="3">{parseTownsServed(representative.towns_represented).join(", ")}</textarea>
            </label>

            <div class="form-grid">
              <label>
                Email
                <input name="email" type="email" value={representative.email || ""} />
              </label>
              <label>
                Phone
                <input name="phone" value={representative.phone || ""} />
              </label>
            </div>

            <label>
              Photo URL
              <input name="photo" type="url" value={representative.photo || ""} />
            </label>
            <input
              type="hidden"
              name="reviewNote"
              value="Reviewed legislator profile for missing photo, website, or email; no update found."
            />

            <label>
              Notes / Bio
              <textarea name="notes" rows="5">{representative.notes || ""}</textarea>
            </label>

            <div class="admin-form-actions">
              <button type="submit">Save Legislator Edits</button>
              <button
                class="secondary-button"
                type="submit"
                name="profileAction"
                value="confirm-reviewed"
              >
                Confirm reviewed, no update found
              </button>
              <span class="admin-inline-status" aria-live="polite"></span>
            </div>
          </form>

          <form
            class="admin-edit-form admin-upload-form"
            action="/api/admin/upload"
            method="post"
            enctype="multipart/form-data"
          >
            <input type="hidden" name="entityType" value="representative" />
            <input
              type="hidden"
              name="entityKey"
              value={representative.personid || representative.id || slug}
            />
            <input type="hidden" name="redirectTo" value={Astro.url.pathname} />

            <div class="section-heading compact-heading">
              <p class="eyebrow">Photo Upload</p>
              <h2>Upload and update legislator photo</h2>
            </div>

            <label>
              R2 key
              <input
                name="key"
                value={`legislators/${representative.employeeno || representative.personid || slug}-${slug}.jpg`}
              />
            </label>

            <label>
              Image file
              <input name="file" type="file" accept="image/*" required />
            </label>

            <button type="submit">Upload Legislator Photo</button>
          </form>

          <form class="admin-edit-form admin-remove-form" action="/api/admin/remove" method="post">
            <input type="hidden" name="entityType" value="representative" />
            <input
              type="hidden"
              name="entityKey"
              value={representative.personid || representative.id || slug}
            />
            <input type="hidden" name="redirectTo" value={Astro.url.pathname} />

            <div class="section-heading compact-heading">
              <p class="eyebrow">Remove</p>
              <h2>Remove legislator from public results</h2>
              <p>This sets the source legislator row to inactive while preserving historical vote records.</p>
            </div>

            <label class="confirm-remove">
              <input name="confirmRemove" type="checkbox" value="yes" required />
              I understand this will remove this legislator from the site.
            </label>

            <button class="danger-button" type="submit">Remove Legislator</button>
          </form>
        </section>
      )}

      <section class="content-grid">
        <div class="stack">
          {hasLegislatorProfile && (
          <section class="panel">
            <div class="section-heading">
              <p class="eyebrow">Service</p>
              <h2>Current and Past Offices</h2>
            </div>

            {officeTerms.length ? (
              <div class="timeline-list">
                {officeTerms.map((term) => (
                  <article class="timeline-item">
                    <div>
                      <h3>{term.title}</h3>
                      <p>
                        {formatDistrictLabel(term)}
                      </p>
                    </div>
                    <span class:list={["status-pill", term.status]}>
                      {term.status}
                    </span>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty">No office history is listed yet.</p>
            )}
          </section>
          )}

          {hasLegislatorProfile && (
          <section class="panel">
            <div class="section-heading split-heading">
              <div>
                <p class="eyebrow">Vote History</p>
                <h2>Tracked Bill Votes</h2>
              </div>
              {trackedVotes.length > 0 && (
                <a class="section-action" href={trackedVotesHref}>
                  See all votes
                </a>
              )}
            </div>

            {trackedVotes.length ? (
              <div class="vote-list">
                {trackedVotes.map((vote) => {
                  const stance = representativeVoteStance(vote, vote.trackedBill);
                  const voteImpact = representativeVoteImpact(vote, vote.trackedBill);
                  const summary =
                    vote.billSummary?.summary ||
                    vote.trackedBill.summary ||
                    "";
                  const billTitle =
                    vote.billSummary?.name ||
                    vote.billSummary?.title ||
                    vote.trackedBill.name ||
                    vote.title;

                  return (
                    <article class="vote-card">
                      <div class="vote-card-main">
                        <div class="vote-heading">
                          <div class="vote-topline">
                            <strong>
                              <a
                                href={billDetailPath(
                                  vote.trackedBill.code,
                                  vote.billSummary?.sessionyear || vote.sessionyear,
                                )}
                              >
                                {vote.trackedBill.code}
                              </a>
                            </strong>
                          </div>
                          <h3>
                            <a
                              href={billDetailPath(
                                vote.trackedBill.code,
                                vote.billSummary?.sessionyear || vote.sessionyear,
                              )}
                            >
                              {billTitle}
                            </a>
                        </h3>
                          {summary && (
                            <div class="tracker-summary">
                              <span>Bill Tracker Summary</span>
                              <p>{summary}</p>
                            </div>
                          )}
                        </div>
                        <div class="vote-copy">
                          <div class:list={["vote-interpretation", stance.className]}>
                            <strong>Representative Vote</strong>
                            <a
                              class:list={["legislator-vote-pill", stance.className]}
                              href="/vote-interpretations"
                              title="How do we determine this?"
                              aria-label={`How do we determine this? ${stance.label}`}
                            >
                              {stance.label}
                            </a>
                            {voteImpact && (
                              <p class="vote-impact">{voteImpact}</p>
                            )}
                          </div>
                          <div class="vote-meta">
                            {vote.vote_date && <span>{formatDate(vote.vote_date)}</span>}
                            {vote.motion && <span>{vote.motion}</span>}
                            {vote.trackedBill.issueArea && (
                              <span>{vote.trackedBill.issueArea}</span>
                            )}
                          </div>
                          {(vote.trackedBill.moreInfoUrl ||
                            vote.legiscan_url ||
                            vote.general_court_url) && (
                            <a
                              class="text-link"
                              href={
                                vote.trackedBill.moreInfoUrl ||
                                vote.legiscan_url ||
                                vote.general_court_url
                              }
                            >
                              Bill details
                            </a>
                          )}
                        </div>
                        <div class="vote-pill-stack">
                          {vote.billSummary && (
                            <BillPositionSummary bill={vote.billSummary} />
                          )}
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="empty">
                No recorded votes currently match the bill tracker.
              </p>
            )}
          </section>
          )}

          <CommunityUpdates
            entityType={hasLegislatorProfile ? "representative" : "candidate"}
            entityKey={hasLegislatorProfile ? representativeEntityKey : profileCandidate?.filerEntityNumber || slug}
            entityName={person.full_name}
            pageUrl={Astro.url.pathname}
          />
        </div>

        <aside class="stack">
          <section class="panel compact-panel">
            <div class="section-heading">
              <p class="eyebrow">Contact</p>
              <h2>Public Details</h2>
            </div>

            <dl class="detail-list">
              <div>
                <dt>Email</dt>
                <dd>
                  {person.email ? (
                    <a href={contactHref("email", person.email)}>{person.email}</a>
                  ) : (
                    "Not listed"
                  )}
                </dd>
              </div>

              <div>
                <dt>Phone</dt>
                <dd>
                  {person.phone ? (
                    <a href={contactHref("phone", person.phone)}>{person.phone}</a>
                  ) : (
                    "Not listed"
                  )}
                </dd>
              </div>

              <div>
                <dt>Website</dt>
                <dd>
                  {person.website_url ? (
                    <a href={person.website_url}>Open website</a>
                  ) : (
                    "Not listed"
                  )}
                </dd>
              </div>
            </dl>
          </section>

          <section class="panel compact-panel">
            <div class="section-heading">
              <p class="eyebrow">District</p>
              <h2>Towns Served</h2>
            </div>

            {townServiceAreas.length ? (
              <div class="towns-list">
                {townServiceAreas.map((area) => (
                  <article>
                    <h3>{area.district}</h3>
                    <div>
                      {area.towns.map((town) => (
                        <span>{town}</span>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty">No towns served are listed yet.</p>
            )}
          </section>

          <section
            class="panel compact-panel endorsements-panel"
            x-data="nhdbFuzzyFilter({ itemSelector: '.endorsement-card[data-fuzzy-item]', syncUrl: false })"
          >
            <div class="section-heading">
              <div>
                <p class="eyebrow">Endorsements</p>
                <h2>
                  Organizational Endorsements
                  {endorsements.length > 0 && (
                    <span class="inline-count">(<span data-fuzzy-count>{endorsements.length}</span>)</span>
                  )}
                </h2>
              </div>
              {linkedCandidateForEndorsements && (
                <a
                  class="section-action"
                  href={`/endorsements/submit?candidate=${encodeURIComponent(candidateSlug(linkedCandidateForEndorsements))}`}
                >
                  Submit
                </a>
              )}
            </div>

            {endorsements.length ? (
              <>
                <details class="endorsement-filter-disclosure">
                  <summary>
                    <span>Filter options</span>
                    <small>Search, position, and sort</small>
                  </summary>
                  <FilterBar submitLabel="Apply" columns="dense" live={true}>
                    <label>
                      Search
                      <input name="q" type="search" placeholder="Organization or note" data-fuzzy-search />
                    </label>
                    <label>
                      Position
                      <select name="position" data-fuzzy-filter-field data-fuzzy-field="position">
                        <option value="">All positions</option>
                        <option value="Endorsed">Endorsed</option>
                        <option value="Recommended">Recommended</option>
                        <option value="Supported">Supported</option>
                        <option value="Opposed">Opposed</option>
                      </select>
                    </label>
                    <label>
                      Sort
                      <select name="sort" data-fuzzy-sort>
                        <option value="name">Organization A-Z</option>
                        <option value="updated:desc">Newest first</option>
                        <option value="position">Position</option>
                      </select>
                    </label>
                  </FilterBar>
                </details>

                <div class="filter-chips" data-fuzzy-chips hidden></div>

                <div class="endorsement-list">
                {endorsements.map((endorsement) => (
                  <article
                    class="endorsement-card"
                    data-fuzzy-item
                    data-fuzzy-name={endorsement.organization.name}
                    data-fuzzy-position={endorsement.position || ""}
                    data-fuzzy-sort-name={endorsement.organization.name}
                    data-fuzzy-sort-position={endorsement.position || ""}
                    data-fuzzy-sort-updated={Date.parse(endorsement.date || endorsement.createdAt || "") || 0}
                    data-fuzzy-text={[
                      endorsement.organization.name,
                      endorsement.position,
                      endorsement.statement,
                      endorsement.office,
                      endorsement.district,
                      endorsement.electionYear,
                      endorsement.date,
                    ].filter(Boolean).join(" ")}
                  >
                    <div class="endorsement-card-main">
                      <a class="endorsement-media" href={organizationPath(endorsement.organization)}>
                        {endorsementMediaUrl(endorsement) ? (
                          <img src={endorsementMediaUrl(endorsement)} alt="" loading="lazy" />
                        ) : (
                          <span>{endorsement.organization.name.slice(0, 1)}</span>
                        )}
                      </a>
                      <div>
                        <div class="endorsement-topline">
                          <strong>
                            <a href={organizationPath(endorsement.organization)}>
                              {endorsement.organization.name}
                            </a>
                          </strong>
                          {endorsement.position && (
                            <span class:list={[endorsementPillClass(endorsement)]}>
                              {endorsement.position}
                            </span>
                          )}
                        </div>

                        {endorsement.statement && <p class="endorsement-preview">{endorsement.statement}</p>}

                        <div class="endorsement-meta">
                          {endorsement.office && <span>{endorsement.office}</span>}
                          {endorsement.district && <span>{endorsement.district}</span>}
                          {endorsement.electionYear && <span>{endorsement.electionYear}</span>}
                          {endorsement.date && <span>{formatDate(endorsement.date)}</span>}
                        </div>
                      </div>
                    </div>
                  </article>
                ))}
                </div>

                <div class="status-message empty-state" data-fuzzy-empty hidden>
                  <strong>No endorsements match those filters.</strong>
                  <span>Try searching by organization name, position, or note.</span>
                </div>
              </>
            ) : (
              <p class="empty">
                {linkedCandidateForEndorsements
                  ? "No organizational endorsements have been published yet."
                  : "No linked candidate profile for endorsements yet."}
              </p>
            )}
          </section>

          <section class="panel compact-panel">
            <div class="section-heading">
              <p class="eyebrow">Articles</p>
              <h2>Relevant Coverage</h2>
            </div>

            <ArticleList
              articles={relatedArticles}
              compact={true}
              emptyText="No related articles returned."
            />

            {person.id && (
              <a
                class="text-link"
                href={`/articles?personid=${person.id}&include=relations`}
              >
                Browse all articles
              </a>
            )}
          </section>

          <section class="panel compact-panel">
            <div class="section-heading">
              <p class="eyebrow">Elections</p>
              <h2>Candidacies</h2>
            </div>

            {candidacies.results.length ? (
              <div class="side-list">
                {candidacies.results.map((race) => (
                  <article>
                    <h3>{race.position_title}</h3>
                    <p>{race.election_name}</p>
                    <span>
                      {race.election_date && `${formatDate(race.election_date)} - `}
                      {race.status}
                    </span>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty">No candidacy records are listed yet.</p>
            )}
          </section>

          <section class="panel compact-panel">
            <div class="section-heading">
              <p class="eyebrow">Sources</p>
              <h2>Links</h2>
            </div>

            {sourceLinks.length ? (
              <div class="side-list">
                {sourceLinks.map((link) => (
                  <article>
                    <h3>
                      <a href={link.url}>{link.title || link.link_type}</a>
                    </h3>
                    {link.publisher && <p>{link.publisher}</p>}
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty">No source links are listed yet.</p>
            )}
          </section>
        </aside>
      </section>
    </main>
    <script define:vars={{ recentlyViewedProfile }}>
      const storageKey = "nhdb:recently-viewed-profiles";
      const maxItems = 6;

      try {
        const existing = JSON.parse(localStorage.getItem(storageKey) || "[]");
        const nextProfile = {
          ...recentlyViewedProfile,
          viewedAt: new Date().toISOString(),
        };
        const profiles = [
          nextProfile,
          ...existing.filter((item) => item?.href !== nextProfile.href),
        ].slice(0, maxItems);
        localStorage.setItem(storageKey, JSON.stringify(profiles));
      } catch {
        // Recently viewed profiles are a convenience; ignore storage failures.
      }
    </script>
    <SiteFooter />
  </body>
</html>

