            </label>

            <button class="danger-button" type="submit">Remove Legislator</button>
          </form>
          )}
        </section>
      )}

      {adminSession && linkedCandidateForEndorsements && (
        <section class="panel admin-edit-panel" data-admin-edit-panel hidden={!adminEditInitiallyOpen}>
          <div class="section-heading">
            <p class="eyebrow">Admin</p>
            <h2>Edit Candidate Role</h2>
            <p>
              These edits update the candidate role details in the source D1
              candidate row. Identity, contact, photo, and social fields are
              edited in the people profile form above.
            </p>
          </div>

          <form
            class="admin-edit-form"
            action="/api/admin/profile"
            method="post"
            hx-post="/api/admin/profile"
            hx-target="find .admin-inline-status"
            hx-swap="innerHTML"
          >
            <input type="hidden" name="entityType" value="candidate" />
            <input
              type="hidden"
              name="entityKey"
              value={linkedCandidateForEndorsements.filerEntityNumber || candidateSlug(linkedCandidateForEndorsements)}
            />
            <input type="hidden" name="redirectTo" value={Astro.url.pathname} />
            <input type="hidden" name="clearFields" value="linkedRepresentativePersonId" />

            <label>
              Linked Legislator
              <input
                name="linkedRepresentativePersonId"
                list="people-legislator-link-options"
                value={linkedRepresentativePersonId}
                placeholder="Start typing a legislator name, then select their personid"
              />
              <small class="field-help">
                Saves an explicit candidate-to-legislator link. Use the numeric
                personid shown by the autocomplete option.
