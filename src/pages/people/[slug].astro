    font-size: clamp(2.05rem, 5vw, 3.8rem);
    letter-spacing: 0;
    line-height: 0.96;
    margin-bottom: 14px;
  }

  .hero-meta,
  .contact-actions,
  .vote-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .meta-pill,
  .contact-actions a,
  .status-pill,
  .vote-topline span,
  .vote-meta span {
    border: 1px solid #d1d5db;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 900;
    padding: 7px 10px;
  }

  .meta-pill,
  .vote-meta span {
    background: #f8fafc;
  }

  .linked-profile-action {
    align-items: center;
    background: #1f2933;
    border: 1px solid #111827;
    border-radius: 999px;
    color: #fffaf0;
