            </label>
            <datalist id="people-legislator-link-options">
              {legislatorOptions.map((rep) => (
                <option
                  value={rep.personid || rep.id}
                  label={legislatorOptionLabel(rep)}
                />
              ))}
            </datalist>

            <div class="form-grid">
              <label>
                Office Type
                <input name="officeType" value={linkedCandidateForEndorsements.officeType || ""} />
              </label>
              <label>
                Office
                <input name="office" value={linkedCandidateForEndorsements.office || ""} />
              </label>
            </div>

            <div class="form-grid">
              <label>
                County
                <input name="county" value={linkedCandidateForEndorsements.county || ""} />
              </label>
              <label>
                District
                <input name="district" value={linkedCandidateForEndorsements.district || ""} />
              </label>
            </div>

            <input
              type="hidden"
              name="reviewNote"
              value="Reviewed candidate role details; no update found."
            />

            <div class="form-grid">
              <label>
                Election Year
                <input name="electionYear" inputmode="numeric" value={linkedCandidateForEndorsements.electionYear || ""} />
              </label>
              <label>
                Election Cycle
                <input name="electionCycle" value={linkedCandidateForEndorsements.electionCycle || ""} />
              </label>
            </div>

            <div class="form-grid">
              <label>
                Total Raised
                <input name="totalRaised" inputmode="decimal" value={linkedCandidateForEndorsements.totalRaised ?? ""} />
              </label>
              <label>
                Total Spent
                <input name="totalSpent" inputmode="decimal" value={linkedCandidateForEndorsements.totalSpent ?? ""} />
              </label>
            </div>

            <div class="admin-form-actions">
              <button type="submit">Save Candidate Role</button>
              <button
                class="secondary-button"
                type="submit"
                name="profileAction"
                value="confirm-reviewed"
              >
                Confirm reviewed, no update found
              </button>
              <span class="admin-inline-status" aria-live="polite"></span>
            </div>
          </form>

          <form class="admin-edit-form admin-remove-form" action="/api/admin/remove" method="post">
            <input type="hidden" name="entityType" value="candidate" />
            <input
              type="hidden"
              name="entityKey"
              value={linkedCandidateForEndorsements.filerEntityNumber || candidateSlug(linkedCandidateForEndorsements)}
            />
            <input type="hidden" name="redirectTo" value={Astro.url.pathname} />

            <div class="section-heading compact-heading">
              <p class="eyebrow">Remove</p>
              <h2>Remove candidate from public results</h2>
              <p>This deletes the candidate row from the source D1 table.</p>
            </div>

            <label class="confirm-remove">
              <input name="confirmRemove" type="checkbox" value="yes" required />
