            <label>
              Name Aliases
              <textarea name="nameAliases" rows="3" placeholder="Sly, Sly Karasinski">{representative?.nameAliases || representative?.name_aliases || linkedCandidateForEndorsements?.nameAliases || linkedCandidateForEndorsements?.name_aliases || ""}</textarea>
