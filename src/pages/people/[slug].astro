---
export const prerender = false;

import ArticleList from "../../components/ArticleList.astro";
import BillPositionSummary from "../../components/BillPositionSummary.astro";
import CommunityUpdates from "../../components/CommunityUpdates.astro";
import ProfileViewTracker from "../../components/ProfileViewTracker.astro";
import SocialGraphicGenerator from "../../components/SocialGraphicGenerator.astro";
import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import profileIcon from "../../assets/profile icon.png";
import {
  Camera,
  ExternalLink,
  Globe,
  Landmark,
  Mail,
  MessageCircle,
  Newspaper,
  Phone,
  Music2,
} from "@lucide/astro";
import { getArticles } from "../../lib/articlesApi";
import { currentAdminSession } from "../../lib/adminAuth";
import {
  candidateGraphicFormValues,
  legislatorGraphicFormValues,
} from "../../lib/contentGenerator";
import {
  FREE_STATE_ALIGNED_TOOLTIP,
  TPACTION_ALIGNED_TOOLTIP,
} from "../../lib/alignmentTags";
import { billDetailPath, getBillDetail, getBillSummaries } from "../../lib/billsApi";
import { getCandidateCampaignFinance } from "../../lib/campaignFinance";
import { representativePersonIdForCandidate } from "../../lib/candidateLegislatorLinks";
import { candidateProfileForLegislator } from "../../lib/candidateLegislators";
import {
  candidateName,
  candidateSlug,
  formatCandidateParty,
  getCandidate,
  getCandidates,
} from "../../lib/candidatesApi";
import { isFreeStater, isTpActionAligned } from "../../lib/civicTags";
import { profilePhotoUrl } from "../../lib/photos";
import { cleanText } from "../../lib/text";
import { endorsementPillClass } from "../../lib/endorsementPresentation";
import {
  endorsementsForCandidate,
  getOrganizations,
  organizationPath,
} from "../../lib/organizationsApi";
import { getRepresentative, getRepresentatives, repName } from "../../lib/repsApi";
import {
  getTrackedBills,
  isVotingAction,
  normalizeBillCode,
  representativeGradeFor,
  representativeOnlineTestimonyVoteStance,
  representativeVoteAttendance,
  representativeVoteImpact,
  representativeVoteStance,
  testimonyAlignmentPercentForGrade,
  trackedBillForVote,
} from "../../lib/trackedBills";

const { slug } = Astro.params;

let apiData = null;
let legislatorOptions = [];
let linkedRepresentativePersonId = "";
const adminSession = await currentAdminSession(Astro.request);
const message = Astro.url.searchParams.get("message") || "";
const error = Astro.url.searchParams.get("error") || "";
const adminEditInitiallyOpen = adminSession && Astro.url.searchParams.get("edit") === "1";

try {
  apiData = await getRepresentative(slug);
} catch (error) {
  console.error(error?.message || "Unable to load representative profile.");
}

const representative = apiData?.representative || null;
let candidateFallback = null;

if (!representative) {
  try {
    const candidateData = await getCandidate(slug);
    candidateFallback = candidateData?.candidate || candidateData;
  } catch (error) {
    console.error(error?.message || "Unable to load candidate profile fallback.");
  }
}

if (!representative && (!candidateFallback?.filerEntityNumber && !candidateFallback?.name)) {
  return Astro.redirect("/404");
}

const hasLegislatorProfile = Boolean(representative);
const profileCandidate = candidateFallback || null;
const person = {
  id: representative?.personid || representative?.id || profileCandidate?.personId || profileCandidate?.filerEntityNumber || slug,
  full_name: representative?.name || candidateName(profileCandidate) || "Civic Profile",
  slug,
  bio: representative?.notes || profileCandidate?.notes || "",
  photo_url: representative?.photo || profileCandidate?.photoUrl || profileCandidate?.legislatorPhotoUrl || "",
  party: representative?.party || profileCandidate?.politicalParty || profileCandidate?.party || "",
  email: representative?.email || profileCandidate?.candidateEmail || "",
  phone: representative?.phone || "",
  website_url: representative?.websiteUrl || representative?.website_url || representative?.sourceUrls?.generalCourt || profileCandidate?.candidateWebsite || "",
  ballotpedia_url: representative?.ballotpediaUrl || representative?.ballotpedia_url || profileCandidate?.ballotpediaUrl || profileCandidate?.ballotpedia_url || "",
  citizens_count_url: representative?.citizensCountUrl || representative?.citizens_count_url || profileCandidate?.citizensCountUrl || profileCandidate?.citizens_count_url || "",
  state_house_profile_url: representative?.stateHouseProfileUrl || representative?.state_house_profile_url || profileCandidate?.stateHouseProfileUrl || profileCandidate?.state_house_profile_url || "",
  substack_url: socialField(representative, profileCandidate, "substack"),
  instagram_url: socialField(representative, profileCandidate, "instagram"),
  facebook_url: socialField(representative, profileCandidate, "facebook"),
  tiktok_url: socialField(representative, profileCandidate, "tiktok"),
  x_url: socialField(representative, profileCandidate, "x"),
  bluesky_url: socialField(representative, profileCandidate, "bluesky"),
};
const representativeEntityKey = representative?.personid || representative?.id || slug;
const trackedVotesHref = `/people/${slug}/votes`;

const apiTerm = representative
  ? representativeToTerm(representative)
  : candidateToTerm(profileCandidate);
const previousElectionResults = (apiData?.electionHistory || []).map(formatElectionResult);

let trackedBills = new Map();
let billSummaries = new Map();

try {
  [trackedBills, billSummaries] = await Promise.all([
    getTrackedBills(),
    getBillSummaries(),
  ]);
} catch (error) {
  console.error(error?.message || "Unable to load tracked bill data.");
}

const voteHistory = representative ? apiData?.voteHistory || [] : [];
const voteAttendance = representativeVoteAttendance(voteHistory);
const normalizedVoteHistory = voteHistory
  .map((vote) => normalizeVote(vote, trackedBills, billSummaries))
  .filter((vote) => isVotingAction(vote));
let trackedVotes = normalizedVoteHistory.filter((vote) => vote.trackedBill);
const voteGrade = representativeGradeFor(
  { ...representative, voteHistory },
  trackedBills,
  billSummaries,
);
const voteTestimonyAlignmentPercent = testimonyAlignmentPercentForGrade(voteGrade);

trackedVotes = await Promise.all(
  trackedVotes.map(async (vote) => {
    if (vote.billSummary) return vote;

    try {
      const detail = await getBillDetail(vote.trackedBill.code, {
        year: vote.sessionyear,
      });
      return { ...vote, billSummary: detail.bill };
    } catch (error) {
      console.error(error?.message || "Unable to load bill summary.");
      return vote;
    }
  }),
);
const trackedVotePreviews = votePreviewSelection(trackedVotes, normalizedVoteHistory, {
  limit: 5,
});

const officeLabel = apiTerm.title || "Civic profile";
const bodyLabel = apiTerm.body || "New Hampshire";
const districtLabel = formatDistrictLabel(apiTerm);
const countiesRepresented = listText(
  representative?.countiesRepresented || representative?.counties_represented
);
const townServiceAreas = [];
if (representative?.towns_represented || representative?.location_text) {
  townServiceAreas.push({
    district: formatDistrictLabel(apiTerm),
    towns:
      parseTownsServed(representative.towns_represented).length > 0
        ? parseTownsServed(representative.towns_represented)
        : parseLocationText(representative.location_text),
  });
} else if (profileCandidate) {
  const candidateTowns = candidateTownsRepresented(profileCandidate);
  if (candidateTowns) {
    townServiceAreas.push({
      district: candidateOfficeLine(profileCandidate),
      towns: candidateTowns.split(/,\s*/).filter(Boolean),
    });
  }
}
const portraitUrl = profilePhotoUrl(person.photo_url);
const currentCandidateProfile = representative
  ? await candidateProfileForLegislator(representative)
  : profileCandidate
    ? {
        candidate: profileCandidate,
        href: `/people/${slug}`,
        label: "Candidate Profile",
      }
    : null;
const linkedCandidateForEndorsements = currentCandidateProfile?.candidate || null;
const linkedCandidateOfficeLine = candidateOfficeLine(linkedCandidateForEndorsements);
const linkedCandidateOfficeContext = await candidateOfficeContext(linkedCandidateForEndorsements);
const linkedCandidateTowns = candidateTownsRepresented(linkedCandidateForEndorsements, representative);
const graphicCommunity = townServiceAreas
  .flatMap((area) => area.towns)
  .filter(Boolean)
  .join(", ");
const socialGraphicProfileType = hasLegislatorProfile ? "legislator" : "candidate";
const socialGraphicProfileId = hasLegislatorProfile
  ? representativeEntityKey
  : profileCandidate?.filerEntityNumber || profileCandidate?.filer_entity_number || slug;
const socialGraphicValues = hasLegislatorProfile
  ? legislatorGraphicFormValues({
      name: person.full_name,
      office: officeLabel,
      districtLine: [districtLabel, graphicCommunity].filter(Boolean).join(" · "),
      image: portraitUrl,
    })
  : candidateGraphicFormValues({
      name: person.full_name,
      officeLine: candidateOfficeLine(profileCandidate),
      community: graphicCommunity
        ? `${graphicCommunity}, New Hampshire`
        : profileCandidate?.county
          ? `${profileCandidate.county} County, New Hampshire`
          : "New Hampshire",
      image: portraitUrl,
    });
const showCandidateRoleInHero = hasLegislatorProfile && Boolean(linkedCandidateForEndorsements);
const heroEyebrow = showCandidateRoleInHero
  ? "2026 Candidate Role"
  : hasLegislatorProfile
    ? officeLabel
    : "Candidate Profile";
const heroDetailsTitle = showCandidateRoleInHero
  ? "Candidate Details"
  : hasLegislatorProfile
    ? "Official Role"
    : "Candidate Details";
const heroPartyLabel = showCandidateRoleInHero
  ? formatCandidateParty(linkedCandidateForEndorsements?.politicalParty || linkedCandidateForEndorsements?.party)
  : hasLegislatorProfile
    ? formatParty(person.party)
    : formatCandidateParty(person.party);
const heroPartyValue = showCandidateRoleInHero
  ? linkedCandidateForEndorsements?.politicalParty || linkedCandidateForEndorsements?.party || person.party
  : person.party;
const recentlyViewedProfile = {
  kind: hasLegislatorProfile ? "legislator" : "candidate",
  name: person.full_name,
  href: `/people/${slug}`,
  photoUrl: portraitUrl || "",
  party: hasLegislatorProfile ? formatParty(person.party) : formatCandidateParty(person.party),
  officeLine: [officeLabel, districtLabel].filter(Boolean).join(", "),
  towns: townServiceAreas.flatMap((area) => area.towns).join(", "),
  testimonyAlignmentPercent: voteTestimonyAlignmentPercent,
  tags: [
    isFreeStater(representative) ? "Free State Aligned" : "",
    isTpActionAligned(representative) ? "TPAction Aligned" : "",
  ].filter(Boolean),
};
let organizations = [];
let endorsements = [];
if (adminSession && linkedCandidateForEndorsements) {
  try {
    const [repData, explicitPersonId] = await Promise.all([
      getRepresentatives({ limit: 700 }),
      representativePersonIdForCandidate(linkedCandidateForEndorsements.filerEntityNumber || ""),
    ]);
    legislatorOptions = repData.representatives || [];
    linkedRepresentativePersonId =
      explicitPersonId ||
      linkedCandidateForEndorsements.legislatorPersonId ||
      representative?.personid ||
      representative?.id ||
      "";
  } catch (error) {
    console.error(error?.message || "Unable to load legislator link options.");
  }
}

try {
  const endorsementProfile = linkedCandidateForEndorsements || profileCandidate || {
    slug,
    name: person.full_name,
    filerEntityNumber:
      representative?.filerEntityNumber ||
      representative?.filer_entity_number ||
      "",
    personid: representative?.personid || representative?.id || "",
  };
  organizations = await getOrganizations();
  endorsements = endorsementsForCandidate(organizations, endorsementProfile, slug);
} catch (error) {
  console.error(error?.message || "Unable to load organization endorsements.");
}

let campaignFinance = {
  contributors: [],
  itemizedTotal: 0,
  totalRaised: 0,
  hasData: false,
};

if (linkedCandidateForEndorsements) {
  const reportedTotalRaised = Number(linkedCandidateForEndorsements.totalRaised) || 0;
  try {
    const itemizedFinance = await getCandidateCampaignFinance({
      filerEntityNumber: linkedCandidateForEndorsements.filerEntityNumber,
      electionYear: linkedCandidateForEndorsements.electionYear || 2026,
    });
    const totalRaised = reportedTotalRaised > 0
      ? reportedTotalRaised
      : itemizedFinance.itemizedTotal;
    campaignFinance = {
      ...itemizedFinance,
      totalRaised,
      hasData: totalRaised > 0 || itemizedFinance.contributors.length > 0,
    };
  } catch (error) {
    console.error(error?.message || "Unable to load campaign finance details.");
    campaignFinance = {
      ...campaignFinance,
      totalRaised: reportedTotalRaised,
      hasData: reportedTotalRaised > 0,
    };
  }
}

const topCampaignContributors = campaignFinance.contributors.slice(0, 5);

let relatedArticles =
  apiData?.relatedArticles ||
  representative?.relatedArticles ||
  [];

if (!relatedArticles.length && person.id) {
  try {
    if (hasLegislatorProfile) {
      const articleData = await getArticles({
        personid: person.id,
        include: "relations",
        limit: 6,
      });
      relatedArticles = articleData.articles || [];
    } else if (profileCandidate) {
      const articleData = await getArticles({
        candidate: profileCandidate.filerEntityNumber || profileCandidate.filer_entity_number || person.full_name,
        include: "relations",
        limit: 6,
      });
      relatedArticles = articleData.articles || [];
    }
  } catch (error) {
    console.error(error?.message || "Unable to load representative articles.");
  }
}
function formatParty(party) {
  if (!party) return "Party not listed";
  if (party === "R") return "Republican";
  if (party === "D") return "Democratic";
  if (party === "I") return "Independent";
  return party;
}

function formatElectionResult(result = {}) {
  const votesReceived = wholeNumber(result.votesReceived);
  const totalContestVotes = wholeNumber(result.totalContestVotes);
  const winningMarginVotes = wholeNumber(result.winningMarginVotes);
  const marginPercent = totalContestVotes > 0
    ? (winningMarginVotes / totalContestVotes) * 100
    : null;

  return {
    ...result,
    votesReceived,
    totalContestVotes,
    winningMarginVotes,
    marginPercent,
    officeLabel: [
      result.office || "Election",
      result.county && result.district
        ? `${result.county} District ${formatDistrictNumber(result.district)}`
        : result.district
          ? `District ${formatDistrictNumber(result.district)}`
          : result.county || "",
    ].filter(Boolean).join(" · "),
  };
}

function wholeNumber(value) {
  const number = Number(value);
  return Number.isFinite(number) ? Math.round(number) : 0;
}

function formatElectionNumber(value) {
  return new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(value || 0);
}

function formatCampaignCurrency(value) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(Number(value) || 0);
}

function formatElectionPercent(value) {
  if (!Number.isFinite(value)) return "Not available";
  return `${value.toFixed(1)}%`;
}

function partyClass(party) {
  const normalized = String(party || "").toLowerCase();
  if (party === "R" || normalized.includes("republican")) return "party-republican";
  if (party === "D" || normalized.includes("democrat")) return "party-democrat";
  if (party === "I" || normalized.includes("independent")) return "party-independent";
  return "party-unknown";
}

function candidateToTerm(candidate = {}) {
  return {
    title: candidate?.office || "Candidate Profile",
    body: candidate?.officeType || "Candidate",
    district: candidate?.district || "",
    division_name: candidateOfficeLine(candidate),
  };
}

function formatDistrictLabel(term = {}) {
  const divisionName = term?.division_name || "";
  const rawDistrict = term?.district || "";
  const district = formatDistrictNumber(rawDistrict);

  if (divisionName.startsWith("NH House District")) {
    return `NH House District ${formatDistrictNumber(
      divisionName.replace("NH House District", "").trim(),
    )}`;
  }

  if (divisionName.startsWith("NH Senate District")) {
    return `NH Senate District ${formatDistrictNumber(
      divisionName.replace("NH Senate District", "").trim(),
    )}`;
  }

  if (term?.body?.includes("House") && district) {
    return `NH House District ${district}`;
  }

  if (term?.body?.includes("Senate") && district) {
    return `NH Senate District ${district}`;
  }

  return divisionName || rawDistrict || "District not listed";
}

function formatDistrictNumber(value = "") {
  const district = String(value).trim();
  if (!district) return "";
  if (/^\d+$/.test(district)) return String(Number(district));
  return district;
}

function parseTownsServed(value = "") {
  if (Array.isArray(value)) {
    return value.map((town) => String(town).trim()).filter(Boolean);
  }

  return String(value)
    .split(/;|,/)
    .map((town) => town.trim())
    .filter(Boolean);
}

function parseLocationText(value = "") {
  const location = String(value).trim();
  if (!location) return [];
  if (/ward/i.test(location)) return [location];

  return location
    .split(/\s+and\s+|;/i)
    .map((town) => town.trim())
    .filter(Boolean);
}

function representativeToTerm(rep = {}) {
  if (!rep) return {};

  return {
    title:
      rep.chamber === "House"
        ? "State Representative"
        : rep.chamber === "Senate"
          ? "State Senator"
          : "State Legislator",
    body:
      rep.chamber === "House"
        ? "New Hampshire House of Representatives"
        : rep.chamber === "Senate"
          ? "New Hampshire Senate"
          : "New Hampshire General Court",
    district: rep.raw_district || rep.district || "",
    division_name: "",
  };
}

function normalizeVote(vote = {}, bills = new Map(), summaries = new Map()) {
  const billNumber = vote.condensedbillno || vote.bill_number || "";
  const trackedBill = trackedBillForVote(bills, vote);
  const billSummary = summaries.get(normalizeBillCode(billNumber));

  return {
    ...vote,
    bill_number: billNumber,
    title: vote.title || vote.action_text || vote.question_motion || vote.description || "",
    vote_date: vote.vote_date || vote.statusdate || "",
    motion: vote.motion || vote.action_text || vote.question_motion || vote.description || "",
    vote_label: vote.vote_label || vote.vote || "Not listed",
    general_court_url: vote.general_court_url || "",
    legiscan_url: vote.legiscan_url || "",
    billSummary,
    trackedBill,
  };
}

function formatVotePreviewHeading(code = "", title = "") {
  const billCode = cleanText(code);
  const billTitle = cleanText(title);

  if (!billCode) return billTitle || "Bill";
  if (!billTitle) return billCode;

  const duplicatePrefix = new RegExp(`^${billCode}\\s*:?\\s*`, "i");
  const cleanTitle = billTitle.replace(duplicatePrefix, "").trim();

  return cleanTitle ? `${billCode}: ${cleanTitle}` : billCode;
}

function votePreviewSelection(primaryVotes = [], allVotes = [], { limit = 5 } = {}) {
  const selected = [];
  const seen = new Set();

  for (const vote of primaryVotes) {
    if (selected.length >= limit) break;
    const key = votePreviewKey(vote);
    if (!key || seen.has(key)) continue;
    selected.push({ ...vote, previewSource: "tracked" });
    seen.add(key);
  }

  if (selected.length >= limit) return selected;

  const backfill = allVotes
    .filter((vote) => {
      const key = votePreviewKey(vote);
      return key && !seen.has(key) && vote.billSummary && testimonyTotal(vote.billSummary) > 0;
    })
    .sort((a, b) => {
      const testimonyDelta = testimonyTotal(b.billSummary) - testimonyTotal(a.billSummary);
      if (testimonyDelta) return testimonyDelta;
      return voteDateValue(b) - voteDateValue(a);
    });

  for (const vote of backfill) {
    if (selected.length >= limit) break;
    const key = votePreviewKey(vote);
    selected.push({ ...vote, previewSource: "high-testimony" });
    seen.add(key);
  }

  return selected;
}

function votePreviewKey(vote = {}) {
  return [
    normalizeBillCode(vote.bill_number || vote.condensedbillno || vote.billSummary?.condensedbillno || ""),
    vote.votesequencenumber || vote.vote_sequence || vote.sequence || vote.motion || "",
    vote.sessionyear || vote.billSummary?.sessionyear || "",
  ].join(":");
}

function testimonyTotal(bill = {}) {
  return (
    Number(bill.testimony_count || bill.testimonyCount || 0) ||
    Number(bill.support_count || bill.supportCount || bill.testimonySupport || bill.support || 0) +
      Number(bill.oppose_count || bill.opposeCount || bill.testimonyOppose || bill.oppose || bill.against || 0)
  );
}

function voteDateValue(vote = {}) {
  const date = new Date(vote.vote_date || vote.statusdate || vote.statusDate || "");
  return Number.isNaN(date.getTime()) ? 0 : date.getTime();
}

function externalProfileUrl(entity = {}, names = []) {
  return names
    .map((name) => entity[name])
    .find((value) => typeof value === "string" && value.trim());
}

function ballotpediaUrlForName(value = "") {
  const slug = String(value)
    .trim()
    .replace(/\s+/g, "_")
    .replace(/[^A-Za-z0-9_().-]/g, "");
  return slug ? `https://ballotpedia.org/${slug}` : "";
}

const profileLinkEntity = representative || profileCandidate || {};
const ballotpediaProfileUrl =
  externalProfileUrl(profileLinkEntity, ["ballotpediaUrl", "ballotpedia_url"]) ||
  ballotpediaUrlForName(person.full_name);
const citizensCountProfileUrl = externalProfileUrl(profileLinkEntity, [
  "citizensCountUrl",
  "citizens_count_url",
  "citizenscount_url",
]);
const stateHouseProfileUrl = externalProfileUrl(profileLinkEntity, [
  "stateHouseProfileUrl",
  "state_house_profile_url",
]);
const profileResourceLinks = [
  person.email && {
    href: contactHref("email", person.email),
    label: "Email",
    icon: Mail,
  },
  person.phone && {
    href: contactHref("phone", person.phone),
    label: "Call",
    icon: Phone,
  },
  person.website_url && {
    href: contactHref("web", person.website_url),
    label: officialProfileLabel(person.website_url) || "Website",
    icon: officialProfileLabel(person.website_url) ? Landmark : Globe,
  },
  linkedCandidateForEndorsements?.candidateWebsite && {
    href: linkedCandidateForEndorsements.candidateWebsite,
    label: "Campaign Website",
    icon: Globe,
  },
  linkedCandidateForEndorsements?.candidateEmail && {
    href: `mailto:${linkedCandidateForEndorsements.candidateEmail}`,
    label: "Campaign Email",
    icon: Mail,
  },
  linkedCandidateForEndorsements && {
    href: "https://cfs.sos.nh.gov/public/cf/reports",
    label: "Search candidate finance filings",
    icon: ExternalLink,
  },
  ballotpediaProfileUrl && {
    href: ballotpediaProfileUrl,
    label: "Ballotpedia",
    icon: ExternalLink,
  },
  citizensCountProfileUrl && {
    href: citizensCountProfileUrl,
    label: "Citizens Count",
    icon: ExternalLink,
  },
  stateHouseProfileUrl && stateHouseProfileUrl !== person.website_url && {
    href: stateHouseProfileUrl,
    label: "State House Profile",
    icon: Landmark,
  },
  person.substack_url && {
    href: socialProfileUrl(person.substack_url, "substack"),
    label: "Substack",
    icon: Newspaper,
    platform: "substack",
  },
  person.instagram_url && {
    href: socialProfileUrl(person.instagram_url, "instagram"),
    label: "Instagram",
    icon: Camera,
    platform: "instagram",
  },
  person.facebook_url && {
    href: socialProfileUrl(person.facebook_url, "facebook"),
    label: "Facebook",
    icon: MessageCircle,
    platform: "facebook",
  },
  person.tiktok_url && {
    href: socialProfileUrl(person.tiktok_url, "tiktok"),
    label: "TikTok",
    icon: Music2,
    platform: "tiktok",
  },
  person.x_url && {
    href: socialProfileUrl(person.x_url, "x"),
    label: "X",
    icon: ExternalLink,
    platform: "x",
  },
  person.bluesky_url && {
    href: socialProfileUrl(person.bluesky_url, "bluesky"),
    label: "Bluesky",
    icon: ExternalLink,
    platform: "bluesky",
  },
].filter(Boolean);

function formatDate(value) {
  if (!value) return "";

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
}

function endorsementMediaUrl(endorsement = {}) {
  return endorsement.photoUrl || endorsement.organization?.logoUrl || "";
}

function contactHref(type, value) {
  if (!value) return "";
  if (type === "email") return `mailto:${value}`;
  if (type === "phone") return `tel:${value}`;
  return value;
}

function officialProfileLabel(value = "") {
  const url = String(value || "").toLowerCase();
  if (!/gencourt\.state\.nh\.us|gc\.nh\.gov/.test(url)) return "";
  if (/\/house\/members\/member\.aspx/.test(url)) return "State House Profile";
  if (/\/senate\/members\//.test(url)) return "State Senate Profile";
  return "General Court Profile";
}

function socialField(primary = {}, fallback = {}, platform = "") {
  const camel = `${platform}Url`;
  const snake = `${platform}_url`;
  return primary?.[camel] || primary?.[snake] || fallback?.[camel] || fallback?.[snake] || "";
}

function socialProfileUrl(value = "", platform = "") {
  const cleaned = String(value || "").trim();
  if (!cleaned) return "";
  if (/^https?:\/\//i.test(cleaned)) return cleaned;

  const handle = cleaned.replace(/^@+/, "").replace(/^\/+/, "");
  if (platform === "substack") {
    if (handle.includes(".")) return `https://${handle}`;
    return `https://${handle}.substack.com`;
  }

  const bases = {
    instagram: "https://www.instagram.com/",
    facebook: "https://www.facebook.com/",
    tiktok: "https://www.tiktok.com/@",
    x: "https://x.com/",
    bluesky: "https://bsky.app/profile/",
  };
  return bases[platform] ? `${bases[platform]}${handle}` : cleaned;
}

function legislatorOptionLabel(rep = {}) {
  return [
    repName(rep),
    rep.chamber || rep.legislativebody,
    rep.district || rep.raw_district,
    rep.party,
  ].filter(Boolean).join(" - ");
}

function candidateOfficeLine(candidate = {}) {
  if (!candidate) return "";
  const office = cleanDisplay(candidate.office);
  const isSenateOffice = /state senate|state senator/i.test(office);

  return [
    office,
    isSenateOffice ? "" : candidate.county,
    candidate.district ? `District ${candidate.district}` : "",
  ].filter(Boolean).join(", ");
}

async function candidateOfficeContext(candidate = {}) {
  if (!candidate) return null;

  const label = candidateOfficeLine(candidate);
  const office = cleanDisplay(candidate.office);
  const district = cleanDisplay(candidate.district);
  const isSenateOffice = /state senate|state senator/i.test(office);
  const county = isSenateOffice ? "" : cleanDisplay(candidate.county);
  const electionYear = cleanDisplay(candidate.electionYear || "2026");
  const seats = candidateOfficeSeats(candidate);
  let candidateCount = 0;

  try {
    const data = await getCandidates({
      office,
      county,
      district,
      electionYear,
      limit: 100,
    });
    candidateCount = (data.candidates || []).length;
  } catch (error) {
    console.error(error?.message || "Unable to load candidate race count.");
  }

  const params = new URLSearchParams();
  if (office) params.set("office", office);
  if (county) params.set("county", county);
  if (district) params.set("district", district);
  if (electionYear) params.set("electionYear", electionYear);

  const metaParts = [
    seats ? `${seats} ${seats === 1 ? "seat" : "seats"}` : "",
    candidateCount ? `${candidateCount} ${candidateCount === 1 ? "candidate" : "candidates"} for this seat` : "",
  ].filter(Boolean);

  return {
    label,
    href: `/candidates${params.toString() ? `?${params.toString()}` : ""}#candidate-results`,
    metaLabel: metaParts.join(" · ") || "View matching candidates",
    seats,
    candidateCount,
  };
}

function candidateOfficeSeats(candidate = {}) {
  const office = String(candidate.office || "");
  if (/state senate|state senator/i.test(office)) return 1;
  const seats = Number(candidate.seats);
  return Number.isFinite(seats) && seats > 0 ? seats : 0;
}

function cleanDisplay(value = "") {
  return cleanText(value).trim();
}

function statementLinkSegments(value = "") {
  const text = String(value || "");
  const pattern = /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)|\b((?:https?:\/\/|www\.)[^\s<>()]+)/gi;
  const segments = [];
  let cursor = 0;

  for (const match of text.matchAll(pattern)) {
    const index = match.index ?? 0;
    if (index > cursor) segments.push({ text: text.slice(cursor, index), href: "" });

    if (match[1] && match[2]) {
      segments.push({ text: match[1], href: match[2] });
    } else {
      const rawUrl = match[3] || "";
      const url = rawUrl.replace(/[.,!?;:\]}]+$/, "");
      const trailing = rawUrl.slice(url.length);
      segments.push({ text: url, href: url.startsWith("www.") ? `https://${url}` : url });
      if (trailing) segments.push({ text: trailing, href: "" });
    }

    cursor = index + match[0].length;
  }

  if (cursor < text.length) segments.push({ text: text.slice(cursor), href: "" });
  return segments.length ? segments : [{ text, href: "" }];
}

function candidateTownsRepresented(candidate = {}, legislator = {}) {
  const towns = [
    candidate?.townsRepresented,
    candidate?.towns_represented,
    candidate?.communitiesRepresented,
    candidate?.communities_represented,
    candidate?.towns,
    candidate?.locationText,
    candidate?.location_text,
    candidate?.legislatorTownsRepresented,
    candidate?.legislatorLocationText,
    legislator?.towns_represented,
    legislator?.townsRepresented,
    legislator?.location_text,
    legislator?.locationText,
  ].flatMap(townsFromValue);

  return uniqueTowns(towns).join(", ");
}

function listText(value = "") {
  if (Array.isArray(value)) return value.map(listText).filter(Boolean).join(", ");
  if (typeof value === "object" && value !== null) {
    return listText(value.name || value.label || value.county || "");
  }
  return cleanDisplay(value);
}

function townsFromValue(value = "") {
  if (Array.isArray(value)) {
    return value.flatMap((item) => {
      if (typeof item === "object" && item !== null) {
        return item.town || item.name || item.label || "";
      }
      return item;
    }).flatMap(townsFromValue);
  }

  if (typeof value === "object" && value !== null) {
    return townsFromValue(value.town || value.name || value.label || "");
  }

  const text = String(value || "").trim();
  const delimiter = /ward/i.test(text) ? /;|\||\s+and\s+/i : /[,;|]|\s+and\s+/i;

  return text
    .split(delimiter)
    .map((town) => town.trim())
    .filter(Boolean);
}

function uniqueTowns(towns = []) {
  const seen = new Set();
  const unique = [];

  for (const town of towns) {
    const label = String(town || "").trim();
    const key = label.toLowerCase();
    if (!label || seen.has(key)) continue;
    seen.add(key);
    unique.push(label);
  }

  return unique;
}
