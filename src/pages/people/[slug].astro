                class="context-tab-panel context-tab-panel-updates"
                id="context-panel-submissions"
                role="tabpanel"
                aria-labelledby="context-tab-submissions-label"
              >
                <CommunityUpdates
                  entityType={hasLegislatorProfile ? "representative" : "candidate"}
                  entityKey={hasLegislatorProfile ? representativeEntityKey : profileCandidate?.filerEntityNumber || slug}
                  entityName={person.full_name}
                  pageUrl={Astro.url.pathname}
                  variant="narrow"
                  embedded={true}
                  showPeoplePreview={false}
                  fetchMissingPreviews={false}
                />
              </div>

              <div
                class="context-tab-panel context-tab-panel-articles"
                id="context-panel-articles"
                role="tabpanel"
                aria-labelledby="context-tab-articles-label"
              >
                <div class="context-feed-section-heading">
                  <p class="eyebrow">Related coverage</p>
                  <h3>Articles</h3>
                </div>
                <ArticleList
                  articles={relatedArticles}
                  compact={true}
                  emptyText="No related articles returned."
                />

                {person.id && (
                  <a
                    class="text-link"
                    href={`/articles?personid=${person.id}&include=relations`}
                  >
                    Browse all articles
                  </a>
                )}
              </div>
            </div>
          </section>
        </div>

      </section>
      </div>
    </main>
    <ProfileViewTracker slug={slug} />
    <script define:vars={{ recentlyViewedProfile }}>
      const storageKey = "nhdb:recently-viewed-profiles";
      const maxItems = 6;

      try {
        const existing = JSON.parse(localStorage.getItem(storageKey) || "[]");
        const nextProfile = {
          ...recentlyViewedProfile,
          viewedAt: new Date().toISOString(),
        };
        const profiles = [
          nextProfile,
          ...existing.filter((item) => item?.href !== nextProfile.href),
        ].slice(0, maxItems);
        localStorage.setItem(storageKey, JSON.stringify(profiles));
      } catch {
        // Recently viewed profiles are a convenience; ignore storage failures.
      }
    </script>
    <script>
      (() => {
        const statements = Array.from(document.querySelectorAll("[data-expandable-statement]"));

        statements.forEach((statement) => {
          const copy = statement.querySelector("[data-expandable-copy]");
          const toggle = statement.querySelector("[data-expand-statement]");
          if (!(copy instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;

          if (copy.scrollHeight <= copy.clientHeight + 1) return;
          toggle.hidden = false;

          toggle.addEventListener("click", () => {
            const expanded = statement.classList.toggle("is-expanded");
            toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
            toggle.textContent = expanded ? "Show less" : "Show more";
          });
        });
      })();
    </script>
    <script>
      (() => {
        const toggles = Array.from(document.querySelectorAll("[data-campaign-info-toggle]"));
        if (!toggles.length) return;

        toggles.forEach((toggle) => {
          const panelId = toggle.getAttribute("aria-controls");
          const panel = panelId ? document.getElementById(panelId) : null;
          if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

          toggle.addEventListener("click", () => {
            const isOpening = panel.hidden;
            panel.hidden = !isOpening;
            toggle.setAttribute("aria-expanded", isOpening ? "true" : "false");
            toggle.textContent = isOpening ? "Close Campaign Information" : "Submit Campaign Information";

            if (isOpening) {
              panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }
          });
        });
      })();
    </script>
    <script>
      (() => {
        const panels = Array.from(document.querySelectorAll("[data-admin-edit-panel]"));
        const toggles = Array.from(document.querySelectorAll("[data-admin-edit-toggle]"));
        if (!panels.length || !toggles.length) return;

        const storageKey = `nhdb:admin-edit-view:${window.location.pathname}`;
        const urlWantsEdit = new URLSearchParams(window.location.search).get("edit") === "1";
        let isOpen = urlWantsEdit;

        try {
          const stored = localStorage.getItem(storageKey);
          if (!urlWantsEdit && stored !== null) isOpen = stored === "1";
        } catch {
          // Edit view persistence is a convenience; ignore storage failures.
        }

        function render() {
          panels.forEach((panel) => {
            panel.hidden = !isOpen;
          });
          toggles.forEach((toggle) => {
            toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
            toggle.textContent = isOpen ? "Hide edit view" : "Show edit view";
          });
        }

        toggles.forEach((toggle) => {
          toggle.addEventListener("click", () => {
            isOpen = !isOpen;
            try {
              localStorage.setItem(storageKey, isOpen ? "1" : "0");
            } catch {
              // Ignore storage failures.
            }
            render();
            if (isOpen) {
              panels[0]?.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          });
        });

        render();
      })();
    </script>
    <SiteFooter />
  </body>
