---
export const prerender = false;

import BillPositionSummary from "../../../components/BillPositionSummary.astro";
import TopNav from "../../../components/TopNav.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import profileIcon from "../../../assets/profile icon.png";
import { billDetailPath, getBillDetail, getBillSummaries } from "../../../lib/billsApi";
import { profilePhotoUrl } from "../../../lib/photos";
import { getRepresentative, repName } from "../../../lib/repsApi";
import { cleanText } from "../../../lib/text";
import {
  gradeFromCachedOnlineTestimony,
  getTrackedBills,
  isKnownVote,
  isVotingAction,
  normalizeBillCode,
  representativeOnlineTestimonyAnalysis,
  representativeOnlineTestimonyGrade,
  representativeOnlineTestimonyVoteStance,
  representativeVoteImpact,
  representativeVoteStance,
  trackedBillForVote,
} from "../../../lib/trackedBills";

const { slug } = Astro.params;

let apiData = null;
let trackedBills = new Map();
let billSummaries = new Map();
let error = "";

try {
  apiData = await getRepresentative(slug, { voteLimit: 500 });
} catch (loadError) {
  error = loadError?.message || "Unable to load representative.";
}

try {
  [trackedBills, billSummaries] = await Promise.all([
    getTrackedBills(),
    getBillSummaries(),
  ]);
} catch (loadError) {
  console.error(loadError?.message || "Unable to load tracked bill data.");
}

const representative = apiData?.representative || null;

if (!error && !representative) {
  return Astro.redirect("/404");
}

const representativeName = repName(representative || {}) || "Representative";
const portraitUrl = profilePhotoUrl(representative?.photo || representative?.photo_url);
const partyLabel = formatParty(representative?.party);
const roleLabel = representativeRoleLabel(representative || {});
const districtLabel = representativeDistrictLabel(representative || {});
const townsRepresented = locationLabel(representative || {});
const countiesRepresented = listText(
  representative?.countiesRepresented || representative?.counties_represented
);
let votes = (apiData?.voteHistory || []).map((vote) =>
  normalizeVote(vote, trackedBills, billSummaries),
).filter((vote) => isVotingAction(vote) && isKnownVote(vote));
const trackedVoteCount = votes.filter((vote) => vote.trackedBill).length;

votes = await Promise.all(
  votes.map(async (vote) => {
    if (vote.billSummary) return vote;

    try {
      const detail = await getBillDetail(vote.bill_number, {
        year: vote.sessionyear,
      });
      return { ...vote, billSummary: detail.bill };
    } catch (detailError) {
      console.error(detailError?.message || "Unable to load bill summary.");
      return vote;
    }
  }),
);
const voteDataSummary = buildVoteDataSummary(votes, trackedVoteCount, representative);

function normalizeVote(vote = {}, bills = new Map(), summaries = new Map()) {
  const billNumber = vote.condensedbillno || vote.bill_number || "";
  const trackedBill = trackedBillForVote(bills, vote);
  const billSummary = summaries.get(normalizeBillCode(billNumber));

  return {
    ...vote,
    bill_number: billNumber,
    title: vote.title || vote.action_text || vote.question_motion || vote.description || "",
    vote_date: vote.vote_date || vote.statusdate || "",
    motion: vote.motion || vote.action_text || vote.question_motion || vote.description || "",
    bill_status: vote.bill_status || "",
    vote_label: displayVoteLabel(vote),
    billSummary,
    trackedBill,
  };
}

function displayVoteLabel(vote = {}) {
  const rawLabel = cleanText(vote.vote_label || "");
  if (rawLabel && !["N/A", "NA"].includes(rawLabel.toUpperCase())) return rawLabel;

  return displayRawVoteLabel(vote);
}

function displayRawVoteLabel(vote = {}) {
  const voteValue = String(vote.vote || vote.vote_code || "").trim().toLowerCase();
  const labels = {
    "1": "Yea",
    yea: "Yea",
    yes: "Yea",
    "2": "Nay",
    nay: "Nay",
    no: "Nay",
    "3": "Absent",
    absent: "Absent",
    "4": "Present",
    present: "Present",
    "5": "Not voting",
    other_not_voting: "Not voting",
    "6": "Present not voting",
    "7": "Present not voting",
    other_present_not_voting: "Present not voting",
    "0": "Not counted",
    other_not_counted: "Not counted",
  };

  return labels[voteValue] || cleanText(vote.vote || "Not listed");
}

function voteClass(vote = {}) {
  const label = String(vote.vote_label || vote.vote || "").toLowerCase();
  if (label.includes("support") || label === "yea" || label === "yes") return "legislator-support";
  if (label.includes("against") || label.includes("oppose") || label === "nay" || label === "no") {
    return "legislator-oppose";
  }
  return "legislator-neutral";
}

function billCodeFor(vote = {}) {
  return vote.trackedBill?.code || vote.bill_number || vote.condensedbillno || "Bill";
}

function billTitleFor(vote = {}) {
  return (
    vote.billSummary?.name ||
    vote.billSummary?.title ||
    vote.trackedBill?.name ||
    vote.trackedBill?.title ||
    billCodeFor(vote)
  );
}

function voteActionFor(vote = {}) {
  return cleanText(
    vote.action_text ||
      vote.question_motion ||
      vote.motion ||
      vote.title1 ||
      vote.title2 ||
      vote.description ||
      "",
  );
}

function testimonyPositionForBill(bill = {}) {
  const support = Number(bill?.support_count || bill?.supportCount || 0);
  const oppose = Number(bill?.oppose_count || bill?.opposeCount || 0);
  const total = support + oppose;

  if (!Number.isFinite(total) || total === 0 || support === oppose) {
    return "";
  }

  const margin = Math.abs(support - oppose) / total;
  if (total < 50 && margin <= 0.25) return "";
  if (margin <= 0.1) return "";

  return support > oppose ? "support" : "oppose";
}

function inferredBillPosition(vote = {}, motion = "") {
  const voteValue = String(vote.vote_code || vote.vote || vote.vote_label || "")
    .trim()
    .toLowerCase();
  const isYea = ["1", "yea", "yes", "y"].includes(voteValue);
  const isNay = ["2", "nay", "no", "n"].includes(voteValue);

  if (!isYea && !isNay) return "";

  const motionText = cleanText(motion).toLowerCase();
  const motionOpposesBill =
    /\bitl\b/.test(motionText) ||
    motionText.includes("inexpedient to legislate") ||
    /\btable\b/.test(motionText) ||
    motionText.includes("laid on the table") ||
    motionText.includes("lay on the table") ||
    motionText.includes("indefinitely postpone") ||
    motionText.includes("postpone indefinitely");

  if (motionOpposesBill) return isYea ? "oppose" : "support";
  return isYea ? "support" : "oppose";
}

function titleCase(value = "") {
  return String(value || "").replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function testimonyVoteStanceFor(vote = {}) {
  const bill = vote.billSummary || null;
  if (!bill) return null;

  const position = inferredBillPosition(vote, voteActionFor(vote));
  if (!position) return null;

  const testimony = testimonyPositionForBill(bill);
  const rawVote = displayRawVoteLabel(vote);
  if (!testimony) {
    return {
      label: `Voted: ${rawVote}: ${titleCase(position)} - no clear testimony position`,
      className: "legislator-neutral",
    };
  }

  const aligned = position === testimony;
  return {
    label: `Voted: ${rawVote}: ${titleCase(position)} - ${
      aligned ? "aligned with testimony position" : "not aligned with testimony position"
    }`,
    className: aligned ? "legislator-support" : "legislator-oppose",
  };
}

function voteStanceFor(vote = {}) {
  if (vote.billSummary) return representativeOnlineTestimonyVoteStance(vote, vote.billSummary);
  const testimonyStance = testimonyVoteStanceFor(vote);
  if (testimonyStance) return testimonyStance;
  if (vote.trackedBill) return representativeVoteStance(vote, vote.trackedBill);
  if (vote.billSummary) return representativeVoteStance(vote, vote.billSummary);
  return {
    label: `Voted: ${displayVoteLabel(vote)}`,
    className: voteClass(vote),
  };
}

function voteImpactFor(vote = {}) {
  if (!vote.trackedBill) return "";
  return representativeVoteImpact(vote, vote.trackedBill);
}

function voteGradeContributionFor(vote = {}) {
  const analysis = representativeOnlineTestimonyAnalysis(vote, vote.billSummary || {});
  const score = Number(analysis.score);

  if (!Number.isFinite(score)) {
    return {
      label: "Not included in grade",
      className: "grade-impact-neutral",
      tooltip:
        "This vote does not change the grade because the bill does not have a clear online testimony position or enough testimony data.",
    };
  }

  const formattedScore = formatSignedScore(score);
  const strength = analysis.testimonyStrength ? ` Online testimony was ${analysis.testimonyStrength.toLowerCase()}.` : "";
  const action =
    analysis.alignment === "aligned"
      ? "This vote increases the grade because it aligned with online testimony."
      : analysis.alignment === "partial"
        ? "This nonvote lowers the grade by a smaller accountability penalty."
        : "This vote lowers the grade because it did not align with online testimony.";

  return {
    label: `Grade impact: ${formattedScore}`,
    className:
      score > 0 ? "grade-impact-positive" : score < 0 ? "grade-impact-negative" : "grade-impact-neutral",
    tooltip: `${action}${strength}`,
  };
}

function buildVoteDataSummary(votes = [], trackedCount = 0, rep = {}) {
  const cachedGrade = gradeFromCachedOnlineTestimony(rep);
  const computedGrade = representativeOnlineTestimonyGrade(votes, {
    get: (code) => votes.find((vote) => normalizeBillCode(vote.bill_number) === code)?.billSummary || null,
  });
  const grade = cachedGrade || computedGrade;
  const summary = {
    total: votes.length,
    tracked: trackedCount,
    aligned: 0,
    misaligned: 0,
    neutral: 0,
    nonVotes: 0,
    scoredVotes: 0,
    scoreAligned: 0,
    scoreMisaligned: 0,
    scoreNonVotes: 0,
    totalTestimonyWeight: grade?.totalWeight || 0,
    weightedNetScore: grade?.netScore || 0,
    weightedAverageScore: grade?.percent ?? null,
    gradeLetter: grade?.letter || "N/A",
    withPublicTestimony: 0,
  };

  for (const vote of votes) {
    const stance = voteStanceFor(vote);
    const rawVote = String(vote.vote || vote.vote_code || vote.vote_label || "").trim().toLowerCase();
    const documentedNonVote = [
      "3",
      "4",
      "5",
      "6",
      "7",
      "absent",
      "present",
      "other_not_voting",
      "other_present_not_voting",
      "not voting",
      "present not voting",
      "not counted",
    ].includes(rawVote);

    if (documentedNonVote) summary.nonVotes += 1;
    if (testimonyPositionForBill(vote.billSummary || {})) summary.withPublicTestimony += 1;

    const analysis = representativeOnlineTestimonyAnalysis(vote, vote.billSummary || {});
    if (Number.isFinite(analysis.score)) {
      summary.scoredVotes += 1;
      if (analysis.alignment === "aligned") summary.scoreAligned += 1;
      if (analysis.alignment === "misaligned") summary.scoreMisaligned += 1;
      if (analysis.alignment === "partial") summary.scoreNonVotes += 1;
    }

    if (stance.className === "legislator-support") {
      summary.aligned += 1;
    } else if (stance.className === "legislator-oppose") {
      summary.misaligned += 1;
    } else {
      summary.neutral += 1;
    }
  }

  if (cachedGrade) {
    summary.scoredVotes = cachedGrade.total ?? summary.scoredVotes;
    summary.scoreAligned = cachedGrade.aligned ?? summary.scoreAligned;
    summary.scoreMisaligned = cachedGrade.misaligned ?? summary.scoreMisaligned;
    summary.scoreNonVotes = cachedGrade.partial ?? summary.scoreNonVotes;
  }

  summary.alignmentRate = summary.aligned + summary.misaligned
    ? Math.round((summary.aligned / (summary.aligned + summary.misaligned)) * 100)
    : null;
  summary.weightedScoreLabel = summary.weightedAverageScore === null
    ? "No vote grade yet"
    : `${summary.gradeLetter} vote grade`;

  return summary;
}

function formatScore(value) {
  const number = Number(value);
  if (!Number.isFinite(number)) return "N/A";
  return number.toFixed(3).replace(/0+$/, "").replace(/\.$/, "");
}

function formatSignedScore(value) {
  const score = formatScore(value);
  if (score === "N/A") return score;
  return Number(value) > 0 ? `+${score}` : score;
}

function formatDate(value) {
  if (!value) return "";

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
}

function previewText(value = "", length = 260) {
  const text = cleanText(value).trim();
  if (text.length <= length) return text;
  return `${text.slice(0, length).trim()}...`;
}

function formatParty(value = "") {
  const party = String(value || "").trim().toUpperCase();
  if (party === "D") return "Democratic";
  if (party === "R") return "Republican";
  if (party === "I") return "Independent";
  return cleanText(value || "Party not listed");
}

function legislativeBody(person = {}) {
  const value = String(person.chamber || person.legislativebody || person.body || "").toLowerCase();
  if (value === "h" || value === "house") return "House";
  if (value === "s" || value === "senate") return "Senate";
  return cleanText(person.chamber || "");
}

function representativeRoleLabel(person = {}) {
  const body = legislativeBody(person);
  if (body === "House") return "New Hampshire House of Representatives";
  if (body === "Senate") return "New Hampshire Senate";
  return cleanText(person.office || person.role || "Legislator");
}

function representativeDistrictLabel(person = {}) {
  const district = cleanText(person.district || person.raw_district || "");
  const body = legislativeBody(person);
  if (!district) return "";
  if (body === "House") return `NH House District ${district}`;
  if (body === "Senate") return `NH Senate District ${district}`;
  return `District ${district}`;
}

function locationLabel(person = {}) {
  const value =
    person.location_text ||
    person.locationText ||
    person.towns_represented ||
    person.townsRepresented ||
    "";
  if (Array.isArray(value)) return value.map(cleanText).filter(Boolean).join(", ");
  return cleanText(value);
}

function listText(value = "") {
  if (Array.isArray(value)) return value.map(listText).filter(Boolean).join(", ");
  if (typeof value === "object" && value !== null) {
    return listText(value.name || value.label || value.county || "");
  }
  return cleanText(value);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Votes for {representativeName} | NH Deserves Better</title>
    <meta
      name="description"
      content={`Vote history and bill summaries for ${representativeName}.`}
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <a class="back" href={`/people/${slug}`}>Back to profile</a>

      {error ? (
        <p class="status-message">{error}</p>
      ) : (
        <>
          <section class="hero">
            <a class="portrait-card" href={`/people/${slug}`}>
              {portraitUrl ? (
                <img src={portraitUrl} alt={`Photo of ${representativeName}`} />
              ) : (
                <img class="portrait-fallback" src={profileIcon.src} alt="" />
              )}
            </a>

            <div class="hero-copy">
              <p class="eyebrow">Vote History</p>
              <h1>{representativeName}</h1>

              <div class="hero-meta">
                {partyLabel && <span>{partyLabel}</span>}
                {roleLabel && <span>{roleLabel}</span>}
                {districtLabel && <span>{districtLabel}</span>}
                <span>{votes.length} votes</span>
                <span>{trackedVoteCount} tracked</span>
              </div>

              {townsRepresented && (
                <p class="towns-served">
                  <strong>Towns served</strong>
                  {townsRepresented}
                </p>
              )}
              {countiesRepresented && (
                <p class="towns-served">
                  <strong>Counties represented</strong>
                  {countiesRepresented}
                </p>
              )}

              <p>
                These are all votes currently returned for this legislator. Votes
                are limited to bill actions with a documented roll-call action.
                Votes connected to the bill tracker include tracker summaries,
                interpretations, and public testimony summary data where available.
              </p>
            </div>
          </section>

          <section class="vote-data-summary" aria-label="Vote data summary">
            <div class="summary-intro">
              <p class="eyebrow">Vote Data Summary</p>
              <h2>
                {voteDataSummary.weightedScoreLabel}
              </h2>
              <p>
                This grade compares voting records with online public testimony.
                Votes that match public testimony help the score, votes that do
                not match lower it, and nonvotes count as a smaller penalty.
              </p>
            </div>

            <div class="summary-stats">
              <span class:list={["summary-grade", `grade-${voteDataSummary.gradeLetter.toLowerCase()}`]}>
                <strong>{voteDataSummary.gradeLetter}</strong>
                Grade
              </span>
              <span
                title="Net score adds this legislator's scored votes after testimony strength is applied. Positive votes matched online testimony, negative votes did not, and nonvotes count as a smaller penalty."
              >
                <strong>{formatScore(voteDataSummary.weightedNetScore)}</strong>
                Net score
              </span>
              <span>
                <strong>{voteDataSummary.total}</strong>
                Votes shown
              </span>
              <span>
                <strong>{voteDataSummary.tracked}</strong>
                Tracked bills
              </span>
              <span class="summary-good">
                <strong>{voteDataSummary.scoreAligned}</strong>
                Scored aligned
              </span>
              <span class="summary-bad">
                <strong>{voteDataSummary.scoreMisaligned}</strong>
                Scored not aligned
              </span>
              <span class="summary-bad">
                <strong>{voteDataSummary.scoreNonVotes}</strong>
                Nonvote penalties
              </span>
              <span>
                <strong>{voteDataSummary.withPublicTestimony}</strong>
                With public testimony
              </span>
            </div>
          </section>

          {votes.length ? (
            <>
              <section class="vote-color-legend" aria-label="Representative vote color legend">
                <div>
                  <p class="eyebrow">Legend</p>
                  <h2>Representative vote colors</h2>
                </div>
                <div class="legend-items">
                  <span class="legend-item legislator-support">Aligned with testimony position</span>
                  <span class="legend-item legislator-oppose">Not aligned with testimony position</span>
                  <span class="legend-item legislator-neutral">Neutral or no clear testimony position</span>
                </div>
                <a href="/vote-interpretations">How vote labels work</a>
              </section>

              <section class="vote-filter-panel" aria-label="Filter and sort votes">
                <div class="vote-filter-heading">
                  <p class="eyebrow">Find Votes</p>
                  <h2>Filter bill actions</h2>
                </div>

                <label class="vote-search-field">
                  <span>Search bills</span>
                  <input
                    type="search"
                    placeholder="Search bill number, title, motion, issue..."
                    data-vote-search
                  />
                </label>

                <div class="vote-filter-fields">
                  <label>
                    <span>Vote alignment</span>
                    <select data-vote-filter="alignment">
                      <option value="">All vote alignments</option>
                      <option value="aligned">Aligned with testimony</option>
                      <option value="not-aligned">Not aligned with testimony</option>
                      <option value="neutral">Neutral/no clear position</option>
                    </select>
                  </label>

                  <label>
                    <span>Bill type</span>
                    <select data-vote-filter="tracked">
                      <option value="">Tracked and untracked</option>
                      <option value="tracked">Tracked bills</option>
                      <option value="untracked">Untracked bills</option>
                    </select>
                  </label>

                  <label>
                    <span>Public testimony</span>
                    <select data-vote-filter="testimony">
                      <option value="">All testimony statuses</option>
                      <option value="has-testimony">Has testimony summary</option>
                      <option value="no-testimony">No testimony summary</option>
                    </select>
                  </label>

                  <label>
                    <span>Sort</span>
                    <select data-vote-sort>
                      <option value="newest">Newest first</option>
                      <option value="oldest">Oldest first</option>
                      <option value="bill-az">Bill A-Z</option>
                      <option value="tracked-first">Tracked first</option>
                    </select>
                  </label>
                </div>

                <div class="vote-filter-status" aria-live="polite">
                  <strong data-vote-result-count>{votes.length}</strong>
                  <span>votes shown</span>
                  <button type="button" data-vote-clear>Clear filters</button>
                </div>
              </section>

              <section class="vote-grid" data-vote-grid>
                {votes.map((vote) => {
                  const stance = voteStanceFor(vote);
                  const voteImpact = voteImpactFor(vote);
                  const gradeContribution = voteGradeContributionFor(vote);
                  const billYear = vote.billSummary?.sessionyear || vote.sessionyear;
                  const summary =
                    vote.billSummary?.summary ||
                    vote.trackedBill?.summary ||
                    "";
                  const billCode = billCodeFor(vote);
                  const action = voteActionFor(vote);
                  const stanceKey = stance.className === "legislator-support"
                    ? "aligned"
                    : stance.className === "legislator-oppose"
                      ? "not-aligned"
                      : "neutral";
                  const testimonyKey = vote.billSummary ? "has-testimony" : "no-testimony";
                  const trackedKey = vote.trackedBill ? "tracked" : "untracked";
                  const voteTimestamp = vote.vote_date ? new Date(vote.vote_date).getTime() : 0;
                  const searchableText = cleanText([
                    billCode,
                    billTitleFor(vote),
                    summary,
                    action,
                    stance.label,
                    voteImpact,
                    vote.trackedBill?.issueArea,
                    billYear,
                    vote.votesequencenumber ? `roll call ${vote.votesequencenumber}` : "",
                  ].filter(Boolean).join(" "));

                  return (
                    <article
                      class="vote-bill-card"
                      data-vote-card
                      data-search={searchableText}
                      data-alignment={stanceKey}
                      data-tracked={trackedKey}
                      data-testimony={testimonyKey}
                      data-date={voteTimestamp}
                      data-bill={billCode}
                    >
                      <div class="bill-topline">
                        <strong>
                          <a href={billDetailPath(billCode, billYear)}>
                            {billCode}
                          </a>
                        </strong>
                        {billYear && <span>{billYear}</span>}
                        {vote.trackedBill ? (
                          <span class="tracker-pill">Tracked</span>
                        ) : (
                          <span>Untracked</span>
                        )}
                      </div>

                      <h2>
                        <a href={billDetailPath(billCode, billYear)}>
                          {billTitleFor(vote)}
                        </a>
                      </h2>

                      {summary && <p>{previewText(summary)}</p>}

                      {action && (
                        <div class="vote-action">
                          <strong>Voting action</strong>
                          <span>{previewText(action, 180)}</span>
                        </div>
                      )}

                      <div class:list={["vote-interpretation", stance.className]}>
                        <strong>Vote</strong>
                        <a
                          class:list={["legislator-vote-pill", stance.className]}
                          href="/vote-interpretations"
                          title="How do we determine this?"
                          aria-label={`How do we determine this? ${stance.label}`}
                        >
                          {stance.label}
                        </a>
                        <span
                          class:list={["vote-grade-impact", gradeContribution.className]}
                          title={gradeContribution.tooltip}
                          aria-label={gradeContribution.tooltip}
                        >
                          {gradeContribution.label}
                        </span>
                        {voteImpact && <p class="vote-impact">{cleanText(voteImpact)}</p>}
                      </div>

                      {vote.billSummary ? (
                        <BillPositionSummary bill={vote.billSummary} />
                      ) : (
                        <div class="position-placeholder">
                          Public testimony summary not available.
                        </div>
                      )}

                      <div class="bill-meta">
                        {vote.vote_date && <span>{formatDate(vote.vote_date)}</span>}
                        {vote.votesequencenumber && (
                          <span>Roll call {vote.votesequencenumber}</span>
                        )}
                        {vote.trackedBill?.issueArea && (
                          <span>{cleanText(vote.trackedBill.issueArea)}</span>
                        )}
                      </div>
                    </article>
                  );
                })}
              </section>
            </>
          ) : (
            <p class="status-message">No votes were returned.</p>
          )}
        </>
      )}
    </main>
    <SiteFooter />
    <script is:inline>
      (() => {
        const grid = document.querySelector("[data-vote-grid]");
        if (!grid) return;

        const cards = Array.from(grid.querySelectorAll("[data-vote-card]"));
        const searchInput = document.querySelector("[data-vote-search]");
        const filterControls = Array.from(document.querySelectorAll("[data-vote-filter]"));
        const sortControl = document.querySelector("[data-vote-sort]");
        const countEl = document.querySelector("[data-vote-result-count]");
        const clearButton = document.querySelector("[data-vote-clear]");

        const normalize = (value = "") =>
          String(value)
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[’‘`]/g, "'")
            .replace(/â€™|â€˜/g, "'")
            .replace(/â€œ|â€�/g, '"')
            .replace(/Â/g, "")
            .toLowerCase()
            .replace(/[^a-z0-9#]+/g, " ")
            .trim();

        const getFilters = () => {
          const filters = {};
          for (const control of filterControls) {
            filters[control.dataset.voteFilter] = control.value;
          }
          return filters;
        };

        const sortCards = (visibleCards) => {
          const sort = sortControl?.value || "newest";
          const sorted = [...visibleCards].sort((a, b) => {
            if (sort === "oldest") return Number(a.dataset.date || 0) - Number(b.dataset.date || 0);
            if (sort === "bill-az") return String(a.dataset.bill || "").localeCompare(String(b.dataset.bill || ""));
            if (sort === "tracked-first") {
              const trackedCompare = Number(b.dataset.tracked === "tracked") - Number(a.dataset.tracked === "tracked");
              if (trackedCompare) return trackedCompare;
              return Number(b.dataset.date || 0) - Number(a.dataset.date || 0);
            }
            return Number(b.dataset.date || 0) - Number(a.dataset.date || 0);
          });

          for (const card of sorted) grid.appendChild(card);
        };

        const applyFilters = () => {
          const query = normalize(searchInput?.value || "");
          const filters = getFilters();
          const visible = [];

          for (const card of cards) {
            const matchesSearch = !query || normalize(card.dataset.search || "").includes(query);
            const matchesAlignment = !filters.alignment || card.dataset.alignment === filters.alignment;
            const matchesTracked = !filters.tracked || card.dataset.tracked === filters.tracked;
            const matchesTestimony = !filters.testimony || card.dataset.testimony === filters.testimony;
            const show = matchesSearch && matchesAlignment && matchesTracked && matchesTestimony;

            card.hidden = !show;
            if (show) visible.push(card);
          }

          sortCards(visible);
          if (countEl) countEl.textContent = String(visible.length);
        };

        searchInput?.addEventListener("input", applyFilters);
        sortControl?.addEventListener("change", applyFilters);
        for (const control of filterControls) {
          control.addEventListener("change", applyFilters);
        }
        clearButton?.addEventListener("click", () => {
          if (searchInput) searchInput.value = "";
          for (const control of filterControls) control.value = "";
          if (sortControl) sortControl.value = "newest";
          applyFilters();
          searchInput?.focus();
        });

        applyFilters();
      })();
    </script>
  </body>
</html>

