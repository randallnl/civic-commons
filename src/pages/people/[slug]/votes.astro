---
export const prerender = false;

import BillPositionSummary from "../../../components/BillPositionSummary.astro";
import TopNav from "../../../components/TopNav.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import profileIcon from "../../../assets/profile icon.png";
import { billDetailPath, getBillDetail, getBillSummaries } from "../../../lib/billsApi";
import { profilePhotoUrl } from "../../../lib/photos";
import { getRepresentative, repName } from "../../../lib/repsApi";
import { cleanText } from "../../../lib/text";
import {
  getTrackedBills,
  isKnownVote,
  isVotingAction,
  normalizeBillCode,
  representativeVoteImpact,
  representativeVoteStance,
  trackedBillForVote,
} from "../../../lib/trackedBills";

const { slug } = Astro.params;

let apiData = null;
let trackedBills = new Map();
let billSummaries = new Map();
let error = "";

try {
  apiData = await getRepresentative(slug, { voteLimit: 500 });
} catch (loadError) {
  error = loadError?.message || "Unable to load representative.";
}

try {
  [trackedBills, billSummaries] = await Promise.all([
    getTrackedBills(),
    getBillSummaries(),
  ]);
} catch (loadError) {
  console.error(loadError?.message || "Unable to load tracked bill data.");
}

const representative = apiData?.representative || null;

if (!error && !representative) {
  return Astro.redirect("/404");
}

const representativeName = repName(representative || {}) || "Representative";
const portraitUrl = profilePhotoUrl(representative?.photo || representative?.photo_url);
const partyLabel = formatParty(representative?.party);
const roleLabel = representativeRoleLabel(representative || {});
const districtLabel = representativeDistrictLabel(representative || {});
const townsRepresented = locationLabel(representative || {});
let votes = (apiData?.voteHistory || []).map((vote) =>
  normalizeVote(vote, trackedBills, billSummaries),
).filter((vote) => isVotingAction(vote) && isKnownVote(vote));
const trackedVoteCount = votes.filter((vote) => vote.trackedBill).length;

votes = await Promise.all(
  votes.map(async (vote) => {
    if (vote.billSummary) return vote;

    try {
      const detail = await getBillDetail(vote.bill_number, {
        year: vote.sessionyear,
      });
      return { ...vote, billSummary: detail.bill };
    } catch (detailError) {
      console.error(detailError?.message || "Unable to load bill summary.");
      return vote;
    }
  }),
);

function normalizeVote(vote = {}, bills = new Map(), summaries = new Map()) {
  const billNumber = vote.condensedbillno || vote.bill_number || "";
  const trackedBill = trackedBillForVote(bills, vote);
  const billSummary = summaries.get(normalizeBillCode(billNumber));

  return {
    ...vote,
    bill_number: billNumber,
    title: vote.title || vote.action_text || vote.question_motion || vote.description || "",
    vote_date: vote.vote_date || vote.statusdate || "",
    motion: vote.motion || vote.action_text || vote.question_motion || vote.description || "",
    bill_status: vote.bill_status || "",
    vote_label: displayVoteLabel(vote),
    billSummary,
    trackedBill,
  };
}

function displayVoteLabel(vote = {}) {
  const rawLabel = cleanText(vote.vote_label || "");
  if (rawLabel && !["N/A", "NA"].includes(rawLabel.toUpperCase())) return rawLabel;

  return displayRawVoteLabel(vote);
}

function displayRawVoteLabel(vote = {}) {
  const voteValue = String(vote.vote || vote.vote_code || "").trim().toLowerCase();
  const labels = {
    "1": "Yea",
    yea: "Yea",
    yes: "Yea",
    "2": "Nay",
    nay: "Nay",
    no: "Nay",
    "3": "Absent",
    absent: "Absent",
    "4": "Present",
    present: "Present",
    "5": "Not voting",
    other_not_voting: "Not voting",
    "6": "Present not voting",
    "7": "Present not voting",
    other_present_not_voting: "Present not voting",
    "0": "Not counted",
    other_not_counted: "Not counted",
  };

  return labels[voteValue] || cleanText(vote.vote || "Not listed");
}

function voteClass(vote = {}) {
  const label = String(vote.vote_label || vote.vote || "").toLowerCase();
  if (label.includes("support") || label === "yea" || label === "yes") return "legislator-support";
  if (label.includes("against") || label.includes("oppose") || label === "nay" || label === "no") {
    return "legislator-oppose";
  }
  return "legislator-neutral";
}

function billCodeFor(vote = {}) {
  return vote.trackedBill?.code || vote.bill_number || vote.condensedbillno || "Bill";
}

function billTitleFor(vote = {}) {
  return (
    vote.billSummary?.name ||
    vote.billSummary?.title ||
    vote.trackedBill?.name ||
    vote.trackedBill?.title ||
    billCodeFor(vote)
  );
}

function voteActionFor(vote = {}) {
  return cleanText(
    vote.action_text ||
      vote.question_motion ||
      vote.motion ||
      vote.title1 ||
      vote.title2 ||
      vote.description ||
      "",
  );
}

function testimonyPositionForBill(bill = {}) {
  const support = Number(bill?.support_count || bill?.supportCount || 0);
  const oppose = Number(bill?.oppose_count || bill?.opposeCount || 0);
  const total = support + oppose;

  if (!Number.isFinite(total) || total === 0 || support === oppose) {
    return "";
  }

  const margin = Math.abs(support - oppose) / total;
  if (total < 50 && margin <= 0.25) return "";
  if (margin <= 0.1) return "";

  return support > oppose ? "support" : "oppose";
}

function inferredBillPosition(vote = {}, motion = "") {
  const voteValue = String(vote.vote_code || vote.vote || vote.vote_label || "")
    .trim()
    .toLowerCase();
  const isYea = ["1", "yea", "yes", "y"].includes(voteValue);
  const isNay = ["2", "nay", "no", "n"].includes(voteValue);

  if (!isYea && !isNay) return "";

  const motionText = cleanText(motion).toLowerCase();
  const motionOpposesBill =
    /\bitl\b/.test(motionText) ||
    motionText.includes("inexpedient to legislate") ||
    motionText.includes("indefinitely postpone") ||
    motionText.includes("postpone indefinitely");

  if (motionOpposesBill) return isYea ? "oppose" : "support";
  return isYea ? "support" : "oppose";
}

function titleCase(value = "") {
  return String(value || "").replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function testimonyVoteStanceFor(vote = {}) {
  const bill = vote.billSummary || null;
  if (!bill) return null;

  const position = inferredBillPosition(vote, voteActionFor(vote));
  if (!position) return null;

  const testimony = testimonyPositionForBill(bill);
  const rawVote = displayRawVoteLabel(vote);
  if (!testimony) {
    return {
      label: `Voted: ${rawVote}: ${titleCase(position)} - no clear testimony position`,
      className: "legislator-neutral",
    };
  }

  const aligned = position === testimony;
  return {
    label: `Voted: ${rawVote}: ${titleCase(position)} - ${
      aligned ? "aligned with testimony position" : "not aligned with testimony position"
    }`,
    className: aligned ? "legislator-support" : "legislator-oppose",
  };
}

function voteStanceFor(vote = {}) {
  const testimonyStance = testimonyVoteStanceFor(vote);
  if (testimonyStance) return testimonyStance;
  if (vote.trackedBill) return representativeVoteStance(vote, vote.trackedBill);
  if (vote.billSummary) return representativeVoteStance(vote, vote.billSummary);
  return {
    label: `Voted: ${displayVoteLabel(vote)}`,
    className: voteClass(vote),
  };
}

function voteImpactFor(vote = {}) {
  if (!vote.trackedBill) return "";
  return representativeVoteImpact(vote, vote.trackedBill);
}

function formatDate(value) {
  if (!value) return "";

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
}

function previewText(value = "", length = 260) {
  const text = cleanText(value).trim();
  if (text.length <= length) return text;
  return `${text.slice(0, length).trim()}...`;
}

function formatParty(value = "") {
  const party = String(value || "").trim().toUpperCase();
  if (party === "D") return "Democratic";
  if (party === "R") return "Republican";
  if (party === "I") return "Independent";
  return cleanText(value || "Party not listed");
}

function legislativeBody(person = {}) {
  const value = String(person.chamber || person.legislativebody || person.body || "").toLowerCase();
  if (value === "h" || value === "house") return "House";
  if (value === "s" || value === "senate") return "Senate";
  return cleanText(person.chamber || "");
}

function representativeRoleLabel(person = {}) {
  const body = legislativeBody(person);
  if (body === "House") return "New Hampshire House of Representatives";
  if (body === "Senate") return "New Hampshire Senate";
  return cleanText(person.office || person.role || "Legislator");
}

function representativeDistrictLabel(person = {}) {
  const district = cleanText(person.district || person.raw_district || "");
  const body = legislativeBody(person);
  if (!district) return "";
  if (body === "House") return `NH House District ${district}`;
  if (body === "Senate") return `NH Senate District ${district}`;
  return `District ${district}`;
}

function locationLabel(person = {}) {
  const value =
    person.location_text ||
    person.locationText ||
    person.towns_represented ||
    person.townsRepresented ||
    "";
  if (Array.isArray(value)) return value.map(cleanText).filter(Boolean).join(", ");
  return cleanText(value);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Votes for {representativeName} | NH Deserves Better</title>
    <meta
      name="description"
      content={`Vote history and bill summaries for ${representativeName}.`}
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <a class="back" href={`/people/${slug}`}>Back to profile</a>

      {error ? (
        <p class="status-message">{error}</p>
      ) : (
        <>
          <section class="hero">
            <a class="portrait-card" href={`/people/${slug}`}>
              {portraitUrl ? (
                <img src={portraitUrl} alt={`Photo of ${representativeName}`} />
              ) : (
                <img class="portrait-fallback" src={profileIcon.src} alt="" />
              )}
            </a>

            <div class="hero-copy">
              <p class="eyebrow">Vote History</p>
              <h1>{representativeName}</h1>

              <div class="hero-meta">
                {partyLabel && <span>{partyLabel}</span>}
                {roleLabel && <span>{roleLabel}</span>}
                {districtLabel && <span>{districtLabel}</span>}
                <span>{votes.length} votes</span>
                <span>{trackedVoteCount} tracked</span>
              </div>

              {townsRepresented && (
                <p class="towns-served">
                  <strong>Towns served</strong>
                  {townsRepresented}
                </p>
              )}

              <p>
                These are all votes currently returned for this legislator. Votes
                are limited to bill actions with a documented roll-call action.
                Votes connected to the bill tracker include tracker summaries,
                interpretations, and public testimony summary data where available.
              </p>
            </div>
          </section>

          {votes.length ? (
            <>
              <section class="vote-color-legend" aria-label="Representative vote color legend">
                <div>
                  <p class="eyebrow">Legend</p>
                  <h2>Representative vote colors</h2>
                </div>
                <div class="legend-items">
                  <span class="legend-item legislator-support">Aligned with testimony position</span>
                  <span class="legend-item legislator-oppose">Not aligned with testimony position</span>
                  <span class="legend-item legislator-neutral">Neutral or no clear testimony position</span>
                </div>
                <a href="/vote-interpretations">How vote labels work</a>
              </section>

              <section class="vote-grid">
                {votes.map((vote) => {
                  const stance = voteStanceFor(vote);
                  const voteImpact = voteImpactFor(vote);
                  const billYear = vote.billSummary?.sessionyear || vote.sessionyear;
                  const summary =
                    vote.billSummary?.summary ||
                    vote.trackedBill?.summary ||
                    "";
                  const billCode = billCodeFor(vote);
                  const action = voteActionFor(vote);

                  return (
                    <article class="vote-bill-card">
                      <div class="bill-topline">
                        <strong>
                          <a href={billDetailPath(billCode, billYear)}>
                            {billCode}
                          </a>
                        </strong>
                        {billYear && <span>{billYear}</span>}
                        {vote.trackedBill ? (
                          <span class="tracker-pill">Tracked</span>
                        ) : (
                          <span>Untracked</span>
                        )}
                      </div>

                      <h2>
                        <a href={billDetailPath(billCode, billYear)}>
                          {billTitleFor(vote)}
                        </a>
                      </h2>

                      {summary && <p>{previewText(summary)}</p>}

                      {action && (
                        <div class="vote-action">
                          <strong>Voting action</strong>
                          <span>{previewText(action, 180)}</span>
                        </div>
                      )}

                      <div class:list={["vote-interpretation", stance.className]}>
                        <strong>Vote</strong>
                        <a
                          class:list={["legislator-vote-pill", stance.className]}
                          href="/vote-interpretations"
                          title="How do we determine this?"
                          aria-label={`How do we determine this? ${stance.label}`}
                        >
                          {stance.label}
                        </a>
                        {voteImpact && <p class="vote-impact">{cleanText(voteImpact)}</p>}
                      </div>

                      {vote.billSummary ? (
                        <BillPositionSummary bill={vote.billSummary} />
                      ) : (
                        <div class="position-placeholder">
                          Public testimony summary not available.
                        </div>
                      )}

                      <div class="bill-meta">
                        {vote.vote_date && <span>{formatDate(vote.vote_date)}</span>}
                        {vote.votesequencenumber && (
                          <span>Roll call {vote.votesequencenumber}</span>
                        )}
                        {vote.trackedBill?.issueArea && (
                          <span>{cleanText(vote.trackedBill.issueArea)}</span>
                        )}
                      </div>
                    </article>
                  );
                })}
              </section>
            </>
          ) : (
            <p class="status-message">No votes were returned.</p>
          )}
        </>
      )}
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .back,
  a {
    color: #1f2933;
    font-weight: 800;
  }

  .hero {
    align-items: stretch;
    background:
      radial-gradient(circle at 82% 18%, rgba(220, 77, 9, 0.14), transparent 28%),
      linear-gradient(135deg, #eff6ff 0%, #ffffff 48%, #f8fbff 100%);
    border: 1px solid #bfdbfe;
    border-radius: 18px;
    display: grid;
    gap: clamp(18px, 3vw, 28px);
    grid-template-columns: minmax(160px, 260px) minmax(0, 1fr);
    margin: 18px 0 24px;
    overflow: hidden;
    padding: clamp(18px, 3vw, 28px);
    position: relative;
  }

  .portrait-card {
    aspect-ratio: 4 / 5;
    background: #d8cfc0;
    border: 1px solid #dbeafe;
    border-radius: 10px;
    display: block;
    overflow: hidden;
    width: 100%;
  }

  .portrait-card img,
  .portrait-fallback {
    display: block;
    height: 100%;
    width: 100%;
  }

  .portrait-card img {
    object-fit: cover;
    object-position: center top;
  }

  .portrait-card img.portrait-fallback {
    background: transparent;
    object-fit: cover;
    padding: 0;
  }

  .hero-copy {
    align-self: center;
    min-width: 0;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.15rem, 5vw, 4rem);
    line-height: 0.92;
    margin: 0 0 14px;
  }

  .hero p {
    color: #4b5563;
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 780px;
  }

  .towns-served {
    background: rgba(255, 255, 255, 0.74);
    border: 1px solid #dbeafe;
    border-radius: 12px;
    display: grid;
    gap: 5px;
    margin: 14px 0;
    padding: 12px 14px;
  }

  .towns-served strong {
    color: #6b4f2a;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-meta,
  .bill-topline,
  .bill-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-meta span,
  .bill-topline span,
  .bill-meta span {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 900;
    padding: 6px 9px;
  }

  .bill-topline .tracker-pill {
    background: #dbeafe;
    border-color: #60a5fa;
    color: #1d4ed8;
  }

  .vote-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .vote-color-legend {
    align-items: center;
    background: #ffffff;
    border: 1px solid #dbeafe;
    border-radius: 12px;
    display: grid;
    gap: 14px;
    grid-template-columns: minmax(180px, auto) minmax(0, 1fr) auto;
    margin: 0 0 18px;
    padding: 16px;
  }

  .vote-color-legend h2 {
    color: #1f2933;
    font-size: 1.15rem;
    line-height: 1.1;
    margin: 0;
  }

  .vote-color-legend .eyebrow {
    margin-bottom: 4px;
  }

  .legend-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .legend-item {
    border: 1px solid #d1d5db;
    border-radius: 999px;
    color: #1f2933;
    font-size: 0.78rem;
    font-weight: 950;
    line-height: 1.15;
    padding: 8px 10px;
  }

  .vote-color-legend a {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    font-size: 0.82rem;
    padding: 9px 11px;
    text-align: center;
    text-decoration: none;
  }

  .vote-bill-card,
  .status-message {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    padding: 18px;
  }

  .bill-topline {
    justify-content: space-between;
  }

  .bill-topline strong {
    font-size: 1.1rem;
  }

  .vote-bill-card h2 {
    font-size: 1.35rem;
    line-height: 1.15;
    margin: 14px 0 8px;
  }

  .vote-bill-card > p,
  .vote-impact {
    color: #4b5563;
    line-height: 1.55;
    margin: 0 0 14px;
  }

  .vote-action {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    display: grid;
    gap: 5px;
    margin: 14px 0;
    padding: 10px 12px;
  }

  .vote-action strong {
    color: #475569;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .vote-action span {
    color: #1f2933;
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .vote-interpretation {
    background: white;
    border: 1px solid #9ca3af;
    border-radius: 12px;
    display: grid;
    gap: 8px;
    margin: 14px 0;
    padding: 8px;
  }

  .vote-interpretation > strong {
    color: #4b5563;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .legislator-vote-pill {
    border: 1px solid #d1d5db;
    border-radius: 999px;
    box-sizing: border-box;
    color: #1f2933;
    display: block;
    font-size: 0.78rem;
    font-weight: 900;
    line-height: 1.2;
    padding: 7px 10px;
    text-align: center;
    text-decoration: none;
    width: 100%;
    white-space: normal;
  }

  .legislator-support {
    background: #dff0d8;
    border-color: #2f7d4f;
  }

  .legislator-oppose {
    background: #fde2de;
    border-color: #b42318;
  }

  .legislator-neutral {
    background: #dbeafe;
    border-color: #2563eb;
  }

  .vote-impact {
    font-weight: 500;
    margin: 0;
  }

  .position-placeholder {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 12px;
    color: #4b5563;
    font-size: 0.86rem;
    font-weight: 850;
    margin-top: 14px;
    padding: 12px;
  }

  .bill-meta {
    margin-top: 14px;
  }

  @media (max-width: 640px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .portrait-card {
      max-width: 220px;
    }

    .vote-color-legend {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .vote-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
