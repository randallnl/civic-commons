---
export const prerender = false;

import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CommunityUpdates from "../../components/CommunityUpdates.astro";
import {
  formatByteSize,
  getReportDownloads,
  reportDownloadPath,
} from "../../lib/reportDownloads";

const reportSlug = "nh-education-aid-per-pupil";
const categoryLabels = new Map([
  ["district-adequacy", "District adequacy"],
  ["charter-schools", "Charter schools"],
  ["education-freedom-accounts", "Education Freedom Accounts"],
]);

let reportDownloads = [];

try {
  reportDownloads = await getReportDownloads(reportSlug);
} catch (error) {
  console.error(JSON.stringify({
    event: "education_report_downloads_unavailable",
    message: error instanceof Error ? error.message : String(error),
  }));
}

const bundleDownloads = reportDownloads.filter(
  (download) => download.category === "source-bundle",
);
const sourceDownloadGroups = Array.from(categoryLabels, ([category, label]) => ({
  category,
  label,
  downloads: reportDownloads.filter((download) => download.category === category),
})).filter((group) => group.downloads.length > 0);
const sourceFileCount = sourceDownloadGroups.reduce(
  (total, group) => total + group.downloads.length,
  0,
);

const fundingData = [
  { year: 2016, baseAdequacy: 613.833923, calculatedCost: 758.455507, differentialAid: 144.621584, districtGrant: 570.120846, swept: 363.137923, charterDirect: 22.953740, charterSped: 0.366312, efaPayments: 0, districtAdm: 172363.77, charterAdm: 4035.97, efaMembership: 0 },
  { year: 2017, baseAdequacy: 604.680355, calculatedCost: 745.216971, differentialAid: 140.536616, districtGrant: 564.007588, swept: 363.431572, charterDirect: 28.427990, charterSped: 0.681184, efaPayments: 0, districtAdm: 169793.46, charterAdm: 4462.07, efaMembership: 0 },
