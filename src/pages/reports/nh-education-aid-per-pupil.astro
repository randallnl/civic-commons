  { year: 2019, baseAdequacy: 603.934684, calculatedCost: 747.686406, differentialAid: 143.751722, districtGrant: 552.624220, swept: 363.099673, charterDirect: 35.110841, charterSped: 0.849814, efaPayments: 0, districtAdm: 166095.9071, charterAdm: 5236.28, efaMembership: 0 },
  { year: 2020, baseAdequacy: 625.761540, calculatedCost: 779.389670, differentialAid: 153.628130, districtGrant: 599.249581, swept: 363.246023, charterDirect: 38.126966, charterSped: 1.116616, efaPayments: 0, districtAdm: 168724.3621, charterAdm: 5546.5, efaMembership: 0 },
