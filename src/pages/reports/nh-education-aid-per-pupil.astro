  { year: 2022, baseAdequacy: 634.260169, calculatedCost: 788.588331, differentialAid: 154.328163, districtGrant: 624.823445, swept: 363.283230, charterDirect: 45.319324, charterSped: 1.426062, efaPayments: 9.004046, districtAdm: 167498.5789, charterAdm: 6266.7174, efaMembership: 1821 },
