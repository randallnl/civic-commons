  { year: 2020, calculatedCost: 779.389670, districtGrant: 599.249581, swept: 363.246023, charterDirect: 38.126966, charterSped: 1.116616, efaPayments: 0, districtAdm: 168724.3621, charterAdm: 5546.5, efaMembership: 0 },
