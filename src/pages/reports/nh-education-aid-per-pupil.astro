<script>
  const explorer = document.querySelector("[data-funding-explorer]");
  const dataNode = document.querySelector("#education-funding-data");

  if (explorer instanceof HTMLElement && dataNode) {
    const rows = JSON.parse(dataNode.textContent || "[]");
    const autoMatch = explorer.querySelector("[data-auto-match]");
    const studentInputs = Array.from(explorer.querySelectorAll("[data-student]"));
    const fundingInputs = Array.from(explorer.querySelectorAll("[data-funding]"));
    const districtInputs = Array.from(explorer.querySelectorAll('input[name="district-measure"]'));
    const districtAddons = explorer.querySelector("[data-district-addons]");
    const districtAddonsRow = explorer.querySelector("[data-district-addons-row]");
    const presetButtons = Array.from(explorer.querySelectorAll("[data-preset]"));

    const fundingLabels = {
      baseAdequacy: "Base adequacy aid",
      calculatedCost: "Formula cost",
      districtGrant: "District grant paid",
      swept: "SWEPT",
      charterDirect: "Charter direct aid",
      charterSped: "Charter special-education aid",
      efaPayments: "EFA scheduled payments",
    };
    const studentLabels = {
      districtAdm: "District ADM",
      charterAdm: "Charter ADM",
      efaMembership: "EFA membership",
    };
    const componentColors = {
      baseAdequacy: "#2563eb",
      calculatedCost: "#49a78e",
      districtGrant: "#49a78e",
      swept: "#c6952e",
      charterDirect: "#7aa5bd",
      charterSped: "#b9d2df",
      efaPayments: "#d66a5e",
    };
    const numberFormat = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });
    const moneyFormat = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });

    function selectedDistrictRadio() {
      const selected = districtInputs.find((input) => input instanceof HTMLInputElement && input.checked);
      return selected instanceof HTMLInputElement ? selected.value : "none";
    }

    function selectedDistrictMeasure() {
      const selected = selectedDistrictRadio();
      if (selected === "districtGrant" && districtAddons instanceof HTMLInputElement && !districtAddons.checked) {
        return "baseAdequacy";
      }
      return selected;
    }

    function selectedFundingKeys() {
      const districtMeasure = selectedDistrictMeasure();
      const keys = districtMeasure === "none" ? [] : [districtMeasure];
      fundingInputs.forEach((input) => {
        if (input instanceof HTMLInputElement && input.checked) keys.push(input.dataset.funding);
      });
      return keys.filter(Boolean);
    }

    function selectedStudentKeys() {
      return studentInputs
        .filter((input) => input instanceof HTMLInputElement && input.checked)
        .map((input) => input.dataset.student)
        .filter(Boolean);
    }

    function setCheckbox(key, checked, type) {
      const input = explorer.querySelector(`[data-${type}="${key}"]`);
      if (input instanceof HTMLInputElement) input.checked = checked;
    }

    function setDistrictMeasure(value) {
      districtInputs.forEach((input) => {
        if (input instanceof HTMLInputElement) input.checked = input.value === value;
      });
    }

    function updateDistrictAddonControl() {
      const enabled = selectedDistrictRadio() === "districtGrant";
      if (districtAddons instanceof HTMLInputElement) districtAddons.disabled = !enabled;
      if (districtAddonsRow instanceof HTMLElement) districtAddonsRow.classList.toggle("disabled-choice", !enabled);
    }

    function syncStudentPopulation() {
      if (!(autoMatch instanceof HTMLInputElement) || !autoMatch.checked) return;
      const keys = selectedFundingKeys();
      setCheckbox("districtAdm", keys.includes("districtGrant") || keys.includes("baseAdequacy") || keys.includes("calculatedCost") || keys.includes("swept"), "student");
      setCheckbox("charterAdm", keys.includes("charterDirect") || keys.includes("charterSped"), "student");
      setCheckbox("efaMembership", keys.includes("efaPayments"), "student");
    }

    function updateStudentControls() {
      const isAutomatic = autoMatch instanceof HTMLInputElement && autoMatch.checked;
      studentInputs.forEach((input) => {
        if (input instanceof HTMLInputElement) input.disabled = isAutomatic;
      });
      const note = explorer.querySelector("[data-manual-note]");
      if (note) note.textContent = isAutomatic
        ? "Turn off matching to choose the student population manually."
        : "Manual mode: make sure the selected students match the selected funding programs.";
    }

    function calculate(row) {
      const fundingKeys = selectedFundingKeys();
      const studentKeys = selectedStudentKeys();
      const missingFunding = fundingKeys.filter((key) => row[key] === null || row[key] === undefined);
      const missingStudents = studentKeys.filter((key) => row[key] === null || row[key] === undefined);
      const missing = [
        ...missingFunding.map((key) => fundingLabels[key]),
        ...missingStudents.map((key) => studentLabels[key]),
      ];
      const totalMillions = fundingKeys.reduce((sum, key) => sum + (typeof row[key] === "number" ? row[key] : 0), 0);
      const students = studentKeys.reduce((sum, key) => sum + (typeof row[key] === "number" ? row[key] : 0), 0);
      const available = fundingKeys.length > 0 && studentKeys.length > 0 && missing.length === 0 && students > 0;
      return {
        row,
        fundingKeys,
        studentKeys,
        missing,
        totalMillions,
        students,
        available,
        perStudent: available ? totalMillions * 1000000 / students : null,
      };
    }

    function formatMillions(value) {
      if (value >= 1000) return `$${(value / 1000).toFixed(2)} billion`;
      return `$${value.toFixed(1)} million`;
    }

    function updateFormula() {
      const formula = explorer.querySelector("[data-formula]");
      if (!formula) return;
      const fundingKeys = selectedFundingKeys();
      const studentKeys = selectedStudentKeys();
      const numerator = fundingKeys.length
        ? fundingKeys.map((key) => fundingLabels[key]).join(" + ")
        : "No funding selected";
      const denominator = studentKeys.length
        ? studentKeys.map((key) => studentLabels[key]).join(" + ")
        : "No students selected";
      formula.textContent = `(${numerator}) ÷ (${denominator}). The charts and table apply this definition separately to each fiscal year.`;
    }

    function updateChartLegend(selector, fundingKeys) {
      const legend = explorer.querySelector(selector);
      if (!(legend instanceof HTMLElement)) return;
      legend.replaceChildren();
      if (fundingKeys.length === 0) {
        legend.textContent = "Select at least one funding program.";
        legend.classList.add("empty");
        return;
      }
      legend.classList.remove("empty");
      fundingKeys.forEach((key) => {
        const item = document.createElement("span");
        const swatch = document.createElement("i");
        swatch.style.background = componentColors[key];
        item.append(swatch, document.createTextNode(fundingLabels[key]));
        legend.append(item);
      });
    }

    function updateSpendChart(results) {
      const svg = explorer.querySelector("[data-spend-chart]");
      if (!(svg instanceof SVGElement)) return;
      const fundingKeys = selectedFundingKeys();
      updateChartLegend("[data-spend-legend]", fundingKeys);
      const title = "<title>Total selected education spending by program and fiscal year</title>";
      const description = "<desc>Each complete bar stacks the selected funding programs. Missing selected data leaves a marked gap.</desc>";
      if (fundingKeys.length === 0) {
        svg.innerHTML = `${title}${description}<text x="380" y="143" text-anchor="middle" class="chart-empty">Select funding to build the chart</text>`;
        return;
      }

      const completeResults = results.filter((result) => fundingKeys.every((key) => typeof result.row[key] === "number"));
      if (completeResults.length === 0) {
        svg.innerHTML = `${title}${description}<text x="380" y="143" text-anchor="middle" class="chart-empty">No complete years for these selections</text>`;
        return;
      }

      const rawMax = Math.max(...completeResults.map((result) => fundingKeys.reduce((sum, key) => sum + result.row[key], 0)));
      const max = Math.max(100, Math.ceil(rawMax / 100) * 100);
      const left = 62;
      const right = 742;
      const top = 24;
      const bottom = 230;
      const barWidth = Math.min(42, (right - left) / results.length * .68);
      const x = (index) => left + index * (right - left) / (results.length - 1);
      const y = (value) => bottom - value / max * (bottom - top);
      const parts = [title, description];

      for (let index = 0; index <= 4; index += 1) {
        const value = max * index / 4;
        const lineY = y(value);
        parts.push(`<line x1="${left}" y1="${lineY}" x2="${right}" y2="${lineY}" class="chart-grid" />`);
        parts.push(`<text x="${left - 10}" y="${lineY + 4}" text-anchor="end" class="chart-label">$${numberFormat.format(value)}m</text>`);
      }

      results.forEach((result, index) => {
        const centerX = x(index);
        const missingKeys = fundingKeys.filter((key) => typeof result.row[key] !== "number");
        parts.push(`<text x="${centerX}" y="258" text-anchor="middle" class="chart-year">${String(result.row.year).slice(2)}</text>`);
        if (missingKeys.length > 0) {
          const missingLabel = `FY${result.row.year}: unavailable ${missingKeys.map((key) => fundingLabels[key]).join(", ")}`;
          parts.push(`<g class="chart-missing-year" tabindex="0" role="img" aria-label="${missingLabel}"><text x="${centerX}" y="${bottom - 7}" text-anchor="middle">×</text></g>`);
          return;
        }

        let stackedValue = 0;
        fundingKeys.forEach((key) => {
          const value = result.row[key];
          if (value <= 0) return;
          const segmentBottom = y(stackedValue);
          stackedValue += value;
          const segmentTop = y(stackedValue);
          const segmentHeight = Math.max(0, segmentBottom - segmentTop);
          const tooltipWidth = 286;
          const tooltipHeight = 62;
          const tooltipX = Math.max(0, Math.min(centerX - tooltipWidth / 2, 760 - tooltipWidth));
          const tooltipY = segmentTop >= 76 ? segmentTop - 72 : Math.min(bottom - tooltipHeight - 5, segmentTop + segmentHeight + 7);
          const accessibleLabel = `${fundingLabels[key]}, FY${result.row.year}: ${formatMillions(value)}`;
          parts.push(`
            <g class="chart-bar-group" tabindex="0" role="img" aria-label="${accessibleLabel}">
              <rect x="${centerX - barWidth / 2}" y="${segmentTop}" width="${barWidth}" height="${segmentHeight}" fill="${componentColors[key]}" class="chart-bar-segment" />
              <g class="chart-tooltip" transform="translate(${tooltipX} ${tooltipY})" aria-hidden="true">
                <rect width="${tooltipWidth}" height="${tooltipHeight}" rx="7" />
                <text x="14" y="24" class="chart-tooltip-year">${fundingLabels[key]} · FY${result.row.year}</text>
                <text x="14" y="48" class="chart-tooltip-value">${formatMillions(value)}</text>
              </g>
            </g>
          `);
        });
      });
      parts.push(`<text x="${left}" y="278" class="chart-axis-title">Fiscal year 20— · millions of dollars</text>`);
      svg.innerHTML = parts.join("");
    }

    function updateChart(results) {
      const svg = explorer.querySelector("[data-trend-chart]");
      if (!(svg instanceof SVGElement)) return;
      const title = "<title>Education aid per selected student by fiscal year</title>";
      const description = "<desc>The combined selected funding is divided by the selected student population for each year. Missing data creates gaps.</desc>";
      const valid = results.filter((result) => result.available);
      if (valid.length === 0) {
        svg.innerHTML = `${title}${description}<text x="380" y="135" text-anchor="middle" class="chart-empty">No complete years for these selections</text>`;
        return;
      }

      const values = valid.map((result) => result.perStudent);
      const rawMin = Math.min(...values);
      const rawMax = Math.max(...values);
      const spread = Math.max(rawMax - rawMin, rawMax * 0.08, 250);
      const min = Math.max(0, Math.floor((rawMin - spread * .16) / 250) * 250);
      const max = Math.ceil((rawMax + spread * .16) / 250) * 250;
      const left = 62;
      const right = 742;
      const top = 24;
      const bottom = 218;
      const x = (index) => left + index * (right - left) / (results.length - 1);
      const y = (value) => bottom - (value - min) / (max - min || 1) * (bottom - top);
      const parts = [title, description];

      for (let index = 0; index < 4; index += 1) {
        const value = min + (max - min) * index / 3;
        const lineY = y(value);
        parts.push(`<line x1="${left}" y1="${lineY}" x2="${right}" y2="${lineY}" class="chart-grid" />`);
        parts.push(`<text x="${left - 10}" y="${lineY + 4}" text-anchor="end" class="chart-label">${moneyFormat.format(value)}</text>`);
      }

      results.forEach((result, index) => {
        parts.push(`<text x="${x(index)}" y="246" text-anchor="middle" class="chart-year">${String(result.row.year).slice(2)}</text>`);
      });
      let run = [];
      const finishRun = () => {
        if (run.length > 0) parts.push(`<polyline points="${run.join(" ")}" class="chart-line" />`);
        run = [];
      };
      results.forEach((result, index) => {
        if (result.available) run.push(`${x(index)},${y(result.perStudent)}`);
        else finishRun();
      });
      finishRun();

      results.forEach((result, index) => {
        if (!result.available) return;
        const pointX = x(index);
        const pointY = y(result.perStudent);
        const tooltipWidth = 244;
        const tooltipHeight = 62;
        const tooltipX = Math.max(0, Math.min(pointX - tooltipWidth / 2, 760 - tooltipWidth));
        const tooltipY = pointY >= 82 ? pointY - 74 : pointY + 14;
        const accessibleLabel = `FY${result.row.year}: ${moneyFormat.format(result.perStudent)} aid per student`;
        parts.push(`
          <g class="chart-point-group" tabindex="0" role="img" aria-label="${accessibleLabel}">
            <circle cx="${pointX}" cy="${pointY}" r="15" class="chart-hit-area" />
            <circle cx="${pointX}" cy="${pointY}" r="4" class="chart-point" />
            <g class="chart-tooltip" transform="translate(${tooltipX} ${tooltipY})" aria-hidden="true">
              <rect width="${tooltipWidth}" height="${tooltipHeight}" rx="7" />
              <text x="14" y="24" class="chart-tooltip-year">FY${result.row.year}</text>
              <text x="14" y="48" class="chart-tooltip-value">${moneyFormat.format(result.perStudent)} aid per student</text>
            </g>
          </g>
        `);
      });
      parts.push(`<text x="${left}" y="265" class="chart-axis-title">Fiscal year 20—</text>`);
      svg.innerHTML = parts.join("");
    }

    function updateTrendTable(results) {
      const tableBody = explorer.querySelector("[data-trend-table]");
      if (!(tableBody instanceof HTMLElement)) return;
      tableBody.replaceChildren();
      results.forEach((result) => {
        const row = document.createElement("tr");
        const yearCell = document.createElement("td");
        yearCell.textContent = `FY${result.row.year}`;

        const totalCell = document.createElement("td");
        totalCell.className = "numeric";
        totalCell.textContent = result.fundingKeys.length > 0 && result.fundingKeys.every((key) => typeof result.row[key] === "number")
          ? `$${result.totalMillions.toFixed(1)}m`
          : "—";
        const studentCell = document.createElement("td");
        studentCell.className = "numeric";
        studentCell.textContent = result.studentKeys.length > 0 && result.studentKeys.every((key) => typeof result.row[key] === "number")
          ? numberFormat.format(result.students)
          : "—";
        const perCell = document.createElement("td");
        perCell.className = "numeric result-cell";
        perCell.textContent = result.available ? moneyFormat.format(result.perStudent) : "—";
        const coverageCell = document.createElement("td");
        coverageCell.textContent = result.available
          ? "Complete"
          : result.missing.length > 0
            ? `Missing: ${result.missing.join(", ")}`
            : result.studentKeys.length > 0 && result.students === 0
              ? "Program not operating / zero membership"
              : "Selection incomplete";
        row.append(yearCell, totalCell, studentCell, perCell, coverageCell);
        tableBody.append(row);
      });
    }

    function updatePresetState() {
      const measure = selectedDistrictMeasure();
      const funding = new Set(selectedFundingKeys());
      const students = new Set(selectedStudentKeys());
      const automatic = autoMatch instanceof HTMLInputElement && autoMatch.checked;
      const matches = {
        "all-programs": automatic && measure === "districtGrant" && funding.size === 4 && !funding.has("swept") && funding.has("charterDirect") && funding.has("charterSped") && funding.has("efaPayments"),
        "district-only": automatic && measure === "districtGrant" && funding.size === 1 && students.size === 1 && students.has("districtAdm"),
        "with-swept": automatic && measure === "districtGrant" && funding.size === 2 && funding.has("swept") && students.size === 1 && students.has("districtAdm"),
        "calculated-cost": automatic && measure === "calculatedCost" && funding.size === 1 && students.size === 1 && students.has("districtAdm"),
      };
      presetButtons.forEach((button) => {
        if (button instanceof HTMLButtonElement) button.setAttribute("aria-pressed", matches[button.dataset.preset] ? "true" : "false");
      });
    }

    function render() {
      updateDistrictAddonControl();
      syncStudentPopulation();
      updateStudentControls();
      const results = rows.map(calculate);
      updateFormula();
      updateSpendChart(results);
      updateChart(results);
      updateTrendTable(results);
      updatePresetState();
    }

    function applyPreset(name) {
      setCheckbox("swept", name === "with-swept", "funding");
      setCheckbox("charterDirect", name === "all-programs", "funding");
      setCheckbox("charterSped", name === "all-programs", "funding");
      setCheckbox("efaPayments", name === "all-programs", "funding");
      setDistrictMeasure(name === "calculated-cost" ? "calculatedCost" : "districtGrant");
      if (districtAddons instanceof HTMLInputElement) districtAddons.checked = true;
      if (autoMatch instanceof HTMLInputElement) autoMatch.checked = true;
      render();
    }

    [...fundingInputs, ...districtInputs].forEach((input) => input.addEventListener("change", render));
    if (districtAddons) districtAddons.addEventListener("change", render);
    if (autoMatch) autoMatch.addEventListener("change", render);
    studentInputs.forEach((input) => input.addEventListener("change", render));
    presetButtons.forEach((button) => button.addEventListener("click", () => applyPreset(button.dataset.preset)));

    render();
  }
</script>

