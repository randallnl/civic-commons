.shell { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
.section { padding: 76px 0; }
h1, h2, h3, p { margin-top: 0; }
h1 {
  max-width: 880px;
  margin-bottom: 24px;
  font-size: clamp(3rem, 7vw, 6.3rem);
  line-height: .94;
  letter-spacing: -.065em;
}
h2 { margin-bottom: 10px; font-size: clamp(2rem, 4vw, 3.35rem); line-height: 1; letter-spacing: -.045em; }
h3 { margin-bottom: 8px; font-size: 1.18rem; line-height: 1.25; }

.education-report-hero {
  position: relative;
  padding: 94px 0 76px;
  color: var(--white);
  background:
    radial-gradient(circle at 86% 12%, rgba(198,149,46,.28), transparent 30%),
    linear-gradient(128deg, #0c2939 0%, #163d4e 67%, #1c4e55 100%);
}
.education-report-hero::after {
  content: "";
  position: absolute;
  right: -120px;
  bottom: -170px;
  width: 470px;
  height: 470px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 50%;
  box-shadow: 0 0 0 48px rgba(255,255,255,.03), 0 0 0 96px rgba(255,255,255,.02);
}
.hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0,1fr) 310px; gap: 56px; align-items: end; }
.eyebrow, .verdict-label, .section-number, .formula-year, .finding-card > span, .impact-grid span, .download-panel span, .source-list span {
  font-family: "Courier New", monospace;
  font-size: .73rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.eyebrow { margin-bottom: 16px; color: var(--gold); }
.dek { max-width: 820px; margin-bottom: 24px; color: rgba(255,253,248,.82); font-size: clamp(1.08rem,2vw,1.35rem); }
.jump-links { display: flex; flex-wrap: wrap; gap: 10px; }
.jump-links a { padding: 8px 12px; border: 1px solid rgba(255,255,255,.28); color: rgba(255,253,248,.86); font-size: .78rem; text-decoration: none; }
.jump-links a:hover, .jump-links a:focus-visible { background: var(--white); color: var(--ink); }
.hero-verdict { padding: 25px; border-top: 5px solid var(--gold); background: rgba(255,255,255,.1); backdrop-filter: blur(8px); }
.hero-verdict span, .hero-verdict strong { display: block; }
.hero-verdict strong { margin: 9px 0 11px; font-size: 1.32rem; line-height: 1.25; }
.hero-verdict > span:last-child { color: rgba(255,253,248,.72); font-size: .9rem; }
.verdict-label { color: var(--gold); }
.hero-verdict ol { margin: 14px 0 16px; padding-left: 22px; }
.hero-verdict li { margin: 5px 0; font-weight: 700; }

.explorer-band { color: var(--white); background: #0f3343; border-top: 1px solid rgba(255,255,255,.12); }
.explorer-heading { margin-bottom: 24px; }
.preset-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 18px; }
.preset-row > span { margin-right: 4px; color: rgba(255,253,248,.68); font-family: "Courier New", monospace; font-size: .7rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
.preset-row button { padding: 9px 12px; border: 1px solid rgba(255,255,255,.28); border-radius: 0; background: transparent; color: var(--white); cursor: pointer; font: inherit; font-size: .75rem; }
.preset-row button:hover, .preset-row button:focus-visible { border-color: var(--gold); }
.preset-row button[aria-pressed="true"] { border-color: var(--gold); background: var(--gold); color: #182c32; font-weight: 700; }
.explorer-layout { display: grid; grid-template-columns: minmax(320px,390px) minmax(0,1fr); gap: 18px; align-items: start; }
.explorer-controls { color: var(--ink); background: var(--paper); border: 1px solid rgba(255,255,255,.18); }
.control-intro { display: grid; gap: 7px; padding: 20px; background: var(--gold-soft); border-bottom: 1px solid var(--line); }
.control-intro label { font-weight: 700; }
.control-intro select { width: 100%; padding: 11px 38px 11px 12px; border: 1px solid #9f927e; border-radius: 0; background: var(--white); color: var(--ink); font: inherit; font-weight: 700; }
.control-intro small, .choice-row small, .auto-match small { color: var(--ink-2); font-size: .72rem; }
.explorer-controls fieldset { margin: 0; padding: 19px 20px 20px; border: 0; border-bottom: 1px solid var(--line); }
.explorer-controls fieldset:last-child { border-bottom: 0; }
.explorer-controls legend { width: 100%; padding: 0 0 11px; font-weight: 700; }
.explorer-controls legend span { display: inline-grid; place-items: center; width: 25px; height: 25px; margin-right: 7px; border-radius: 50%; background: var(--ink); color: var(--white); font-family: "Courier New", monospace; font-size: .7rem; }
.choice-row, .auto-match { display: grid; grid-template-columns: 18px minmax(0,1fr); gap: 10px; align-items: start; padding: 8px 0; cursor: pointer; }
.choice-row input, .auto-match input, .student-choices input { width: 16px; height: 16px; margin: 3px 0 0; accent-color: var(--green); }
.choice-row strong, .choice-row small, .auto-match strong, .auto-match small { display: block; }
.student-choices { display: grid; grid-template-columns: 1fr; gap: 6px; margin: 8px 0 0 28px; }
.student-choices label { display: flex; gap: 8px; align-items: center; font-size: .8rem; }
.student-choices input:disabled { opacity: .72; }
.manual-note { margin: 11px 0 0 28px; color: var(--ink-2); font-size: .69rem; }
.explorer-output { display: grid; gap: 14px; }
.result-status { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; padding: 11px 15px; border-left: 5px solid; font-size: .78rem; }
.result-status.complete { border-color: #65c0a7; background: rgba(73,167,142,.16); }
.result-status.unavailable { border-color: #e2b75b; background: rgba(198,149,46,.16); }
.result-status :global(strong) { font-size: .82rem; }
.result-status :global(span) { color: rgba(255,253,248,.72); }
.result-metrics { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1px; background: rgba(255,255,255,.18); }
.result-metrics article { min-height: 124px; padding: 20px; background: #173f4f; }
.result-metrics span, .formula-card > div > span, .trend-card figcaption span { display: block; color: rgba(255,253,248,.62); font-family: "Courier New", monospace; font-size: .66rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
.result-metrics strong { display: block; margin-top: 14px; color: var(--white); font-size: clamp(1.35rem,2.3vw,2rem); line-height: 1; letter-spacing: -.04em; }
.result-metrics .primary-result { background: var(--green); }
.result-metrics .primary-result span { color: rgba(255,255,255,.74); }
.result-metrics .primary-result strong { color: var(--white); }
.formula-card { padding: 18px 20px; background: #092735; border-left: 4px solid var(--gold); }
.formula-card > div { display: flex; justify-content: space-between; gap: 14px; align-items: center; }
.formula-card a { color: var(--gold-soft); font-size: .72rem; }
.formula-card p { margin: 11px 0 0; color: var(--white); font-family: "Courier New", monospace; font-size: .8rem; line-height: 1.65; overflow-wrap: anywhere; }
.breakdown-card { padding: 20px; background: var(--white); color: var(--ink); }
.breakdown-card h3 { font-size: .98rem; }
.breakdown-bar { display: flex; min-height: 16px; margin: 13px 0 12px; background: var(--paper-2); overflow: hidden; }
.breakdown-bar :global(span) { min-width: 2px; }
.breakdown-card ul { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 20px; margin: 0; padding: 0; list-style: none; }
.breakdown-card :global(li) { display: flex; justify-content: space-between; gap: 12px; color: var(--ink-2); font-size: .72rem; }
.breakdown-card :global(li > span) { display: flex; gap: 7px; align-items: center; }
.breakdown-card :global(li i) { flex: 0 0 auto; width: 9px; height: 9px; }
.breakdown-card :global(li strong) { color: var(--ink); white-space: nowrap; }
.breakdown-card :global(.missing-component strong) { color: var(--red); }
.trend-card { margin: 0; padding: 20px 20px 12px; background: var(--white); color: var(--ink); }
.trend-card figcaption { display: flex; justify-content: space-between; gap: 20px; align-items: end; }
.trend-card figcaption span { color: var(--red); }
.trend-card figcaption strong { display: block; margin-top: 4px; font-size: 1.05rem; }
.trend-card figcaption small { max-width: 260px; color: var(--ink-2); font-size: .7rem; text-align: right; }
.trend-card svg { display: block; width: 100%; height: auto; min-height: 220px; margin-top: 6px; overflow: visible; }
.trend-card :global(.chart-grid) { stroke: #ddd5c7; stroke-width: 1; }
.trend-card :global(.chart-line) { fill: none; stroke: var(--green); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
.trend-card :global(.chart-point) { fill: var(--white); stroke: var(--green); stroke-width: 3; }
.trend-card :global(.chart-point.selected) { fill: var(--gold); stroke: var(--ink); }
.trend-card :global(.chart-selected-line) { stroke: var(--gold); stroke-width: 1; stroke-dasharray: 4 4; }
.trend-card :global(.chart-label), .trend-card :global(.chart-year), .trend-card :global(.chart-axis-title), .trend-card :global(.chart-empty) { fill: #536d78; font-family: "Courier New", monospace; font-size: 11px; }
.trend-card :global(.chart-axis-title) { font-size: 9px; }
.trend-card :global(.chart-empty) { font-size: 14px; }
.trend-table-details { margin-top: 18px; color: var(--ink); background: var(--white); }
.trend-table-details summary { padding: 15px 18px; cursor: pointer; color: var(--green); font-weight: 700; }
.explorer-table :global(td) { padding: 11px 14px; border-bottom: 1px solid var(--line); color: var(--ink); font-size: .78rem; }
.explorer-table :global(tr:last-child td) { border-bottom: 0; }
.explorer-table :global(.selected-year-row) { background: var(--gold-soft); }
.explorer-table :global(button) { padding: 0; border: 0; background: transparent; color: var(--green); cursor: pointer; font: inherit; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
.explorer-table :global(.numeric) { text-align: right; font-variant-numeric: tabular-nums; }
.explorer-table :global(.result-cell) { color: var(--green); font-weight: 700; }

.glossary-section { scroll-margin-top: 20px; }
.glossary-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; }
.glossary-grid article { padding: 24px; background: var(--white); border: 1px solid var(--line); border-top: 4px solid var(--green); }
.glossary-grid span { color: var(--red); font-family: "Courier New", monospace; font-size: .68rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
.glossary-grid h3 { margin-top: 10px; }
.glossary-grid p { margin-bottom: 0; color: var(--ink-2); font-size: .84rem; }
.definition-caution { margin-top: 18px; padding: 21px 24px; background: var(--gold-soft); border-left: 5px solid var(--gold); }
.definition-caution strong { display: block; }
.definition-caution p { margin: 4px 0 0; color: #62450e; font-size: .86rem; }

.section-heading { display: grid; grid-template-columns: 52px minmax(0,1fr); gap: 20px; max-width: 930px; margin-bottom: 38px; }
.section-heading p:not(.section-number) { max-width: 790px; margin-bottom: 0; color: var(--ink-2); font-size: 1.05rem; }
.section-number { margin: 4px 0 0; color: var(--red); }
.light-heading { color: var(--white); }
.light-heading .section-number { color: var(--gold); }
.light-heading p:not(.section-number) { color: rgba(255,253,248,.7); }

.finding-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
