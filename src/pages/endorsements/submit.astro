---
export const prerender = false;

import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import {
  candidateName,
  candidateSlug,
  getLegislativeCandidates,
} from "../../lib/candidatesApi";
import { getOrganizations } from "../../lib/organizationsApi";
import { cleanText } from "../../lib/text";

const submitted = Astro.url.searchParams.get("submitted") === "1";
const error = Astro.url.searchParams.get("error") || "";
const requestedCandidate = Astro.url.searchParams.get("candidate") || "";
let candidates = [];
let organizations = [];

try {
  candidates = await getLegislativeCandidates({ electionYear: 2026 });
} catch (error) {
  console.error(error?.message || "Unable to load candidate selector.");
}

try {
  organizations = await getOrganizations();
} catch (error) {
  console.error(error?.message || "Unable to load organization selector.");
}

const candidateOptions = candidates.map((candidate) => {
  const slug = candidateSlug(candidate);
  const name = candidateName(candidate);
  const officeParts = [
    candidate.office,
    candidate.county,
    candidate.district ? `District ${candidate.district}` : "",
  ].filter(Boolean);
  const label = [name, officeParts.join(" - ")].filter(Boolean).join(" | ");

  return {
    label,
    value: label,
    name,
    slug,
    office: candidate.office || "",
    district: [candidate.county, candidate.district ? `District ${candidate.district}` : ""]
      .filter(Boolean)
      .join(", "),
    electionYear: String(candidate.electionYear || 2026),
  };
});

const selectedOption = candidateOptions.find((option) =>
  [option.slug, option.name, option.label]
    .map((value) => String(value || "").toLowerCase())
    .includes(String(requestedCandidate || "").toLowerCase()),
);

const organizationOptions = organizations.map((organization) => ({
  name: organization.name,
  value: organization.name,
  slug: organization.slug,
  website: organization.website || "",
  email: organization.email || "",
  type: organization.type || "Organization",
})).sort((first, second) => first.name.localeCompare(second.name));
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Submit an Endorsement | NH Deserves Better</title>
  </head>

  <body>
    <TopNav />
    <main class="page">
      <a class="back" href={selectedOption ? `/candidates/${selectedOption.slug}` : "/candidates"}>
        Back to candidates
      </a>

      <section class="hero">
        <p class="eyebrow">Community Submissions</p>
        <h1>Share an organization endorsement.</h1>
        <p class="lede">
          Submit endorsements from advocacy organizations, unions, community
          groups, or other public organizations. Submissions are reviewed before
          they appear on candidate profiles. Choose from an existing organization
          profile first so endorsements stay connected to the right organization page.
        </p>
      </section>

      {submitted && (
        <p class="status-message success">
          Thanks. The endorsement was submitted for review.
        </p>
      )}
      {error && <p class="status-message error">{cleanText(error)}</p>}

      <section class="panel">
        <form class="endorsement-form" action="/api/endorsements/submit" method="post" enctype="multipart/form-data">
          <input type="hidden" name="redirectTo" value="/endorsements/submit" />
          <input id="organizationSlug" type="hidden" name="organizationSlug" value="" />
          <input id="candidateSlug" type="hidden" name="candidateSlug" value={selectedOption?.slug || ""} />
          <input id="candidateName" type="hidden" name="candidateName" value={selectedOption?.name || ""} />
          <input id="candidateOffice" type="hidden" name="office" value={selectedOption?.office || ""} />
          <input id="candidateDistrict" type="hidden" name="district" value={selectedOption?.district || ""} />
          <input id="candidateElectionYear" type="hidden" name="electionYear" value={selectedOption?.electionYear || "2026"} />

          <div class="form-grid two">
            <label>
              Organization name
              <input
                id="organizationSearch"
                name="organizationName"
                list="organizationOptions"
                placeholder="Start typing an existing organization"
                autocomplete="off"
                required
              />
              <datalist id="organizationOptions">
                {organizationOptions.map((option) => (
                  <option value={option.value} label={[option.type, option.website].filter(Boolean).join(" | ")} />
                ))}
              </datalist>
            </label>
            <label>
              Organization website
              <input id="organizationWebsite" name="organizationWebsite" type="url" placeholder="https://example.org" />
            </label>
          </div>

          <p class="form-note">
            Organization profiles need to be created before endorsements can be entered.
            If the organization is not listed yet, <a href="/suggest-update">suggest an organization profile</a>
            before submitting the endorsement.
          </p>

          <label>
            Candidate
            <input
              id="candidateSearch"
              list="candidateOptions"
              value={selectedOption?.label || ""}
              placeholder="Start typing a candidate name"
              autocomplete="off"
              required
            />
            <datalist id="candidateOptions">
              {candidateOptions.map((option) => (
                <option value={option.value} />
              ))}
            </datalist>
          </label>

          <div class="form-grid three">
            <label>
              Position
              <select name="position">
                <option value="Endorsed">Endorsed</option>
                <option value="Recommended">Recommended</option>
                <option value="Opposed">Opposed</option>
                <option value="Supported">Supported</option>
              </select>
            </label>
            <label>
              Endorsement date
              <input name="date" type="date" />
            </label>
            <label>
              Organization contact email
              <input id="organizationEmail" name="organizationEmail" type="email" />
            </label>
          </div>

          <label>
            Notes or endorsement text
            <textarea name="statement" rows="5" placeholder="Paste the endorsement language or explain where it was published."></textarea>
          </label>

          <label>
            Endorsement image <span>Optional</span>
            <input name="photo" type="file" accept="image/*" />
          </label>

          <div class="form-grid two">
            <label>
              Your name
              <input name="submitterName" />
            </label>
            <label>
              Your email
              <input name="submitterEmail" type="email" />
            </label>
          </div>

          <button type="submit">Submit for Review</button>
        </form>
      </section>
    </main>

    <script define:vars={{ candidateOptions, organizationOptions }}>
      const candidateSearch = document.getElementById("candidateSearch");
      const organizationSearch = document.getElementById("organizationSearch");
      const fields = {
        slug: document.getElementById("candidateSlug"),
        name: document.getElementById("candidateName"),
        office: document.getElementById("candidateOffice"),
        district: document.getElementById("candidateDistrict"),
        electionYear: document.getElementById("candidateElectionYear"),
      };
      const organizationFields = {
        slug: document.getElementById("organizationSlug"),
        website: document.getElementById("organizationWebsite"),
        email: document.getElementById("organizationEmail"),
      };
      const optionMap = new Map(candidateOptions.map((option) => [option.value, option]));
      const organizationMap = new Map(organizationOptions.map((option) => [option.value, option]));

      function syncCandidate() {
        const selected = optionMap.get(candidateSearch?.value || "");
        fields.slug.value = selected?.slug || "";
        fields.name.value = selected?.name || "";
        fields.office.value = selected?.office || "";
        fields.district.value = selected?.district || "";
        fields.electionYear.value = selected?.electionYear || "2026";
      }

      function syncOrganization() {
        const selected = organizationMap.get(organizationSearch?.value || "");
        organizationFields.slug.value = selected?.slug || "";

        if (selected?.website) {
          organizationFields.website.value = selected.website;
        }
        if (selected?.email) {
          organizationFields.email.value = selected.email;
        }
      }

      candidateSearch?.addEventListener("input", syncCandidate);
      organizationSearch?.addEventListener("input", syncOrganization);
      candidateSearch?.form?.addEventListener("submit", syncCandidate);
      organizationSearch?.form?.addEventListener("submit", syncOrganization);
    </script>
    <SiteFooter />
  </body>
</html>

<style>
  .back,
  a {
    color: #1f2933;
    font-weight: 850;
  }

  .hero {
    padding: 42px 0 28px;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.2rem, 5.5vw, 4.15rem);
    line-height: 0.95;
    margin: 0;
  }

  .lede {
    color: #4b5563;
    font-size: clamp(1.08rem, 2vw, 1.28rem);
    font-weight: 750;
    line-height: 1.5;
    margin: 20px 0 0;
    max-width: 780px;
  }

  .panel,
  .status-message {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: none;
    padding: clamp(20px, 4vw, 28px);
  }

  .status-message.success {
    background: #ecfdf5;
    color: #065f46;
  }

  .status-message.error {
    background: #fef2f2;
    color: #991b1b;
  }

  .endorsement-form,
  label {
    display: grid;
    gap: 8px;
  }

  .endorsement-form {
    gap: 16px;
  }

  .form-note {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    color: #1e3a8a;
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1.45;
    margin: -4px 0 0;
    padding: 12px 14px;
  }

  .form-note a {
    color: #1d4ed8;
  }

  label {
    color: #374151;
    font-size: 0.86rem;
    font-weight: 900;
  }

  input,
  select,
  textarea {
    border: 1px solid #9ca3af;
    border-radius: 10px;
    color: #1f2933;
    font: inherit;
    font-weight: 650;
    padding: 11px 12px;
  }

  textarea {
    line-height: 1.45;
  }

  .form-grid {
    display: grid;
    gap: 14px;
  }

  .form-grid.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .form-grid.three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  button {
    background: #1f2933;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    color: white;
    cursor: pointer;
    font: inherit;
    font-weight: 950;
    justify-self: start;
    padding: 12px 18px;
  }

  @media (max-width: 760px) {
    .form-grid.two,
    .form-grid.three {
      grid-template-columns: 1fr;
    }
  }
</style>
