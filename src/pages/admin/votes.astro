---
export const prerender = false;

import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import {
  adminDb,
  canUseSourceDataTools,
  currentAdminSession,
} from "../../lib/adminAuth";
import { cleanText } from "../../lib/text";
import {
  defaultVoteVisibility,
  ensureVoteVisibilityTable,
  voteVisibilityCaseExpression,
} from "../../lib/voteVisibility";

const session = await currentAdminSession(Astro.request);
const canReviewVotes = session ? canUseSourceDataTools(session) : false;
const message = Astro.url.searchParams.get("message") || "";
const error = Astro.url.searchParams.get("error") || "";
const filters = {
  q: Astro.url.searchParams.get("q")?.trim() || "",
  year: Astro.url.searchParams.get("year")?.trim() || "2026",
  body: Astro.url.searchParams.get("body")?.trim().toUpperCase() || "",
  visibility: Astro.url.searchParams.get("visibility")?.trim() || "",
};

let votes = [];
let summary = { total: 0, shown: 0, graded: 0, overridden: 0 };
let loadError = "";

if (session && canReviewVotes) {
  try {
    const db = adminDb();
    await ensureVoteVisibilityTable(db);
    await ensureBillOverrideTable(db);
    votes = await getVoteRows(db, filters);
    summary = await getVoteSummary(db, filters.year);
  } catch (error) {
    loadError = error?.message || "Unable to load vote data.";
  }
}

function bodyLabel(value = "") {
  if (value === "H") return "House";
  if (value === "S") return "Senate";
  return value || "Unknown";
}

function formatDate(value = "") {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

function visibilityLabel(row = {}) {
  if (!row.include_in_display) return "Hidden";
  if (!row.include_in_grades) return "Shown, not graded";
  return "Shown and graded";
}

function visibilityClass(row = {}) {
  if (!row.include_in_display) return "hidden";
  if (!row.include_in_grades) return "not-graded";
  return "graded";
}

function actionText(row = {}) {
  return cleanText(row.question_motion || row.title1 || row.title2 || "Motion not listed");
}

async function getVoteRows(db, filters) {
  const where = [];
  const binds = [];
  const actionExpression = `COALESCE(
    NULLIF(TRIM(rs.question_motion), ''),
    NULLIF(TRIM(rs.title1), ''),
    NULLIF(TRIM(rs.title2), '')
  )`;
  const defaultVisibility = voteVisibilityCaseExpression(actionExpression);

  if (filters.year) {
    where.push("rs.sessionyear = ?");
    binds.push(Number(filters.year));
  }

  if (filters.body) {
    where.push("rs.legislativebody = ?");
    binds.push(filters.body);
  }

  if (filters.q) {
    where.push(`(
      UPPER(rs.condensedbillno) LIKE ?
      OR UPPER(COALESCE(rs.question_motion, '')) LIKE ?
      OR UPPER(COALESCE(rs.title1, '')) LIKE ?
      OR UPPER(COALESCE(rs.title2, '')) LIKE ?
      OR UPPER(COALESCE(bo.title, b.description, '')) LIKE ?
    )`);
    const q = `%${filters.q.toUpperCase()}%`;
    binds.push(q, q, q, q, q);
  }

  if (filters.visibility === "hidden") {
    where.push(`COALESCE(vvo.include_in_display, ${defaultVisibility}) = 0`);
  } else if (filters.visibility === "not-graded") {
    where.push(`COALESCE(vvo.include_in_display, ${defaultVisibility}) = 1`);
    where.push(`COALESCE(vvo.include_in_grades, ${defaultVisibility}) = 0`);
  } else if (filters.visibility === "graded") {
    where.push(`COALESCE(vvo.include_in_display, ${defaultVisibility}) = 1`);
    where.push(`COALESCE(vvo.include_in_grades, ${defaultVisibility}) = 1`);
  } else if (filters.visibility === "overridden") {
    where.push("vvo.updated_at IS NOT NULL");
  }

  const sql = `
    SELECT
      rs.sessionyear,
      rs.legislativebody,
      rs.votesequencenumber,
      rs.condensedbillno,
      rs.votedate,
      rs.question_motion,
      rs.title1,
      rs.title2,
      rs.yeas,
      rs.nays,
      rs.present,
      rs.absent,
      COALESCE(NULLIF(bo.title, ''), NULLIF(b.description, ''), '') AS bill_title,
      COALESCE(vvo.include_in_display, ${defaultVisibility}) AS include_in_display,
      COALESCE(vvo.include_in_grades, ${defaultVisibility}) AS include_in_grades,
      vvo.notes,
      vvo.updated_by,
      vvo.updated_at
    FROM d1_rollcallsummary rs
    LEFT JOIN d1_bills b
      ON b.sessionyear = rs.sessionyear
      AND UPPER(b.condensedbillno) = UPPER(rs.condensedbillno)
      AND b.legislativebody = rs.legislativebody
    LEFT JOIN d1_bill_overrides bo
      ON bo.sessionyear = rs.sessionyear
      AND UPPER(bo.condensedbillno) = UPPER(rs.condensedbillno)
    LEFT JOIN d1_vote_visibility_overrides vvo
      ON vvo.sessionyear = rs.sessionyear
      AND vvo.legislativebody = rs.legislativebody
      AND vvo.votesequencenumber = rs.votesequencenumber
      AND UPPER(vvo.condensedbillno) = UPPER(rs.condensedbillno)
    ${where.length ? `WHERE ${where.join(" AND ")}` : ""}
    ORDER BY rs.sessionyear DESC, rs.votedate DESC, rs.votesequencenumber DESC
    LIMIT 250
  `;

  const result = await db.prepare(sql).bind(...binds).all();
  return (result.results || []).map((row) => {
    const defaults = defaultVoteVisibility(row);
    return {
      ...row,
      include_in_display: Number(row.include_in_display ?? defaults.includeInDisplay),
      include_in_grades: Number(row.include_in_grades ?? defaults.includeInGrades),
      default_reason: defaults.reason,
    };
  });
}

async function ensureBillOverrideTable(db) {
  await db
    .prepare(
      `CREATE TABLE IF NOT EXISTS d1_bill_overrides (
        sessionyear INTEGER NOT NULL,
        condensedbillno TEXT NOT NULL,
        title TEXT,
        summary TEXT,
        description TEXT,
        updated_by TEXT,
        updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
        PRIMARY KEY (sessionyear, condensedbillno)
      )`,
    )
    .run();
}

async function getVoteSummary(db, year) {
  const yearFilter = year ? "WHERE rs.sessionyear = ?" : "";
  const binds = year ? [Number(year)] : [];
  const actionExpression = `COALESCE(
    NULLIF(TRIM(rs.question_motion), ''),
    NULLIF(TRIM(rs.title1), ''),
    NULLIF(TRIM(rs.title2), '')
  )`;
  const defaultVisibility = voteVisibilityCaseExpression(actionExpression);
  const result = await db
    .prepare(
      `SELECT
        COUNT(*) AS total,
        SUM(CASE WHEN COALESCE(vvo.include_in_display, ${defaultVisibility}) = 1 THEN 1 ELSE 0 END) AS shown,
        SUM(CASE WHEN COALESCE(vvo.include_in_grades, ${defaultVisibility}) = 1 THEN 1 ELSE 0 END) AS graded,
        SUM(CASE WHEN vvo.updated_at IS NOT NULL THEN 1 ELSE 0 END) AS overridden
      FROM d1_rollcallsummary rs
      LEFT JOIN d1_vote_visibility_overrides vvo
        ON vvo.sessionyear = rs.sessionyear
        AND vvo.legislativebody = rs.legislativebody
        AND vvo.votesequencenumber = rs.votesequencenumber
        AND UPPER(vvo.condensedbillno) = UPPER(rs.condensedbillno)
      ${yearFilter}`,
    )
    .bind(...binds)
    .first();

  return {
    total: Number(result?.total || 0),
    shown: Number(result?.shown || 0),
    graded: Number(result?.graded || 0),
    overridden: Number(result?.overridden || 0),
  };
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vote Review | NH Deserves Better Admin</title>
    <meta
      name="description"
      content="Admin tool for reviewing roll-call vote visibility and grade calculation settings."
    />
  </head>
  <body>
    <TopNav activePath="/admin" />
    <main class="admin-votes-page">
      {!session ? (
        <section class="panel login-panel">
          <p class="eyebrow">Admin</p>
          <h1>Sign in required</h1>
          <p>Use the admin login to review vote visibility settings.</p>
          <a href="/admin">Go to admin login</a>
        </section>
      ) : !canReviewVotes ? (
        <section class="panel login-panel">
          <p class="eyebrow">Admin</p>
          <h1>Source data access required</h1>
          <p>Your admin role cannot change vote visibility settings.</p>
          <a href="/admin">Back to admin</a>
        </section>
      ) : (
        <>
          <section class="vote-hero panel">
            <div>
              <p class="eyebrow">Vote Data</p>
              <h1>Review roll-call visibility</h1>
              <p>
                Decide which roll-call actions are shown on profiles and which
                actions count toward legislator grade calculations. Procedural
                motions like Adopt Amendment and Special Order default to
                hidden and excluded.
              </p>
            </div>
            <a href="/admin/data">Back to data tools</a>
          </section>

          {(message || error || loadError) && (
            <p class:list={["notice", error || loadError ? "error" : "success"]}>
              {error || loadError || message}
            </p>
          )}

          <section class="summary-grid" aria-label="Vote review summary">
            <span><strong>{summary.total}</strong> Roll calls</span>
            <span><strong>{summary.shown}</strong> Shown</span>
            <span><strong>{summary.graded}</strong> Used for grades</span>
            <span><strong>{summary.overridden}</strong> Manually set</span>
          </section>

          <section class="panel grade-cache-panel">
            <div>
              <p class="eyebrow">Grade Cache</p>
              <h2>Refresh stored legislator grades</h2>
              <p>
                Rebuild cached online-testimony grades after vote imports,
                testimony updates, or methodology changes.
              </p>
            </div>
            <form
              action="/api/admin/grades"
              method="post"
              hx-post="/api/admin/grades"
              hx-target="find .grade-cache-status"
              hx-swap="innerHTML"
            >
              <input type="hidden" name="scope" value="all" />
              <input type="hidden" name="limit" value="500" />
              <button type="submit">Rebuild all grades</button>
              <span class="grade-cache-status" aria-live="polite"></span>
            </form>
          </section>

          <section class="panel filter-panel">
            <form class="vote-filter-form" method="get">
              <label>
                Search
                <input name="q" value={filters.q} placeholder="HB155, ITL, motion text..." />
              </label>
              <label>
                Year
                <input name="year" type="number" value={filters.year} />
              </label>
              <label>
                Body
                <select name="body">
                  <option value="">All</option>
                  <option value="H" selected={filters.body === "H"}>House</option>
                  <option value="S" selected={filters.body === "S"}>Senate</option>
                </select>
              </label>
              <label>
                Status
                <select name="visibility">
                  <option value="">All</option>
                  <option value="graded" selected={filters.visibility === "graded"}>Shown and graded</option>
                  <option value="not-graded" selected={filters.visibility === "not-graded"}>Shown, not graded</option>
                  <option value="hidden" selected={filters.visibility === "hidden"}>Hidden</option>
                  <option value="overridden" selected={filters.visibility === "overridden"}>Manually set</option>
                </select>
              </label>
              <button type="submit">Filter</button>
            </form>
          </section>

          <section class="vote-list" aria-label="Roll-call votes">
            {votes.length ? (
              votes.map((vote) => (
                <article class="vote-row panel">
                  <div class="vote-main">
                    <div class="vote-title-line">
                      <a href={`/bills/${vote.condensedbillno}?year=${vote.sessionyear}`}>
                        {vote.condensedbillno}
                      </a>
                      <span>{vote.sessionyear}</span>
                      <span>{bodyLabel(vote.legislativebody)}</span>
                      <span>Roll call {vote.votesequencenumber}</span>
                    </div>
                    <h2>{actionText(vote)}</h2>
                    {vote.bill_title && <p>{cleanText(vote.bill_title)}</p>}
                    <div class="vote-meta">
                      {vote.votedate && <span>{formatDate(vote.votedate)}</span>}
                      <span>{vote.yeas || 0} Yea</span>
                      <span>{vote.nays || 0} Nay</span>
                      <span>{vote.present || 0} Present</span>
                      <span>{vote.absent || 0} Absent</span>
                      <span>{vote.default_reason}</span>
                    </div>
                  </div>

                  <form
                    class="visibility-form"
                    action="/api/admin/vote-visibility"
                    method="post"
                    hx-post="/api/admin/vote-visibility"
                    hx-target="find .vote-save-status"
                    hx-swap="innerHTML"
                  >
                    <input type="hidden" name="sessionyear" value={vote.sessionyear} />
                    <input type="hidden" name="legislativebody" value={vote.legislativebody} />
                    <input type="hidden" name="votesequencenumber" value={vote.votesequencenumber} />
                    <input type="hidden" name="condensedbillno" value={vote.condensedbillno} />
                    <input type="hidden" name="includeInDisplay" value="0" />
                    <input type="hidden" name="includeInGrades" value="0" />

                    <span class:list={["visibility-pill", visibilityClass(vote)]}>
                      {visibilityLabel(vote)}
                    </span>

                    <label class="toggle-line">
                      <input
                        type="checkbox"
                        name="includeInDisplay"
                        value="1"
                        checked={Boolean(vote.include_in_display)}
                      />
                      Show on profiles
                    </label>
                    <label class="toggle-line">
                      <input
                        type="checkbox"
                        name="includeInGrades"
                        value="1"
                        checked={Boolean(vote.include_in_grades)}
                      />
                      Use for grades
                    </label>
                    <label>
                      Notes
                      <input name="notes" value={vote.notes || ""} placeholder="Optional internal note" />
                    </label>
                    <button type="submit">Save</button>
                    <span class="vote-save-status" aria-live="polite">
                      {vote.updated_at && `Updated ${formatDate(vote.updated_at)}`}
                    </span>
                  </form>
                </article>
              ))
            ) : (
              <p class="empty panel">No roll-call votes match those filters.</p>
            )}
          </section>
        </>
      )}
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .admin-votes-page {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 32px 0 56px;
  }

  .panel {
    border: 1px solid rgba(57, 102, 163, 0.18);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 18px 45px rgba(37, 58, 92, 0.08);
  }

  .vote-hero {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: flex-start;
    padding: clamp(24px, 5vw, 52px);
    background:
      radial-gradient(circle at top right, rgba(225, 75, 0, 0.12), transparent 32%),
      linear-gradient(135deg, #f7fbff, #fff8f4);
  }

  .vote-hero h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    line-height: 0.95;
  }

  .vote-hero p {
    max-width: 760px;
    color: #4d5a70;
    font-size: 1.05rem;
  }

  .vote-hero a,
  .filter-panel button,
  .visibility-form button,
  .login-panel a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    border-radius: 999px;
    border: 0;
    background: #1f2b38;
    color: #fffaf2;
    font-weight: 900;
    text-decoration: none;
    padding: 0.85rem 1.2rem;
    cursor: pointer;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #245ae8;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .notice {
    border-radius: 12px;
    padding: 1rem 1.2rem;
    font-weight: 800;
  }

  .notice.success {
    background: #e9f8ef;
    color: #146332;
  }

  .notice.error {
    background: #ffe9e9;
    color: #8f1717;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 18px 0;
  }

  .grade-cache-panel {
    align-items: center;
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-bottom: 18px;
    padding: 18px;
  }

  .grade-cache-panel h2 {
    margin: 0 0 8px;
  }

  .grade-cache-panel p:not(.eyebrow) {
    color: #4d5a70;
    margin: 0;
  }

  .grade-cache-panel form {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }

  .grade-cache-panel button {
    background: #1f2933;
    border: 0;
    border-radius: 999px;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 900;
    padding: 11px 16px;
  }

  .summary-grid span {
    border: 1px solid rgba(57, 102, 163, 0.18);
    border-radius: 16px;
    background: #fff;
    padding: 1rem;
    color: #59657a;
    font-weight: 850;
  }

  .summary-grid strong {
    display: block;
    color: #202a36;
    font-size: 2rem;
    line-height: 1;
  }

  .filter-panel {
    padding: 18px;
    margin-bottom: 18px;
  }

  .vote-filter-form {
    display: grid;
    grid-template-columns: minmax(220px, 1.4fr) repeat(3, minmax(130px, 0.7fr)) auto;
    gap: 12px;
    align-items: end;
  }

  label {
    display: grid;
    gap: 0.4rem;
    color: #4d5a70;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  input,
  select {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #cbd6e5;
    border-radius: 12px;
    background: #fff;
    color: #202a36;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: 0;
    text-transform: none;
    padding: 0.8rem 0.9rem;
  }

  .vote-list {
    display: grid;
    gap: 14px;
  }

  .vote-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    gap: 18px;
    padding: 18px;
  }

  .vote-title-line,
  .vote-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .vote-title-line a,
  .vote-title-line span,
  .vote-meta span {
    border: 1px solid #cfe0ff;
    border-radius: 999px;
    background: #f7fbff;
    color: #41516b;
    font-size: 0.78rem;
    font-weight: 900;
    text-decoration: none;
    padding: 0.35rem 0.65rem;
  }

  .vote-title-line a {
    background: #eaf2ff;
    color: #1f56c4;
  }

  .vote-main h2 {
    margin: 0.75rem 0 0.4rem;
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .vote-main p {
    margin: 0 0 0.8rem;
    color: #566279;
  }

  .visibility-form {
    display: grid;
    gap: 10px;
    align-content: start;
    border-left: 1px solid rgba(57, 102, 163, 0.16);
    padding-left: 18px;
  }

  .visibility-pill {
    justify-self: start;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 950;
    padding: 0.45rem 0.75rem;
  }

  .visibility-pill.graded {
    background: #e8f7ed;
    color: #126131;
  }

  .visibility-pill.not-graded {
    background: #fff3d8;
    color: #7a4a00;
  }

  .visibility-pill.hidden {
    background: #ffe7e2;
    color: #8d2314;
  }

  .toggle-line {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.94rem;
  }

  .toggle-line input {
    width: auto;
  }

  .vote-save-status {
    min-height: 1.2rem;
    color: #66758d;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .vote-save-status :global(.inline-status.success) {
    color: #126131;
  }

  .vote-save-status :global(.inline-status.error) {
    color: #8d2314;
  }

  .empty,
  .login-panel {
    padding: 28px;
  }

  @media (max-width: 820px) {
    .vote-hero,
    .vote-row,
    .grade-cache-panel {
      grid-template-columns: 1fr;
      display: grid;
    }

    .grade-cache-panel form {
      justify-content: flex-start;
    }

    .vote-filter-form,
    .summary-grid {
      grid-template-columns: 1fr;
    }

    .visibility-form {
      border-left: 0;
      border-top: 1px solid rgba(57, 102, 163, 0.16);
      padding-left: 0;
      padding-top: 16px;
    }
  }
</style>
