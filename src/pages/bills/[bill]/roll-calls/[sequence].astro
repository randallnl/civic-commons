---
export const prerender = false;

import { billDetailPath, getRollCallVotes, positionCounts } from "../../../../lib/billsApi";
import TopNav from "../../../../components/TopNav.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import FilterBar from "../../../../components/FilterBar.astro";
import GlobalTheme from "../../../../components/GlobalTheme.astro";
import profileIcon from "../../../../assets/profile icon.png";
import { FREE_STATE_ALIGNED_TOOLTIP, TPACTION_ALIGNED_TOOLTIP } from "../../../../lib/alignmentTags";
import { isFreeStater, isTpActionAligned } from "../../../../lib/civicTags";
import { profilePhotoUrl } from "../../../../lib/photos";
import { cleanText } from "../../../../lib/text";
import { getTrackedBills, normalizeBillCode } from "../../../../lib/trackedBills";
import {
  ROLL_CALL_SHARE_HEIGHT,
  ROLL_CALL_SHARE_WIDTH,
  rollCallShareImageUrl,
} from "../../../../lib/rollCallSharePreview";

const billCode = Astro.params.bill || "";
const sequence = Astro.params.sequence || "";
const year = Astro.url.searchParams.get("year")?.trim() || "";
const sharePreviewCapture = Astro.url.searchParams.get("share-preview") === "1";

let bill = null;
let rollCall = null;
let votes = [];
let trackedBill = null;
let error = "";

try {
  const [data, trackedBills] = await Promise.all([
    getRollCallVotes(billCode, sequence, { year }),
    getTrackedBills(),
  ]);

  bill = data.bill;
  rollCall = data.rollCall;
  votes = (data.votes || []).filter(isListedLegislatorVote);
  trackedBill = trackedBills.get(normalizeBillCode(bill?.condensedbillno || billCode));
} catch (loadError) {
  error = loadError?.message || "Unable to load roll call votes.";
}

const groupedVotes = groupVotes(votes);
const voteFilters = groupedVotes.map((group) => ({
  label: group.label,
  count: group.rows.length,
  key: filterKey(group.label),
}));
const countyFilters = groupByValue(votes, (vote) => cleanText(vote.county || ""));
const testimonyPosition = testimonyPositionForBill(bill);
const testimonyCounts = positionCounts(bill || {});
const testimonyTotal = Math.max(
  testimonyCounts.total,
  testimonyCounts.support + testimonyCounts.oppose + testimonyCounts.neutral,
);
const testimonySummaryLabel = publicTestimonySummaryLabel(testimonyCounts);
const shareBillCode = bill?.condensedbillno || billCode;
const shareYear = String(bill?.sessionyear || year || "");
const shareRevision =
  rollCall?.votedate ||
  rollCall?.updated_at ||
  bill?.updated_at ||
  bill?.last_updated ||
  shareYear;
const rollCallShareImage = rollCallShareImageUrl(
  shareBillCode,
  sequence,
  shareYear,
  shareRevision,
);
const rollCallShareUrl = new URL(Astro.url.pathname, "https://nhdeservesbetter.com");
if (shareYear) rollCallShareUrl.searchParams.set("year", shareYear);
const rollCallShareTitle = `Roll Call ${sequence} | ${shareBillCode} | NH Deserves Better`;
const rollCallShareDescription = cleanText(
  trackedBill?.name || rollCall?.question_motion || `Roll call votes for ${shareBillCode}.`,
);

function isListedLegislatorVote(vote = {}) {
  return Boolean(
    cleanText(vote.name || "") &&
      (vote.personid || vote.id || vote.slug || vote.employeeno || cleanText(vote.name || "")),
  );
}

function groupVotes(voteRows = []) {
  const groups = new Map();

  for (const vote of voteRows) {
    const key = vote.vote_label || vote.vote || "Not listed";
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(vote);
  }

  return [...groups].map(([label, rows]) => ({ label, rows }));
}

function groupByValue(rows = [], getValue) {
  const groups = new Map();

  for (const row of rows) {
    const label = getValue(row);
    if (!label) continue;
    const key = filterKey(label);
    if (!groups.has(key)) groups.set(key, { key, label, count: 0 });
    groups.get(key).count += 1;
  }

  return [...groups.values()].sort((first, second) => first.label.localeCompare(second.label));
}

function formatDate(value) {
  if (!value) return "";

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
}

function partyClass(party = "") {
  const initial = partyInitial(party);
  if (initial === "R") return "republican";
  if (initial === "D") return "democrat";
  if (initial === "I") return "independent";
  return "unknown";
}

function partyLabel(party = "") {
  const value = String(party || "").trim();
  const lower = value.toLowerCase();
  if (value === "R" || lower.includes("republican")) return "Republican";
  if (value === "D" || lower.includes("democrat")) return "Democratic";
  if (value === "I" || lower.includes("independent")) return "Independent";
  return value || "Party not listed";
}

function partyInitial(party = "") {
  const label = partyLabel(party);
  if (label === "Republican") return "R";
  if (label === "Democrat") return "D";
  if (label === "Independent") return "I";
  return String(party || "").trim().charAt(0).toUpperCase() || "";
}

function bodyLabel(value = "") {
  const body = String(value || "").trim().toUpperCase();
  if (body === "H") return "House";
  if (body === "S") return "Senate";
  if (body === "HOUSE") return "House";
  if (body === "SENATE") return "Senate";
  return value || "Legislator";
}

function districtLine(vote = {}) {
  const chamber = bodyLabel(vote.legislativebody || vote.chamber);
  const district = vote.district || vote.raw_district || "";
  const districtText =
    chamber === "House"
      ? `NH House District ${district || "not listed"}`
      : chamber === "Senate"
        ? `NH Senate District ${district || "not listed"}`
        : district
          ? `${chamber} District ${district}`
          : chamber;

  return districtText;
}

function townsLine(vote = {}) {
  return cleanText(vote.towns_represented || vote.townsRepresented || vote.location_text || "");
}

function testimonyPositionForBill(bill = {}) {
  const support = Number(bill?.support_count || bill?.supportCount || 0);
  const oppose = Number(bill?.oppose_count || bill?.opposeCount || 0);
  const total = support + oppose;

  if (!Number.isFinite(total) || total === 0 || support === oppose) {
    return "";
  }

  const margin = Math.abs(support - oppose) / total;
  if (total < 50 && margin <= 0.25) return "";
  if (margin <= 0.1) return "";

  return support > oppose ? "support" : "oppose";
}

function publicTestimonySummaryLabel(counts = {}) {
  const support = Math.max(0, Number(counts.support || 0));
  const oppose = Math.max(0, Number(counts.oppose || 0));
  const neutral = Math.max(0, Number(counts.neutral || 0));
  if (support + oppose + neutral === 0) return "No public testimony";
  if (support === oppose) return "Support and opposition are evenly divided";
  return support > oppose
    ? "More testimony supports this bill"
    : "More testimony opposes this bill";
}

function inferredBillPosition(vote = {}, motion = "") {
  const voteValue = String(vote.vote_code || vote.vote || vote.vote_label || "")
    .trim()
    .toLowerCase();
  const isYea = ["1", "yea", "yes", "y"].includes(voteValue);
  const isNay = ["2", "nay", "no", "n"].includes(voteValue);

  if (!isYea && !isNay) return "";

  const motionText = cleanText(motion).toLowerCase();
  const motionOpposesBill =
    /\bitl\b/.test(motionText) ||
    motionText.includes("inexpedient to legislate") ||
    /\btable\b/.test(motionText) ||
    motionText.includes("laid on the table") ||
    motionText.includes("lay on the table") ||
    motionText.includes("indefinitely postpone") ||
    motionText.includes("postpone indefinitely");

  if (motionOpposesBill) return isYea ? "oppose" : "support";
  return isYea ? "support" : "oppose";
}

function rollCallVoteInterpretation(vote = {}, rollCall = {}, bill = {}) {
  const voteLabel = vote.vote_label || vote.vote || "Not listed";
  const motion = rollCall.question_motion || rollCall.title1 || rollCall.title2 || "";
  const position = inferredBillPosition(vote, motion);
  const testimony = testimonyPositionForBill(bill);

  if (!position) {
    return {
      label: voteLabel,
      className: "testimony-neutral",
    };
  }

  if (!testimony) {
    return {
      label: `${voteLabel}: ${titleCase(position)} - no clear testimony position`,
      className: "testimony-neutral",
    };
  }

  const aligned = position === testimony;

  return {
    label: `${voteLabel}: ${titleCase(position)} - ${
      aligned ? "aligned with testimony position" : "not aligned with testimony position"
    }`,
    className: aligned ? "aligned-with-testimony" : "not-aligned-with-testimony",
  };
}

function titleCase(value = "") {
  return String(value || "").replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function filterKey(value = "") {
  return String(value || "not listed")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

function personHref(vote = {}) {
  return `/people/${vote.personid || vote.id || slugify(vote.name)}`;
}

function slugify(value = "") {
  return String(value)
    .toLowerCase()
    .trim()
    .replace(/['']/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={rollCallShareTitle} />
    <meta property="og:description" content={rollCallShareDescription} />
    <meta property="og:url" content={rollCallShareUrl.toString()} />
    <meta property="og:image" content={rollCallShareImage} />
    <meta property="og:image:width" content={ROLL_CALL_SHARE_WIDTH} />
    <meta property="og:image:height" content={ROLL_CALL_SHARE_HEIGHT} />
    <meta property="og:image:alt" content={`Roll call summary for ${shareBillCode}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={rollCallShareTitle} />
    <meta name="twitter:description" content={rollCallShareDescription} />
    <meta name="twitter:image" content={rollCallShareImage} />
    <title>{rollCallShareTitle}</title>
    <meta
      name="description"
      content={rollCallShareDescription}
    />
  </head>

  <body class:list={[sharePreviewCapture && "roll-call-share-capture"]}>
    {sharePreviewCapture ? <GlobalTheme /> : <TopNav />}
    <main
      class:list={["page", sharePreviewCapture && "roll-call-share-shell"]}
      x-data="nhdbFuzzyFilter({ itemSelector: '.candidate-card[data-fuzzy-item]', pageSize: 24, syncUrl: false })"
    >
      {!sharePreviewCapture && (
        <a class="back" href={billDetailPath(bill?.condensedbillno || billCode, bill?.sessionyear || year)}>
          Back to bill
        </a>
      )}

      {error ? (
        <p class="status-message">{error}</p>
      ) : bill && rollCall ? (
        <>
          <section class="hero">
            {sharePreviewCapture && (
              <div class="share-brand">
                <img src="/nhdb-logo-circle.png" alt="" width="46" height="46" />
                <span>NH Deserves Better</span>
              </div>
            )}
            <p class="eyebrow">Roll Call</p>
            <h1>{bill.condensedbillno}</h1>
            <h2>{trackedBill?.name || rollCall.question_motion || "Roll call vote"}</h2>
            {rollCall.title1 && <p>{rollCall.title1}</p>}
            <div class="hero-meta">
              <span>{rollCall.question_motion || "Motion not listed"}</span>
              {rollCall.votedate && <span>{formatDate(rollCall.votedate)}</span>}
              <span>{votes.length} votes</span>
            </div>
          </section>

          <div class:list={["roll-call-summary-row", sharePreviewCapture && "with-testimony-summary"]}>
            <section class="count-grid">
              <article>
                <span>Yeas</span>
                <strong>{rollCall.yeas}</strong>
              </article>
              <article>
                <span>Nays</span>
                <strong>{rollCall.nays}</strong>
              </article>
              <article>
                <span>Present</span>
                <strong>{rollCall.present}</strong>
              </article>
              <article>
                <span>Absent</span>
                <strong>{rollCall.absent}</strong>
              </article>
            </section>

            {sharePreviewCapture && (
              <section class="testimony-share-summary" aria-label="Public testimony summary">
                <div>
                  <p class="eyebrow">Public Testimony</p>
                  <strong>{testimonySummaryLabel}</strong>
                  <small>{testimonyTotal} submitted positions</small>
                </div>
                <dl>
                  <div class="support">
                    <dt>Support</dt>
                    <dd>{testimonyCounts.support}</dd>
                  </div>
                  <div class="oppose">
                    <dt>Oppose</dt>
                    <dd>{testimonyCounts.oppose}</dd>
                  </div>
                  <div class="neutral">
                    <dt>Neutral</dt>
                    <dd>{testimonyCounts.neutral}</dd>
                  </div>
                </dl>
              </section>
            )}
          </div>

          <section class:list={["panel", "vote-browser", sharePreviewCapture && "share-preview-hidden"]} data-roll-call-browser>
            <div class="section-heading split-heading">
              <div>
                <p class="eyebrow">Legislator Votes</p>
                <h2>How each legislator voted</h2>
              </div>
              <span class="visible-count"><span data-fuzzy-count>{Math.min(votes.length, 24)}</span> shown</span>
            </div>

            <FilterBar action={Astro.url.pathname} submitLabel="Filter votes" clearHref={`${Astro.url.pathname}${year ? `?year=${encodeURIComponent(year)}` : ""}`} columns="dense" live={true}>
              {year && <input type="hidden" name="year" value={year} />}
              <label for="roll-call-search">
                <span>Search</span>
                <input
                  id="roll-call-search"
                  name="q"
                  type="search"
                  placeholder="Name, party, district..."
                  data-fuzzy-search
                />
              </label>

              <label for="roll-call-vote-filter">
                <span>Vote</span>
                <select
                  id="roll-call-vote-filter"
                  name="vote"
                  data-fuzzy-filter-field
                  data-fuzzy-field="vote"
                  data-fuzzy-match="exact"
                  data-fuzzy-label="Vote"
                >
                  <option value="">All votes ({votes.length})</option>
                  {voteFilters.map((filter) => (
                    <option value={filter.key}>{filter.label} ({filter.count})</option>
                  ))}
                </select>
              </label>

              <label for="roll-call-party-filter">
                <span>Party</span>
                <select
                  id="roll-call-party-filter"
                  name="party"
                  data-fuzzy-filter-field
                  data-fuzzy-field="party"
                  data-fuzzy-match="exact"
                  data-fuzzy-label="Party"
                >
                  <option value="">All parties</option>
                  <option value="R">Republican</option>
                  <option value="D">Democrat</option>
                  <option value="I">Independent</option>
                </select>
              </label>

              <label for="roll-call-county-filter">
                <span>County</span>
                <select
                  id="roll-call-county-filter"
                  name="county"
                  data-fuzzy-filter-field
                  data-fuzzy-field="county"
                  data-fuzzy-match="exact"
                  data-fuzzy-label="County"
                >
                  <option value="">All counties</option>
                  {countyFilters.map((filter) => (
                    <option value={filter.label}>{filter.label} ({filter.count})</option>
                  ))}
                </select>
              </label>

              <label for="roll-call-sort">
                <span>Sort</span>
                <select id="roll-call-sort" name="sort" data-fuzzy-sort>
                  <option value="name:asc">Name A-Z</option>
                  <option value="district:asc">District</option>
                  <option value="vote:asc">Vote</option>
                </select>
              </label>
            </FilterBar>
            <div class="filter-chips" data-fuzzy-chips hidden></div>

            <div class="vote-list">
              {votes.map((vote) => {
                const voteLabel = vote.vote_label || vote.vote || "Not listed";
                const voteInterpretation = rollCallVoteInterpretation(vote, rollCall, bill);
                const photoUrl = profilePhotoUrl(vote.photo);
                const searchText = [
                  vote.name,
                  partyLabel(vote.party),
                  vote.party,
                  vote.district,
                  vote.raw_district,
                  vote.chamber,
                  vote.location_text,
                  vote.towns_represented,
                  voteLabel,
                  voteInterpretation.label,
                  testimonyPosition,
                  isFreeStater(vote) ? "Free State Aligned" : "",
                  isTpActionAligned(vote) ? "TPAction Aligned" : "",
                ]
                  .filter(Boolean)
                  .join(" ")
                  .toLowerCase();
                const href = personHref(vote);
                const towns = townsLine(vote);

                return (
                  <article
                    class="candidate-card"
                    data-fuzzy-item
                    data-fuzzy-name={cleanText(vote.name || "")}
                    data-fuzzy-town={towns}
                    data-fuzzy-county={cleanText(vote.county || "")}
                    data-fuzzy-district={cleanText(vote.district || vote.raw_district || "")}
                    data-fuzzy-body={bodyLabel(vote.legislativebody || vote.chamber)}
                    data-fuzzy-party={partyInitial(vote.party)}
                    data-fuzzy-vote={filterKey(voteLabel)}
                    data-fuzzy-sort-name={cleanText(vote.name || "")}
                    data-fuzzy-sort-district={cleanText(vote.district || vote.raw_district || "")}
                    data-fuzzy-sort-vote={voteLabel}
                    data-fuzzy-text={searchText}
                  >
                      <a class="photo-wrap" href={href}>
                        <img
                          class:list={[!photoUrl && "photo-fallback"]}
                          src={photoUrl || profileIcon.src}
                          alt={photoUrl ? `Photo of ${vote.name}` : ""}
                          loading="lazy"
                        />
                      </a>
                      <div class="candidate-copy">
                        <div class="candidate-heading">
                          <h3>
                          <a href={href}>{vote.name || "Legislator not listed"}</a>
                          </h3>
                          <a
                            class:list={["vote-pill", voteInterpretation.className]}
                            href="/vote-interpretations"
                            title="How do we determine this?"
                            aria-label={`How do we determine this? ${voteInterpretation.label}`}
                          >
                            {voteInterpretation.label}
                          </a>
                        </div>
                        <div class="pill-row">
                          <span class:list={["party-pill", `party-${partyClass(vote.party)}`]} data-party-affiliation>
                            {partyLabel(vote.party)}
                          </span>
                          <span>{bodyLabel(vote.legislativebody || vote.chamber)}</span>
                          {vote.county && <span>{cleanText(vote.county)} County</span>}
                          {isFreeStater(vote) && (
                            <a
                              class="free-stater-pill"
                              href="/free-staters"
                              title={FREE_STATE_ALIGNED_TOOLTIP}
                              aria-label={FREE_STATE_ALIGNED_TOOLTIP}
                            >
                              Free State Aligned
                            </a>
                          )}
                          {isTpActionAligned(vote) && (
                            <a
                              class="free-stater-pill tpaction-pill"
                              href="/tpaction-aligned"
                              title={TPACTION_ALIGNED_TOOLTIP}
                              aria-label={TPACTION_ALIGNED_TOOLTIP}
                            >
                              TPAction Aligned
                            </a>
                          )}
                        </div>
                        <p class="office-line">{districtLine(vote)}</p>
                        {towns && (
                          <p class="towns-line">
                            <span>Towns represented</span>
                            {towns}
                          </p>
                        )}
                      </div>
                  </article>
                );
              })}
            </div>

            <p class="status-message empty-state" data-fuzzy-empty hidden>No legislators match those filters.</p>
            <div class="see-more-row">
              <button type="button" class="see-more-button" data-fuzzy-more hidden>Show more legislators</button>
            </div>
          </section>
        </>
      ) : (
        <p class="status-message">Roll call not found.</p>
      )}
    </main>
    {!sharePreviewCapture && <SiteFooter />}
  </body>
</html>

<style>
  :global(body.roll-call-share-capture) {
    background: linear-gradient(145deg, #eef4fb, #d5dde7);
    margin: 0;
    overflow: hidden;
  }

  :global(body.roll-call-share-capture) .roll-call-share-shell {
    box-sizing: border-box;
    height: 630px;
    margin: 0 auto;
    max-width: 1200px;
    overflow: hidden;
    padding: 30px 38px !important;
    width: 100%;
  }

  :global(body.roll-call-share-capture) .hero {
    padding: 0 0 20px;
  }

  :global(body.roll-call-share-capture) .hero h1 {
    font-size: 4.4rem;
    margin-bottom: 10px;
  }

  :global(body.roll-call-share-capture) .hero h2 {
    font-size: 2.15rem;
    margin-bottom: 10px;
    max-width: 1080px;
  }

  :global(body.roll-call-share-capture) .hero p:not(.eyebrow) {
    line-height: 1.4;
    margin: 8px 0;
  }

  :global(body.roll-call-share-capture) .count-grid {
    margin-bottom: 0;
  }

  :global(body.roll-call-share-capture) .roll-call-summary-row {
    align-items: stretch;
    display: grid;
    gap: 14px;
    grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.9fr);
  }

  :global(body.roll-call-share-capture) .count-grid article {
    padding: 20px;
  }

  .testimony-share-summary {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    display: grid;
    gap: 14px;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: 18px;
  }

  .testimony-share-summary .eyebrow {
    margin-bottom: 7px;
  }

  .testimony-share-summary strong,
  .testimony-share-summary small {
    display: block;
  }

  .testimony-share-summary strong {
    font-size: 1rem;
    line-height: 1.2;
    max-width: 230px;
  }

  .testimony-share-summary small {
    color: #64748b;
    font-size: 0.76rem;
    font-weight: 850;
    margin-top: 6px;
  }

  .testimony-share-summary dl {
    display: grid;
    gap: 6px;
    margin: 0;
  }

  .testimony-share-summary dl div {
    align-items: center;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    display: flex;
    gap: 8px;
    justify-content: space-between;
    min-width: 116px;
    padding: 5px 9px;
  }

  .testimony-share-summary dt {
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .testimony-share-summary dd {
    font-size: 0.92rem;
    font-weight: 950;
    margin: 0;
  }

  .testimony-share-summary .support {
    background: #dcfce7;
    border-color: #86efac;
    color: #166534;
  }

  .testimony-share-summary .oppose {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #991b1b;
  }

  .testimony-share-summary .neutral {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #475569;
  }

  .share-brand {
    align-items: center;
    display: flex;
    font-size: 1.05rem;
    font-weight: 950;
    gap: 10px;
    margin-bottom: 18px;
  }

  .share-brand img {
    border-radius: 8px;
  }

  .share-preview-hidden {
    display: none !important;
  }

  .back,
  a {
    color: #1f2933;
    font-weight: 800;
  }

  .hero {
    padding: 28px 0 18px;
  }

  .eyebrow,
  .count-grid span {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.35rem, 6vw, 4.75rem);
    line-height: 0.9;
    margin: 0 0 16px;
