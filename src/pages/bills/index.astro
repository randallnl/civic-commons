---
export const prerender = false;

import BillPositionSummary from "../../components/BillPositionSummary.astro";
import FilterBar from "../../components/FilterBar.astro";
import PageHero from "../../components/PageHero.astro";
import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { billDetailPath, getBills } from "../../lib/billsApi";
import { getTrackedBills, normalizeBillCode } from "../../lib/trackedBills";

const q = Astro.url.searchParams.get("q")?.trim() || "";
const year = Astro.url.searchParams.get("year")?.trim() || "";
const sort = Astro.url.searchParams.get("sort")?.trim() || "";
const body = Astro.url.searchParams.get("body")?.trim() || "";
const stage = Astro.url.searchParams.get("stage")?.trim() || "";
const position = Astro.url.searchParams.get("position")?.trim() || "";

let bills = [];
let error = "";
let trackedBills = new Map();

try {
  const [data, tracked] = await Promise.all([
    getBills({ limit: 500 }),
    getTrackedBills(),
  ]);
  bills = data.bills || [];
  trackedBills = tracked;
} catch (loadError) {
  error = loadError?.message || "Unable to load bills.";
}

function formatDate(value) {
  if (!value) return "";

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
}

function trackedBillFor(bill) {
  return trackedBills.get(normalizeBillCode(bill.condensedbillno));
}

function previewText(text = "", maxLength = 180) {
  const normalized = String(text).replace(/\s+/g, " ").trim();
  if (normalized.length <= maxLength) return normalized;
  return `${normalized.slice(0, maxLength).trim()}...`;
}

function billBody(value = "") {
  const normalized = String(value).trim().toLowerCase();
  if (normalized === "h" || normalized.includes("house")) return "House";
  if (normalized === "s" || normalized.includes("senate")) return "Senate";
  return value || "Other";
}

function billStage(description = "") {
  const value = String(description).toLowerCase();
  if (/signed|chapter\s+\d+|became law|effective\s+[a-z]+\s+\d+|veto(?:ed)?/.test(value)) return "Outcome";
  if (/passed|adopted|enrolled/.test(value)) return "Passed Legislature";
  if (/committee|hearing|referred|retained|interim study|re-referred|rereferred/.test(value)) return "Committee";
  if (/introduced/.test(value)) return "Introduced";
  return "Other";
}

function testimonyLead(bill = {}) {
  const support = Number(bill.support_count || 0);
  const oppose = Number(bill.oppose_count || 0);
  const neutral = Number(bill.neutral_count || 0);
  if (support + oppose + neutral === 0) return "No testimony";
  if (support === oppose) return "Even";
  return support > oppose ? "Support leads" : "Opposition leads";
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Bills | NH Deserves Better</title>
    <meta
      name="description"
      content="Browse tracked New Hampshire bills and testimony summaries."
    />
  </head>

  <body>
    <TopNav />
    <main class="page" x-data="nhdbFuzzyFilter({ itemSelector: '.bill-card[data-fuzzy-item]', pageSize: 24 })">
      <PageHero
        backHref="/"
        backLabel="Back home"
        eyebrow="Tracked Bills"
        title="Browse bills and public testimony."
      >
        <FilterBar
          action="/bills"
          submitLabel="Filter bills"
          clearHref={q || year || body || stage || position || sort ? "/bills" : ""}
          columns="dense"
          live
        >
          <label>
            <span>Search</span>
            <input
              type="search"
              name="q"
              value={q}
              placeholder="HB699, education, labor..."
              data-fuzzy-search
            />
          </label>

          <label>
            <span>Year</span>
            <input
              type="number"
              name="year"
              value={year}
              placeholder="2025"
              min="2020"
              max="2030"
              data-fuzzy-filter-field
              data-fuzzy-field="year"
              data-fuzzy-match="exact"
            />
          </label>

          <label>
            <span>Chamber</span>
            <select name="body" data-fuzzy-filter-field data-fuzzy-field="body" data-fuzzy-match="exact">
              <option value="" selected={!body}>All chambers</option>
              <option value="House" selected={body === "House"}>House</option>
              <option value="Senate" selected={body === "Senate"}>Senate</option>
            </select>
          </label>

          <label>
            <span>Stage</span>
            <select name="stage" data-fuzzy-filter-field data-fuzzy-field="stage" data-fuzzy-match="exact">
              <option value="" selected={!stage}>All stages</option>
              <option value="Introduced" selected={stage === "Introduced"}>Introduced</option>
              <option value="Committee" selected={stage === "Committee"}>Committee review</option>
              <option value="Passed Legislature" selected={stage === "Passed Legislature"}>Passed Legislature</option>
              <option value="Outcome" selected={stage === "Outcome"}>Signed or vetoed</option>
              <option value="Other" selected={stage === "Other"}>Other/unknown</option>
            </select>
          </label>

          <label>
            <span>Public input</span>
            <select name="position" data-fuzzy-filter-field data-fuzzy-field="position" data-fuzzy-match="exact">
              <option value="" selected={!position}>Any testimony</option>
              <option value="Support leads" selected={position === "Support leads"}>Support leads</option>
              <option value="Opposition leads" selected={position === "Opposition leads"}>Opposition leads</option>
              <option value="Even" selected={position === "Even"}>Evenly divided</option>
              <option value="No testimony" selected={position === "No testimony"}>No testimony</option>
            </select>
          </label>

          <label>
            <span>Sort</span>
            <select name="sort" data-fuzzy-sort>
              <option value="" selected={!sort}>Default</option>
              <option value="name:asc" selected={sort === "name:asc"}>Title A-Z</option>
              <option value="bill:asc" selected={sort === "bill:asc"}>Bill code</option>
              <option value="updated:desc" selected={sort === "updated:desc"}>Recently updated</option>
              <option value="testimony:desc" selected={sort === "testimony:desc"}>Most public testimony</option>
            </select>
          </label>

        </FilterBar>
        <div class="filter-chips" data-fuzzy-chips hidden></div>
      </PageHero>

      {error && <p class="status-message">{error}</p>}

      {!error && (
        <section class="results">
          <div class="results-heading">
            <h2>
              Showing <span data-fuzzy-count>{Math.min(bills.length, 24)}</span>
              of <span data-fuzzy-matched-count>{bills.length}</span> matching bills
            </h2>
            {(q || year || body || stage || position || sort) && <a href="/bills">Clear filters</a>}
          </div>

          {bills.length ? (
            <div class="bill-grid">
              {bills.map((bill) => {
                const trackedBill = trackedBillFor(bill);

                return (
                  <article
                    class="bill-card"
                    data-fuzzy-item
                    data-fuzzy-title={bill.name || bill.title || trackedBill?.name || bill.condensedbillno}
                    data-fuzzy-bill={bill.condensedbillno}
                    data-fuzzy-year={bill.sessionyear}
                    data-fuzzy-body={billBody(bill.legislativebody)}
                    data-fuzzy-stage={billStage(bill.description)}
                    data-fuzzy-position={testimonyLead(bill)}
                    data-fuzzy-sort-name={bill.name || bill.title || trackedBill?.name || bill.condensedbillno}
                    data-fuzzy-sort-bill={bill.condensedbillno}
                    data-fuzzy-sort-updated={Date.parse(bill.statusdate || bill.updated_at || bill.updatedAt || "") || 0}
                    data-fuzzy-sort-testimony={Number(bill.testimony_count || 0)}
                    data-fuzzy-text={[
                      bill.condensedbillno,
                      bill.sessionyear,
                      bill.name,
                      bill.title,
                      trackedBill?.name,
                      bill.summary,
                      trackedBill?.summary,
                      bill.description,
                      bill.legislativebody,
                    ].filter(Boolean).join(" ")}
                  >
                    <div class="bill-topline">
                      <strong>{bill.condensedbillno}</strong>
                      <span>{bill.sessionyear}</span>
                    </div>
                    <h3>
                      <a href={billDetailPath(bill.condensedbillno, bill.sessionyear)}>
                        {bill.name || bill.title || trackedBill?.name || bill.condensedbillno}
                      </a>
                    </h3>
                    <p>
                      {previewText(
                        bill.summary ||
                          trackedBill?.summary ||
                          bill.description ||
                          "No summary returned.",
                      )}
                    </p>
                    <BillPositionSummary bill={bill} />
                    <div class="bill-meta">
                      {bill.legislativebody && <span>{billBody(bill.legislativebody)}</span>}
                      <span>{billStage(bill.description)}</span>
                      {bill.statusdate && <span>{formatDate(bill.statusdate)}</span>}
                    </div>
                  </article>
                );
              })}
            </div>
          ) : (
            <div class="status-message empty-state">
              <strong>No bills found.</strong>
              <ul>
                <li>Try a bill code like HB155 or SB134.</li>
                <li>Remove the year filter.</li>
                <li>Search by issue keywords like housing, schools, or labor.</li>
              </ul>
            </div>
          )}
          <div class="status-message empty-state" data-fuzzy-empty hidden>
            <strong>No bills matched those filters.</strong>
            <ul>
              <li>Try a bill code like HB155 or SB134.</li>
              <li>Remove the year chip above.</li>
              <li>Search by issue keywords like housing, schools, or labor.</li>
            </ul>
          </div>
          <button class="show-more-bills" type="button" data-fuzzy-more hidden>
            Show more bills
          </button>
        </section>
      )}
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  a {
    color: #1f2933;
    font-weight: 800;
  }

  .eyebrow {
    color: #6b4f2a;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.2rem, 5.5vw, 4.25rem);
    line-height: 0.95;
    margin: 0 0 24px;
    max-width: 900px;
  }

  .results-heading {
    align-items: center;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .results-heading h2 {
    font-size: 1.7rem;
    margin: 0;
  }

  .bill-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .filter-chips button {
    align-items: center;
    background: #eef6ff;
    border: 1px solid #93c5fd;
    border-radius: 999px;
    color: #1f2933;
    cursor: pointer;
    display: inline-flex;
    gap: 8px;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 900;
    padding: 7px 10px;
  }

  .filter-chips b {
    color: #b91c1c;
    font-size: 1rem;
    line-height: 1;
  }

  .bill-card,
  .status-message {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: none;
    padding: 18px;
  }

  .bill-topline,
  .bill-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: space-between;
  }

  .bill-topline strong {
    font-size: 1.1rem;
  }

  .bill-topline span,
  .bill-meta span {
    background: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 900;
    padding: 6px 9px;
  }

  .bill-card h3 {
    font-size: 1.35rem;
    margin: 14px 0 8px;
  }

  .bill-card p {
    color: #4b5563;
    line-height: 1.55;
    margin: 0 0 14px;
  }

  .empty-state strong {
    color: #1f2933;
    display: block;
    margin-bottom: 8px;
  }

  .empty-state ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 20px;
  }

  .bill-meta {
    justify-content: start;
    margin-top: 14px;
  }

  .show-more-bills {
    background: #1f2933;
    border: 1px solid #1f2933;
    border-radius: 999px;
    color: white;
    cursor: pointer;
    display: block;
    font: inherit;
    font-weight: 950;
    margin: 24px auto 0;
    min-height: 44px;
    padding: 10px 18px;
  }

  .show-more-bills:hover,
  .show-more-bills:focus-visible {
    background: #334155;
  }

  @media (max-width: 520px) {
    .results-heading {
      align-items: start;
      flex-direction: column;
      gap: 8px;
    }

    .results-heading h2 {
      font-size: 1.35rem;
    }
  }

</style>
