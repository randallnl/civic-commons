---
import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Donate | NH Deserves Better</title>
    <meta
      name="description"
      content="Support NH Deserves Better and help keep useful information about New Hampshire legislators and candidates available to the community."
    />
    <script
      is:inline
      async
      src="https://widgets.givebutter.com/latest.umd.cjs?acct=iq1I5oL6otdFZf0i"
    ></script>
  </head>

  <body>
    <TopNav />
    <main class="donation-page">
      <section class="donation-intro">
        <p class="eyebrow">Support the project</p>
        <h1>Help keep NH Deserves Better growing.</h1>
        <p class="lede">
          Randall donates his time to making sure the community has useful
          information about New Hampshire legislators and candidates. A
          contribution of any size shows that this work matters and helps the
          project continue to improve.
        </p>
      </section>

      <section class="donation-panel" aria-label="Donation form">
        <givebutter-widget id="LZov05" align="center"></givebutter-widget>
        <noscript>
          <p>
            JavaScript is required to display the donation form. You can also
            <a href="https://givebutter.com/findmyNHcandidate">donate through Givebutter</a>.
          </p>
        </noscript>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .donation-page {
    display: grid;
    gap: clamp(28px, 5vw, 56px);
    grid-template-columns: minmax(0, 1fr) minmax(320px, 460px);
    margin: 0 auto;
    padding: clamp(44px, 7vw, 88px) 0 80px;
    width: min(1120px, calc(100% - 32px));
  }

  .donation-intro {
    align-self: start;
    padding-top: clamp(8px, 3vw, 30px);
  }

  .eyebrow {
    color: #9a3412;
    font-size: 0.8rem;
    font-weight: 950;
    letter-spacing: 0.14em;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  h1 {
    color: #1f2933;
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    letter-spacing: -0.055em;
    line-height: 0.94;
    margin: 0;
    max-width: 760px;
  }

  .lede {
    color: #475569;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    font-weight: 700;
    line-height: 1.6;
    margin: 26px 0 0;
    max-width: 680px;
  }

  .donation-panel {
    background: #fffaf1;
    border: 1px solid #fed7aa;
    border-radius: 18px;
    box-shadow: 0 22px 55px rgba(120, 53, 15, 0.12);
    box-sizing: border-box;
    min-height: 280px;
    padding: clamp(20px, 4vw, 34px);
    width: 100%;
  }

  .donation-panel givebutter-widget {
    display: block;
    margin: 0 auto;
    max-width: 420px;
    width: 100%;
  }

  .donation-panel noscript p {
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  .donation-panel noscript a {
    color: #b6390a;
    font-weight: 900;
  }

  @media (max-width: 820px) {
    .donation-page {
      grid-template-columns: 1fr;
      padding-top: 38px;
    }

    .donation-intro {
      padding-top: 0;
    }

    .donation-panel {
      justify-self: center;
      max-width: 500px;
    }
  }

  @media (max-width: 520px) {
    .donation-page {
      width: min(100% - 20px, 1120px);
    }

    .donation-panel {
      border-radius: 12px;
      padding: 14px;
    }
  }
</style>
