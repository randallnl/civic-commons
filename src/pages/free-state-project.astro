---
export const prerender = false;

import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const freeStateLogoUrl = organizationAssetUrl("freestateprojectlogo.png");

const timelineMilestones = [
  {
    year: "2001",
    era: "foundation",
    title: "The proposal is published",
    summary: "Jason Sorens publishes the essay that proposes concentrating activists in one state.",
    detail: "Sorens's July 23 essay in The Libertarian Enterprise proposed using a pledge to coordinate a move to a small state. Its first outline placed state selection at 20,000 participants.",
    sourceLabel: "Read the founding essay",
    sourceUrl: "https://ncc-1776.org/archives/tle2001/libe131-20010723-03.html",
  },
  {
    year: "2003",
    era: "foundation",
    title: "New Hampshire is selected",
    summary: "After a 5,000-signature threshold and a vote among candidate states, the project announces New Hampshire.",
    detail: "The project's history says more than 2,500 ballots were cast in a Condorcet vote among ten candidate states, with the October 1 announcement selecting New Hampshire.",
    sourceLabel: "FSP history",
    sourceUrl: "https://www.fsp.org/history/",
  },
  {
    year: "2004",
    era: "growth",
    title: "First Porcupine Freedom Festival",
    summary: "The first PorcFest is reported in Lancaster as the movement begins building a recurring public gathering.",
    detail: "Contemporary ABC reporting describes the 2004 festival and reports more than 6,000 committed members and more than 300 participants then residing in New Hampshire. The reported resident figure is not a completed-moves count.",
    sourceLabel: "ABC News reporting",
    sourceUrl: "https://abcnews.com/amp/US/story?id=96696&page=1",
  },
  {
    year: "2006–07",
    era: "growth",
    title: "Early-move campaign and first electoral milestone",
    summary: "The First 1000 campaign launches; the project's history identifies Joel Winters as its first mover elected to the NH House.",
    detail: "A contemporary reproduction of a 2006 FSP release describes the First 1000 campaign. FSP's history identifies Winters as the first mover elected to the House in the November 2006 election. These are organizational and contemporary-source claims, respectively, not a complete mover roster.",
    sourceLabel: "First 1000 contemporary reproduction",
    sourceUrl: "https://outoftheinkwell.blogspot.com/2006/01/bothered-by-illegal-domestic-spying.html",
  },
  {
    year: "2011–13",
    era: "public-life",
    title: "Leadership and jury-instruction legislation",
    summary: "Carla Gericke's FSP presidency begins in 2011; a 2012 law takes effect in 2013 allowing a defense to inform juries about judging facts and law.",
    detail: "FSP's legacy team page dates Gericke's presidency from March 2011; 2013 Concord city minutes independently identify her as FSP president. HB 146 became Chapter 243 in 2012 and took effect January 1, 2013. The law's legislative outcome should not be used alone to assign organizational credit.",
    sourceLabel: "HB 146, Chapter 243",
    sourceUrl: "https://gc.nh.gov/legislation/2012/HB0146.html",
  },
  {
    year: "2016",
    era: "growth",
    title: "20,000 pledge threshold triggers a move commitment",
    summary: "FSP reports 20,000 Statements of Intent and begins a five-year relocation commitment period.",
    detail: "The project's announcement reports nearly 2,000 people already relocated when the threshold was reached. A signed Statement of Intent is not evidence that a person completed a move.",
    sourceLabel: "FSP trigger announcement",
    sourceUrl: "https://legacy.fsp.org/free-state-project-triggers-the-move-libertarians-new-hampshire/",
  },
  {
    year: "2017",
    era: "public-life",
    title: "Concealed-carry bill becomes law",
    summary: "SB 12 is signed as Chapter 1, effective on the day of signature.",
    detail: "The official docket records Senate passage of 13–10 and House passage of 200–97. Those results document the law, but do not by themselves establish FSP's contribution or identify the organizational status of individual legislators.",
    sourceLabel: "Official SB 12 docket",
    sourceUrl: "https://gc.nh.gov/bill_status/legacy/bs2016/Bill_docket.aspx?lsr=140&q=1&sortoption=&sy=2017&txtbillnumber=Sb12&txtsessionyear=2017",
  },
  {
    year: "2021–22",
    era: "public-life",
    title: "Education and local-government controversies",
    summary: "The state creates Education Freedom Accounts; Croydon's school-budget conflict brings national attention to local FSP-linked participants.",
    detail: "HB 2, Chapter 91 created the EFA program in 2021. In 2022, NHPR reported that Ian and Jody Underwood had moved to Croydon as part of FSP and described their roles in the proposed school-budget cut. That reports a person-specific connection, not organizational direction of the school board or SDGANH.",
    sourceLabel: "NHPR on Croydon",
    sourceUrl: "https://www.nhpr.org/nh-news/2022-03-31/in-croydon-school-budget-cuts-prompt-a-reckoning-on-the-role-of-local-government",
  },
  {
    year: "2023",
    era: "current",
    title: "Eric Brakey becomes executive director",
    summary: "FSP names former Maine state senator Eric Brakey as its next executive director.",
    detail: "NHPR reported the selection November 30, 2023, and FSP's leadership page dates the start of his tenure to December 2023. This page uses the month-level date reflected by those sources.",
    sourceLabel: "NHPR reporting",
    sourceUrl: "https://www.nhpr.org/politics/2023-11-30/free-state-project-taps-maine-state-senator-as-its-next-leader",
  },
  {
    year: "2025",
    era: "public-life",
    title: "EFA eligibility expands",
    summary: "SB 295 becomes Chapter 75, changing EFA eligibility and enrollment provisions.",
    detail: "The enacted law removed the general income eligibility ceiling while retaining priority categories and an enrollment-cap mechanism. The enactment documents a policy outcome; the supplied research does not assign it to a single organization or group of legislators.",
    sourceLabel: "SB 295, enacted text",
    sourceUrl: "https://gc.nh.gov/bill_status/legacy/bs2016/billText.aspx?id=965&sy=2025&txtFormat=html",
  },
  {
    year: "2026",
    era: "current",
    title: "A changing organizational landscape",
    summary: "Separate political organizations emerge while Carla Gericke departs the FSP board and PorcFest production.",
    detail: "Reporting on a newly launched Free State Party says its name alone does not establish FSP authorization or affiliation. Separately, FSP announced in April that Gericke had left her chair and board roles and withdrawn from PorcFest production.",
    sourceLabel: "FSP's April 2026 announcement",
    sourceUrl: "https://community.fsp.org/era-defining-leader-carla-gericke-steps-down-and-passes-the-fsp-baton/",
  },
];

const relationshipRoster = [
  {
    id: "fsp",
    category: "Project and events",
    name: "Free State Project",
    type: "Core organization",
    relationship: "The hub used for this map",
    description: "The organization behind the pledge-based migration project. Its own history is used for its internal milestones; other claims on this page use government records or independent reporting where available.",
    logoUrl: freeStateLogoUrl,
    sourceLabel: "FSP mission and history",
    sourceUrl: "https://www.fsp.org/learn/mission/",
  },
  {
    id: "porcfest-liberty-forum",
    category: "Project and events",
    name: "PorcFest & Liberty Forum",
    type: "Events",
    relationship: "Project-run gatherings",
    description: "PorcFest is documented in the supplied research as a recurring FSP festival. Liberty Forum's own retrospective identifies 2007 as its first year. They are places where participants, advocates, candidates, and speakers may appear; attendance or a speaking role does not establish membership.",
    sourceLabel: "Liberty Forum's history",
    sourceUrl: "https://nhlibertyforum.com/why-this-conference/",
  },
  {
    id: "nhla",
    category: "Independent organizations",
    name: "New Hampshire Liberty Alliance",
    type: "Advocacy organization",
    relationship: "Independent organization; documented network proximity",
    description: "NHLA dates its own founding to November 2003. Its organization directory lists both NHLA and FSP, which documents directory-level network proximity—not shared governance, funding, or formal affiliation.",
    logoUrl: "https://www.nhliberty.org/wp-content/uploads/2026/09/nhla-logo-gold2-medal-coolsilver.svg",
    sourceLabel: "NHLA organizations directory",
    sourceUrl: "https://www.nhliberty.org/organizations/",
  },
  {
    id: "sdganh",
    category: "Independent organizations",
    name: "School District Governance Association of NH",
    type: "Education advocacy organization",
    relationship: "Documented person-specific bridge",
    description: "SDGANH identifies Jody Underwood as a founding member, past president, and secretary. NHPR reported that Jody and Ian Underwood moved to Croydon in 2007 as part of FSP. That is evidence about an individual, not proof that SDGANH is owned, directed, funded, or authorized by FSP.",
    logoUrl: "https://sdganh.org/wp-content/uploads/2021/09/SDGA-Logo.jpg",
    sourceLabel: "SDGANH about page",
    sourceUrl: "https://sdganh.org/about/",
  },
  {
    id: "afp-nh",
    category: "Independent organizations",
    name: "Americans for Prosperity–New Hampshire",
    type: "Advocacy organization",
    relationship: "Issue-specific parallel advocacy",
    description: "FSP, NHLA, and AFP-NH each publicly advocated for 2025 EFA expansion in distinct ways. Those parallel advocacy records do not establish that FSP directed AFP-NH or that any group controlled the final bill.",
    sourceLabel: "AFP-NH's 2025 EFA statement",
    sourceUrl: "https://americansforprosperity.org/press-release/afp-nh-praises-new-hampshire-legislature-for-voting-to-make-efas-universal/",
  },
  {
    id: "porcupine-real-estate",
    category: "Businesses",
    name: "Porcupine Real Estate",
    type: "Business",
    relationship: "Founder-specific business connection",
    description: "FSP's leadership page identifies Mark Warden as an early mover, board director, and founder of Porcupine Real Estate. The company's description of serving movers and liberty-community clients is context for its business audience, not evidence of political control or activity.",
    logoUrl: "https://porcupinerealestate.com/wp-content/uploads/2021/04/TEXT-ONLY-04-scaled.png",
    sourceLabel: "Porcupine Real Estate team page",
    sourceUrl: "https://porcupinerealestate.com/our-agents/",
  },
  {
    id: "josiah-bartlett",
    category: "Distinct entities",
    name: "Josiah Bartlett Center for Public Policy",
    type: "Policy organization",
    relationship: "Pre-FSP organization; no affiliation conclusion",
    description: "The center says it was launched in 1992 and elsewhere references a 1993 founding—both before FSP began in 2001. A shared listing in NHLA's directory does not establish an FSP affiliation.",
    sourceLabel: "Josiah Bartlett Center history",
    sourceUrl: "https://jbartlett.org/about-us/",
  },
  {
    id: "lpnh",
    category: "Distinct entities",
    name: "Libertarian Party of New Hampshire",
    type: "Political party organization",
    relationship: "Separate entity; no FSP relationship conclusion",
    description: "The supplied research calls for separate role histories and primary records before any relationship label is assigned. This roster therefore does not treat party rhetoric, shared ideology, or individual overlap as evidence that LPNH is an FSP affiliate.",
    sourceLabel: "NHPR reporting on LPNH",
    sourceUrl: "https://www.nhpr.org/nh-news/2026-05-28/nh-libertarians-newhampshire-ejected-party-jeremy-kauffman",
  },
  {
    id: "free-state-party",
    category: "Distinct entities",
    name: "Free State Party",
    type: "New political organization",
    relationship: "Reported as separate; not treated as an FSP subsidiary",
    description: "Independent Political Report described a newly launched organization in 2026. Its name does not establish that it is FSP-authorized, an FSP affiliate, or a ballot-qualified political party. Primary governance and registration records are still needed.",
    sourceLabel: "Independent Political Report",
    sourceUrl: "https://independentpoliticalreport.com/2026/03/new-free-state-party-organization-launches-in-new-hampshire/",
  },
];

const keyPeople = [
  {
    id: "jason-sorens",
    name: "Jason Sorens",
    role: "Founder and author of the 2001 proposal",
    relationship: "Direct project founder",
    summary: "Published the founding essay while at Yale, proposing a pledge-based strategy to concentrate activists in one state.",
    imageUrl: "https://www.fsp.org/wp-content/uploads/2025/08/Jason_Sorens-837x1024.png",
    imageSourceLabel: "FSP leadership portrait",
    imageSourceUrl: "https://www.fsp.org/learn/leaders/",
    sourceLabel: "Founding essay",
    sourceUrl: "https://ncc-1776.org/archives/tle2001/libe131-20010723-03.html",
  },
  {
    id: "carla-gericke",
    name: "Carla Gericke",
    role: "Former FSP president, chair, and board member",
    relationship: "Direct organizational leadership",
    summary: "FSP's legacy biography dates her PorcFest organizing to 2009–10 and her presidency from 2011. FSP announced her departure from chair and board roles in April 2026.",
    imageUrl: "https://porcupinerealestate.com/wp-content/uploads/2023/06/Carla-300x400.png",
    imageSourceLabel: "Porcupine Real Estate profile portrait",
    imageSourceUrl: "https://porcupinerealestate.com/our-agents/carla-gericke/",
    sourceLabel: "FSP's April 2026 announcement",
    sourceUrl: "https://community.fsp.org/era-defining-leader-carla-gericke-steps-down-and-passes-the-fsp-baton/",
  },
  {
    id: "mark-warden",
    name: "Mark Warden",
    role: "Early mover, FSP board director, and entrepreneur",
    relationship: "Leadership and business bridge",
    summary: "FSP identifies Warden as an early mover, board director, and founder of Porcupine Real Estate. That supports a founder-specific connection to the business, not a claim that the business is an FSP arm.",
    imageUrl: "https://www.fsp.org/wp-content/uploads/2025/08/mark-warden-scaled-1-819x1024.jpg",
    imageSourceLabel: "FSP leadership portrait",
    imageSourceUrl: "https://www.fsp.org/learn/leaders/",
    sourceLabel: "FSP leadership page",
    sourceUrl: "https://www.fsp.org/learn/leaders/",
  },
  {
    id: "jody-underwood",
    name: "Jody Underwood",
    role: "SDGANH founder and former president",
    relationship: "Documented person-specific bridge",
    summary: "SDGANH describes Underwood as a founding member, past president, and secretary. NHPR reported that she and Ian Underwood moved to Croydon in 2007 as part of FSP.",
    imageUrl: "https://sdganh.org/wp-content/uploads/2019/11/jody-underwood.jpg",
    imageSourceLabel: "SDGANH board portrait",
    imageSourceUrl: "https://sdganh.org/about/",
    sourceLabel: "NHPR on Croydon",
    sourceUrl: "https://www.nhpr.org/nh-news/2022-03-31/in-croydon-school-budget-cuts-prompt-a-reckoning-on-the-role-of-local-government",
  },
  {
    id: "joel-winters",
    name: "Joel Winters",
    role: "New Hampshire House member",
    relationship: "FSP history's first elected mover",
    summary: "FSP's history identifies Winters as its first mover elected to the NH House in 2006. He is listed among the sponsors of 2007's HB 685, the REAL ID restriction law.",
    sourceLabel: "HB 685, Chapter 243",
    sourceUrl: "https://gc.nh.gov/legislation/2007/hb0685.html",
  },
  {
    id: "keith-ammon",
    name: "Keith Ammon",
    role: "New Hampshire legislator",
    relationship: "Reported FSP mover; bill sponsor",
    summary: "NHPR identified Ammon as an FSP mover in 2018. He was the prime sponsor of 2025's HB 302, which authorized a limited state strategic reserve investment option; the law does not establish a completed purchase or investment return.",
    sourceLabel: "NHPR's FSP explainer",
    sourceUrl: "https://www.nhpr.org/nh-news/2018-04-12/you-asked-we-answered-what-is-the-free-state-project",
  },
  {
    id: "eric-brakey",
    name: "Eric Brakey",
    role: "FSP executive director since December 2023",
    relationship: "Direct organizational leadership",
    summary: "NHPR reported his selection in late November 2023; FSP's leadership page gives a December 2023 start date.",
    imageUrl: "https://www.fsp.org/wp-content/uploads/2025/09/Brakey-001-682x1024.jpg",
    imageSourceLabel: "FSP leadership portrait",
    imageSourceUrl: "https://www.fsp.org/learn/leaders/",
    sourceLabel: "NHPR reporting",
    sourceUrl: "https://www.nhpr.org/politics/2023-11-30/free-state-project-taps-maine-state-senator-as-its-next-leader",
  },
  {
    id: "jason-osborne",
    name: "Jason Osborne",
    role: "New Hampshire House Majority Leader",
    relationship: "Political-context figure; membership not established here",
    summary: "NHPR reported on his March 2026 Liberty Forum speech encouraging political participation and coalition work. This records the event and speech, not FSP membership or a formal leadership role.",
    sourceLabel: "NHPR on Liberty Forum",
    sourceUrl: "https://www.nhpr.org/nh-news/2026-03-09/free-staters-freestateproject-nh-newhampshire-jason-osbrne-libertarians-free-state-liberty-forum",
  },
];

const relationshipCategories = [...new Set(relationshipRoster.map((entry) => entry.category))];
const featuredPeople = keyPeople.filter((person) => [
  "jason-sorens",
  "carla-gericke",
  "mark-warden",
  "eric-brakey",
].includes(person.id));

const relationshipGraphData = {
  nodes: [
    ...relationshipRoster.map((entry) => ({
      id: entry.id,
      label: entry.name,
      kind: entry.category === "Businesses" ? "business" : "organization",
      type: entry.type,
      relationship: entry.relationship,
      description: entry.description,
      sourceLabel: entry.sourceLabel,
      sourceUrl: entry.sourceUrl,
      visualUrl: entry.logoUrl || "",
      visualAlt: entry.logoUrl ? `${entry.name} logo` : "",
    })),
    ...keyPeople.map((person) => ({
      id: person.id,
      label: person.name,
      kind: "person",
      type: person.role,
      relationship: person.relationship,
      description: person.summary,
      sourceLabel: person.sourceLabel,
      sourceUrl: person.sourceUrl,
      visualUrl: person.imageUrl || "",
      visualAlt: person.imageUrl ? `Portrait of ${person.name}` : "",
    })),
  ],
  edges: [
    { id: "fsp-porcfest", source: "fsp", target: "porcfest-liberty-forum", classification: "direct", relation: "Project events", summary: "PorcFest is documented as an FSP festival; the record distinguishes event participation from membership.", recordId: "porcfest-liberty-forum" },
    { id: "fsp-sorens", source: "fsp", target: "jason-sorens", classification: "direct", relation: "Founder", summary: "Sorens authored the 2001 proposal that became the Free State Project.", recordId: "jason-sorens" },
    { id: "fsp-gericke", source: "fsp", target: "carla-gericke", classification: "direct", relation: "Leadership", summary: "The cited FSP records describe Gericke's former organizational leadership roles.", recordId: "carla-gericke" },
    { id: "fsp-warden", source: "fsp", target: "mark-warden", classification: "direct", relation: "Board director", summary: "FSP's leadership record identifies Warden as an early mover and board director.", recordId: "mark-warden" },
    { id: "fsp-brakey", source: "fsp", target: "eric-brakey", classification: "direct", relation: "Executive director", summary: "FSP and NHPR records identify Brakey as executive director from December 2023.", recordId: "eric-brakey" },
    { id: "fsp-winters", source: "fsp", target: "joel-winters", classification: "direct", relation: "First elected mover", summary: "FSP history identifies Winters as its first mover elected to the NH House.", recordId: "joel-winters" },
    { id: "fsp-underwood", source: "fsp", target: "jody-underwood", classification: "bridge", relation: "Reported mover", summary: "NHPR reported that Jody and Ian Underwood moved to Croydon as part of FSP; this is a person-specific connection.", recordId: "jody-underwood" },
    { id: "underwood-sdganh", source: "jody-underwood", target: "sdganh", classification: "bridge", relation: "Founder and officer", summary: "SDGANH identifies Underwood as a founding member, past president, and secretary.", recordId: "sdganh" },
    { id: "fsp-ammon", source: "fsp", target: "keith-ammon", classification: "bridge", relation: "Reported mover", summary: "NHPR identified Ammon as an FSP mover; the connection is person-specific.", recordId: "keith-ammon" },
    { id: "fsp-nhla", source: "fsp", target: "nhla", classification: "bridge", relation: "Directory proximity", summary: "NHLA's directory lists both organizations. That records network proximity, not shared governance, funding, or control.", recordId: "nhla" },
    { id: "fsp-afp", source: "fsp", target: "afp-nh", classification: "bridge", relation: "Parallel advocacy", summary: "The records document separate FSP, NHLA, and AFP-NH advocacy on EFA expansion; they do not establish organizational direction.", recordId: "afp-nh" },
    { id: "warden-pre", source: "mark-warden", target: "porcupine-real-estate", classification: "bridge", relation: "Founder", summary: "FSP's leadership page identifies Warden as founder of Porcupine Real Estate; this supports a founder-specific connection.", recordId: "porcupine-real-estate" },
    { id: "forum-osborne", source: "porcfest-liberty-forum", target: "jason-osborne", classification: "bridge", relation: "2026 speech context", summary: "NHPR documented Osborne's 2026 Liberty Forum speech. This is event context, not evidence of FSP membership or leadership.", recordId: "jason-osborne" },
    { id: "fsp-jbartlett", source: "fsp", target: "josiah-bartlett", classification: "boundary", relation: "No affiliation conclusion", summary: "The center predates FSP. A shared directory listing does not establish an FSP affiliation.", recordId: "josiah-bartlett" },
    { id: "fsp-lpnh", source: "fsp", target: "lpnh", classification: "boundary", relation: "Separate entity", summary: "This guide does not treat shared ideology or individual overlap as evidence that LPNH is an FSP affiliate.", recordId: "lpnh" },
    { id: "fsp-free-state-party", source: "fsp", target: "free-state-party", classification: "boundary", relation: "Not a subsidiary", summary: "The similar name does not establish FSP authorization, affiliation, or subsidiary status.", recordId: "free-state-party" },
  ],
};

function organizationAssetUrl(filename = "") {
  return `/api/organization-assets/${String(filename)
    .split("/")
    .map((part) => encodeURIComponent(part))
    .join("/")}`;
}

---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/nhdb-logo-circle.png" />
    <link rel="apple-touch-icon" href="/nhdb-logo-circle.png" />
    <meta property="og:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nhdeservesbetter.com/nhdb-seo-image.png" />
    <title>Free State Project Timeline & Relationship Map | NH Deserves Better</title>
    <meta
      name="description"
      content="Explore a sourced timeline, relationship map, and roster of Free State Project-connected organizations, businesses, and people in New Hampshire."
    />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Research guide · New Hampshire</p>
          <h1>Free State Project: Timeline &amp; Relationship Map</h1>
          <p class="lede">
            A quick, sourced guide to the Project’s history, key figures, and documented connections.
          </p>
          <div class="hero-actions" aria-label="Explore this guide">
            <a class="primary-action" href="#timeline">Explore the timeline</a>
            <a class="secondary-action" href="#relationship-map">View the relationship map</a>
            <a class="secondary-action" href="/free-staters#directory">Browse Free State Aligned people</a>
          </div>
        </div>
        <div class="hero-logo">
          <img src={freeStateLogoUrl} alt="Free State Project logo" data-fsp-logo />
          <span class="logo-fallback" aria-hidden="true">FSP</span>
        </div>
      </section>

      <section class="snapshot-panel" aria-label="Free State Project overview">
        <article>
          <span>2001</span>
          <strong>Founding proposal</strong>
          <p>Jason Sorens publishes the pledge-based migration concept.</p>
        </article>
        <article>
          <span>2003</span>
          <strong>New Hampshire selected</strong>
          <p>The project announces its winning destination after a state vote.</p>
        </article>
        <article>
          <span>2016</span>
          <strong>20,000 pledges</strong>
          <p>FSP reports the threshold that activated a five-year move commitment.</p>
        </article>
        <article>
          <span>2026</span>
          <strong>Still evolving</strong>
          <p>Leadership changes and separate political entities complicate the landscape.</p>
        </article>
      </section>

      <section class="reading-note" aria-labelledby="reading-note-title">
        <div>
          <p class="eyebrow">How to read this map</p>
          <h2 id="reading-note-title">A connection is not automatically an affiliation.</h2>
        </div>
        <p>
          Direct roles, documented bridges, and separate entities are shown differently. A connection alone does not prove affiliation, funding, control, or responsibility.
        </p>
      </section>

      <section class="timeline-section" id="timeline" aria-labelledby="timeline-title">
        <div class="section-intro">
          <div>
            <p class="eyebrow">At a glance</p>
            <h2 id="timeline-title">A timeline you can scan in a minute</h2>
          </div>
          <p>
            Use a filter, then scroll sideways to move through the milestones.
          </p>
        </div>

        <div class="timeline-filters" role="group" aria-label="Filter timeline milestones">
          <button type="button" class="is-active" data-timeline-filter="all" aria-pressed="true">All milestones</button>
          <button type="button" data-timeline-filter="foundation" aria-pressed="false">Foundation</button>
          <button type="button" data-timeline-filter="growth" aria-pressed="false">Growth</button>
          <button type="button" data-timeline-filter="public-life" aria-pressed="false">Public life</button>
          <button type="button" data-timeline-filter="current" aria-pressed="false">Current landscape</button>
        </div>

        <div class="timeline-scroll-shell">
          <div class="timeline-scroll-guide">
            <span>Scroll timeline</span>
            <b>← Swipe, trackpad, or use arrows →</b>
            <div class="timeline-scroll-actions" aria-label="Move through the timeline">
              <button type="button" data-timeline-previous aria-label="Show earlier milestones">←</button>
              <button type="button" data-timeline-next aria-label="Show later milestones">→</button>
            </div>
          </div>
          <ol class="visual-timeline" data-timeline-list>
            {timelineMilestones.map((milestone) => (
              <li data-timeline-item data-era={milestone.era}>
                <a href={`#milestone-${milestone.year.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>
                  <span class="timeline-year">{milestone.year}</span>
                  <strong>{milestone.title}</strong>
                  <span>{milestone.summary}</span>
                  <small>Open the evidence ↓</small>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="relationship-section" id="relationship-map" aria-labelledby="relationship-map-title">
        <div class="section-intro">
          <div>
            <p class="eyebrow">Relationship map</p>
            <h2 id="relationship-map-title">Start at the center. Read every edge.</h2>
          </div>
          <p>
            These are relationship labels, not a claim that every organization is part of the
            Free State Project. Choose a node to see the supporting explanation in the roster.
          </p>
        </div>

        <div class="relationship-graph-experience" data-relationship-graph hidden>
          <div class="graph-toolbar" aria-label="Relationship map controls">
            <div class="graph-filter-group" role="group" aria-label="Filter relationship types">
              <button type="button" class="is-active" data-graph-filter="all" aria-pressed="true">All connections</button>
              <button type="button" data-graph-filter="direct" aria-pressed="false">Direct roles</button>
              <button type="button" data-graph-filter="bridge" aria-pressed="false">Documented bridges</button>
              <button type="button" data-graph-filter="boundary" aria-pressed="false">Important boundaries</button>
            </div>
            <button class="graph-reset" type="button" data-graph-reset>Reset view</button>
          </div>

          <div class="relationship-graph-layout">
            <div
              id="relationship-graph-canvas"
              class="relationship-graph-canvas"
              role="img"
              aria-label="Interactive relationship graph. Select a node or connection to read its evidence summary."
              aria-describedby="relationship-graph-help"
            ></div>

            <aside class="graph-inspector" aria-live="polite" aria-atomic="true">
              <img class="graph-inspector-visual" data-graph-visual alt="" hidden />
              <p class="graph-inspector-kicker" data-graph-kicker>Core organization</p>
              <h3 data-graph-title>Free State Project</h3>
              <p data-graph-description>Select a node or a line to focus its documented context. This map only visualizes the labels and boundaries described in the records below.</p>
              <div class="graph-inspector-actions">
                <a class="graph-record-link" data-graph-record href="#fsp">Open detailed record <span aria-hidden="true">↓</span></a>
                <a class="graph-source-link" data-graph-source href="https://www.fsp.org/learn/mission/" target="_blank" rel="noreferrer">Open cited source <span aria-hidden="true">↗</span></a>
              </div>
            </aside>
          </div>
          <p class="graph-help" id="relationship-graph-help">Drag the canvas to pan, scroll or pinch to zoom, and select a node or line to focus its supporting context. The full, accessible source record remains below.</p>
        </div>

        <div class="relationship-static-fallback" data-relationship-static>
          <div class="relationship-map" aria-label="Free State Project relationship map">
            <div class="map-hub">
              <img src={freeStateLogoUrl} alt="" data-fsp-logo />
              <span class="hub-logo-fallback" aria-hidden="true">FSP</span>
              <strong>Free State<br />Project</strong>
              <span>Core organization</span>
            </div>
            <div class="map-orbits">
              <a class="map-node project-node" href="#porcfest-liberty-forum">
                <span class="node-icon" aria-hidden="true">✦</span>
                <strong>Project events</strong>
                <small>PorcFest &amp; Liberty Forum</small>
              </a>
              <a class="map-node org-node" href="#nhla">
                <span class="node-icon" aria-hidden="true">↔</span>
                <strong>Independent groups</strong>
                <small>Network proximity or issue overlap</small>
              </a>
              <a class="map-node person-node" href="#people-in-the-record">
                <span class="node-icon" aria-hidden="true">●</span>
                <strong>People</strong>
                <small>Leadership, movers, event figures</small>
              </a>
              <a class="map-node business-node" href="#porcupine-real-estate">
                <span class="node-icon" aria-hidden="true">⌂</span>
                <strong>Businesses</strong>
                <small>Founder-specific connections</small>
              </a>
              <a class="map-node boundary-node" href="#free-state-party">
                <span class="node-icon" aria-hidden="true">!</span>
                <strong>Important boundaries</strong>
                <small>Distinct entities ≠ affiliates</small>
              </a>
            </div>
          </div>

          <div class="relationship-legend" aria-label="Relationship label legend">
            <span><b class="legend-dot direct"></b> Direct project role or project-run event</span>
            <span><b class="legend-dot bridge"></b> Documented person-specific or issue-specific connection</span>
            <span><b class="legend-dot boundary"></b> Separate entity; no affiliation conclusion</span>
          </div>
        </div>
        <script id="relationship-graph-data" type="application/json" set:html={JSON.stringify(relationshipGraphData)}></script>
      </section>

      <section class="people-callouts" aria-labelledby="people-callouts-title">
        <div class="section-intro compact-intro">
          <div>
            <p class="eyebrow">Key people</p>
            <h2 id="people-callouts-title">Four figures to know</h2>
          </div>
          <p>Start here, then open the full record for all eight people included in this guide.</p>
        </div>
        <div class="people-callout-grid">
          {featuredPeople.map((person) => (
            <a href={`#${person.id}`}>
              <span class="person-callout-photo" aria-hidden="true">
                {person.imageUrl ? (
                  <img src={person.imageUrl} alt="" loading="lazy" />
                ) : (
                  person.name.split(" ").map((part) => part[0]).join("")
                )}
              </span>
              <span class="person-callout-content">
                <span class="relationship-label">{person.relationship}</span>
                <strong>{person.name}</strong>
                <small>{person.role}</small>
                <b>Read profile ↓</b>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="detailed-record" aria-labelledby="record-title">
        <div class="section-intro">
          <div>
            <p class="eyebrow">Detailed record</p>
            <h2 id="record-title">Explore the evidence</h2>
          </div>
          <p>
            Open a card for the full context and its cited source.
          </p>
        </div>

        <div class="record-group" id="timeline-record">
          <div class="record-group-heading">
            <p class="eyebrow">Timeline detail</p>
            <h3>Milestone record</h3>
          </div>
          <div class="milestone-records">
            {timelineMilestones.map((milestone) => (
              <article id={`milestone-${milestone.year.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>
                <details>
                  <summary class="milestone-record-summary">
                    <span class="record-year">{milestone.year}</span>
                    <span class="record-summary-copy">
                      <strong>{milestone.title}</strong>
                      <span>{milestone.summary}</span>
                    </span>
                    <span class="record-disclosure">Evidence + source</span>
                  </summary>
                  <div class="record-detail-body">
                    <p>{milestone.detail}</p>
                    <a class="source-link" href={milestone.sourceUrl} target="_blank" rel="noreferrer">
                      {milestone.sourceLabel} <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </details>
              </article>
            ))}
          </div>
        </div>

        <div class="record-group" id="people-in-the-record">
          <div class="record-group-heading">
            <p class="eyebrow">People</p>
            <h3>People in the record</h3>
          </div>
          <p class="visuals-note">Official portraits appear where a current primary source provides one. The profile and image links identify their source; initials remain where this guide has not verified a suitable image.</p>
          <div class="person-records">
            {keyPeople.map((person) => (
              <article id={person.id}>
                <details>
                  <summary class="person-record-summary">
                    {person.imageUrl ? (
                      <span class="person-photo">
                        <img src={person.imageUrl} alt={`Portrait of ${person.name}`} loading="lazy" />
                      </span>
                    ) : (
                      <span class="person-monogram" aria-hidden="true">{person.name.split(" ").map((part) => part[0]).join("")}</span>
                    )}
                    <span class="record-summary-copy">
                      <span class="relationship-label">{person.relationship}</span>
                      <strong>{person.name}</strong>
                      <small>{person.role}</small>
                    </span>
                    <span class="record-disclosure">Evidence</span>
                  </summary>
                  <div class="record-detail-body">
                    <p>{person.summary}</p>
                    {person.imageUrl && (
                      <a class="image-source-link" href={person.imageSourceUrl} target="_blank" rel="noreferrer">
                        Image: {person.imageSourceLabel} <span aria-hidden="true">↗</span>
                      </a>
                    )}
                    <a class="source-link" href={person.sourceUrl} target="_blank" rel="noreferrer">
                      {person.sourceLabel} <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </details>
              </article>
            ))}
          </div>
        </div>

        <div class="record-group" id="organization-roster">
          <div class="record-group-heading">
            <p class="eyebrow">Roster</p>
            <h3>Organizations and businesses</h3>
          </div>
          <p class="roster-note">This is a starting roster of entities in the supplied research, organized by the kind of relationship the available record supports. Current marks are shown only when an official source is available; the linked source on each card provides the context.</p>
          {relationshipCategories.map((category) => (
            <section class="roster-category" aria-labelledby={`category-${category.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>
              <h4 id={`category-${category.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`}>{category}</h4>
              <div class="organization-records">
                {relationshipRoster.filter((entry) => entry.category === category).map((entry) => (
                  <article id={entry.id}>
                    <details>
                      <summary class="organization-record-summary">
                        {entry.logoUrl ? (
                          <img class="organization-mark organization-logo" src={entry.logoUrl} alt="" aria-hidden="true" loading="lazy" />
                        ) : (
                          <span class="organization-mark" aria-hidden="true">{entry.name.slice(0, 1)}</span>
                        )}
                        <span class="record-summary-copy">
                          <span class="relationship-label">{entry.relationship}</span>
                          <strong>{entry.name}</strong>
                          <small>{entry.type}</small>
                        </span>
                        <span class="record-disclosure">Evidence</span>
                      </summary>
                      <div class="record-detail-body">
                        <p>{entry.description}</p>
                        <a class="source-link" href={entry.sourceUrl} target="_blank" rel="noreferrer">
                          {entry.sourceLabel} <span aria-hidden="true">↗</span>
                        </a>
                      </div>
                    </details>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>

    </main>
    <SiteFooter />
  </body>
</html>

<script>
  import cytoscape from "cytoscape";

  const graphDataElement = document.querySelector("#relationship-graph-data");
  const graphExperience = document.querySelector("[data-relationship-graph]");
  const graphFallback = document.querySelector("[data-relationship-static]");
  const graphCanvas = document.querySelector("#relationship-graph-canvas");

  if (
    graphDataElement instanceof HTMLScriptElement &&
    graphExperience instanceof HTMLElement &&
    graphFallback instanceof HTMLElement &&
    graphCanvas instanceof HTMLElement
  ) {
    try {
      const relationshipGraphData = JSON.parse(graphDataElement.textContent || "{}");
      const filterButtons = Array.from(document.querySelectorAll("[data-graph-filter]"));
      const resetButton = document.querySelector("[data-graph-reset]");
      const inspectorVisual = document.querySelector("[data-graph-visual]");
      const inspectorKicker = document.querySelector("[data-graph-kicker]");
      const inspectorTitle = document.querySelector("[data-graph-title]");
      const inspectorDescription = document.querySelector("[data-graph-description]");
      const inspectorRecord = document.querySelector("[data-graph-record]");
      const inspectorSource = document.querySelector("[data-graph-source]");

      graphExperience.hidden = false;
      graphFallback.hidden = true;

      const cy = cytoscape({
        container: graphCanvas,
        elements: [
          ...(relationshipGraphData.nodes || []).map((node) => ({ data: node })),
          ...(relationshipGraphData.edges || []).map((edge) => ({ data: edge })),
        ],
        style: [
          {
            selector: "node",
            style: {
              "background-color": "#e0e7ff",
              "border-color": "#4f46e5",
              "border-width": 2,
              color: "#172554",
              label: "data(label)",
              "font-family": "ui-sans-serif, system-ui, sans-serif",
              "font-size": 11,
              "font-weight": 800,
              "text-halign": "center",
              "text-max-width": 88,
              "text-valign": "center",
              "text-wrap": "wrap",
              height: 52,
              padding: 8,
              shape: "round-rectangle",
              width: 96,
            },
          },
          {
            selector: 'node[kind = "person"]',
            style: {
              "background-color": "#ede9fe",
              "border-color": "#7c3aed",
              color: "#3b0764",
              shape: "ellipse",
            },
          },
          {
            selector: 'node[kind = "business"]',
            style: {
              "background-color": "#dcfce7",
              "border-color": "#15803d",
              color: "#14532d",
            },
          },
          {
            selector: "#fsp",
            style: {
              "background-color": "#1f2937",
              "border-color": "#f59e0b",
              "border-width": 4,
              color: "#ffffff",
              "font-size": 13,
              height: 70,
              shape: "ellipse",
              width: 116,
            },
          },
          {
            selector: "edge",
            style: {
              "curve-style": "bezier",
              "font-family": "ui-sans-serif, system-ui, sans-serif",
              "font-size": 8,
              "font-weight": 800,
              label: "data(relation)",
              "line-color": "#cbd5e1",
              "source-arrow-shape": "none",
              "target-arrow-color": "#cbd5e1",
              "target-arrow-shape": "triangle",
              "text-background-color": "#ffffff",
              "text-background-opacity": 0.9,
              "text-background-padding": 2,
              "text-rotation": "autorotate",
              "text-wrap": "wrap",
              "text-max-width": 72,
              width: 2,
            },
          },
          {
            selector: 'edge[classification = "direct"]',
            style: {
              color: "#9a3412",
              "line-color": "#f97316",
              "target-arrow-color": "#f97316",
            },
          },
          {
            selector: 'edge[classification = "bridge"]',
            style: {
              color: "#1d4ed8",
              "line-color": "#2563eb",
              "target-arrow-color": "#2563eb",
            },
          },
          {
            selector: 'edge[classification = "boundary"]',
            style: {
              color: "#9f1239",
              "line-color": "#e11d48",
              "line-style": "dashed",
              "target-arrow-color": "#e11d48",
            },
          },
          {
            selector: ".is-muted",
            style: {
              opacity: 0.14,
              "text-opacity": 0.2,
            },
          },
          {
            selector: ".is-filtered",
            style: {
              display: "none",
            },
          },
          {
            selector: ".is-focus-node",
            style: {
              "border-color": "#111827",
              "border-width": 5,
            },
          },
          {
            selector: ".is-focus-edge",
            style: {
              "text-opacity": 1,
              width: 4,
            },
          },
        ],
        userPanningEnabled: true,
        userZoomingEnabled: true,
        wheelSensitivity: 0.2,
      });

      const fspNode = cy.getElementById("fsp");

      function fitVisibleElements() {
        const visibleElements = cy.elements().not(".is-filtered");
        if (visibleElements.nonempty()) cy.fit(visibleElements, 44);
      }

      function runLayout() {
        cy.layout({
          name: "concentric",
          animate: false,
          avoidOverlap: true,
          concentric: (node) => (node.id() === "fsp" ? 100 : node.degree()),
          levelWidth: () => 2,
          minNodeSpacing: 26,
          padding: 44,
        }).run();
        fitVisibleElements();
      }

      function updateInspector({ title, kicker, description, recordId, sourceLabel, sourceUrl, visualUrl, visualAlt }) {
        if (inspectorKicker instanceof HTMLElement) inspectorKicker.textContent = kicker;
        if (inspectorTitle instanceof HTMLElement) inspectorTitle.textContent = title;
        if (inspectorDescription instanceof HTMLElement) inspectorDescription.textContent = description;

        if (inspectorVisual instanceof HTMLImageElement) {
          inspectorVisual.hidden = !visualUrl;
          inspectorVisual.alt = visualAlt || "";
          if (visualUrl) inspectorVisual.src = visualUrl;
          else inspectorVisual.removeAttribute("src");
        }

        if (inspectorRecord instanceof HTMLAnchorElement) {
          inspectorRecord.href = `#${recordId}`;
          inspectorRecord.hidden = !recordId;
        }

        if (inspectorSource instanceof HTMLAnchorElement) {
          inspectorSource.href = sourceUrl || "#";
          inspectorSource.hidden = !sourceUrl;
          inspectorSource.innerHTML = `${sourceLabel || "Open cited source"} <span aria-hidden="true">↗</span>`;
        }
      }

      function focusNode(node) {
        const neighborhood = node.closedNeighborhood();
        cy.elements().removeClass("is-muted is-focus-node is-focus-edge");
        cy.elements().not(neighborhood).addClass("is-muted");
        neighborhood.edges().addClass("is-focus-edge");
        node.addClass("is-focus-node");
        updateInspector({
          title: node.data("label"),
          kicker: node.data("relationship"),
          description: node.data("description"),
          recordId: node.id(),
          sourceLabel: node.data("sourceLabel"),
          sourceUrl: node.data("sourceUrl"),
          visualUrl: node.data("visualUrl"),
          visualAlt: node.data("visualAlt"),
        });
      }

      function focusEdge(edge) {
        const source = edge.source();
        const target = edge.target();
        const recordNode = cy.getElementById(edge.data("recordId"));
        const connected = source.union(target).union(edge);
        cy.elements().removeClass("is-muted is-focus-node is-focus-edge");
        cy.elements().not(connected).addClass("is-muted");
        edge.addClass("is-focus-edge");
        source.addClass("is-focus-node");
        target.addClass("is-focus-node");
        updateInspector({
          title: `${source.data("label")} ↔ ${target.data("label")}`,
          kicker: edge.data("relation"),
          description: edge.data("summary"),
          recordId: edge.data("recordId"),
          sourceLabel: recordNode.data("sourceLabel"),
          sourceUrl: recordNode.data("sourceUrl"),
          visualUrl: recordNode.data("visualUrl"),
          visualAlt: recordNode.data("visualAlt"),
        });
      }

      function applyFilter(selectedFilter) {
        cy.batch(() => {
          cy.elements().removeClass("is-muted is-focus-node is-focus-edge");
          cy.edges().forEach((edge) => {
            edge.toggleClass("is-filtered", selectedFilter !== "all" && edge.data("classification") !== selectedFilter);
          });
          cy.nodes().forEach((node) => {
            const isHub = node.id() === "fsp";
            const hasVisibleEdge = node.connectedEdges().some((edge) => !edge.hasClass("is-filtered"));
            node.toggleClass("is-filtered", !isHub && !hasVisibleEdge);
          });
        });
        filterButtons.forEach((button) => {
          const isActive = button.dataset.graphFilter === selectedFilter;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });
        fitVisibleElements();
        focusNode(fspNode);
      }

      cy.on("tap", "node", (event) => focusNode(event.target));
      cy.on("tap", "edge", (event) => focusEdge(event.target));
      cy.on("tap", (event) => {
        if (event.target === cy) focusNode(fspNode);
      });

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => applyFilter(button.dataset.graphFilter || "all"));
      });

      if (resetButton instanceof HTMLButtonElement) {
        resetButton.addEventListener("click", () => {
          applyFilter("all");
          runLayout();
        });
      }

      runLayout();
      focusNode(fspNode);
    } catch (error) {
      graphExperience.hidden = true;
      graphFallback.hidden = false;
      console.warn("Unable to initialize the interactive relationship graph", error);
    }
  }

  const timelineFilters = Array.from(document.querySelectorAll("[data-timeline-filter]"));
  const timelineItems = Array.from(document.querySelectorAll("[data-timeline-item]"));
  const timelineList = document.querySelector("[data-timeline-list]");
  const previousTimelineButton = document.querySelector("[data-timeline-previous]");
  const nextTimelineButton = document.querySelector("[data-timeline-next]");

  function moveTimeline(direction) {
    if (!(timelineList instanceof HTMLElement)) return;
    timelineList.scrollBy({
      behavior: "smooth",
      left: direction * Math.max(timelineList.clientWidth * 0.72, 280),
    });
  }

  if (previousTimelineButton instanceof HTMLButtonElement) {
    previousTimelineButton.addEventListener("click", () => moveTimeline(-1));
  }

  if (nextTimelineButton instanceof HTMLButtonElement) {
    nextTimelineButton.addEventListener("click", () => moveTimeline(1));
  }

  timelineFilters.forEach((filter) => {
    filter.addEventListener("click", () => {
      const selectedEra = filter.dataset.timelineFilter || "all";

      timelineFilters.forEach((button) => {
        const isSelected = button === filter;
        button.classList.toggle("is-active", isSelected);
        button.setAttribute("aria-pressed", String(isSelected));
      });

      timelineItems.forEach((item) => {
        const isVisible = selectedEra === "all" || item.dataset.era === selectedEra;
        item.toggleAttribute("hidden", !isVisible);
      });

      if (timelineList instanceof HTMLElement) {
        timelineList.scrollTo({ behavior: "smooth", left: 0 });
      }
    });
  });

  function revealRecordFromHash() {
    const recordId = window.location.hash.slice(1);
    if (!recordId) return;
    const record = document.getElementById(recordId);
    const details = record?.querySelector(":scope > details");
    if (details instanceof HTMLDetailsElement) details.open = true;
  }

  revealRecordFromHash();
  window.addEventListener("hashchange", revealRecordFromHash);

  document.querySelectorAll("[data-fsp-logo]").forEach((image) => {
    const showFallback = () => image.parentElement?.classList.add("logo-unavailable");

    image.addEventListener("error", showFallback);
    if (image instanceof HTMLImageElement && image.complete && image.naturalWidth === 0) {
      showFallback();
    }
  });
</script>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .primary-action,
  .secondary-action {
    align-items: center;
    border-radius: 999px;
    display: inline-flex;
    font-size: 0.92rem;
    font-weight: 900;
    justify-content: center;
    padding: 11px 15px;
    text-decoration: none;
  }

  .primary-action {
    background: #1f2933;
    border: 1px solid #1f2933;
    color: #ffffff;
  }

  .secondary-action {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #1f2933;
  }

  .primary-action:hover,
  .primary-action:focus-visible {
    background: #dc4d09;
    border-color: #dc4d09;
  }

  .secondary-action:hover,
  .secondary-action:focus-visible {
    background: #fff7ed;
    border-color: #dc4d09;
  }

  .snapshot-panel {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 16px;
  }

  .snapshot-panel article {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    min-width: 0;
    padding: 18px;
  }

  .snapshot-panel span,
  .snapshot-panel strong {
    display: block;
  }

  .snapshot-panel span {
    color: #dc4d09;
