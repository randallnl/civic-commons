---
export const prerender = false;

import TopNav from "../components/TopNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { articleDetailPath, articlePublishDate, articleSourceName, getArticles } from "../lib/articlesApi";
import { cleanText } from "../lib/text";
import { enrichArticlesWithPreviews } from "../lib/articlePreviews";
import { getOrganizations, organizationPath } from "../lib/organizationsApi";
import {
  communityUpdateDate,
  getRecentApprovedCommunityUpdates,
} from "../lib/communityUpdates";
import {
  getTrackedBills,
  normalizeBillCode,
} from "../lib/trackedBills";

let recentArticles = [];
let organizationComments = [];
let recentCommunityUpdates = [];
let trackedBills = new Map();
const howToStepImages = [
  organizationAssetUrl("capital dome.png"),
  organizationAssetUrl("portsmouth.png"),
  organizationAssetUrl("nh chamber.jpg"),
  organizationAssetUrl("community.png"),
];

try {
  const [
    articleResult,
    trackedBillResult,
    organizationResult,
    communityUpdatesResult,
  ] = await Promise.allSettled([
    getArticles({ include: "relations", limit: 5 }),
    getTrackedBills(),
    getOrganizations(),
    getRecentApprovedCommunityUpdates({ limit: 6 }),
  ]);

  const articleData = articleResult.status === "fulfilled" ? articleResult.value : {};
  trackedBills = trackedBillResult.status === "fulfilled" ? trackedBillResult.value : new Map();
  const organizations = organizationResult.status === "fulfilled" ? organizationResult.value : [];
  recentCommunityUpdates = communityUpdatesResult.status === "fulfilled" ? communityUpdatesResult.value : [];

  recentArticles = articleData.articles || [];
  organizationComments = organizations
    .flatMap((organization) =>
      (organization.comments || []).map((comment) => ({ ...comment, organization })),
    )
    .filter((comment) => trackedBillForCode(comment.bill || comment.billLabel))
    .slice(0, 4);
} catch (error) {
  console.error(error?.message || "Unable to load homepage API data.");
}

recentArticles = await enrichArticlesWithPreviews(recentArticles, { limit: 5 });

function trackedBillForCode(code = "") {
  const normalized = normalizeBillCode(code);
  if (!normalized) return null;
  if (trackedBills.has(normalized)) return trackedBills.get(normalized);

  for (const [key, bill] of trackedBills.entries()) {
    if (String(key).startsWith(`${normalized}::`)) return bill;
  }

  return null;
}

function organizationAssetUrl(filename = "") {
  return `/api/organization-assets/${String(filename)
    .split("/")
    .map((part) => encodeURIComponent(part))
    .join("/")}`;
}

function previewText(text = "", maxLength = 150) {
  const normalized = cleanText(text).replace(/\s+/g, " ").trim();
  if (normalized.length <= maxLength) return normalized;
  return `${normalized.slice(0, maxLength).trim()}...`;
}

function instagramPreview(value = "") {
  try {
    const url = new URL(value);
    const host = url.hostname.replace(/^www\./, "").toLowerCase();
    if (!["instagram.com", "instagr.am"].includes(host)) return null;

    const parts = url.pathname.split("/").filter(Boolean);
    const first = parts[0]?.toLowerCase() || "";
    const labels = {
      p: "Instagram post",
      reel: "Instagram reel",
      reels: "Instagram reel",
      tv: "Instagram video",
      stories: "Instagram story",
    };
    const label = labels[first] || "Instagram profile";
    const handle =
      first === "stories"
        ? parts[1]
        : labels[first]
          ? ""
          : parts[0] || "";

    return { label, handle, host };
  } catch {
    return null;
  }
}

function positionClass(position = "") {
  const value = String(position).toLowerCase();
  if (value.includes("support") || value.includes("favor")) return "support";
  if (value.includes("oppose") || value.includes("against")) return "oppose";
  return "neutral";
}

function billCommentTitle(trackedBill = {}, fallbackCode = "") {
  const code = normalizeBillCode(trackedBill.code || fallbackCode);
  const name = cleanText(trackedBill.name || trackedBill.title || "");
  if (!name) return code;

  const title = cleanText(
    name
      .replace(new RegExp(`^${code}\\s*[:\\-–—]?\\s*`, "i"), "")
      .trim(),
  ) || name;

  return [code, title].filter(Boolean).join(": ");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/NH%20DB%20Logo.svg" />
    <link rel="apple-touch-icon" href="/NH%20DB%20Logo.svg" />
    <title>NH Deserves Better</title>
    <meta name="description" content="A community-powered civic directory for New Hampshire." />
  </head>

  <body>
    <TopNav />
    <main class="page">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Community-powered civic information</p>
          <h1>Start with your address.</h1>
          <p class="lede">
            Find your New Hampshire State Representatives, State Senator, and
            the candidates running for those offices.
          </p>

          <form class="hero-lookup" action="/my-state-rep" method="get" data-hero-lookup>
            <div class="lookup-tabs" role="tablist" aria-label="Choose lookup type">
              <button
                class="active"
                type="button"
                data-lookup-target="legislators"
                aria-selected="true"
              >
                Legislators
              </button>
              <button
                type="button"
                data-lookup-target="candidates"
                aria-selected="false"
              >
                Candidates
              </button>
            </div>

            <label for="hero-address">Enter your address</label>
            <div class="hero-address-row">
              <input
                id="hero-address"
                name="address"
                type="search"
                placeholder="107 North Main Street, Concord, New Hampshire"
                autocomplete="street-address"
                required
              />
              <button type="submit">Find Matches</button>
            </div>
            <p data-lookup-help>
              See your current State Representative and State Senator districts.
            </p>
          </form>
        </div>
      </section>

      <section class="recently-viewed-panel" data-recently-viewed hidden>
        <div class="section-intro">
          <p class="eyebrow">Recently viewed</p>
          <h2>Pick up where you left off.</h2>
        </div>
        <div class="recently-viewed-grid" data-recently-viewed-list></div>
        <button class="recently-viewed-clear" type="button" data-recently-viewed-clear>
          Clear recently viewed
        </button>
      </section>

      <section class="pathway">
        <div class="section-intro">
          <p class="eyebrow">How to use NH Deserves Better</p>
          <h2>Explore the tools on the site.</h2>
        </div>

        <div class="feature-grid">
          <a class="feature-card" href="/my-state-rep">
            <img class="step-photo" src={howToStepImages[0]} alt="" loading="lazy" />
            <div>
              <span>Address lookup</span>
              <h3>Find My Legislator</h3>
            </div>
          </a>

          <a class="feature-card" href="/communities">
            <img class="step-photo" src={howToStepImages[1]} alt="" loading="lazy" />
            <div>
              <span>Town and county profiles</span>
              <h3>Explore Communities</h3>
            </div>
          </a>

          <a class="feature-card" href="/bills">
            <img class="step-photo" src={howToStepImages[2]} alt="" loading="lazy" />
            <div>
              <span>Bills and votes</span>
              <h3>Track Legislation</h3>
            </div>
          </a>

          <a class="feature-card" href="/articles">
            <img class="step-photo" src={howToStepImages[3]} alt="" loading="lazy" />
            <div>
              <span>Community context</span>
              <h3>Share Updates</h3>
            </div>
          </a>
        </div>
      </section>

      <section class="portal-sidebar-row" aria-label="Social and trending links">
        <aside class="portal-widget trending-widget">
          <h2>Trending Post</h2>
          <div class="trending-list">
            {recentArticles.slice(0, 4).map((article, index) => (
              <a class="trending-item" href={articleDetailPath(article)}>
                <strong>{index + 1}</strong>
                <span>{cleanText(article.preview?.title || article.title || "Community update")}</span>
                {articlePublishDate(article) && <small>{articlePublishDate(article)}</small>}
              </a>
            ))}
          </div>
        </aside>

        <aside class="portal-widget follow-widget">
          <h2>Follow Us</h2>
          <div class="social-grid">
            <a href="#">Facebook</a>
            <a href="#">Twitter</a>
            <a href="#">Instagram</a>
            <a href="#">Youtube</a>
            <a href="#">Linkedin</a>
            <a href="#">Telegram</a>
          </div>
        </aside>
      </section>

      <section class="homepage-stack">
        <div class="homepage-panel">
          <div class="section-intro">
          <p class="eyebrow">Community Comments</p>
          <h2>Pair public experience with organized civic analysis.</h2>
          <p>
            This space will bring together resident comments and published
            organizational comments on tracked bills so visitors can see both
            personal impact and policy analysis in one place. The goal is to
            help neighbors understand the local context behind votes,
            legislation, and public accountability.
          </p>
          </div>

          <div class="comment-list stacked-comment-list">
              {organizationComments.length ? (
                organizationComments.map((item) => {
                  const trackedBill = trackedBillForCode(item.bill || item.billLabel);
                  const billCode = trackedBill?.code || normalizeBillCode(item.bill || item.billLabel);
                  const billTitle = billCommentTitle(trackedBill, billCode);

                  return (
                    <article class="comment-card">
                      <div class="comment-topline">
                        <div class="organization-comment-source">
                          {item.organization.logoUrl && (
                            <a class="organization-comment-logo" href={organizationPath(item.organization)} tabindex="-1" aria-hidden="true">
                              <img src={item.organization.logoUrl} alt="" loading="lazy" />
                            </a>
                          )}
                          <a href={organizationPath(item.organization)}>
                            {item.organization.name}
                          </a>
                        </div>
                        {item.position && (
                          <span class:list={["position-pill", positionClass(item.position)]}>
                            {item.position}
                          </span>
                        )}
                      </div>
                      <a class="bill-comment-link" href={`/bills/${billCode}`}>
                        {billTitle}
                      </a>
                      <p>{previewText(item.comment, 190)}</p>
                    </article>
                  );
                })
              ) : (
                <article class="comment-card placeholder">
                  <span>Organizational comments</span>
                  <strong>No tracked bill comments yet</strong>
                  <p>Published organization comments for bills in the tracker will appear here automatically.</p>
                </article>
              )}
          </div>
        </div>
      </section>

      <section class="cta">
        <h2>Help keep civic information accurate and useful.</h2>
        <p>
          New Hampshire has one of the largest legislatures in the country, and
          transparency at that scale takes community participation. Help us keep
          the data correct and up to date, and help your neighbors understand
          the context of this work by sharing articles, social posts, images,
          profile updates, and bill context for review.
        </p>
        <a href="/suggest-update">Suggest an update</a>
      </section>
    </main>
    <script>
      const lookupForm = document.querySelector("[data-hero-lookup]");
      const lookupHelp = lookupForm?.querySelector("[data-lookup-help]");
      const lookupTabs = lookupForm?.querySelectorAll("[data-lookup-target]");
      let lookupTarget = "legislators";

      function setLookupTarget(nextTarget) {
        lookupTarget = nextTarget === "candidates" ? "candidates" : "legislators";
        lookupForm?.setAttribute(
          "action",
          lookupTarget === "candidates" ? "/candidates" : "/my-state-rep",
        );
        if (lookupHelp) {
          lookupHelp.textContent =
            lookupTarget === "candidates"
              ? "See State House and State Senate candidates for your address."
              : "See your current State Representative and State Senator districts.";
        }

        lookupTabs?.forEach((tab) => {
          const active = tab.getAttribute("data-lookup-target") === lookupTarget;
          tab.classList.toggle("active", active);
          tab.setAttribute("aria-selected", String(active));
        });
      }

      lookupTabs?.forEach((tab) => {
        tab.addEventListener("click", () => setLookupTarget(tab.getAttribute("data-lookup-target")));
      });

      lookupForm?.addEventListener("submit", (event) => {
        if (lookupTarget !== "legislators") return;
        event.preventDefault();
        const formData = new FormData(lookupForm);
        const address = String(formData.get("address") || "").trim();
        if (!address) return;
        window.location.href = `/my-state-rep?address=${encodeURIComponent(address)}#rep-results`;
      });

      const recentlyViewedPanel = document.querySelector("[data-recently-viewed]");
      const recentlyViewedList = document.querySelector("[data-recently-viewed-list]");
      const recentlyViewedClear = document.querySelector("[data-recently-viewed-clear]");
      const recentlyViewedKey = "nhdb:recently-viewed-profiles";

      function safeProfileHref(value) {
        const href = String(value || "");
        return href.startsWith("/people/") || href.startsWith("/candidates/")
          ? href
          : "";
      }

      function profileInitials(name = "") {
        return String(name || "")
          .trim()
          .split(/\s+/)
          .slice(0, 2)
          .map((part) => part[0] || "")
          .join("")
          .toUpperCase() || "NH";
      }

      function appendText(parent, tagName, text, className = "") {
        if (!text) return null;
        const element = document.createElement(tagName);
        if (className) element.className = className;
        element.textContent = text;
        parent.append(element);
        return element;
      }

      function previewTowns(value = "", maxLength = 92) {
        const text = String(value || "").replace(/\s+/g, " ").trim();
        if (text.length <= maxLength) return text;

        const clipped = text.slice(0, maxLength + 1);
        const commaBreak = clipped.lastIndexOf(",");
        const spaceBreak = clipped.lastIndexOf(" ");
        const breakAt = commaBreak > 42 ? commaBreak : spaceBreak;
        return `${text.slice(0, breakAt > 42 ? breakAt : maxLength).trim().replace(/,+$/, "")}...`;
      }

      function renderRecentlyViewedProfiles() {
        if (!recentlyViewedPanel || !recentlyViewedList) return;

        let profiles = [];
        try {
          profiles = JSON.parse(localStorage.getItem(recentlyViewedKey) || "[]");
        } catch {
          profiles = [];
        }

        profiles = profiles
          .filter((profile) => profile && safeProfileHref(profile.href) && profile.name)
          .slice(0, 6);

        recentlyViewedList.replaceChildren();
        recentlyViewedPanel.hidden = profiles.length === 0;
        if (!profiles.length) return;

        for (const profile of profiles) {
          const card = document.createElement("article");
          card.className = `recent-profile-card ${profile.kind === "candidate" ? "candidate-style" : "legislator-style"}`;

          const href = safeProfileHref(profile.href);
          const photoLink = document.createElement("a");
          photoLink.className = "recent-profile-photo";
          photoLink.href = href;
          const photo = document.createElement("span");
          photo.className = "recent-profile-photo-inner";
          if (profile.photoUrl) {
            const image = document.createElement("img");
            image.src = profile.photoUrl;
            image.alt = "";
            image.loading = "lazy";
            photo.append(image);
          } else {
            photo.textContent = profileInitials(profile.name);
          }
          photoLink.append(photo);
          card.append(photoLink);

          const copy = document.createElement("span");
          copy.className = "recent-profile-copy";
          appendText(copy, "small", profile.kind === "candidate" ? "Candidate Profile" : "Legislator Profile", "recent-profile-kind");

          const title = document.createElement("strong");
          const titleLink = document.createElement("a");
          titleLink.href = href;
          titleLink.textContent = profile.name;
          title.append(titleLink);
          copy.append(title);

          const meta = document.createElement("span");
          meta.className = "recent-profile-meta";
          appendText(meta, "span", profile.party);
          for (const tag of (profile.tags || []).slice(0, 2)) {
            appendText(meta, "span", tag);
          }
          if (meta.childElementCount) copy.append(meta);

          appendText(copy, "span", profile.officeLine || profile.party, "recent-profile-office");
          if (profile.towns) {
            const towns = document.createElement("span");
            towns.className = "recent-profile-towns";
            appendText(towns, "span", "Towns represented");
            const townsText = appendText(towns, "strong", previewTowns(profile.towns));
            if (townsText) townsText.title = profile.towns;
            copy.append(towns);
          }

          if (profile.grade) {
            const grade = document.createElement("span");
            grade.className = `recent-profile-grade grade-${String(profile.grade).trim().charAt(0).toLowerCase()}`;
            appendText(grade, "strong", profile.grade);
            appendText(grade, "small", "Grade");
            card.append(grade);
          }

          const action = document.createElement("span");
          action.className = "recent-profile-action";
          action.textContent = "Open profile";
          copy.append(action);

          card.append(copy);
          recentlyViewedList.append(card);
        }
      }

      recentlyViewedClear?.addEventListener("click", () => {
        localStorage.removeItem(recentlyViewedKey);
        renderRecentlyViewedProfiles();
      });

      renderRecentlyViewedProfiles();
    </script>
    <SiteFooter />
  </body>
</html>

<style>
  .page {
    width: min(1280px, calc(100% - clamp(28px, 4vw, 64px)));
    margin: 0 auto;
    padding: 18px 0 56px;
  }

  .hero {
    align-items: center;
    background:
      radial-gradient(circle at 82% 18%, rgba(220, 77, 9, 0.16), transparent 28%),
      linear-gradient(135deg, #eff6ff 0%, #ffffff 48%, #f8fbff 100%);
    border: 1px solid #bfdbfe;
    border-radius: 18px;
    box-sizing: border-box;
    display: grid;
    justify-items: center;
    margin: 0;
    min-height: clamp(430px, 42vw, 540px);
    overflow: hidden;
    padding: clamp(28px, 5vw, 62px);
    position: relative;
    width: 100%;
  }

  .hero::before {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(96, 165, 250, 0.04));
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 999px;
    content: "";
    height: 320px;
    position: absolute;
    right: -120px;
    top: -130px;
    width: 320px;
  }

  .hero::after {
    background: rgba(220, 77, 9, 0.13);
    border-radius: 999px;
    bottom: -90px;
    content: "";
    height: 220px;
    left: -80px;
    position: absolute;
    width: 220px;
  }

  .hero-copy {
    color: #1f2933;
    display: grid;
    gap: 18px;
    justify-items: center;
    position: relative;
    text-align: center;
    width: min(900px, 100%);
    z-index: 2;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    font-weight: 700;
    color: #6b4f2a;
    margin-bottom: 16px;
  }

  .hero .eyebrow {
    color: #1d4ed8;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(2rem, 4.2vw, 3.45rem);
    line-height: 1;
    margin: 0;
  }

  .hero h1 {
    color: #1f2933;
    text-shadow: none;
  }

  .lede {
    max-width: 760px;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.6;
    margin: 18px 0 0;
    color: #4b5563;
  }

  .hero .lede {
    color: #334155;
    margin-top: 0;
    text-shadow: none;
  }

  .hero-lookup {
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(135deg, rgba(37, 99, 235, 0.62), rgba(220, 77, 9, 0.38)) border-box;
    border: 1px solid transparent;
    border-radius: 18px;
    box-shadow: 0 18px 50px rgba(37, 99, 235, 0.12);
    display: grid;
    gap: 14px;
    margin-top: 8px;
    padding: clamp(16px, 2vw, 22px);
    text-align: left;
    width: min(760px, 100%);
  }

  .lookup-tabs {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 999px;
    display: inline-flex;
    gap: 4px;
    justify-self: center;
    padding: 4px;
  }

  .lookup-tabs button {
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: #1e3a8a;
    cursor: pointer;
    font: inherit;
    font-weight: 950;
    padding: 10px 14px;
  }

  .lookup-tabs button.active {
    background: #1d4ed8;
    color: #ffffff;
  }

  .hero-lookup label {
    color: #1e3a8a;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-address-row {
    align-items: stretch;
    display: grid;
    gap: 10px;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .hero-address-row input,
  .hero-address-row button {
    border-radius: 999px;
    box-sizing: border-box;
    font: inherit;
    min-height: 56px;
  }

  .hero-address-row input {
    background: #f8fbff;
    border: 1px solid rgba(37, 99, 235, 0.38);
    color: #1f2933;
    font-size: 1.05rem;
    font-weight: 800;
    padding: 14px 18px;
    width: 100%;
  }

  .hero-address-row input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.14);
    outline: none;
  }

  .hero-address-row button {
    background: #dc4d09;
    border: 1px solid #b83f07;
    color: #ffffff;
    cursor: pointer;
    font-weight: 950;
    padding: 14px 22px;
  }

  .hero-lookup p {
    color: #475569;
    font-size: 0.94rem;
    font-weight: 850;
    line-height: 1.4;
    margin: 0;
    text-align: center;
  }

  .cta a {
    border: 1px solid #e2e8f0;
    background: #1f2933;
    color: white;
    padding: 16px 22px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .pathway,
  .rep-preview,
  .community-comments,
  .recently-viewed-panel,
  .homepage-panel,
  .cta {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: none;
  }

  .recently-viewed-panel {
    display: grid;
    gap: 18px;
    margin: 24px 0 42px;
    padding: 24px;
  }

  .recently-viewed-panel[hidden] {
    display: none;
  }

  .recently-viewed-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .recent-profile-card {
    align-items: start;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    color: inherit;
    display: grid;
    gap: 16px;
    grid-template-columns: 92px minmax(0, 1fr);
    min-width: 0;
    padding: 16px;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .recent-profile-card:hover {
    border-color: #2563eb;
    transform: translateY(-1px);
  }

  .recent-profile-photo {
    color: inherit;
    display: block;
    text-decoration: none;
  }

  .recent-profile-photo-inner {
    align-items: center;
    aspect-ratio: 4 / 5;
    background: #dbeafe;
    border-radius: 8px;
    color: #1d4ed8;
    display: flex;
    font-weight: 950;
    justify-content: center;
    overflow: hidden;
    width: 92px;
  }

  .recent-profile-photo-inner img {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    width: 100%;
  }

  .recent-profile-copy {
    display: grid;
    gap: 8px;
    grid-column: 2;
    min-width: 0;
  }

  .recent-profile-copy a {
    color: inherit;
    text-decoration: none;
  }

